import argparse
import hashlib
import json
import subprocess
from pathlib import Path

MANIFEST = 'ops/rebuild-2026-09-29/evidence-custody.json'
DOC = 'ops/rebuild-2026-09-29/evidence-custody.md'
EXPECTED = {'promoted_from_defer': (11, 677342), 'post_inventory_copies': (46, 115127)}


def run(root, *args):
    return subprocess.run(['git', '-C', str(root), *args], capture_output=True)


def check(root, mode, revision):
    def read(path):
        if mode == 'git':
            exists = run(root, 'cat-file', '-e', f'{revision}:{path}')
            if exists.returncode:
                raise FileNotFoundError(path)
            result = run(root, 'cat-file', 'blob', f'{revision}:{path}')
            result.check_returncode()
            return result.stdout
        return (root / path).read_bytes()

    manifest = json.loads(read(MANIFEST))['committed']['landed_with_task_7_1']
    doc = read(DOC).decode().split('## Task 7.1 landing\\n', 1)[1].split('\\n## ', 1)[0]
    assert '11 of the 13 Task 7.1 entries (677,342 B)' in doc
    assert '46 compact files (115,127 B)' in doc
    output = {'root': str(root), 'mode': mode, 'revision': revision if mode == 'git' else None,
              'markdown_counts_match': True, 'groups': {}, 'errors': []}
    seen = set()
    for key, (count, size) in EXPECTED.items():
        entries = manifest[key]
        actual_bytes = 0
        present = 0
        matching = 0
        rows = []
        for entry in entries:
            path = entry['target_path']
            assert path not in seen, path
            seen.add(path)
            assert path.startswith('ops/') and all(p not in ('', '.', '..') for p in path.split('/'))
            row = {'path': path, 'expected_bytes': entry['bytes'], 'expected_sha256': entry['sha256']}
            try:
                data = read(path)
            except FileNotFoundError:
                row['status'] = 'missing'
                output['errors'].append({'path': path, 'kind': 'missing'})
            else:
                digest = hashlib.sha256(data).hexdigest()
                present += 1
                actual_bytes += len(data)
                row.update(bytes=len(data), sha256=digest)
                if digest == entry['sha256'] and len(data) == entry['bytes']:
                    matching += 1
                    row['status'] = 'match'
                else:
                    row['status'] = 'mismatch'
                    output['errors'].append({'path': path, 'kind': 'hash_or_size_mismatch',
                                             'bytes': len(data), 'sha256': digest})
            rows.append(row)
        recorded_bytes = sum(e['bytes'] for e in entries)
        assert len(entries) == count and recorded_bytes == size, (key, len(entries), recorded_bytes)
        output['groups'][key] = {'recorded_count': count, 'recorded_bytes': size,
                                'present_count': present, 'actual_bytes': actual_bytes,
                                'matching_count': matching, 'entries': rows}
    output['passed'] = not output['errors']
    return output


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('root', type=Path)
    parser.add_argument('--mode', choices=('git', 'files'), default='git')
    parser.add_argument('--revision', default='HEAD')
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    result = check(args.root, args.mode, args.revision)
    args.output.write_text(json.dumps(result, indent=2) + '\\n')
    print(json.dumps({**{k:v for k,v in result.items() if k "'!= '"'groups'},
                      'groups': {k: {n:v for n,v in g.items() if n "'!= '"'entries'} for k,g in result['groups'].items()}}, indent=2))
    raise SystemExit(0 if result['passed'] else 1)
