    optimizer_steps: int,
    teacher_schedule: TeacherScheduleConfig,
    config: PPOConfig,
) -> tuple[float, float]:
    multiplier = _teacher_schedule_multiplier(teacher_schedule, optimizer_steps)
    return config.teacher_kl_coef * multiplier, config.teacher_value_coef * multiplier


