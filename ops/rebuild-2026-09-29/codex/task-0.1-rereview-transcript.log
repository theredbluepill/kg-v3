   486	                    &mut self.output.features[i * 2 * self.width..(i + 1) * 2 * self.width],
   487	                    &mut self.output.context[i * 4..(i + 1) * 4],
   488	                )?;
   489	                replacements.push((i, game, next_seed.to_string()));
   490	                next_seed += &self.stride;
