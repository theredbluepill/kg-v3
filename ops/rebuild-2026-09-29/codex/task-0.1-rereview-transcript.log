  3730	fn market_price_numeric(
  3731	    item: &str,
  3732	    inventory: &Value,
  3733	    params: &MarketParams,
  3734	) -> Result<Value, String> {
  3735	    let base = param_number(params, item, "base")?;
  3736	    let i0 = params
  3737	        .get(item)
  3738	        .and_then(|param| param.get("I0"))
  3739	        .ok_or_else(|| format!("marketParams[{item:?}][\"I0\"] is missing"))?;
  3740	    let price = if numeric_less(inventory, i0, "market inventory/I0")? {
  3741	        let function = param_string(params, item, "below_func");
  3742	        let amplitude = market_amplitude(params, item, "below_target", function)?;
  3743	        let distance_shape =
  3744	            market_distance_shape(params, item, function, i0, inventory, "market scarcity")?;
  3745	        base + amplitude * distance_shape
  3746	    } else {
  3747	        let function = param_string(params, item, "above_func");
  3748	        let amplitude = market_amplitude(params, item, "above_target", function)?;
  3749	        let distance_shape =
  3750	            market_distance_shape(params, item, function, inventory, i0, "market glut")?;
  3751	        base - amplitude * distance_shape
  3752	    };
