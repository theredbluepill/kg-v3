  3792	fn fib(index: usize) -> BigInt {
  3793	    let (mut a, mut b) = (BigInt::from(1), BigInt::from(1));
  3794	    for _ in 0..index {
  3795	        (a, b) = (b.clone(), a + b);
  3796	    }
  3797	    a
  3798	}
