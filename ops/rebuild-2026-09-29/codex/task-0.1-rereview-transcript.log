  2951	}
  2952	
  2953	fn inv_take(inv: &mut Inventory, item: &str, count: i64) -> bool {
  2954	    let available = inv.get(item).copied().unwrap_or(0);
  2955	    if available < count {
  2956	        return false;
  2957	    }
  2958	    let left = available - count;
  2959	    if left == 0 {
  2960	        inv.shift_remove(item);
  2961	    } else {
  2962	        inv.insert(item.to_string(), left);
  2963	    }
  2964	    true
  2965	}
