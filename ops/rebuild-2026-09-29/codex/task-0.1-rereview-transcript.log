   100	            "margin" => margin / 3000.0,
   101	            "win_only" => (sign + 1.0) / 2.0,
   102	            "win_share" => {
   103	                let share = if own + other > 0.0 {
   104	                    own / (own + other).max(1e-30)
   105	                } else {
   106	                    0.5
   107	                };
