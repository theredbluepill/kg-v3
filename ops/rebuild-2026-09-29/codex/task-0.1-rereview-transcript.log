     6	"""
     7	
     8	from typing import Literal, Self
     9	
    10	import torch
    11	from pydantic import Field, model_validator
    12	
    13	from owl.config import BaseConfig
    14	
    15	RewardMode = Literal["win_loss", "win_only", "win_share", "margin"]
    16	ECON_FIELDS = 32
    17	
    18	
    19	class KaggricultureRewardConfig(BaseConfig):
    20	    share_weight: float = Field(default=0.1, ge=0, le=1, allow_inf_nan=False)
    21	    econ_shaping: float = Field(default=0, ge=0, allow_inf_nan=False)
    22	    econ_starvation_weight: float = Field(default=4, ge=0, allow_inf_nan=False)
    23	    econ_drought_weight: float = Field(default=1, ge=0, allow_inf_nan=False)
    24	    econ_cap: float = Field(default=0.25, gt=0, lt=1, allow_inf_nan=False)
    25	    econ_ineffective_weight: float = Field(default=0, ge=0, allow_inf_nan=False)
    26	    econ_ineffective_cap: float = Field(default=0.10, gt=0, lt=1, allow_inf_nan=False)
    27	
    28	    @property
    29	    def enabled(self) -> bool:
    30	        return self.econ_shaping > 0 or self.econ_ineffective_weight > 0
    31	
    32	    @property
    33	    def terminal_scale(self) -> float:
    34	        death_cap = self.econ_cap if self.econ_shaping > 0 else 0.0
    35	        ineffective_cap = (
    36	            self.econ_ineffective_cap if self.econ_ineffective_weight > 0 else 0.0
    37	        )
    38	        return 1.0 - death_cap - ineffective_cap
    39	
    40	    @model_validator(mode="after")
    41	    def validate_budget(self) -> Self:
    42	        if self.terminal_scale <= 0:
    43	            raise ValueError("active economic penalty caps must sum below one")
    44	        if (
    45	            self.enabled
    46	            and self.econ_shaping * self.econ_starvation_weight == 0
    47	            and self.econ_shaping * self.econ_drought_weight == 0
    48	            and self.econ_ineffective_weight == 0
    49	        ):
    50	            raise ValueError("economic shaping requires a positive event weight")
    51	        return self
    52	
    53	
    54	def terminal_rewards(
    55	    banks: torch.Tensor, mode: RewardMode, config: KaggricultureRewardConfig
    56	) -> torch.Tensor:
    57	    margin = banks - banks.flip(-1)
    58	    if mode == "margin":
    59	        return margin / 3000.0
    60	    win_loss = margin.sign()
    61	    if mode == "win_loss":
    62	        return win_loss
    63	    if mode == "win_only":
    64	        return (win_loss + 1) / 2
    65	    if mode == "win_share":
    66	        total = banks.sum(-1, keepdim=True)
    67	        share = torch.where(total > 0, banks / total.clamp_min(1e-30), 0.5)
    68	        return (1 - config.share_weight) * win_loss + config.share_weight * (
    69	            2 * share - 1
    70	        )
    71	    raise ValueError(f"unsupported reward mode: {mode}")
    72	
    73	
    74	def economic_penalty(
    75	    counts: torch.Tensor, config: KaggricultureRewardConfig
    76	) -> torch.Tensor:
    77	    counts = counts.to(dtype=torch.float64)
    78	    deaths = config.econ_shaping * (
    79	        config.econ_starvation_weight * counts[..., 0]
    80	        + config.econ_drought_weight * counts[..., 1]
    81	    )
    82	    ineffective = config.econ_ineffective_weight * counts[..., 2]
    83	    return deaths.clamp(max=config.econ_cap) + ineffective.clamp(
    84	        max=config.econ_ineffective_cap
    85	    )
    86	
    87	
    88	def economic_rewards(
    89	    before: torch.Tensor, after: torch.Tensor, config: KaggricultureRewardConfig
    90	) -> torch.Tensor:
    91	    delta = economic_penalty(after, config) - economic_penalty(before, config)
    92	    return delta.flip(-1) - delta
