  3800	fn spawn_hand(farm: &Farm, board_size: usize) -> Vec<i64> {
  3801	    let access = shed_access_tiles(board_size);
  3802	    let mut occupancy = vec![0_usize; access.len()];
  3803	    for position in std::iter::once(&farm.farmer).chain(farm.hands.iter()) {
  3804	        if position.len() < 2 {
  3805	            continue;
  3806	        }
  3807	        if let Some(index) = access
  3808	            .iter()
  3809	            .position(|tile| *tile == (position[0], position[1]))
  3810	        {
  3811	            occupancy[index] += 1;
  3812	        }
  3813	    }
  3814	    let best = (0..access.len())
  3815	        .min_by_key(|index| (occupancy[*index], *index))
  3816	        .unwrap_or(0);
  3817	    vec![access[best].0, access[best].1]
  3818	}
