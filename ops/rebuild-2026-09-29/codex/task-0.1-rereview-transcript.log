  3754	        return Err(format!("market price for {item} is non-finite: {price}"));
  3755	    }
  3756	    // Python's round() is bankers/ties-to-even; f64::round() is not.
  3757	    let rounded = price.round_ties_even();
  3758	    if let Some(rounded) = rounded.to_i64()
  3759	        && rounded >= PRICE_FLOOR
  3760	    {
  3761	        return Ok(Value::from(rounded));
  3762	    }
  3763	    if rounded < PRICE_FLOOR as f64 {
  3764	        return Ok(Value::from(PRICE_FLOOR));
  3765	    }
  3766	    let rounded = BigInt::from_f64(rounded)
  3767	        .ok_or_else(|| format!("cannot convert rounded market price {rounded} to integer"))?;
  3768	    integer_json(&rounded.max(BigInt::from(PRICE_FLOOR)))
  3769	}
