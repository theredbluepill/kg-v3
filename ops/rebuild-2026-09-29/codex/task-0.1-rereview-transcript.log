  4165	fn decay_plants(farm: &mut Farm, step: usize) -> (u64, u64) {
  4166	    let mut deaths = 0;
  4167	    let mut units_lost = 0;
  4168	    let board_size = farm.tiles.len();
  4169	    for y in 0..board_size {
  4170	        for x in 0..board_size {
  4171	            let tile = &mut farm.tiles[y][x];
  4172	            let Some(object) = tile.as_object_mut() else {
  4173	                continue;
  4174	            };
  4175	            if map_str(object, "kind") != Some("PLANT") {
  4176	                continue;
  4177	            }
  4178	            let Some(Ok(max_lifespan)) = object.get("max_lifespan_step").and_then(integer_value)
  4179	            else {
  4180	                continue;
  4181	            };
  4182	            let step = BigInt::from(step);
  4183	            if max_lifespan < BigInt::from(0)
  4184	                || step < max_lifespan
  4185	                || (&step - &max_lifespan) % BigInt::from(2) != BigInt::from(0)
  4186	            {
  4187	                continue;
  4188	            }
  4189	            let held = map_i64(object, "yield_units");
  4190	            let remaining = held - 1;
  4191	            if remaining <= 0 {
  4192	                units_lost += held.max(0) as u64;
  4193	                *tile = json!({"kind": "WEED"});
  4194	                deaths += 1;
  4195	            } else {
  4196	                units_lost += 1;
  4197	                set_i64(object, "yield_units", remaining);
  4198	            }
  4199	        }
  4200	    }
  4201	    (deaths, units_lost)
  4202	}
