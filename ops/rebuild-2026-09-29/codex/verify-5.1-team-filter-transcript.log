   764	@contextlib.contextmanager
   765	def _mapper(workers: int) -> Iterator[Callable[..., Iterable[Any]]]:
   766	    """In-process ``map`` for one worker, else a bounded spawn pool."""
   767	    if workers == 1:
   768	        yield map
   769	        return
   770	    context = multiprocessing.get_context("spawn")
   771	    with context.Pool(workers, maxtasksperchild=64) as pool:
   772	        yield pool.imap_unordered
   773	
   774	
   775	def _parse_days(text: str) -> list[int]:
   776	    if "-" in text:
   777	        first, last = (int(part) for part in text.split("-", 1))
   778	        return list(range(first, last + 1))
   779	    return [int(part) for part in text.split(",")]
   780	
   781	
   782	def _bind_identity(out_dir: Path, identity: dict[str, Any]) -> None:
   783	    """Record the preparation identity, or require an exact match on resume."""
   784	    records = out_dir / RECORD_DIR
   785	    path = records / IDENTITY_NAME
   786	    if path.is_file():
   787	        stored = json.loads(path.read_text(encoding="utf-8"))
   788	        if stored != identity:
   789	            changed = sorted(
   790	                key
   791	                for key in stored.keys() | identity.keys()
   792	                if stored.get(key) != identity.get(key)
   793	            )
   794	            raise RuntimeError(
   795	                f"{path} differs from this run in {changed}; "
   796	                "prepare into a fresh out_dir"
   797	            )
   798	        return
   799	    if records.is_dir() and any(records.glob("*.json")):
   800	        raise RuntimeError(
   801	            f"{records} has records but no {IDENTITY_NAME}; use a fresh out_dir"
   802	        )
   803	    records.mkdir(parents=True, exist_ok=True)
   804	    path.write_text(
   805	        json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
   806	    )
   807	
   808	
   809	def _redact_team(argv: Sequence[str]) -> list[str]:
   810	    """The command line with any ``--team`` value replaced (names never persist)."""
   811	    out: list[str] = []
   812	    redact = False
   813	    for arg in argv:
   814	        if redact:
   815	            out.append("<team>")
   816	            redact = False
   817	        elif arg == "--team":
   818	            out.append(arg)
   819	            redact = True
   820	        elif arg.startswith("--team="):
   821	            out.append("--team=<team>")
   822	        else:
   823	            out.append(arg)
   824	    return out
   825	
