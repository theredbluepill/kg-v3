   827	def main(argv: Sequence[str] | None = None) -> int:
   828	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   829	    parser.add_argument("archives", type=Path, help="directory of day archive ZIPs")
   830	    parser.add_argument(
   831	        "out_dir", type=Path, help="dataset root (outside the checkout)"
   832	    )
   833	    parser.add_argument("--month", default="2026-09")
   834	    parser.add_argument("--days", default="22-28", help="e.g. 22-28 or 22,23")
   835	    parser.add_argument(
   836	        "--workers", type=int, default=max(1, min(16, (os.cpu_count() or 2) - 2))
   837	    )
   838	    parser.add_argument("--validation-fraction", type=float, default=0.03)
   839	    stride = parser.add_mutually_exclusive_group()
   840	    stride.add_argument("--turn-stride", type=int, default=None)
   841	    stride.add_argument(
   842	        "--resident-budget-gib",
   843	        type=float,
   844	        default=None,
   845	        help="derive the turn stride so all turn rows fit this host-memory budget",
   846	    )
   847	    parser.add_argument(
   848	        "--team", default=None, help="imitate only this team's seats (by TeamNames)"
   849	    )
   850	    parser.add_argument(
   851	        "--include-losses",
   852	        action="store_true",
   853	        help="with --team, also imitate the team's losing seats",
   854	    )
   855	    parser.add_argument("--limit-episodes", type=int, default=None)
   856	    parser.add_argument("--pairing-sample", type=int, default=0)
   857	    parser.add_argument("--pairing-only", action="store_true")
   858	    args = parser.parse_args(argv)
   859	    if not 0.0 < args.validation_fraction < 1.0:
   860	        raise ValueError("--validation-fraction must be in (0, 1)")
   861	    if args.workers < 1:
   862	        raise ValueError("--workers must be >= 1")
   863	    if args.include_losses and args.team is None:
   864	        raise ValueError("--include-losses needs --team")
   865	    team_sha256 = None if args.team is None else name_sha256(args.team)
   866	    repo = Path(__file__).resolve().parents[1]
   867	    out_dir: Path = args.out_dir.resolve()
   868	    if out_dir.is_relative_to(repo):
   869	        raise ValueError("out_dir must lie outside the checkout")
   870	    if (out_dir / "manifest.json").exists():
   871	        raise FileExistsError(f"{out_dir}/manifest.json exists; dataset is complete")
   872	    run = _source_identity(repo)
   873	    days = _parse_days(args.days)
   874	    tasks = list_tasks(
   875	        args.archives,
   876	        month=args.month,
   877	        days=days,
   878	        validation_fraction=args.validation_fraction,
   879	        turn_stride=1,
   880	    )
   881	    if args.limit_episodes is not None:
   882	        tasks = tasks[: args.limit_episodes]
   883	    if not tasks:
   884	        raise ValueError("no episodes found")
   885	    turn_stride = args.turn_stride or 1
   886	    if args.resident_budget_gib is not None:
   887	        turn_stride = stride_for_budget(len(tasks), args.resident_budget_gib)
   888	    tasks = [
   889	        EpisodeTask(
   890	            t.archive,
   891	            t.member,
   892	            t.day,
   893	            t.episode_id,
   894	            t.split,
   895	            turn_stride,
   896	            team_sha256,
   897	            args.include_losses,
   898	        )
   899	        for t in tasks
   900	    ]
   901	    out_dir.mkdir(parents=True, exist_ok=True)
   902	    archive_sha256 = {
   903	        Path(archive).name: _sha256(Path(archive))
   904	        for archive in sorted({t.archive for t in tasks})
   905	    }
   906	    _bind_identity(
   907	        out_dir,
   908	        {
   909	            "run": run,
   910	            "month": args.month,
   911	            "days": days,
   912	            "validation_fraction": args.validation_fraction,
   913	            "turn_stride": turn_stride,
   914	            "hire_limit": HIRE_LIMIT,
   915	            "label_pairing": LABEL_PAIRING,
   916	            "team_sha256": team_sha256,
   917	            "include_losses": args.include_losses,
   918	            "archive_sha256": archive_sha256,
   919	        },
   920	    )
   921	    print(
   922	        f"episodes={len(tasks)} days={days} turn_stride={turn_stride} "
   923	        f"bytes_per_turn_row={resident_bytes_per_turn()} workers={args.workers}",
   924	        flush=True,
   925	    )
   926	    with _mapper(args.workers) as mapper:
   927	        if args.pairing_sample > 0:
   928	            pairing = pairing_sample(tasks, args.pairing_sample, mapper)
   929	            (out_dir / PAIRING_NAME).write_text(json.dumps(pairing, indent=2) + "\n")
   930	            print(
   931	                f"pairing: {pairing['matches']}/{pairing['total']} transitions match "
   932	                f"({pairing['fraction']:.4f}) over {len(pairing['episodes'])} episodes",
   933	                flush=True,
   934	            )
   935	            if args.pairing_only:
   936	                return 0
   937	        records: list[dict[str, Any]] = []
   938	        todo: list[EpisodeTask] = []
   939	        for task in tasks:
   940	            path = _record_path(out_dir, task)
   941	            if path.is_file():
   942	                records.append(json.loads(path.read_text(encoding="utf-8")))
   943	            else:
   944	                todo.append(task)
   945	        print(f"resuming: {len(records)} done, {len(todo)} to do", flush=True)
   946	        for index, record in enumerate(
   947	            mapper(_run_task, [(t, str(out_dir)) for t in todo]), 1
   948	        ):
   949	            records.append(record)
   950	            if index % 50 == 0 or index == len(todo):
   951	                print(f"episodes {index}/{len(todo)}", flush=True)
   952	    pairing_path = out_dir / PAIRING_NAME
   953	    manifest = build_manifest(
   954	        out_dir,
   955	        records,
   956	        {
   957	            "run": run
   958	            | {
   959	                "command": [sys.executable, *_redact_team(sys.argv)],
   960	                "workers": args.workers,
   961	                "hire_limit": HIRE_LIMIT,
   962	                "turn_stride": turn_stride,
   963	                "bytes_per_turn_row": resident_bytes_per_turn(),
   964	                "validation_fraction": args.validation_fraction,
   965	                "label_pairing": LABEL_PAIRING,
   966	                "policy_seats": (
   967	                    "winner by final bank; both on a draw"
   968	                    if team_sha256 is None
   969	                    else "the --team seats (by TeamNames SHA-256)"
   970	                    + ("" if args.include_losses else " that won; both on a draw")
   971	                ),
   972	                "team_sha256": team_sha256,
   973	                "include_losses": args.include_losses,
   974	            },
   975	            "source": {
   976	                "archives": str(args.archives),
   977	                "month": args.month,
   978	                "days": days,
   979	                "archive_sha256": archive_sha256,
   980	                "archive_bytes": {
   981	                    Path(t.archive).name: Path(t.archive).stat().st_size for t in tasks
   982	                },
   983	                "episodes_listed": len(tasks),
   984	            },
   985	            "pairing": (
   986	                json.loads(pairing_path.read_text()) if pairing_path.is_file() else None
   987	            ),
   988	        },
   989	    )
   990	    extra = manifest.model_extra or {}
   991	    print(json.dumps(extra.get("totals"), indent=2), flush=True)
   992	    return 0
   993	
