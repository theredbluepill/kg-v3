   356	_NUMPY_DTYPES: dict[torch.dtype, type[np.generic]] = {
   357	    torch.int64: np.int64,
   358	    torch.float32: np.float32,
   359	    torch.float64: np.float64,
   360	    torch.bool: np.bool_,
   361	}
