    83	    assert len(kept) in (143, 144)
    84	    assert np.all(np.diff(kept) == 5)
    85	    phases = {prepare.kept_turns(str(n), 5)[0] for n in range(40)}
    86	    assert len(phases) > 1
    87	    with pytest.raises(ValueError, match="turn stride"):
