    60	def _archive(root: Path, day: int, episodes: dict[str, dict[str, Any]]) -> None:
    61	    root.mkdir(parents=True, exist_ok=True)
    62	    path = root / f"kaggriculture-episodes-2026-09-{day:02d}.zip"
    63	    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as archive:
    64	        for episode_id, data in episodes.items():
    65	            archive.writestr(f"{episode_id}.json", json.dumps(data))
