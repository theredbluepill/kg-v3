   372	
   373	def encode_observations(
   374	    data: dict[str, Any], turns: Sequence[int]
   375	) -> dict[str, npt.NDArray[Any]]:
   376	    """Native Task 1.3 encoding of ``steps[t]`` for every kept turn, both seats."""
   377	    arrays = _allocate(len(turns))
   378	    for start in range(0, len(turns), ENCODE_BATCH):
   379	        chunk = turns[start : start + ENCODE_BATCH]
   380	        headers = json.dumps([turn_header(data, t) for t in chunk])
   381	        view = {name: a[start : start + len(chunk)] for name, a in arrays.items()}
   382	        try:
   383	            rs.encode_kaggriculture_headers_into(headers, **view)
   384	        except ValueError as error:
   385	            raise EpisodeRejected(
   386	                f"encoder: turns {chunk[0]}..{chunk[-1]}: {error}"
   387	            ) from error
   388	    return arrays
   389	
   390	
   391	def admit_turns(
   392	    data: dict[str, Any],
   393	    turns: Sequence[int],
   394	    arrays: dict[str, npt.NDArray[Any]],
   395	    policy: tuple[bool, bool],
   396	) -> tuple[
   397	    npt.NDArray[np.bool_],
   398	    npt.NDArray[np.int64],
   399	    npt.NDArray[np.int64],
   400	    Counter[str],
   401	    Counter[str],
   402	]:
   403	    """Strict per-turn admission of the policy seats' step+1 actions."""
   404	    order_limit_config = int(data["configuration"]["maxMarketOrdersPerTurn"])
   405	    rows = len(turns)
   406	    admitted = np.zeros(rows, dtype=np.bool_)
   407	    tokens = np.zeros((rows, 2, kt.MAX_FRAMES, kt.ACTION_SLOTS), dtype=np.int64)
   408	    lengths = np.zeros((rows, 2), dtype=np.int64)
   409	    rejections: Counter[str] = Counter()
   410	    normalizations: Counter[str] = Counter()
   411	    for row, t in enumerate(turns):
   412	        farms = data["steps"][t][0]["observation"]["farms"]
   413	        ok = True
   414	        for seat in (0, 1):
   415	            actors = int(arrays["actor_mask"][row, seat, :HIRE_LIMIT].sum())
   416	            order_limit = int(arrays["order_limits"][row, seat])
   417	            if actors != 1 + len(farms[seat]["hands"]):
   418	                raise EpisodeRejected(f"turn {t} seat {seat}: actor count mismatch")
   419	            if order_limit != order_limit_config:
   420	                raise EpisodeRejected(f"turn {t} seat {seat}: order limit mismatch")
   421	            out = tokens[row, seat]
   422	            if not policy[seat]:
   423	                try:
   424	                    lengths[row, seat] = rs.kaggriculture_encode(
   425	                        json.dumps(pass_action(actors)),
   426	                        actors,
   427	                        order_limit,
   428	                        HIRE_LIMIT,
   429	                        out,
   430	                    )
   431	                except ValueError as error:
   432	                    rejections[f"placeholder {rejection_reason(error)}"] += 1
   433	                    ok = False
   434	                continue
   435	            # Step+1 pairing: the action answering steps[t] is recorded at steps[t + 1].
   436	            raw = data["steps"][t + 1][seat]["action"]
   437	            try:
   438	                action, kinds = normalize_action(raw)
   439	                length = rs.kaggriculture_encode(
   440	                    json.dumps(action), actors, order_limit, HIRE_LIMIT, out
   441	                )
   442	                decoded = json.loads(
   443	                    rs.kaggriculture_decode(
   444	                        out, length, actors, order_limit, HIRE_LIMIT
   445	                    )
   446	                )
   447	                if decoded != action:
   448	                    raise ValueError("decode round trip")
   449	            except ValueError as error:
   450	                rejections[rejection_reason(error)] += 1
   451	                out[:] = 0
   452	                ok = False
   453	                continue
   454	            normalizations.update(kinds)
   455	            lengths[row, seat] = length
   456	        admitted[row] = ok
   457	    return admitted, tokens, lengths, rejections, normalizations
