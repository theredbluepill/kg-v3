   289	def resident_bytes_per_turn() -> int:
   290	    """Host bytes one turn row occupies in ``load_bc_dataset``'s compact store."""
   291	    sizes = {torch.int64: 4, torch.float32: 4, torch.float64: 8, torch.bool: 1}
   292	    per_seat = sum(
   293	        sizes[dtype] * math.prod(shape) for dtype, shape, _, _ in kt._SCHEMA.values()
   294	    )
   295	    labels = kt.MAX_FRAMES + 2 * kt.MAX_FRAMES * kt.ACTION_SLOTS + 4 + 1
   296	    return kt.PLAYERS * (per_seat + labels) + 4 + 8
