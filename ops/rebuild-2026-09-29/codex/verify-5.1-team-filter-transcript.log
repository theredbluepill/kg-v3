   364	def _allocate(rows: int) -> dict[str, npt.NDArray[Any]]:
   365	    arrays = {
   366	        name: np.zeros((rows, kt.PLAYERS, *shape), dtype=_NUMPY_DTYPES[dtype])
   367	        for name, (dtype, shape, _, _) in kt._SCHEMA.items()
   368	    }
   369	    arrays["can_act"] = np.zeros((rows, kt.PLAYERS, kt.MAX_FRAMES), dtype=np.bool_)
   370	    return arrays
