   128	def test_envelope_checks(played: dict[str, Any]) -> None:
   129	    good = _episode(played, "123")
   130	    prepare.check_envelope(good, "123")
   131	    with pytest.raises(prepare.EpisodeRejected, match="EpisodeId"):
   132	        prepare.check_envelope(good, "124")
   133	    short = copy.deepcopy(good)
   134	    short["steps"] = short["steps"][:-1]
   135	    with pytest.raises(prepare.EpisodeRejected, match="steps"):
   136	        prepare.check_envelope(short, "123")
   137	    boolean = copy.deepcopy(good)
   138	    boolean["info"]["seed"] = True
   139	    with pytest.raises(prepare.EpisodeRejected, match="seed"):
   140	        prepare.check_envelope(boolean, "123")
   141	    errored = copy.deepcopy(good)
   142	    errored["steps"][-1][1]["status"] = "ERROR"
   143	    with pytest.raises(prepare.EpisodeRejected, match="final statuses"):
   144	        prepare.check_envelope(errored, "123")
   145	    partial = copy.deepcopy(good)
   146	    del partial["configuration"]["shedCapacity"]
   147	    with pytest.raises(prepare.EpisodeRejected, match="shedCapacity"):
   148	        prepare.check_envelope(partial, "123")
