   190	
   191	def test_end_to_end_writes_loadable_winner_shards_and_resumes(
   192	    played: dict[str, Any], tmp_path: Path, monkeypatch: pytest.MonkeyPatch
   193	) -> None:
   194	    monkeypatch.setattr(prepare, "_source_identity", lambda _repo: {"git_head": "t"})
   195	    train_id, valid_id = _ids("train", 1)[0], _ids("validation", 1)[0]
   196	    bad = _episode(played, "999")
   197	    bad["steps"] = bad["steps"][:700]
   198	    archives = tmp_path / "archives"
   199	    _archive(archives, 21, {train_id: _episode(played, train_id), "999": bad})
   200	    _archive(archives, 22, {valid_id: _episode(played, valid_id)})
   201	    out = tmp_path / "bc"
   202	    argv = [
   203	        str(archives),
   204	        str(out),
   205	        "--days",
   206	        "21-22",
   207	        "--workers",
   208	        "1",
   209	        "--turn-stride",
   210	        "3",
   211	        "--pairing-sample",
   212	        "3",
   213	    ]
   214	    assert prepare.main(argv) == 0
   215	
   216	    manifest_text = (out / MANIFEST_NAME).read_text()
   217	    assert _SECRET_NAME not in manifest_text
   218	    manifest = json.loads(manifest_text)
   219	    assert manifest["pairing"]["matches"] == manifest["pairing"]["total"] == 2 * 719
   220	    assert [r["episode_id"] for r in manifest["rejected_episodes"]] == ["999"]
   221	    assert manifest["episode_rejections"] == {"steps": 1}
   222	    records = {r["episode_id"]: r for r in manifest["episodes"]}
   223	    banks = played["steps"][-1][0]["observation"]["farms"]
   224	    winner = [s for s in (0, 1) if banks[s]["money"] == max(f["money"] for f in banks)]
   225	    for episode_id, split in ((train_id, "train"), (valid_id, "validation")):
   226	        record = records[episode_id]
   227	        assert record["split"] == split
   228	        assert record["policy_seats"] == winner
   229	        assert record["kept_turns"] == len(prepare.kept_turns(episode_id, 3))
   230	        assert record["admitted"] == record["kept_turns"]
   231	    assert manifest["run"]["turn_stride"] == 3
   232	
   233	    dataset = load_bc_dataset(out)
   234	    batch = dataset.train.gather(np.arange(dataset.train.num_rows))
   235	    expected = [s in winner for s in (0, 1)]
   236	    assert batch.policy_seat.tolist() == [expected] * dataset.train.num_rows
   237	    assert dataset.train.turn.tolist() == prepare.kept_turns(train_id, 3)
   238	    from owl import rs
   239	
   240	    seat = winner[0]
   241	    for row, t in enumerate(dataset.train.turn.tolist()):
   242	        decoded = rs.kaggriculture_decode(
   243	            batch.actions.tokens[row, seat].numpy(),
   244	            int(batch.actions.lengths[row, seat]),
   245	            int(batch.obs.actor_mask[row, seat, :241].sum()),
   246	            int(batch.obs.order_limits[row, seat]),
   247	            241,
   248	        )
   249	        recorded = played["steps"][t + 1][seat]["action"]
   250	        assert json.loads(decoded) == prepare.normalize_action(recorded)[0], t
   251	
   252	    # Resume: finished episodes are skipped and their shards stay byte-identical.
   253	    shards = {p: p.read_bytes() for p in out.glob("*/*.npz")}
   254	    (out / MANIFEST_NAME).unlink()
   255	    monkeypatch.setattr(
   256	        prepare, "process_episode", lambda *_: pytest.fail("finished episode redone")
   257	    )
   258	    assert prepare.main(argv[:-2]) == 0
   259	    assert {p: p.read_bytes() for p in out.glob("*/*.npz")} == shards
   260	    with pytest.raises(FileExistsError):
   261	        prepare.main(argv)
   262	
   263	    # A resume whose source or label settings changed refuses the old records.
   264	    (out / MANIFEST_NAME).unlink()
