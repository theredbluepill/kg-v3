   782	def _bind_identity(out_dir: Path, identity: dict[str, Any]) -> None:
   783	    """Record the preparation identity, or require an exact match on resume."""
   784	    records = out_dir / RECORD_DIR
   785	    path = records / IDENTITY_NAME
   786	    if path.is_file():
   787	        stored = json.loads(path.read_text(encoding="utf-8"))
   788	        if stored != identity:
   789	            changed = sorted(
   790	                key
   791	                for key in stored.keys() | identity.keys()
   792	                if stored.get(key) != identity.get(key)
   793	            )
   794	            raise RuntimeError(
   795	                f"{path} differs from this run in {changed}; "
   796	                "prepare into a fresh out_dir"
   797	            )
   798	        return
   799	    if records.is_dir() and any(records.glob("*.json")):
   800	        raise RuntimeError(
   801	            f"{records} has records but no {IDENTITY_NAME}; use a fresh out_dir"
   802	        )
   803	    records.mkdir(parents=True, exist_ok=True)
   804	    path.write_text(
   805	        json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
   806	    )
