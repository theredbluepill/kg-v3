#[derive(Clone, Debug, Default, Serialize)]
pub struct MarketStepMetrics {
    pub submitted_orders: u64,
    pub zero_commit_orders: u64,
    pub committed_orders: u64,
    pub committed_units: u64,
    pub sell_orders: u64,
    pub buy_orders: u64,
