   360	fn read_trace(path: &Path) -> String {
   361	    if path.extension().is_some_and(|ext| ext == "gz") {
   362	        let output = Command::new("gzip")
   363	            .arg("-dc")
   364	            .arg(path)
   365	            .output()
   366	            .expect("gzip is required for compressed replay fixtures");
   367	        assert!(
   368	            output.status.success(),
   369	            "{}: {}",
   370	            path.display(),
   371	            String::from_utf8_lossy(&output.stderr)
   372	        );
   373	        String::from_utf8(output.stdout).unwrap()
   374	    } else {
   375	        std::fs::read_to_string(path).unwrap_or_else(|error| panic!("{}: {error}", path.display()))
   376	    }
