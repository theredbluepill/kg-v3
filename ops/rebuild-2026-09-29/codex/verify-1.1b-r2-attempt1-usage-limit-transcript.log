   499	    }
   500	
   501	    let mut stats = ReplayStats::default();
   502	    for (offset, line) in lines.enumerate() {
   503	        let index = offset + 1;
   504	        let row = parse_line(line, index)?;
   505	        let from_step = row["from_step"].as_u64().map(|step| step as usize);
