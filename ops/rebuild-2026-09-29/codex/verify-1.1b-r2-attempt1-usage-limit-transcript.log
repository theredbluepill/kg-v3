spec=importlib.util.spec_from_file_location('sweep_r2',root/'scripts/kaggriculture_parity/sweep.py')
sweep=importlib.util.module_from_spec(spec)
spec.loader.exec_module(sweep)
env={**os.environ,'TMPDIR':str(root/'.codex-tmp'),'UV_OFFLINE':'1'}
command=['cargo','test','--manifest-path','engine_rs/Cargo.toml','--locked','--offline','--test','replay_parity','env_directory_traces','--','--exact','--test-threads=1']
def replay(directory,label):
    report=directory/'rust-report.json'
    output=subprocess.run(command,cwd=root,env={**env,'KAGG_PARITY_TRACES':str(directory),'KAGG_PARITY_REPORT':str(report)},capture_output=True,text=True)
    (base/(label+'.log')).write_text(output.stdout+output.stderr)
    return output.returncode,json.loads(report.read_text())
def records(data):
    return [json.loads(line) for line in gzip.decompress(data).splitlines()]
def encode(rows):
    return gzip.compress((''.join(json.dumps(row,separators=(',',':'))+'\\n' for row in rows)).encode(),mtime=0)

# Use an exact copy of a committed generated fixture; restore its original bytes.
source=root/'engine_rs/fixtures/generated/gen-edge-vs-edge.jsonl.gz'
data=source.read_bytes()
directory=base/'perturb-fixture'
directory.mkdir(exist_ok=True)
path=directory/source.name
rows=records(data)
index=next(i for i,r in enumerate(rows) if r.get('type')=='transition' and r['from_step']==100)
before=rows[index]['expected']['farms'][0]['money']
rows[index]['expected']['farms'][0]['money']=before+1.0
path.write_bytes(encode(rows))
try:
    bad_code,bad=replay(directory,'perturbed-replay')
    assert bad_code==101 and len(bad)==1 and not bad[0]['ok'],bad
    d=bad[0]['divergence']
    assert d['from_step']==100 and d['field']=='public.farms[0].money',d
finally:
    path.write_bytes(data)
good_code,good=replay(directory,'restored-replay')
assert good_code==0 and good[0]['ok'] and path.read_bytes()==source.read_bytes()
print('perturb',bad_code,bad[0]['divergence'])
print('restored',good_code,good)

# Real D1 trace with an independent state corruption at the failing line.
trace_dir=base/'classification'
trace_dir.mkdir(exist_ok=True)
name='probe-167-market.jsonl.gz'
rows=records((base/'sweep-traces'/name).read_bytes())
rows[3]['expected']['day']+=1
(trace_dir/name).write_bytes(encode(rows))
status,report=replay(trace_dir,'classification-original')
recheck_dir=trace_dir/'d1-recheck'
rewritten=sweep.write_d1_rechecks(report,trace_dir,recheck_dir)
assert rewritten==[name]
recheck_code,recheck=replay(recheck_dir,'classification-ascii')
assert not recheck[0]['ok'] and recheck[0]['divergence']['field']=='public.day',recheck
entries=json.loads((base/'sweep-traces/generated-probes.json').read_text())
summary=sweep.summarize([e for e in entries if e['path']==name],report,trace_dir,recheck)
assert summary['new_divergences']==1 and summary['divergences_by_class']=={'unclassified':1},summary
(base/'classification-summary.json').write_text(json.dumps(summary,indent=2)+'\\n')
print('corrupted D1 classification',summary['divergences_by_class'],'new',summary['new_divergences'])
print('ASCII recheck',recheck[0]['divergence'])

# Independently audit every probe label against the actual submitted JSON.
mismatches=[]
for entry in entries:
    rows=records((base/'sweep-traces'/entry['path']).read_bytes())
    row=next(r for r in rows[1:] if r['from_step']==2)
    if json.dumps(row['actions'][0],sort_keys=True)"'!=json.dumps(json.loads(entry['"'probe']),sort_keys=True):
        mismatches.append(entry['path'])
assert not mismatches,mismatches
null_rows=records((base/'sweep-traces/probe-296-action.jsonl.gz').read_bytes())
assert null_rows[3]['actions'][0] is None
print('probe labels exact',len(entries),'null probe action',null_rows[3]['actions'][0])

code,repros=replay(base/'live-repros','live-repros-replay')
assert code==101 and len(repros)==7 and all(not r['ok'] for r in repros)
for r in repros:
    d=r['divergence']
    assert d['line']==1 and d['from_step']==0
print('live minimal repros',len(repros),[r['divergence']['kind'] for r in repros])
(base/'perturb-summary.json').write_text(json.dumps({'perturb':bad,'restored':good,'probe_labels_checked':len(entries),'probe_mismatches':mismatches,'live_repros':repros},indent=2)+'\\n')
