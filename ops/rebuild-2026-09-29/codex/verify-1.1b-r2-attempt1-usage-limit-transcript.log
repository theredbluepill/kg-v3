   464	        return Err(header_error("type", &"header", &raw["type"]));
   465	    }
   466	    if raw["source"]["module_version"] != MODULE_VERSION {
   467	        return Err(header_error(
   468	            "source.module_version",
   469	            &MODULE_VERSION,
   470	            &raw["source"]["module_version"],
   471	        ));
   472	    }
   473	    if raw["source"]["engine_sha256"] != ENGINE_SHA256 {
   474	        return Err(header_error(
   475	            "source.engine_sha256",
   476	            &ENGINE_SHA256,
   477	            &raw["source"]["engine_sha256"],
   478	        ));
   479	    }
   480	    let header: TraceHeader = serde_json::from_value(raw.clone()).map_err(|error| {
   481	        Divergence::new(0, None, "header", "schema").values("TraceHeader", error)
   482	    })?;
   483	    let mut game =
   484	        Game::new_with_seed_decimal(header.configuration.clone(), &header.seed.to_string(), 2)
   485	            .map_err(|error| {
   486	                Divergence::new(0, None, "rust_error", "Game::new").values("Ok", error)
   487	            })?;
   488	    let initial = game.snapshot();
   489	    let (public, privates) = snapshot_values(&game);
   490	    compare_tree(&public, &raw["initial"]["public"], "public", 0, None)?;
   491	    compare_tree(&privates, &raw["initial"]["privates"], "private", 0, None)?;
   492	    if initial.statuses != ["ACTIVE", "ACTIVE"] || initial.rewards != [0.0, 0.0] || initial.done {
   493	        return Err(
