   789	/// Larger local or pod sweeps: `KAGG_PARITY_TRACES=<dir>` replays every
   790	/// `*.jsonl.gz`/`*.jsonl` in that directory; `KAGG_PARITY_REPORT=<file>` receives a
   791	/// JSON report of each trace's counts or first divergence. Unset, this is a no-op.
   792	#[test]
   793	fn env_directory_traces() {
   794	    let Some(directory) = std::env::var_os("KAGG_PARITY_TRACES") else {
   795	        eprintln!("KAGG_PARITY_TRACES is unset; skipping the external trace sweep");
   796	        return;
   797	    };
   798	    let mut paths: Vec<PathBuf> = std::fs::read_dir(&directory)
   799	        .unwrap_or_else(|error| {
   800	            panic!("KAGG_PARITY_TRACES={directory:?} (relative to engine_rs/): {error}")
   801	        })
   802	        .map(|entry| entry.unwrap().path())
   803	        .filter(|path| {
   804	            let name = path.file_name().unwrap().to_string_lossy();
   805	            name.ends_with(".jsonl.gz") || name.ends_with(".jsonl")
   806	        })
   807	        .collect();
   808	    paths.sort();
   809	    assert!(
   810	        !paths.is_empty(),
   811	        "KAGG_PARITY_TRACES={directory:?} has no traces"
   812	    );
   813	    let mut report = vec![];
   814	    let mut failures = vec![];
   815	    for path in &paths {
   816	        let name = path.file_name().unwrap().to_string_lossy().to_string();
   817	        match replay_text(&read_trace(path)) {
   818	            Ok(stats) => report.push(json!({
   819	                "file": name, "ok": true,
   820	                "transitions": stats.transitions, "rejected": stats.rejected,
   821	            })),
   822	            Err(divergence) => {
   823	                failures.push(format!("{name}: {divergence}"));
   824	                report.push(json!({"file": name, "ok": false, "divergence": divergence.to_json()}));
   825	            },
   826	        }
   827	    }
   828	    if let Some(output) = std::env::var_os("KAGG_PARITY_REPORT") {
   829	        std::fs::write(
   830	            &output,
   831	            serde_json::to_string_pretty(&report).unwrap() + "\n",
   832	        )
   833	        .unwrap_or_else(|error| panic!("KAGG_PARITY_REPORT={output:?}: {error}"));
   834	    }
   835	    eprintln!(
   836	        "replayed {} traces, {} divergent",
   837	        paths.len(),
   838	        failures.len()
   839	    );
   840	    assert!(
   841	        failures.is_empty(),
   842	        "parity divergences:\n{}",
   843	        failures.join("\n")
   844	    );
   845	}

