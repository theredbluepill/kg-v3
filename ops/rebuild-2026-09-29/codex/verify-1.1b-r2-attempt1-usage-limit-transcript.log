   399	fn state_view(game: &Game) -> StateView {
   400	    let snapshot = game.snapshot();
   401	    StateView {
   402	        public: serde_json::to_value(&snapshot.public).unwrap(),
   403	        privates: serde_json::to_value(&snapshot.privates).unwrap(),
   404	        statuses: snapshot.statuses,
   405	        rewards: snapshot.rewards,
   406	        done: snapshot.done,
   407	    }
   408	}
