   410	/// A rejected step must leave the complete state untouched: public and private
   411	/// trees (values and map key order, which `Value` equality ignores), statuses,
   412	/// rewards and completion.
   413	fn rollback_difference(
   414	    before: &StateView,
   415	    after: &StateView,
   416	    line: usize,
   417	    from_step: Option<usize>,
   418	) -> Result<(), Divergence> {
   419	    let mutated = |divergence: Divergence| Divergence {
   420	        kind: format!("rust_mutated {}", divergence.kind),
   421	        ..divergence
   422	    };
   423	    compare_tree(&after.public, &before.public, "public", line, from_step).map_err(mutated)?;
   424	    compare_tree(
   425	        &after.privates,
   426	        &before.privates,
   427	        "private",
   428	        line,
   429	        from_step,
   430	    )
   431	    .map_err(mutated)?;
   432	    let scalar = |field: &str, expected: String, actual: String| {
   433	        Err(Divergence::new(line, from_step, "rust_mutated", field).values(expected, actual))
   434	    };
   435	    if after.statuses != before.statuses {
   436	        return scalar(
   437	            "statuses",
   438	            format!("{:?}", before.statuses),
   439	            format!("{:?}", after.statuses),
   440	        );
   441	    }
   442	    if after.rewards != before.rewards {
   443	        return scalar(
   444	            "rewards",
   445	            format!("{:?}", before.rewards),
   446	            format!("{:?}", after.rewards),
   447	        );
   448	    }
   449	    if after.done != before.done {
   450	        return scalar("done", before.done.to_string(), after.done.to_string());
   451	    }
   452	    Ok(())
   453	}
