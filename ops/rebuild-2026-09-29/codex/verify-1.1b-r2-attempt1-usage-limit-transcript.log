    27	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
    28	enum DiffKind {
    29	    Value,
    30	    KeyOrder,
    31	}
    32	
    33	/// First difference between two JSON trees. Values are compared before key order,
    34	/// so a changed value is reported as such even when it also moves keys.
    35	fn first_difference(actual: &Value, expected: &Value, path: &str) -> Option<(DiffKind, String)> {
    36	    value_difference(actual, expected, path)
    37	        .map(|path| (DiffKind::Value, path))
    38	        .or_else(|| order_difference(actual, expected, path).map(|p| (DiffKind::KeyOrder, p)))
    39	}
    40	
    41	fn value_difference(actual: &Value, expected: &Value, path: &str) -> Option<String> {
    42	    match (actual, expected) {
    43	        (Value::Object(a), Value::Object(e)) => {
    44	            for (key, value) in e {
    45	                let child = format!("{path}.{key}");
    46	                match a.get(key) {
    47	                    None => return Some(format!("{child} (missing in Rust)")),
    48	                    Some(other) => {
    49	                        if let Some(found) = value_difference(other, value, &child) {
    50	                            return Some(found);
    51	                        }
    52	                    },
    53	                }
    54	            }
    55	            a.keys()
    56	                .find(|key| !e.contains_key(*key))
    57	                .map(|key| format!("{path}.{key} (extra in Rust)"))
    58	        },
    59	        (Value::Array(a), Value::Array(e)) => {
    60	            for (index, (value, other)) in a.iter().zip(e).enumerate() {
    61	                if let Some(found) = value_difference(value, other, &format!("{path}[{index}]")) {
    62	                    return Some(found);
    63	                }
    64	            }
    65	            (a.len() != e.len()).then(|| format!("{path} (length {} vs {})", a.len(), e.len()))
    66	        },
    67	        _ => (actual != expected).then(|| path.to_string()),
    68	    }
    69	}
    70	
    71	/// `Value` equality ignores object key order, but IndexMap insertion order is
    72	/// engine state (market inventory/prices, sheds, seeds, inventories, tiles).
    73	fn order_difference(actual: &Value, expected: &Value, path: &str) -> Option<String> {
    74	    match (actual, expected) {
    75	        (Value::Object(a), Value::Object(e)) => {
    76	            if !a.keys().eq(e.keys()) {
    77	                return Some(path.to_string());
    78	            }
    79	            a.iter()
    80	                .find_map(|(key, value)| order_difference(value, &e[key], &format!("{path}.{key}")))
    81	        },
    82	        (Value::Array(a), Value::Array(e)) => {
    83	            a.iter()
    84	                .zip(e)
    85	                .enumerate()
    86	                .find_map(|(index, (value, other))| {
    87	                    order_difference(value, other, &format!("{path}[{index}]"))
    88	                })
    89	        },
    90	        _ => None,
    91	    }
    92	}
    93	
    94	/// Resolve a reported `label.key[index]...` path (annotations after a space are
    95	/// ignored) inside the tree that `label` names.
    96	fn lookup<'a>(root: &'a Value, label: &str, path: &str) -> Option<&'a Value> {
    97	    let rest = path.strip_prefix(label)?;
    98	    let rest = rest.split(' ').next().unwrap_or(rest);
    99	    let mut node = root;
   100	    let mut chars = rest.chars().peekable();
   101	    while let Some(c) = chars.next() {
   102	        let mut token = String::new();
   103	        while let Some(&next) = chars.peek() {
   104	            if next == '.' || next == '[' || (c == '[' && next == ']') {
   105	                break;
   106	            }
   107	            token.push(next);
   108	            chars.next();
   109	        }
   110	        node = match c {
   111	            '.' => node.get(token.as_str())?,
   112	            '[' => {
   113	                chars.next();
   114	                node.get(token.parse::<usize>().ok()?)?
   115	            },
   116	            _ => return None,
   117	        };
   118	    }
   119	    Some(node)
   120	}
   121	
   122	fn excerpt(value: Option<&Value>) -> String {
   123	    let text = value.map_or_else(|| "<absent>".to_string(), Value::to_string);
   124	    if text.chars().count() > 200 {
   125	        format!("{}…", text.chars().take(200).collect::<String>())
   126	    } else {
   127	        text
   128	    }
   129	}
   130	
   131	/// The first point at which a trace and the Rust kernel disagree.
   132	#[derive(Clone, Debug)]
   133	struct Divergence {
   134	    /// Zero-based JSONL line (0 is the header).
   135	    line: usize,
   136	    from_step: Option<usize>,
   137	    kind: String,
   138	    field: String,
   139	    expected: String,
   140	    actual: String,
   141	}
   142	
   143	impl Divergence {
   144	    fn new(line: usize, from_step: Option<usize>, kind: &str, field: &str) -> Self {
   145	        Self {
   146	            line,
   147	            from_step,
   148	            kind: kind.to_string(),
   149	            field: field.to_string(),
   150	            expected: String::new(),
   151	            actual: String::new(),
   152	        }
   153	    }
   154	
   155	    fn values(mut self, expected: impl ToString, actual: impl ToString) -> Self {
   156	        self.expected = expected.to_string();
   157	        self.actual = actual.to_string();
   158	        self
   159	    }
   160	
   161	    fn to_json(&self) -> Value {
   162	        json!({
   163	            "line": self.line,
   164	            "from_step": self.from_step,
   165	            "kind": self.kind,
   166	            "field": self.field,
   167	            "expected": self.expected,
   168	            "actual": self.actual,
   169	        })
   170	    }
   171	}
   172	
   173	impl fmt::Display for Divergence {
   174	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   175	        write!(
   176	            f,
   177	            "line {} from_step {:?}: {} at {}: expected {} actual {}",
   178	            self.line, self.from_step, self.kind, self.field, self.expected, self.actual
   179	        )
   180	    }
   181	}
   182	
   183	fn compare_tree(
   184	    actual: &Value,
   185	    expected: &Value,
   186	    label: &str,
   187	    line: usize,
   188	    from_step: Option<usize>,
   189	) -> Result<(), Divergence> {
   190	    match first_difference(actual, expected, label) {
   191	        None => Ok(()),
   192	        Some((kind, path)) => {
   193	            let name = match kind {
   194	                DiffKind::Value => format!("{label} state"),
   195	                DiffKind::KeyOrder => format!("{label} map key order"),
   196	            };
   197	            Err(Divergence::new(line, from_step, &name, &path).values(
   198	                excerpt(lookup(expected, label, &path)),
   199	                excerpt(lookup(actual, label, &path)),
   200	            ))
   201	        },
   202	    }
   203	}
