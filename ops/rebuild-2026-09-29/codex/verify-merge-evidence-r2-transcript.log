   269	
   270	    results["D"] = _time(run_d, counters, "D_compute_value_256")
   271	
   272	    # --- B: PPO train step ----------------------------------------------------------
   273	    k_b = SPM * HORIZON // ENVS  # 4 -> 512 envs x 2 seats = 1,024 rows
   274	    obs_b = _tile(obs, k_b)
   275	    assert isinstance(obs_b, kt.KaggricultureObsBatch)
   276	    actions_b = kt.KaggricultureActions(
   277	        tokens=actions_256.tokens.repeat(k_b, 1, 1, 1),
   278	        lengths=actions_256.lengths.repeat(k_b, 1),
   279	    )
   280	    old_logp_b = old_logp_256.repeat(k_b, 1)
   281	    gen = torch.Generator(device=device).manual_seed(3)
   282	    adv_b = torch.randn(old_logp_b.shape, generator=gen, device=device)
   283	    ret_b = torch.rand(old_logp_b.shape, generator=gen, device=device) * 2 - 1
   284	    optimizer = create_optimizer(model, MuonConfig())
   285	
   286	    def run_b() -> Any:
   287	        with autocast():
   288	            ev = model.evaluate_actions(obs_b, actions_b)
   289	        new_logp = ev.log_probs.event.float().sum(dim=(-1, -2))
   290	        ratio = (new_logp - old_logp_b).exp()
   291	        pg = -torch.min(ratio * adv_b, ratio.clamp(0.8, 1.2) * adv_b).mean()
   292	        v_loss = 0.5 * (ev.values.float() - ret_b).pow(2).mean()
   293	        ent = ev.entropies.event.float().sum(dim=(-1, -2)).mean()
   294	        loss = pg + 0.5 * v_loss - 0.01 * ent
   295	        optimizer.zero_grad(set_to_none=True)
   296	        loss.backward()
   297	        torch.nn.utils.clip_grad_norm_(model.parameters(), 10.0)
   298	        optimizer.step()
   299	        return loss
