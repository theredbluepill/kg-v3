   136	def main() -> int:
   137	    t0 = time.monotonic()
   138	    deadline = t0 + BUDGET_S
   139	    log_fh = open(RUN / "driver.jsonl", "a")
   140	
   141	    def log(rec: dict) -> None:
   142	        rec = {"utc": now(), "t": round(time.monotonic() - t0, 1), **rec}
   143	        log_fh.write(json.dumps(rec) + "\n")
   144	        log_fh.flush()
   145	        print(json.dumps(rec), flush=True)
   146	
   147	    log({"status": "driver_start", "budget_s": BUDGET_S})
   148	    for name, role, backends, cache, script, args in STAGES:
   149	        remaining = deadline - time.monotonic()
   150	        if remaining < MIN_START_S:
   151	            log({"stage": name, "status": "stop_budget", "remaining_s": round(remaining)})
   152	            return 4
   153	        env = {k: v for k, v in os.environ.items()
   154	               if k != "TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS"}
   155	        env.update(CUDA_VISIBLE_DEVICES="0", PYTHONUNBUFFERED="1",
   156	                   TORCHINDUCTOR_CACHE_DIR=str(RUN / "inductor_cache" / cache),
   157	                   TRITON_CACHE_DIR=str(RUN / "triton_cache" / cache),
   158	                   TORCH_LOGS="recompiles")
   159	        record = RUN / f"{name}.backend.json"
   160	        if role == "bench":
   161	            outdir = RUN / f"bench_{backends.lower()}"
   162	            outdir.mkdir(exist_ok=True)
   163	            sargs = [*args, "--out", str(outdir)]
   164	        else:
   165	            out = RUN / f"{name}.jsonl"
