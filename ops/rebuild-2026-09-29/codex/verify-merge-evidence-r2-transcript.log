   108	def judge_probe(script: str, out: Path, n_points: int) -> tuple[list[str], int]:
   109	    ev = events(out)
   110	    results = [e for e in ev if e.get("event") == "result"]
   111	    errs: list[str] = []
   112	    for r in results:
   113	        bad = trunk_ok(r) if script.startswith("probe_trunk") else lin_ok(r)
   114	        errs += [f"{r['label']} {r.get('spec', r.get('M'))}: {b}" for b in bad]
   115	    targets = [r for r in results if r["label"] == "target"]
   116	    if len(targets) != n_points:
   117	        errs.append(f"{len(targets)} of {n_points} target points produced a result")
   118	    return errs, len(targets)
