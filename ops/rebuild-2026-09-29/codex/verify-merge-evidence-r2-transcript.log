    70	def events(path: Path) -> list[dict]:
    71	    if not path.exists():
    72	        return []
    73	    return [json.loads(line) for line in path.read_text().splitlines() if line]
    74	
    75	
    76	def lin_ok(r: dict) -> list[str]:
    77	    errs = []
    78	    if "fwd" in r:  # forward + backward case
    79	        for part in ("fwd", "dx"):
    80	            if r[part]["bad_rows"] or r[part]["nonfinite"]:
    81	                errs.append(f"{part} bad_rows={r[part]['bad_rows']} "
    82	                            f"nonfinite={r[part]['nonfinite']}")
    83	        for name, rel in r["param_grad_rel_max"].items():
    84	            if not rel <= PARAM_GRAD_REL_MAX:
    85	                errs.append(f"grad {name} rel {rel}")
    86	    else:
    87	        if r["bad_rows"] or r["nonfinite"] or r["ref_clobbered"]:
    88	            errs.append(f"bad_rows={r['bad_rows']} nonfinite={r['nonfinite']} "
    89	                        f"ref_clobbered={r['ref_clobbered']}")
    90	    if r["input_clobbered"]:
    91	        errs.append("input_clobbered")
    92	    return errs
    93	
    94	
    95	def trunk_ok(r: dict) -> list[str]:
    96	    errs = []
    97	    if r["eager"] != "ok" or r["compiled"] != "ok":
    98	        errs.append(f"eager={r['eager']} compiled={r['compiled']}")
    99	        return errs
   100	    if r["tokens_diff_gt_0.25"] or r["nonfinite"]:
   101	        errs.append(f"tokens_diff_gt_0.25={r['tokens_diff_gt_0.25']} "
   102	                    f"nonfinite={r['nonfinite']}")
   103	    if r["trunk_call_M"] != [r["packed_tokens"]]:
   104	        errs.append(f"trunk_call_M {r['trunk_call_M']} != [{r['packed_tokens']}]")
   105	    return errs
