   121	def judge_bench(outdir: Path, density: str) -> list[str]:
   122	    path = outdir / f"results_{density}.json"
   123	    if not path.exists():
   124	        return [f"missing {path}"]
   125	    res = json.loads(path.read_text())["results"]
   126	    errs = []
   127	    for k, want in EXPECTED_CHUNKS[density].items():
   128	        got = res[k]["pack_sequence_calls_per_iter"]
   129	        if got != want:
   130	            errs.append(f"{k} chunks/iter {got} != {want}")
   131	        if not res[k]["use_flash_attn_all_true"]:
   132	            errs.append(f"{k} use_flash_attn not all true")
   133	    return errs
