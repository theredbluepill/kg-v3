    95	def _global_workload(n_envs: int, rl: PPOConfig, world_size: int) -> _GlobalWorkload:
    96	    per_step = rl.segments_per_minibatch * rl.gradient_accumulation_steps
    97	    minibatches = _minibatch_indices(
    98	        config=rl, n_segments=n_envs, device=torch.device("cpu")
    99	    )
   100	    assert len(minibatches) % rl.gradient_accumulation_steps == 0
   101	    return _GlobalWorkload(
   102	        global_envs=n_envs * world_size,
   103	        optimizer_steps_per_iteration=len(minibatches)
   104	        // rl.gradient_accumulation_steps,
   105	        global_segments_per_step=per_step * world_size,
   106	        transitions_per_iteration=rl.horizon * n_envs * world_size,
   107	    )
