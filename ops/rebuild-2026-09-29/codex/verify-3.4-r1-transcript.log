     1	"""Startup workload check against the Kaggriculture model's GEMM chunking limits.
     2	
     3	Every Kaggriculture forward runs one row per seat (``2 x envs`` rows). The model
     4	chunks its compiled trunk (``rows_per_chunk``) and its heads
     5	(``head_rows_per_chunk``) so each call stays below the 2**31 GEMM extent
     6	(cookbook reference compiled-gemm-template-overflows-above-2-21-rows). This
     7	module computes, from config shapes alone, the rows each training forward
     8	issues and how the model's own limits divide them, so a workload the model
     9	cannot service fails at config load instead of mid-run, and the headroom is
    10	logged before any GPU work.
    11	
    12	The trunk limit assumes every row at the full padded sequence length, which is
    13	the padded path's exact chunk size and a conservative bound for the packed path
    14	(packed tokens never exceed padded tokens).
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import logging
    20	import math
    21	from dataclasses import dataclass
    22	
    23	from owl.kaggriculture import types as kt
    24	from owl.model.kaggriculture import (
    25	    KaggricultureTransformerConfig,
    26	    head_rows_per_chunk,
    27	    rows_per_chunk,
    28	    sequence_length,
    29	    trunk_gemm_width,
    30	)
    31	
    32	
    33	@dataclass(frozen=True)
    34	class ForwardWorkload:
    35	    """Seat rows one model forward receives, per rank."""
    36	
    37	    name: str
    38	    rows: int
    39	
    40	
    41	@dataclass(frozen=True)
    42	class WorkloadHeadroom:
    43	    name: str
    44	    rows: int
    45	    tokens_per_row: int
    46	    trunk_rows_per_call: int
    47	    head_rows_per_call: int
    48	
    49	    @property
    50	    def trunk_headroom(self) -> float:
    51	        """Single-call trunk limit over rows; below 1 the trunk chunks."""
    52	        return self.trunk_rows_per_call / self.rows
    53	
    54	    @property
    55	    def head_headroom(self) -> float:
    56	        """Single-call head limit over rows; below 1 the heads chunk."""
    57	        return self.head_rows_per_call / self.rows
    58	
    59	    @property
    60	    def trunk_calls(self) -> int:
    61	        return math.ceil(self.rows / self.trunk_rows_per_call)
    62	
    63	    @property
    64	    def head_calls(self) -> int:
    65	        return math.ceil(self.rows / self.head_rows_per_call)
    66	
    67	    def log_line(self) -> str:
    68	        return (
    69	            f"{self.name}: {self.rows} rows x {self.tokens_per_row} tokens; "
    70	            f"trunk {self.trunk_rows_per_call} rows/call "
    71	            f"({self.trunk_headroom:.4g}x headroom, {self.trunk_calls} call(s)); "
    72	            f"heads {self.head_rows_per_call} rows/call "
    73	            f"({self.head_headroom:.4g}x headroom, {self.head_calls} call(s))"
    74	        )
    75	
    76	
    77	def ppo_forward_workloads(
    78	    *,
    79	    n_envs: int,
    80	    horizon: int,
    81	    segments_per_minibatch: int,
    82	    teacher_segments_per_minibatch: int | None,
    83	) -> tuple[ForwardWorkload, ...]:
    84	    """Per-rank rows of every PPO forward, from Isaiah's trainer loops.
    85	
    86	    - rollout: one step of every env, both seats (``n_envs x 2``).
    87	    - minibatch: one optimizer micro-step (``spm x horizon x 2``); gradient
    88	      accumulation repeats it without widening it.
    89	    - teacher_chunk: ``_precompute_teacher_targets`` slices ``n_envs`` into
    90	      chunks of ``teacher_segments_per_minibatch`` segments; ``None`` means no
    91	      teacher is configured and the workload is omitted.
    92	    - evaluation: ``_evaluate_against_last_best`` plays ``n_envs`` games on
    93	      ``n_envs`` envs; ``n_envs x 2`` bounds either model's rows.
    94	    """
    95	    for name, value in (
    96	        ("n_envs", n_envs),
    97	        ("horizon", horizon),
    98	        ("segments_per_minibatch", segments_per_minibatch),
    99	    ):
   100	        if value < 1:
   101	            raise ValueError(f"{name} must be >= 1, got {value}")
   102	    workloads = [
   103	        ForwardWorkload("rollout", n_envs * kt.PLAYERS),
   104	        ForwardWorkload("minibatch", segments_per_minibatch * horizon * kt.PLAYERS),
   105	    ]
   106	    if teacher_segments_per_minibatch is not None:
   107	        if teacher_segments_per_minibatch < 1:
   108	            raise ValueError(
   109	                "teacher_segments_per_minibatch must be >= 1, got "
   110	                f"{teacher_segments_per_minibatch}"
   111	            )
   112	        teacher_segments = min(teacher_segments_per_minibatch, n_envs)
   113	        workloads.append(
   114	            ForwardWorkload("teacher_chunk", teacher_segments * horizon * kt.PLAYERS)
   115	        )
   116	    workloads.append(ForwardWorkload("evaluation", n_envs * kt.PLAYERS))
   117	    return tuple(workloads)
   118	
   119	
   120	def check_workload_headroom(
   121	    config: KaggricultureTransformerConfig,
   122	    workloads: tuple[ForwardWorkload, ...],
   123	) -> tuple[WorkloadHeadroom, ...]:
   124	    """Assert each workload is serviceable within the model's chunking limits.
   125	
   126	    Uses the model's own ``rows_per_chunk`` and ``head_rows_per_chunk``, so the
   127	    reported calls are the calls the model will issue. Raises ``ValueError``
   128	    when a single row cannot fit the trunk or head limit (the model would raise
   129	    at the first forward) or a workload is empty.
   130	    """
   131	    if not workloads:
   132	        raise ValueError("no workloads to check")
   133	    tokens = sequence_length(config)
   134	    width = trunk_gemm_width(config)
   135	    trunk_rows = rows_per_chunk(tokens=tokens, width=width)
   136	    if trunk_rows < 1:
   137	        raise ValueError(
   138	            f"one padded row of {tokens} tokens x trunk width {width} reaches the "
   139	            "2**31 GEMM limit; no trunk chunking can service this model"
   140	        )
   141	    head_rows = head_rows_per_chunk(config)
   142	    reports = []
   143	    for workload in workloads:
   144	        if workload.rows < 1:
   145	            raise ValueError(
   146	                f"workload {workload.name!r} has {workload.rows} rows; expected >= 1"
   147	            )
   148	        reports.append(
   149	            WorkloadHeadroom(
   150	                name=workload.name,
   151	                rows=workload.rows,
   152	                tokens_per_row=tokens,
   153	                trunk_rows_per_call=trunk_rows,
   154	                head_rows_per_call=head_rows,
   155	            )
   156	        )
   157	    return tuple(reports)
   158	
   159	
   160	def log_workload_headroom(
   161	    reports: tuple[WorkloadHeadroom, ...], logger: logging.Logger
   162	) -> None:
   163	    for report in reports:
   164	        logger.info("GEMM workload headroom %s", report.log_line())
