            8 => {
                if matches!(self.market, Market::Product | Market::Animal | Market::Sell) {
                    self.market = Market::Seed;
                }
            }
            10 => {
                if self.market == Market::Seed {
                    self.market = Market::Other;
                }
            }
            11 => {
                if token == 1 {
                    return None;
                }
                return Some(Self {
                    units: self.units + u16::from(self.unit != Unit::None),
                    orders: self.orders + u8::from(self.market != Market::None),
                    hires: self.hires + u8::from(self.market == Market::Hire),
                    ..Self::default()
                });
            }
            _ => {}
        }
        self.slot += 1;
        Some(self)
    }
}

/// Compute all reachable masks/transitions. Node numbers are deterministic BFS
/// discovery order, and each vocabulary is enumerated in ascending token order.
pub fn plan(actors: u32, limit: u32, hire_limit: u32) -> Result<Vec<u8>, String> {

    def _decoder_inputs(self, encoded: _Encoded) -> tuple[torch.Tensor, torch.Tensor]:
        width = encoded.plan.shape[-1]
        weight = self.frame_input.weight
        context = F.linear(
            encoded.player, weight[:, width : 2 * width], self.frame_input.bias
        ) + F.linear(encoded.plan, weight[:, 2 * width :])
        actor = F.linear(encoded.own_actors, weight[:, :width]) + context[:, None, :]
        market = F.linear(encoded.plan, weight[:, :width]) + context
        return actor, market

    def _field_logits(self, slot: int, hidden: torch.Tensor) -> torch.Tensor:
        return self.heads[SLOT_NAMES[slot]](self.prefix_norm(hidden)).float()

    @staticmethod
    def _field_density(
        logits: torch.Tensor, mask: torch.Tensor, choice: torch.Tensor
    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        width = logits.shape[-1]
        in_range = (choice >= 0) & (choice < width)
        safe = choice.clamp(0, width - 1)
        valid = in_range & mask.gather(-1, safe.unsqueeze(-1)).squeeze(-1)
        log_probs = F.log_softmax(logits.masked_fill(~mask, -torch.inf), dim=-1)
        selected = log_probs.gather(-1, safe.unsqueeze(-1)).squeeze(-1)
        entropy = -(log_probs.exp() * log_probs.masked_fill(~mask, 0)).sum(-1)
        # Admission fails outside the compiled function. Keep invalid data from
        # generating NaNs while collecting its validation flags on the device.
        return torch.where(valid, selected, 0), entropy, valid

    def _field(
        self,
        slot: int,
        hidden: torch.Tensor,
        mask: torch.Tensor,
        supplied: torch.Tensor | None,
        deterministic: bool,
    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
        logits = self._field_logits(slot, hidden)
        if supplied is None:
            supported = logits.masked_fill(~mask, -torch.inf)
            choice = (
                supported.argmax(-1)
                if deterministic
                else _categorical_choice(supported)
            )
        else:
            choice = supplied
        logp, entropy, valid = self._field_density(logits, mask, choice)
        return choice.clamp(0, SLOT_WIDTHS[slot] - 1), logp, entropy, valid

    def _batched_policy(
        self,
        actor_inputs: torch.Tensor,
        market_input: torch.Tensor,
        counts: torch.Tensor,
        active: torch.Tensor,
        order_limits: torch.Tensor,
        masks: BatchedSlotMasks,
        expected: torch.Tensor | None,
        deterministic: bool,
    ) -> _PolicyOutput:
        """Batched entity heads and ordered-market heads, with no frame scan.

        Only the fixed within-command field dependency stages are unrolled.
        Market HIRE capacity is an exact parallel same-Gumbel correction.
        """
        batch, actor_capacity, _ = actor_inputs.shape
        actor_ids = self.actor_slots[:actor_capacity]
        unit_live = (actor_ids[None, :] < counts[:, None]) & active[:, None]
        unit_base = self.frame_norm(actor_inputs)
        unit_prefix = torch.zeros_like(unit_base)
        unit_choices: dict[int, torch.Tensor] = {}
        unit_logps: dict[int, torch.Tensor] = {}
        unit_entropies: dict[int, torch.Tensor] = {}
        valid = torch.ones_like(active)
        for stage, slot in enumerate((1, 3, 4, 5, 6)):
            if slot == 1:
                mask = torch.where(
                    unit_live[..., None], masks.unit_kind, self.zero_category[:20]
                )
            elif slot == 3:
                mask = masks.unit_item[unit_choices[1]]
            elif slot == 4:
                mask = masks.unit_quantity_present[unit_choices[1]]
            elif slot == 5:
                mask = masks.unit_quantity_high[unit_choices[4]]
            else:
                mask = masks.unit_quantity_low[
                    unit_choices[4], (unit_choices[5] == 0).long()
                ]
            supplied = None
            if expected is not None:
                supplied = torch.where(unit_live, expected[:, :actor_capacity, slot], 0)
            choice, logp, entropy, admitted = self._field(
                slot,
                unit_base + unit_prefix / math.sqrt(stage + 1),
        "observation": {
            "player": 0,
            "farms": [{"hands": [[]] * (actors - 1)}] * 2,
        },
        "configuration": {"maxMarketOrdersPerTurn": 10},
    }
    for seat in range(2):
        frames = []
        for row in sampled.actions.tokens[
            0, seat, : sampled.actions.lengths[0, seat]
        ].tolist():
            frame = dict(zip(SLOT_NAMES, row, strict=True))
            actor_codec.frame_masks(legal, frames, frame, hire_limit=hire_limit)
            frames.append(frame)
        assert sum(frame["market_kind"] == 1 for frame in frames) == budget
        assert frames[-1]["stop"] == 1


def test_policy_fullgraph_capture_matches_eager_density_and_gradients():
    """Dynamo's eager backend checks graph completeness, not CUDA performance."""
    model, obs = _model(), _observation(3)
    actions = _pass_program(3, orders=2)
    eager = model.evaluate_actions(obs, actions)
    loss = eager.log_probs.per_player_entity.sum() + eager.values.square().sum()
    loss.backward()
    eager_grads = {name: p.grad.clone() for name, p in model.named_parameters()}
    model.zero_grad(set_to_none=True)
    model._policy_forward = torch.compile(
        model._batched_policy, backend="eager", fullgraph=True, dynamic=True
    )
    captured = model.evaluate_actions(obs, actions)
    torch.testing.assert_close(captured.log_probs.event, eager.log_probs.event)
    torch.testing.assert_close(captured.entropies.event, eager.entropies.event)
    loss = captured.log_probs.per_player_entity.sum() + captured.values.square().sum()
    loss.backward()
    for name, parameter in model.named_parameters():
        torch.testing.assert_close(parameter.grad, eager_grads[name])
    with torch.no_grad():
        sampled = model(obs)
        replayed = model.evaluate_actions(obs, sampled.actions)
    torch.testing.assert_close(sampled.log_probs.event, replayed.log_probs.event)


def test_batched_decoder_declares_version_and_rejects_recurrent_weights():
    model = _model()
    assert model.config.decoder_version == "batched_entities_v2"
    state = dict(model.state_dict())
    state["frame_history.weight_ih"] = torch.zeros(48, 16)
    with pytest.raises(RuntimeError, match=r"frame_history\.weight_ih"):
        model.load_state_dict(state, strict=True)


