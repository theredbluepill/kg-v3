+            }
+            replay.step(actions).unwrap();
+        }
+        assert_eq!(
+            serde_json::to_string(game.snapshot()).unwrap(),
+            serde_json::to_string(replay.snapshot()).unwrap()
+        );
+        assert!(SeatController::new(kind, 0, &replay).is_err());
+    }
+}
