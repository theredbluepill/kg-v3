        b"count = 0\ndef agent(obs, config=None):\n global count\n"
        b" count += 1\n return {'count': count}\n"
    )
    monkeypatch.setattr(
        generator, "sibling_oracle_files", lambda _bot: {"agents/r04/main.py": source}
    )
    original_path = list(sys.path)
