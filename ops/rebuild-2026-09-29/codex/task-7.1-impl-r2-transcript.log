def global_assignment_pairs(pairs, n_units, n_jobs):
    """Return the maximum-total-score one-to-one unit/job assignment.

    The normal scheduler takes the highest remaining pair greedily.  That can
    strand a second hand when the best hand has a nearly-as-good alternative.
    This rectangular Hungarian solve considers all pairs together.  One dummy
    idle column per unit makes leaving a hand unassigned a valid zero-score
    choice; unavailable real pairs are never selected.
    """
    if n_units <= 0 or not pairs:
        return []

    best = {}
    for pair in pairs:
        key = (pair[1], pair[2])
        if key not in best or pair[0] > best[key][0]:
            best[key] = pair

    # Hungarian algorithm for a rectangular minimization problem, n <= m.
    # Real pair costs are negative scores; dummy idle columns cost zero.
    n = n_units
    m = n_jobs + n_units
    missing = 1e15
    u = [0.0] * (n + 1)
    v = [0.0] * (m + 1)
    matched_row = [0] * (m + 1)
    way = [0] * (m + 1)

    def cost(row1, col1):
        col = col1 - 1
        if col >= n_jobs:
            return 0.0
        pair = best.get((row1 - 1, col))
        return -float(pair[0]) if pair is not None else missing

    for row1 in range(1, n + 1):
        matched_row[0] = row1
        minv = [float("inf")] * (m + 1)
        used = [False] * (m + 1)
        col0 = 0
        while True:
            used[col0] = True
            row0 = matched_row[col0]
            delta = float("inf")
            col1 = 0
            for col in range(1, m + 1):
                if used[col]:
                    continue
                cur = cost(row0, col) - u[row0] - v[col]
                if cur < minv[col]:
                    minv[col] = cur
                    way[col] = col0
                if minv[col] < delta:
                    delta = minv[col]
                    col1 = col
            for col in range(m + 1):
                if used[col]:
                    u[matched_row[col]] += delta
                    v[col] -= delta
                else:
                    minv[col] -= delta
            col0 = col1
            if matched_row[col0] == 0:
                break
        while True:
            col1 = way[col0]
            matched_row[col0] = matched_row[col1]
            col0 = col1
            if col0 == 0:
                break

    selected = []
    for col1 in range(1, n_jobs + 1):
        row1 = matched_row[col1]
        if row1 and (row1 - 1, col1 - 1) in best:
            selected.append(best[(row1 - 1, col1 - 1)])
    return sorted(selected, key=lambda pair: -pair[0])


