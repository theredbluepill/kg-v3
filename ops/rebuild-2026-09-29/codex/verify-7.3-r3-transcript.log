   119	def test_live_env_consumed_seed_custody(tmp_path: Path, event: str) -> None:
   120	    # Two envs, stride 3 from seed 91: construction consumes 91/94, an explicit
   121	    # reset 97/100, and the simultaneous terminal auto-reset of both envs
   122	    # allocates the next pair in env-index order.
   123	    configuration = {"episodeSteps": 3}
   124	    n_games = 2 if event != "simultaneous_terminal_reset" else 4
   125	    env, results, _ = _run(
   126	        tmp_path,
   127	        n_envs=2,
   128	        n_games=n_games,
   129	        count=n_games,
   130	        configuration=configuration,
   131	        start="reset" if event == "explicit_reset" else "observe",
   132	    )
   133	    first = (91, 94) if event != "explicit_reset" else (97, 100)
   134	    expected = {0: first[0], 1: first[1]}
   135	    if event == "simultaneous_terminal_reset":
   136	        expected.update({2: first[1] + 3, 3: first[1] + 6})
   137	    custody = _custody(tmp_path)
   138	    assert sorted(custody) == sorted(expected)
   139	    for ordinal, seed in expected.items():
   140	        record = custody[ordinal]
   141	        assert record["status"] == "complete", record.get("error")
   142	        assert record["seed_header"]["seed"] == seed
   143	        episode = json.loads((tmp_path / f"game_{ordinal:06d}.json").read_text())
   144	        assert episode["info"]["seed"] == seed
   145	        # The captured initial snapshot is the live env's, so a wrong seed
   146	        # header would fail native verification rather than pass silently.
   147	        assert record["verification"]["captured"]["initial"] is True
   148	    assert [(r.game_ordinal, r.seed) for r in results] == sorted(expected.items())
   149	    assert [r.env_index for r in results] == [
   150	        ordinal % 2 for ordinal in sorted(expected)
   151	    ]
   152	    assert env.seed_state()[0] > max(expected.values())
