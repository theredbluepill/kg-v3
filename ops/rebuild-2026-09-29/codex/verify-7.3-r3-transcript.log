   201	def test_live_terminal_snapshot_is_captured_before_auto_reset() -> None:
   202	    env = rs.KaggricultureEnv(
   203	        1, 11, 1, json.dumps({"episodeSteps": 3}), REWARD, 1, hire_limit=HIRE_LIMIT
   204	    )
   205	    arrays = buffers(1)
   206	    env.observe(**arrays)
   207	    tokens, lengths = market_policy(arrays, np.zeros(1, dtype=np.int64))
   208	    assert env.terminal_snapshot(0) is None
   209	    env.step(tokens, lengths, **arrays)
   210	    assert not arrays["dones"].any()
   211	    assert env.terminal_snapshot(0) is None
   212	    env.step(tokens, lengths, **arrays)
   213	    assert arrays["dones"].all()
   214	    finished_json = env.terminal_snapshot(0)
   215	    assert finished_json is not None
   216	    finished = json.loads(finished_json)
   217	    live = json.loads(env.state_snapshot(0))
   218	    # The step returned the replacement game's observation; the terminal
   219	    # snapshot still belongs to the completed game.
   220	    assert live["public"]["step"] == 0
   221	    assert live["done"] is False
   222	    assert finished["done"] is True
   223	    assert finished["public"]["step"] == 2
   224	    assert finished["statuses"] == ["DONE", "DONE"]
   225	    metrics = env.terminal_metrics(0)
   226	    assert metrics is not None
   227	    assert [farm["money"] for farm in finished["public"]["farms"]] == [
   228	        metrics["bank_0"],
   229	        metrics["bank_1"],
   230	    ]
   231	    assert arrays["transition_banks_after"][0].tolist() == [
   232	        metrics["bank_0"],
   233	        metrics["bank_1"],
   234	    ]
   235	    env.step(tokens, lengths, **arrays)
   236	    assert env.terminal_snapshot(0) is None
