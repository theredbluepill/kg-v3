+fn game_banks(game: &ObservationGame) -> Result<[f64; 2], EnvError> {
+    let values: [f64; 2] = game
+        .game()
+        .seat_money()
+        .try_into()
+        .map_err(|_| EnvError::Value("exactly two banks required".into()))?;
+    if values.iter().any(|v| !v.is_finite()) {
