   246	@dataclass
   247	class _ActiveReplay:
   248	    game_ordinal: int
   249	    env_index: int
   250	    seed_header: dict[str, Any]
   251	    seat_assignment: int
   252	    checkpoint_hashes: dict[str, str]
   253	    versions: dict[str, Any]
   254	    transitions: list[dict[str, Any]] = field(default_factory=list)
   255	    captured: dict[str, Any] = field(default_factory=dict)
   256	
   257	
   258	class ReplayRecorder:
   259	    """Record selected games and materialize them only after completion/truncation.
   260	
   261	    ``config`` is the caller's ``cfg.rl``; its ``eval_replay_games`` is the default
   262	    count (eight in the two supported rank configs). Failed export or evidence
   263	    comparison writes an error custody record and no successful episode.
   264	    """
   265	
   266	    def __init__(
   267	        self,
   268	        *,
   269	        output_dir: Path,
   270	        evaluation_identity: str,
   271	        total_games: int,
   272	        config: ReplayConfig,
   273	        count: int | None = None,
   274	        seat_assignments: Sequence[int] | None = None,
   275	    ) -> None:
   276	        self.output_dir = output_dir
   277	        self.evaluation_identity = evaluation_identity
   278	        self.selected_games = select_replay_games(
   279	            evaluation_identity,
   280	            total_games,
   281	            config.eval_replay_games if count is None else count,
   282	            seat_assignments=seat_assignments,
   283	        )
   284	        self._seat_assignments = (
   285	            tuple(seat_assignments) if seat_assignments is not None else None
   286	        )
   287	        self._active: dict[int, _ActiveReplay] = {}
   288	        self._finished: set[int] = set()
   289	        self._framework = load_pinned_framework() if self.selected_games else None
   290	
   291	    def start_game(
   292	        self,
   293	        game_ordinal: int,
   294	        env_index: int,
   295	        resolved_seed: int,
   296	        configuration: Mapping[str, Any],
   297	        seat_assignment: int,
   298	        checkpoint_hashes: Mapping[str, str],
   299	        versions: Mapping[str, Any],
   300	        *,
   301	        captured_initial: Mapping[str, Any] | None = None,
   302	    ) -> None:
   303	        if game_ordinal not in self.selected_games:
   304	            return
   305	        if game_ordinal in self._active or game_ordinal in self._finished:
   306	            raise ValueError(f"game {game_ordinal} was already started")
   307	        if type(resolved_seed) is not int or resolved_seed < 0:
   308	            raise ValueError("resolved_seed must be an exact non-negative integer")
   309	        if type(env_index) is not int or env_index < 0:
   310	            raise ValueError("env_index must be a non-negative integer")
   311	        if type(seat_assignment) is not int or seat_assignment not in (0, 1):
   312	            raise ValueError("seat_assignment must be 0 or 1")
   313	        if (
   314	            self._seat_assignments is not None
   315	            and self._seat_assignments[game_ordinal] != seat_assignment
   316	        ):
   317	            raise ValueError("seat_assignment differs from the selection schedule")
   318	        for key in ("source", "engine", "schema_version"):
   319	            if key not in versions:
   320	                raise ValueError(f"versions lacks {key}")
   321	        for key in ("source", "engine"):
   322	            if not isinstance(versions[key], str) or not versions[key]:
   323	                raise ValueError(f"versions.{key} must identify the source")
   324	        for key in ("candidate", "incumbent"):
   325	            digest = checkpoint_hashes.get(key)
   326	            if (
   327	                not isinstance(digest, str)
   328	                or len(digest) != 64
   329	                or any(char not in "0123456789abcdefABCDEF" for char in digest)
   330	            ):
   331	                raise ValueError(f"checkpoint_hashes.{key} must be a SHA-256")
   332	        if self._framework is None:
   333	            raise ValueError("selected replay has no pinned framework")
   334	        provenance = {
   335	            key: versions[key] for key in ("source", "engine", "schema_version")
   336	        }
   337	        provenance["target_framework_version"] = FRAMEWORK_VERSION
   338	        envelope = deepcopy(self._framework["envelope"])
   339	        envelope["id"] = f"{self.evaluation_identity}:game:{game_ordinal}"
   340	        resolved_configuration = deepcopy(self._framework["default_configuration"])
   341	        resolved_configuration.update(deepcopy(dict(configuration)))
   342	        resolved_configuration["seed"] = None
   343	        header = {
   344	            "seed": resolved_seed,
   345	            "configuration": resolved_configuration,
   346	            "provenance": deepcopy(provenance),
   347	            "specification": deepcopy(self._framework["specification"]),
   348	            "envelope": envelope,
   349	        }
   350	        captured = (
   351	            {}
   352	            if captured_initial is None
   353	            else {"initial": deepcopy(dict(captured_initial))}
   354	        )
   355	        self._active[game_ordinal] = _ActiveReplay(
   356	            game_ordinal,
   357	            env_index,
   358	            header,
   359	            seat_assignment,
   360	            deepcopy(dict(checkpoint_hashes)),
   361	            deepcopy(dict(versions)),
   362	            captured=captured,
   363	        )
   364	
   365	    def record_transition(
   366	        self,
   367	        game_ordinal: int,
   368	        actions: Sequence[Mapping[str, Any]],
   369	        *,
   370	        tokens: Sequence[Mapping[str, Any]] | None = None,
   371	        captured: Mapping[str, Any] | None = None,
   372	    ) -> None:
   373	        if game_ordinal not in self.selected_games:
   374	            return
   375	        replay = self._require_active(game_ordinal)
   376	        if len(actions) != 2:
   377	            message = "transition requires exactly two seat actions"
   378	            self.fail_game(game_ordinal, error=message)
   379	            raise ValueError(message)
   380	        transition: dict[str, Any] = {"actions": deepcopy(list(actions))}
   381	        if tokens is not None:
   382	            if len(tokens) != 2:
   383	                message = "tokens requires exactly two seat rows"
   384	                self.fail_game(game_ordinal, error=message)
   385	                raise ValueError(message)
   386	            transition["tokens"] = deepcopy(list(tokens))
   387	        if captured is not None:
   388	            evidence = deepcopy(dict(captured))
   389	            try:
   390	                if "public" in evidence:
   391	                    banks = [farm["money"] for farm in evidence["public"]["farms"]]
   392	                else:
   393	                    banks = evidence["banks"]
   394	                if not isinstance(banks, list) or len(banks) != 2:
   395	                    raise TypeError("expected two seat banks")
   396	            except (KeyError, TypeError) as error:
   397	                message = f"captured evidence needs a snapshot or two banks: {error}"
   398	                self.fail_game(game_ordinal, error=message)
   399	                raise ValueError(message) from error
   400	            if "public" in evidence:
   401	                replay.captured.setdefault("snapshots", []).append(
   402	                    {"transition": len(replay.transitions), "snapshot": evidence}
   403	                )
   404	            replay.captured.setdefault("banks", []).append(banks)
   405	        replay.transitions.append(transition)
   406	
   407	    def finish_game(self, game_ordinal: int, terminal: Mapping[str, Any]) -> None:
   408	        if game_ordinal not in self.selected_games:
   409	            return
   410	        replay = self._require_active(game_ordinal)
   411	        replay.captured["terminal"] = deepcopy(dict(terminal))
   412	        self._write(replay, status="complete")
   413	
   414	    def truncate_game(self, game_ordinal: int, *, reason: str) -> None:
   415	        if game_ordinal not in self.selected_games:
   416	            return
   417	        self._write(
   418	            self._require_active(game_ordinal), status="truncated", reason=reason
   419	        )
   420	
   421	    def fail_game(self, game_ordinal: int, *, error: str) -> None:
   422	        """Record a caller-observed native failure without pretending it committed."""
   423	        if game_ordinal not in self.selected_games:
   424	            return
   425	        self._write(self._require_active(game_ordinal), status="error", reason=error)
   426	
   427	    @property
   428	    def active_games(self) -> frozenset[int]:
   429	        """Selected games started but not yet written as complete/partial/error."""
   430	        return frozenset(self._active)
   431	
   432	    def fail_active_games(self, *, error: str) -> list[tuple[int, Exception]]:
   433	        """Write error custody for every active game, e.g. when evaluation aborts.
   434	
   435	        Each game keeps only its committed transitions. A game whose record
   436	        cannot be published stays active; its ordinal and publication error are
   437	        returned so the caller can report them without masking the abort cause.
   438	        """
   439	        failures: list[tuple[int, Exception]] = []
   440	        for game_ordinal in sorted(self._active):
   441	            try:
   442	                self.fail_game(game_ordinal, error=error)
   443	            except Exception as publication_error:
   444	                failures.append((game_ordinal, publication_error))
   445	        return failures
   446	
   447	    def _require_active(self, game_ordinal: int) -> _ActiveReplay:
   448	        if game_ordinal not in self._active:
   449	            raise ValueError(f"selected game {game_ordinal} is not active")
   450	        return self._active[game_ordinal]
   451	
   452	    def _write(
   453	        self, replay: _ActiveReplay, *, status: str, reason: str | None = None
   454	    ) -> None:
   455	        tape = {"complete": status == "complete", "transitions": replay.transitions}
   456	        sidecar: dict[str, Any] = {
   457	            "schema_version": 1,
   458	            "evaluation_identity": self.evaluation_identity,
   459	            "game_ordinal": replay.game_ordinal,
   460	            "env_index": replay.env_index,
   461	            "status": status,
   462	            "complete": status == "complete",
   463	            "seed_header": replay.seed_header,
   464	            "action_tape": tape,
   465	            "checkpoint_hashes": replay.checkpoint_hashes,
   466	            "seat_assignment": replay.seat_assignment,
   467	            "versions": replay.versions,
   468	            "framework_hashes": self._framework["hashes"] if self._framework else {},
   469	            "captured": replay.captured,
   470	            "producer": "v3 native replay; not executed by the Python framework",
   471	        }
   472	        if reason is not None:
   473	            sidecar["error" if status == "error" else "reason"] = reason
   474	        episode_bytes: bytes | None = None
   475	        if status != "error":
