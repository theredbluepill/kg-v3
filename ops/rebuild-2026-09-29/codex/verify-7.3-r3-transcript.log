   255	def _aborting_policy(
   256	    reject_env: int,
   257	) -> tuple[Any, list[int]]:
   258	    """``market_policy`` that submits an invalid length on its second call."""
   259	    calls = [0]
   260	
   261	    def policy(
   262	        arrays: dict[str, Any], candidate_seats: np.ndarray
   263	    ) -> tuple[np.ndarray, np.ndarray]:
   264	        calls[0] += 1
   265	        tokens, lengths = market_policy(arrays, candidate_seats)
   266	        if calls[0] == 2:
   267	            lengths[reject_env, 0] = 0
   268	        return tokens, lengths
   269	
   270	    return policy, calls
   271	
   272	
   273	def _run_aborting(
   274	    tmp_path: Path, *, count: int, reject_selected: bool
   275	) -> tuple[
   276	    replay_export.ReplayRecorder, dict[str, Any], int, pytest.ExceptionInfo[Any]
   277	]:
   278	    """Two envs commit one transition, then the second policy call is rejected."""
   279	    configuration = {"episodeSteps": 4}
   280	    seats = [0, 0]
   281	    recorder = _recorder(tmp_path, 2, count, seats)
   282	    selected = sorted(recorder.selected_games)
   283	    reject_env = (
   284	        selected[0]
   285	        if reject_selected
   286	        else next(index for index in range(2) if index not in selected)
   287	    )
   288	    policy, calls = _aborting_policy(reject_env)
   289	    env = rs.KaggricultureEnv(
   290	        2, 91, 3, json.dumps(configuration), REWARD, 1, hire_limit=HIRE_LIMIT
   291	    )
   292	    arrays = buffers(2)
   293	    with pytest.raises(ValueError, match="length") as raised:
   294	        evaluate_native_games(
   295	            env,
   296	            arrays,
   297	            policy,
   298	            n_games=2,
   299	            seat_assignments=seats,
   300	            configuration=configuration,
   301	            hire_limit=HIRE_LIMIT,
   302	            recorder=recorder,
   303	            checkpoint_hashes=HASHES,
   304	            versions=VERSIONS,
   305	        )
   306	    assert calls[0] == 2
   307	    # Rollback leaves both envs at their one committed step.
   308	    assert arrays["globals_int"][:, 0, 0].tolist() == [1, 1]
   309	    return recorder, arrays, reject_env, raised
   310	
