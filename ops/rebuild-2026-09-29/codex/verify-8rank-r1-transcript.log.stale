  lr_schedule:
    schedule: linear_warmup_cosine_decay
    warmup_steps: 200
    decay_steps: 150_000
    lr_min_ratio: 0.02

rl:
  horizon: 128
  checkpoint_freq: 20_000_000
  ppo_epochs: 1
  segments_per_minibatch: 8
  gradient_accumulation_steps: 1
