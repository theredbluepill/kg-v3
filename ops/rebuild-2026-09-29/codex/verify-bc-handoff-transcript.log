        )


@contextmanager
def _logger_session(logger: MetricLogger) -> Iterator[MetricLogger]:
    """Close the metric run as failed when training raises."""
    try:
        yield logger
    except BaseException:
        logger.close(exit_code=1)
        raise
    logger.close()


