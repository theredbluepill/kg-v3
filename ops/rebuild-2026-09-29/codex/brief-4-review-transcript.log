        [(NORTH, 0, 0, 0, 0)] * 3,
        [(HIRE, 0, 0, 0), (BUY_SEED, 4, 31, 31), (EMPTY, 0, 0, 0)],
    )
    return obs, _actions([[seat0, seat1]])


