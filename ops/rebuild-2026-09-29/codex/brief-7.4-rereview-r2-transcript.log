   880	        MarketKind::BuySeed | MarketKind::BuyProduct | MarketKind::BuyAnimal | MarketKind::Sell
   881	    );
   882	    let arity = if has_quantity { 3 } else { 1 };
   883	    if args.len() != arity {
   884	        return Err(format!(
   885	            "unsupported market arguments: {field} {} requires {arity} arguments, got {}",
   886	            kind.as_str(),
   887	            args.len()
   888	        ));
   889	    }
   890	    frame[Slot::MarketKind as usize] = kind as i64;
   891	    if has_quantity {
   892	        frame[Slot::MarketItem as usize] =
   893	            encode_item(&args[1], &format!("{field}[1]"), "market item syntax")?;
   894	        let quantity = encode_quantity(&args[2], 0, &format!("{field}[2]"))?;
   895	        frame[Slot::MarketQuantityHigh as usize] = quantity / QUANTITY_BASE;
   896	        frame[Slot::MarketQuantity as usize] = quantity % QUANTITY_BASE;
   897	    }
   898	    Ok(())
   899	}
