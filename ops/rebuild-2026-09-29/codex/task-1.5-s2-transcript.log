import json,re
from pathlib import Path
p=Path('ops/rebuild-2026-09-29/stage2-adapter')
rows=[json.loads(x) for x in (p/'commands.jsonl').read_text().splitlines()]
chosen=[r for r in rows if r['name'].startswith('batched/') and r['exit_code']==0]
chosen +=[r for r in rows if r['name'] in ('heads-remaining','heads-budget10','heads-budgets0to3','parity-isolated')]
totals={'passed':0,'skipped':0,'failed':0}
for r in chosen:
    log=(p/r['log']).read_text()
    summary=[line for line in log.splitlines() if re.search(r'\\d+ (passed|skipped|failed).* in ',line)][-1]
    for n,key in re.findall(r'(\\d+) (passed|skipped|failed)',summary): totals[key]+=int(n)
print(len(chosen),'commands',totals,'sum',sum(totals.values()))
for r in chosen:
    log=(p/r['log']).read_text()
    for line in log.splitlines():
        if line.startswith('SKIPPED'): print(r['name'],line)
(p/'regression-coverage.json').write_text(json.dumps({'commands':[r['name'] for r in chosen],'counts':totals,'collected_full_suite':2230,'all_collected_accounted':sum(totals.values())==2230},indent=2)+'\\n')
