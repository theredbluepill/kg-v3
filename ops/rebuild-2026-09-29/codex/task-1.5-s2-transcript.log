        {},
        {"farmer": ["PASS"], "hands": []},
        {"hands": [], "market": []},
        {"farmer": ["PASS"], "market": []},
        {"farmer": None, "hands": [], "market": []},
        {"farmer": ["PASS"], "hands": [None], "market": []},
