    81	def gumbel_argmax(masked_logits: torch.Tensor) -> torch.Tensor:
    82	    """Exact categorical sample over the last dim via Gumbel-max.
    83	
    84	    ``masked_logits`` carries ``-inf`` outside the support; no multinomial.
    85	    """
    86	    return gumbel_perturb(masked_logits).argmax(dim=-1)
