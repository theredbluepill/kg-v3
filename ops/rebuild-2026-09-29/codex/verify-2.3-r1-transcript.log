   112	def _delta0(width: int, device: torch.device) -> torch.Tensor:
   113	    """Singleton-zero support of width ``width``."""
   114	    return torch.arange(width, device=device) == 0
   115	
   116	
   117	def _safe_choice(
   118	    raw: torch.Tensor, mask: torch.Tensor
   119	) -> tuple[torch.Tensor, torch.Tensor]:
   120	    """Clamped index for every gather/lookup, and whether ``raw`` is admitted.
   121	
   122	    The clamped value is only a temporary index: its validity flag goes to the
   123	    support group, and the canonical comparison rejects any repaired value.
   124	    """
   125	    width = mask.shape[-1]
   126	    safe = raw.clamp(0, width - 1)
   127	    in_range = (raw >= 0) & (raw < width)
   128	    admitted = in_range & mask.gather(-1, safe.unsqueeze(-1)).squeeze(-1)
   129	    return safe, admitted
   130	
   131	
   132	def _masked_density(
   133	    logits: torch.Tensor, mask: torch.Tensor, choice: torch.Tensor
   134	) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
   135	    """Masked log-softmax: chosen log-prob, entropy and admission."""
   136	    log_probs = F.log_softmax(logits.masked_fill(~mask, -torch.inf), dim=-1)
   137	    admitted = mask.gather(-1, choice.unsqueeze(-1)).squeeze(-1)
   138	    selected = log_probs.gather(-1, choice.unsqueeze(-1)).squeeze(-1)
   139	    entropy = -(log_probs.exp() * log_probs.masked_fill(~mask, 0.0)).sum(dim=-1)
   140	    # A rejected replay raises after the core; keep -inf out of the graph.
   141	    return torch.where(admitted, selected, 0.0), entropy, admitted
