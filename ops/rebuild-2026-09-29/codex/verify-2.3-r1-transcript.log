    89	def couple_market_kinds(
    90	    perturbed: torch.Tensor, actor_counts: torch.Tensor, hire_limit: int
    91	) -> torch.Tensor:
    92	    """Final market kinds from perturbed masked scores ``[B, P, 8]``.
    93	
    94	    ``raw`` is the argmax at every position. The exclusive raw-HIRE prefix count
    95	    decides where HIRE capacity (``actor_counts + prior < hire_limit``) is
    96	    exhausted; there HIRE is masked and the argmax is re-taken over the same
    97	    scores, so the corrected outcome can be any non-HIRE kind, including NONE
    98	    and EMPTY. Once the raw and final HIRE prefixes differ, capacity is already
    99	    exhausted under both, so the correction equals the sequential sampler.
   100	    """
   101	    raw = perturbed.argmax(dim=-1)
   102	    raw_hires = (raw == MARKET_HIRE).long()
   103	    prior = raw_hires.cumsum(dim=-1) - raw_hires
   104	    can_hire = actor_counts[:, None] + prior < hire_limit
   105	    hire_column = (
   106	        torch.arange(perturbed.shape[-1], device=perturbed.device) == MARKET_HIRE
   107	    )
   108	    blocked = (~can_hire)[..., None] & hire_column
   109	    return perturbed.masked_fill(blocked, -torch.inf).argmax(dim=-1)
