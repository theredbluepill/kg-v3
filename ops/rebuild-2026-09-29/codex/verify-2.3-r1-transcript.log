    74	def gumbel_perturb(masked_logits: torch.Tensor) -> torch.Tensor:
    75	    """Add independent standard Gumbel noise (``-log Exp(1)``) to every entry."""
    76	    noise = torch.empty_like(masked_logits).exponential_()
    77	    tiny = torch.finfo(masked_logits.dtype).tiny
    78	    return masked_logits - noise.clamp_min(tiny).log()
    79	
