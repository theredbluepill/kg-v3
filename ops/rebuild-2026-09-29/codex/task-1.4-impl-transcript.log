#[serde(default)]
pub struct RewardConfig {
    pub mode: String,
    pub share_weight: f64,
    pub econ_shaping: f64,
    pub econ_starvation_weight: f64,
    pub econ_drought_weight: f64,
    pub econ_cap: f64,
    pub econ_ineffective_weight: f64,
    pub econ_ineffective_cap: f64,
}
impl Default for RewardConfig {
    fn default() -> Self {
        Self {
            mode: "win_loss".into(),
            share_weight: 0.1,
            econ_shaping: 0.0,
            econ_starvation_weight: 4.0,
            econ_drought_weight: 1.0,
            econ_cap: 0.25,
            econ_ineffective_weight: 0.0,
            econ_ineffective_cap: 0.1,
        }
    }
}
impl RewardConfig {
    fn validate(&self) -> Result<(), String> {
        if !["win_loss", "win_only", "win_share", "margin"].contains(&self.mode.as_str()) {
            return Err("unsupported reward mode".into());
        }
        let values = [
            self.share_weight,
            self.econ_shaping,
            self.econ_starvation_weight,
            self.econ_drought_weight,
            self.econ_cap,
            self.econ_ineffective_weight,
            self.econ_ineffective_cap,
        ];
        if values.iter().any(|v| !v.is_finite() || *v < 0.0)
            || self.share_weight > 1.0
            || !(0.0..1.0).contains(&self.econ_cap)
            || !(0.0..1.0).contains(&self.econ_ineffective_cap)
            || self.econ_cap == 0.0
            || self.econ_ineffective_cap == 0.0
            || self.terminal_scale() <= 0.0
        {
            return Err("invalid reward coefficient or budget".into());
        }
        if (self.econ_shaping > 0.0 || self.econ_ineffective_weight > 0.0)
            && !["win_loss", "win_share"].contains(&self.mode.as_str())
        {
            return Err("economic shaping requires win_loss or win_share".into());
        }
        Ok(())
    }
    fn terminal_scale(&self) -> f64 {
        1.0 - if self.econ_shaping > 0.0 {
            self.econ_cap
        } else {
            0.0
        } - if self.econ_ineffective_weight > 0.0 {
            self.econ_ineffective_cap
        } else {
            0.0
        }
    }
    fn penalty(&self, counts: &[u64; ECON_FIELDS]) -> f64 {
        (self.econ_shaping
            * (self.econ_starvation_weight * counts[0] as f64
                + self.econ_drought_weight * counts[1] as f64))
            .min(self.econ_cap)
            + (self.econ_ineffective_weight * counts[2] as f64).min(self.econ_ineffective_cap)
    }
    fn terminal(&self, own: f64, other: f64) -> f64 {
        let margin = own - other;
        let sign = if margin > 0.0 {
            1.0
        } else if margin < 0.0 {
            -1.0
        } else {
            0.0
        };
        match self.mode.as_str() {
            "margin" => margin / 3000.0,
            "win_only" => (sign + 1.0) / 2.0,
            "win_share" => {
                let share = if own + other > 0.0 {
                    own / (own + other).max(1e-30)
                } else {
                    0.5
                };
                (1.0 - self.share_weight) * sign + self.share_weight * (2.0 * share - 1.0)
            },
            _ => sign,
        }
    }
}

