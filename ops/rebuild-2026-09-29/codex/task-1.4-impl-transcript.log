        config: &str, reward_config: &Bound<'_, PyDict>, native_threads: usize, hire_limit: i64) -> PyResult<Self> {
        let seed = integer_seed(seed, "seed")?;
        let stride = integer_seed(seed_stride, "seed_stride")?;
        let config: Config = serde_json::from_str(config)
            .map_err(|error| PyValueError::new_err(format!("config: {error}")))?;
        let reward = self::reward_config(reward_config)?;
        py.detach(move || NativeEnv::new(n_envs, seed, stride, config, reward, native_threads, hire_limit))
            .map(|native| Self {native}).map_err(python_error)
    }
