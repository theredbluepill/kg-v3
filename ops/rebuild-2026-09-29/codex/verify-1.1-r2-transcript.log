## Appendix A: Manifest schema and checker

`TRIM_MANIFEST.json` uses strict schema version 1. Paths are repository-relative, with forward slashes. `retained` has exactly the 12 paths above; `excluded` has the other 113. Each retained entry includes both reference and resulting SHA-256 and an ordered array of line edits. An edit uses **one-based original** `start_line`, `delete_lines` (zero means insertion), exact UTF-8 `insert` text, and a nonempty `reason`. Reconstruct the final file from original bytes and the declared edits; a changed digest alone is insufficient. Binary fixtures must have an empty edit list. `authored` lists new engine files with resulting hashes and reasons. The manifest cannot hash itself; it is the sole explicit inventory exception. Build output under `engine_rs/target/` is ignored, but extra source, test, fixture or metadata files fail verification.

The generator in Appendix C supplies all values directly; there are no placeholder hashes. This checker is a consistency/provenance check, not a signature or semantic proof. A reviewer must assess declared edits, and Cargo/tests must assess behavior.

Create `scripts/check_engine_trim.mjs` with:

```javascript
import assert from 'node:assert/strict'
import { createHash } from 'node:crypto'
import { execFileSync } from 'node:child_process'
import { readFileSync, readdirSync, lstatSync } from 'node:fs'
import { resolve, join } from 'node:path'
import { pathToFileURL } from 'node:url'

export const PIN = '65f0eac5bb00b18a9d3acce319c2a231cbd5dff0'
export const sha = bytes => createHash('sha256').update(bytes).digest('hex')
const keys = (value, expected) =>
  assert.deepEqual(Object.keys(value).sort(), [...expected].sort(), 'schema keys')
const reason = value => assert.equal(typeof value === 'string' && value.trim().length > 0, true, 'reason')
const validPath = path => {
  assert.equal(typeof path, 'string')
  assert.match(path, /^engine_rs\//)
  assert.equal(path.includes('\\'), false)
  assert.equal(path.split('/').some(part => ['', '.', '..'].includes(part)), false)
  assert.equal(path.startsWith('engine_rs/target/'), false)
  assert.notEqual(path, 'engine_rs/TRIM_MANIFEST.json')
}
const sameSet = (a, b, label) => assert.deepEqual([...a].sort(), [...b].sort(), label)

export function verify(manifest, originals, current) {
  keys(manifest, ['schema_version', 'reference_commit', 'retained', 'excluded', 'authored'])
  assert.equal(manifest.schema_version, 1)
  assert.equal(manifest.reference_commit, PIN)
  const seen = new Set()
  for (const entry of [...manifest.retained, ...manifest.excluded, ...manifest.authored]) {
    validPath(entry.path)
    assert.equal(seen.has(entry.path), false, `duplicate: ${entry.path}`)
    seen.add(entry.path)
  }
  sameSet([...manifest.retained, ...manifest.excluded].map(e => e.path), originals.keys(), 'reference inventory')
  sameSet([...manifest.retained, ...manifest.authored].map(e => e.path), current.keys(), 'current inventory')
  for (const entry of manifest.excluded) {
    keys(entry, ['path', 'reference_sha256', 'reason'])
    reason(entry.reason)
    assert.equal(sha(originals.get(entry.path)), entry.reference_sha256, `${entry.path}: reference hash`)
    assert.equal(current.has(entry.path), false, `${entry.path}: excluded file present`)
  }
  for (const entry of manifest.retained) {
    keys(entry, ['path', 'reference_sha256', 'sha256', 'edits'])
    const original = originals.get(entry.path)
    const actual = current.get(entry.path)
    assert.equal(sha(original), entry.reference_sha256, `${entry.path}: reference hash`)
    assert.equal(sha(actual), entry.sha256, `${entry.path}: current hash`)
    let expected = original
    if (entry.edits.length) {
      const text = original.toString('utf8')
      assert.deepEqual(Buffer.from(text), original, `${entry.path}: edits require UTF-8`)
      const lines = text.match(/[^\n]*\n|[^\n]+$/g) ?? []
      let cursor = 0
      const parts = []
      for (const edit of entry.edits) {
        keys(edit, ['start_line', 'delete_lines', 'insert', 'reason'])
        reason(edit.reason)
        assert.equal(Number.isSafeInteger(edit.start_line), true)
        assert.equal(Number.isSafeInteger(edit.delete_lines), true)
        assert.equal(typeof edit.insert, 'string')
        const start = edit.start_line - 1
        assert.equal(start >= cursor && start <= lines.length && edit.delete_lines >= 0, true, `${entry.path}: edit range`)
        assert.equal(start + edit.delete_lines <= lines.length, true, `${entry.path}: edit end`)
        parts.push(lines.slice(cursor, start).join(''), edit.insert)
        cursor = start + edit.delete_lines
      }
      parts.push(lines.slice(cursor).join(''))
      expected = Buffer.from(parts.join(''))
    }
    assert.deepEqual(actual, expected, `${entry.path}: undeclared edit`)
    if (entry.path.endsWith('.rs') && entry.path !== 'engine_rs/src/lib.rs') {
      assert.equal(entry.edits.length, 0, `${entry.path}: retained Rust must be unchanged`)
    }
  }
  for (const entry of manifest.authored) {
    keys(entry, ['path', 'sha256', 'reason'])
    reason(entry.reason)
    assert.equal(sha(current.get(entry.path)), entry.sha256, `${entry.path}: authored hash`)
  }
}

export function check(root) {
  // Largest pinned blob is 5,099,830 bytes; include excluded blobs in custody.
  const git = args => execFileSync('git', args, { cwd: root, maxBuffer: 16 * 1024 * 1024 })
  const paths = git(['ls-tree', '-r', '--name-only', PIN, 'engine_rs']).toString().trim().split('\n')
  const originals = new Map(paths.map(path => [path, git(['show', `${PIN}:${path}`])]))
  const current = new Map()
  function walk(relative) {
    for (const name of readdirSync(join(root, relative))) {
      const path = `${relative}/${name}`
      if (path === 'engine_rs/target' || path === 'engine_rs/TRIM_MANIFEST.json') continue
      const stat = lstatSync(join(root, path))
      assert.equal(stat.isSymbolicLink(), false, `${path}: symlink`)
      if (stat.isDirectory()) walk(path)
      else {
        assert.equal(stat.isFile(), true, `${path}: not a regular file`)
        current.set(path, readFileSync(join(root, path)))
      }
    }
  }
  const manifest = JSON.parse(readFileSync(join(root, 'engine_rs/TRIM_MANIFEST.json'), 'utf8'))
  walk('engine_rs')
  verify(manifest, originals, current)
  const retained = ['Cargo.toml', 'Cargo.lock', 'LICENSE', 'VENDORED_FROM.md',
    'src/lib.rs', 'src/py_random.rs', 'src/econ_attrib.rs', 'tests/py_random.rs',
    ...[95324500, 95901360, 95921764, 95990191].map(id => `fixtures/episode-${id}.jsonl.gz`)]
  sameSet(manifest.retained.map(e => e.path), retained.map(p => `engine_rs/${p}`), 'Task 1.1 retained set')
  const newPaths = manifest.authored.map(e => e.path)
  assert.equal(newPaths.every(p => p === 'engine_rs/tests/replay_parity.rs'), true, 'Task 1.1 authored set')
  const removed = new Set([19, 21, 22, 23, 24, 25, 27])
  const lib = originals.get('engine_rs/src/lib.rs').toString().split(/(?<=\n)/)
  const expectedLib = Buffer.from(lib.filter((_, i) => !removed.has(i + 1)).join(''))
  assert.deepEqual(current.get('engine_rs/src/lib.rs'), expectedLib, 'exact seven removals')
  assert.equal(sha(expectedLib), 'c4b9bac5057be3a435d2f1035aae17bcd15e7f95ea8557322e4929877c8231fd')
  const cargo = originals.get('engine_rs/Cargo.toml').toString()
    .replace('crate-type = ["rlib", "cdylib"]\n', '')
    .replace('[[bin]]\nname = "re_engine"\npath = "src/main.rs"\n\n', '')
    .replace('rayon = "1.12.0"\n', '')
  assert.equal(current.get('engine_rs/Cargo.toml').toString(), cargo, 'Cargo target/dependency removals only')
  const oldProvenance = originals.get('engine_rs/VENDORED_FROM.md')
  assert.deepEqual(current.get('engine_rs/VENDORED_FROM.md').subarray(0, oldProvenance.length), oldProvenance, 'append-only provenance')
}

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  try {
    check(resolve(process.argv[2] ?? '.'))
    console.log('engine trim manifest: OK')
  } catch (error) {
    console.error(error.message)
    process.exitCode = 1
  }
}
```

## Appendix B: Checker regression tests

Create `tests/tools/check_engine_trim.test.mjs` (Node's built-in runner; not a new dependency):

```javascript
import assert from 'node:assert/strict'
import test from 'node:test'
import { PIN, sha, verify } from '../../scripts/check_engine_trim.mjs'

function fixture() {
  const kept = 'engine_rs/src/py_random.rs'
  const omitted = 'engine_rs/src/ffi.rs'
  const authored = 'engine_rs/tests/replay_parity.rs'
  const originals = new Map([[kept, Buffer.from('original\n')], [omitted, Buffer.from('ffi\n')]])
  const current = new Map([[kept, originals.get(kept)], [authored, Buffer.from('test\n')]])
  const manifest = {
    schema_version: 1, reference_commit: PIN,
    retained: [{ path: kept, reference_sha256: sha(originals.get(kept)), sha256: sha(current.get(kept)), edits: [] }],
    excluded: [{ path: omitted, reference_sha256: sha(originals.get(omitted)), reason: 'C5 excluded ABI' }],
    authored: [{ path: authored, sha256: sha(current.get(authored)), reason: 'replay regression' }],
  }
  return { kept, omitted, authored, originals, current, manifest }
}

test('valid full inventory passes', () => {
  const f = fixture()
  verify(f.manifest, f.originals, f.current)
})
test('declared line removal reconstructs exact original bytes', () => {
  const p = 'engine_rs/Cargo.toml'
  const before = Buffer.from('keep\nremove\nkeep2\n')
  const after = Buffer.from('keep\nkeep2\n')
  const manifest = { schema_version: 1, reference_commit: PIN, excluded: [], authored: [],
    retained: [{ path: p, reference_sha256: sha(before), sha256: sha(after),
      edits: [{ start_line: 2, delete_lines: 1, insert: '', reason: 'remove excluded target' }] }] }
  verify(manifest, new Map([[p, before]]), new Map([[p, after]]))
  manifest.retained[0].edits[0].start_line = 1
  assert.throws(() => verify(manifest, new Map([[p, before]]), new Map([[p, after]])), /undeclared edit/)
})
for (const [name, mutate] of [
  ['modified retained bytes', f => f.current.set(f.kept, Buffer.from('changed\n'))],
  ['wrong reference hash', f => { f.manifest.retained[0].reference_sha256 = '0'.repeat(64) }],
  ['undeclared edit despite updated hash', f => {
    f.current.set(f.kept, Buffer.from('changed\n'))
    f.manifest.retained[0].sha256 = sha(f.current.get(f.kept))
  }],
  ['extra excluded module', f => f.current.set(f.omitted, Buffer.from('ffi\n'))],
  ['missing retained file', f => f.current.delete(f.kept)],
  ['missing authored file', f => f.current.delete(f.authored)],
  ['unaccounted reference file', f => f.manifest.excluded.pop()],
  ['duplicate entry', f => f.manifest.retained.push(f.manifest.retained[0])],
  ['unsafe path', f => { f.manifest.retained[0].path = 'engine_rs/../escape' }],
  ['unexpected schema key', f => { f.manifest.fallback = true }],
]) {
  test(name, () => {
    const f = fixture()
    mutate(f)
    assert.throws(() => verify(f.manifest, f.originals, f.current))
  })
}
```

Expected **12 Node tests**. They exercise genuine drift and inventory failures with tiny buffers; they neither copy nor compile the full engine. End-to-end `check()` is then run on the actual package at every acceptance gate.

## Appendix C: Deterministic manifest generation

Run from the repository root after Task A's trim, then again after Task B adds/formats the replay test. This emits **per-file** inventory and exact line hunks, with no manual digest maintenance. Review the resulting diff, especially Cargo's generated lockfile hunks; this is not authorization to accept arbitrary edits.

```bash
.venv/bin/python - <<'PY'
from pathlib import Path
import difflib, hashlib, json, subprocess

pin = '65f0eac5bb00b18a9d3acce319c2a231cbd5dff0'
prefix = 'engine_rs/'
kept = {'Cargo.toml', 'Cargo.lock', 'LICENSE', 'VENDORED_FROM.md', 'src/lib.rs',
        'src/py_random.rs', 'src/econ_attrib.rs', 'tests/py_random.rs'}
kept |= {f'fixtures/episode-{i}.jsonl.gz' for i in (95324500, 95901360, 95921764, 95990191)}
why_edit = {
    'src/lib.rs': 'Remove only excluded module declarations at reference lines 19, 21-25, 27; see brief dependency table.',
    'Cargo.toml': 'Remove unused cdylib, re_engine binary and Rayon dependency; preserve numeric features and compatibility metadata.',
    'Cargo.lock': 'Generated by cargo remove --offline rayon; prune only unused Rayon dependency closure, no manual edits.',
    'VENDORED_FROM.md': 'Append current trim scope while preserving all historical provenance bytes.',
}
excluded_sources = {
    'ffi': 'C5 C ABI/ctypes replaced by native adapter in Task 1.4',
    'joint_matching': 'C2 policy matching enumeration is outside rules kernel',
    'myolie_features': 'C4 flat v2 encoder rebuilt in Task 1.3',
    'myolie_sampler': 'C3 grammar port after review in Task 1.2',
    'native_agents': 'C2 scripted opponents deferred to selected Phase 7 imports',
    'policy_rows': 'C2 policy action-row machinery is outside rules kernel',
    'training': 'C5 old training lifecycle/collector rebuilt in Task 1.4',
    'main': 'Replay/benchmark CLI excluded; direct replay integration test replaces test purpose',
}
def exclusion(path):
    if path.startswith('src/native_agents/'):
        return excluded_sources['native_agents']
    if path.startswith('src/bin/') or path.startswith('examples/'):
        return 'C2 bot executable/oracle not required for rules transitions'
    if path.startswith('src/') and Path(path).stem in excluded_sources:
        return excluded_sources[Path(path).stem]
    if path.startswith('fixtures/'):
        return 'Bot/controller/matching oracle unused by retained rules and RNG tests'
    if path == 'tests/shoprouter_parity.rs':
        return 'Requires excluded ShopRouterController; tests controller actions, zero engine transitions'
    if path == 'README.md':
        return 'Describes excluded full engine/ABI/matching surfaces and unavailable sibling tools'
    if path == 'V3_IMPORT.json':
        return 'Full prior import manifest superseded by exhaustive TRIM_MANIFEST.json'
    raise ValueError(f'unclassified reference path: {path}')
sha = lambda data: hashlib.sha256(data).hexdigest()
paths = subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', pin, 'engine_rs'], text=True).splitlines()
manifest = dict(schema_version=1, reference_commit=pin, retained=[], excluded=[], authored=[])
for path in paths:
    relative = path.removeprefix(prefix)
    before = subprocess.check_output(['git', 'show', f'{pin}:{path}'])
    if relative not in kept:
        manifest['excluded'].append(dict(path=path, reference_sha256=sha(before), reason=exclusion(relative)))
        continue
    after = Path(path).read_bytes()
    edits = []
    if before != after:
        reason = why_edit[relative]  # Deliberately fail for an unauthorized edited file.
        a = before.decode('utf-8').splitlines(keepends=True)
        b = after.decode('utf-8').splitlines(keepends=True)
        for tag, i, j, x, y in difflib.SequenceMatcher(a=a, b=b, autojunk=False).get_opcodes():
            if tag != 'equal':
                edits.append(dict(start_line=i+1, delete_lines=j-i, insert=''.join(b[x:y]), reason=reason))
    manifest['retained'].append(dict(path=path, reference_sha256=sha(before), sha256=sha(after), edits=edits))
new = Path('engine_rs/tests/replay_parity.rs')
if new.exists():
    manifest['authored'].append(dict(path=new.as_posix(), sha256=sha(new.read_bytes()),
                                     reason='New direct native-reset official-trace parity and comparator regressions'))
assert len(paths) == 125 and len(manifest['retained']) == 12 and len(manifest['excluded']) == 113
Path('engine_rs/TRIM_MANIFEST.json').write_text(json.dumps(manifest, indent=2) + '\n')
PY
```

## Appendix D: Direct replay and public API tests

Create `engine_rs/tests/replay_parity.rs` with the following. It uses only retained public APIs and existing dependencies. `gzip -dc` is an explicit test prerequisite and a failed decompression is a hard error. No shell interpolation or new executable target is involved.

```rust
use kaggriculture_engine::{ATTRIB_FIELDS, Config, ECON_FIELDS, ECON_PASS, Game, TraceHeader};
use serde_json::{Value, json};
use std::path::Path;
use std::process::Command;

fn assert_public(actual: &Value, expected: &Value, context: &str) {
    assert_eq!(actual, expected, "public state: {context}");
}

fn assert_private(actual: &Value, expected: &Value, context: &str) {
    assert_eq!(actual, expected, "private state: {context}");
    for (a, e) in actual.as_array().unwrap().iter().zip(expected.as_array().unwrap()) {
        for field in ["shed", "seeds"] {
            assert_eq!(
                a[field].as_object().unwrap().keys().collect::<Vec<_>>(),
                e[field].as_object().unwrap().keys().collect::<Vec<_>>(),
                "private map key order: {context}: {field}"
            );
        }
        for (a, e) in a["inventories"].as_array().unwrap().iter()
            .zip(e["inventories"].as_array().unwrap())
        {
            assert_eq!(
                a.as_object().unwrap().keys().collect::<Vec<_>>(),
                e.as_object().unwrap().keys().collect::<Vec<_>>(),
                "private map key order: {context}: inventory"
            );
        }
    }
}

#[test]
#[should_panic(expected = "private map key order")]
fn private_order_mismatch_is_rejected() {
    let a: Value = serde_json::from_str(
        r#"[{"shed":{},"seeds":{},"inventories":[{"WHEAT":1,"MILK":2}]}]"#,
    ).unwrap();
    let b: Value = serde_json::from_str(
        r#"[{"shed":{},"seeds":{},"inventories":[{"MILK":2,"WHEAT":1}]}]"#,
    ).unwrap();
    assert_private(&a, &b, "negative comparator case");
}

#[test]
#[should_panic(expected = "public state")]
fn public_number_mismatch_is_rejected() {
    let a: Value = serde_json::from_str(r#"{"prices":{"WHEAT":20}}"#).unwrap();
    let b: Value = serde_json::from_str(r#"{"prices":{"WHEAT":20.0}}"#).unwrap();
    assert_public(&a, &b, "negative comparator case");
}

#[test]
fn kernel_public_api() {
    let config = Config { episode_steps: 3_i64.into(), ..Config::default() };
    let mut game = Game::new(config, 42, 2).unwrap();
    assert_eq!(game.public_state().step, 0);
    assert_eq!(game.econ_counters().unwrap(), &[[0_u64; ECON_FIELDS]; 2]);
    assert_eq!(game.attrib_counters().unwrap(), &[[0_u64; ATTRIB_FIELDS]; 2]);
    let pass = [json!({"farmer": ["PASS"]}), json!({"farmer": ["PASS"]})];
    game.step(&pass).unwrap();
    assert_eq!(game.public_state().step, 1);
    assert!(!game.snapshot().done);
    assert_eq!(game.econ_counters().unwrap()[0][ECON_PASS], 1);
    assert!(game.terminal_banks().is_none());
    game.step_with_market_metrics(&pass).unwrap();
    assert!(game.snapshot().done);
    assert_eq!(game.terminal_banks().unwrap(), &[3000.0, 3000.0]);
}

fn replay(file: &str, episode_id: u64) {
    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join(file);
    let output = Command::new("gzip").arg("-dc").arg(&path).output()
        .expect("gzip is required for pinned replay fixtures");
    assert!(output.status.success(), "{}: {}", path.display(), String::from_utf8_lossy(&output.stderr));
    let text = String::from_utf8(output.stdout).unwrap();
    let mut lines = text.lines();
    let raw: Value = serde_json::from_str(lines.next().expect("trace header")).unwrap();
    assert_eq!(raw["type"], "header");
    assert_eq!(raw["source"]["episode_id"].as_u64().unwrap(), episode_id);
    assert_eq!(raw["source"]["module_version"], "1.32.7");
    assert_eq!(raw["source"]["engine_sha256"],
        "bc8a54879ef02c7ea64b8b333d6a976f0ea65c4949149d01f463f23bccee653e");
    let header: TraceHeader = serde_json::from_value(raw.clone()).unwrap();
    assert_eq!(header.transitions, 719);
    let mut game = Game::new(header.configuration.clone(), header.seed.as_i64().unwrap(), 2).unwrap();
    let initial = game.snapshot();
    assert_public(&serde_json::to_value(&initial.public).unwrap(), &raw["initial"]["public"], file);
    assert_private(&serde_json::to_value(&initial.privates).unwrap(), &raw["initial"]["privates"], file);
    assert_eq!(initial.statuses, vec!["ACTIVE", "ACTIVE"]);
    assert_eq!(initial.rewards, vec![0.0, 0.0]);
    assert!(!initial.done);
    let mut count = 0;
    for (index, line) in lines.enumerate() {
        let row: Value = serde_json::from_str(line).unwrap();
        let context = format!("{file}, transition {index}");
        assert_eq!(row["type"], "transition", "{context}");
        assert_eq!(row["from_step"].as_u64().unwrap(), index as u64, "{context}");
        game.step(row["actions"].as_array().unwrap())
            .unwrap_or_else(|error| panic!("{context}: {error}"));
        let actual = game.snapshot();
        assert_public(&serde_json::to_value(&actual.public).unwrap(), &row["expected"], &context);
        assert_private(&serde_json::to_value(&actual.privates).unwrap(), &row["privates"], &context);
        let statuses: Vec<String> = serde_json::from_value(row["statuses"].clone()).unwrap();
        let rewards: Vec<f64> = serde_json::from_value(row["rewards"].clone()).unwrap();
        assert_eq!(actual.statuses, statuses, "{context}");
        assert_eq!(actual.rewards, rewards, "{context}");
        assert_eq!(actual.done, index == 718, "{context}");
        assert_eq!(actual.public.step, index + 1, "{context}");
        count += 1;
    }
    assert_eq!(count, header.transitions);
    assert_eq!(game.terminal_banks().unwrap(), header.terminal_banks.as_slice(), "{file}");
}

