for old in [b'crate-type = ["rlib", "cdylib"]\n',
            b'[[bin]]\nname = "re_engine"\npath = "src/main.rs"\n\n']:
    assert b.count(old) == 1
    b = b.replace(old, b'')
p.write_bytes(b)
PY
cargo remove --manifest-path engine_rs/Cargo.toml --offline rayon
```

