"""Read-only sampling of the owner's v2 volume into a temporary export ZIP."""
from pathlib import Path
import hashlib,json,random,zipfile
root=Path('/data/kaggriculture-v2/public-episodes-2026-09-14-to-2026-09-27')
records=[]
with zipfile.ZipFile('/tmp/kg-v3-bc-replays.zip','w',compression=zipfile.ZIP_DEFLATED,compresslevel=1) as out:
 for day in range(21,28):
  path=root/'archives'/f'kaggriculture-episodes-2026-09-{day}.zip'
  with zipfile.ZipFile(path) as src:
   names=sorted(n for n in src.namelist() if n.endswith('.json'))
   random.Random(20260929+day).shuffle(names)
   for i,name in enumerate(names[:36]):
    payload=src.read(name)
    target=f'{day}/{name}'
    out.writestr(target,payload)
    records.append({'member':target,'split':'validation' if i<4 else 'train','source_archive':path.name,'source_member':name,'sha256':hashlib.sha256(payload).hexdigest(),'bytes':len(payload)})
  print(day,len(records),flush=True)
 out.writestr('selection.json',json.dumps({'volume':'4llk4uaf20','source_root':str(root),'sampling':'seeded32 train+4 validation episodes/day,2026-09-21..27; both seats; no outcome filtering','episodes':records},indent=2))
Path('/tmp/kg-v3-bc-selection.json').write_text(json.dumps(records,indent=2))
