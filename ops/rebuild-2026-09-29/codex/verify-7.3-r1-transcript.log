   775	        reward.as_f64().map(|r| json!(r)).ok_or_else(|| {
   776	            Divergence::new(format!("{p}/rewards/{seat}"), "expected numeric reward")
   777	        })
   778	    })
   779	    .collect::<Result<Vec<_>>>()?;
   780	    evidence.insert("rewards".into(), Value::Array(rewards));
   781	    Ok(Value::Object(evidence))
   782	}
