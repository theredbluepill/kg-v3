   402	pub fn export_kaggle_episode(header: &SeedHeader, tape: &ActionTape) -> Result<Value> {
   403	    let snapshots = replay_from_seed(header, tape)?;
   404	    export_snapshots(header, tape, &snapshots)
   405	}
   406	fn export_snapshots(
   407	    header: &SeedHeader,
   408	    tape: &ActionTape,
   409	    snapshots: &[StepSnapshot],
   410	) -> Result<Value> {
   411	    let mut steps = Vec::with_capacity(snapshots.len());
   412	    for (i, snapshot) in snapshots.iter().enumerate() {
   413	        let mut seats = Vec::with_capacity(2);
   414	        for seat in 0..2 {
   415	            let action = if i == 0 {
   416	                required(
   417	                    &header.specification["action"],
   418	                    "default",
   419	                    "/specification/action",
   420	                )?
   421	                .clone()
   422	            } else {
   423	                tape.transitions[i - 1].actions[seat].clone()
   424	            };
   425	            seats.push(
   426	                json!({"action":action,"reward":kaggle_reward(header, snapshot, seat)?,"info":{},
   427	                "observation":observation(header,snapshot,seat)?,"status":snapshot.statuses[seat]}),
   428	            );
   429	        }
   430	        steps.push(Value::Array(seats));
   431	    }
   432	    let mut result = Map::new();
   433	    for key in [
   434	        "id",
   435	        "name",
   436	        "title",
   437	        "description",
   438	        "version",
   439	        "module_version",
   440	    ] {
   441	        result.insert(key.into(), header.envelope[key].clone());
   442	    }
   443	    result.insert("configuration".into(), header.configuration_json.clone());
   444	    result.insert("specification".into(), header.specification.clone());
   445	    result.insert("steps".into(), Value::Array(steps));
   446	    let last = snapshots.last().expect("initial snapshot");
   447	    let rewards = (0..2)
   448	        .map(|seat| kaggle_reward(header, last, seat))
   449	        .collect::<Result<Vec<_>>>()?;
   450	    result.insert("rewards".into(), Value::Array(rewards));
   451	    result.insert("statuses".into(), json!(last.statuses));
   452	    result.insert("schema_version".into(), json!(1));
   453	    result.insert("info".into(),json!({"seed":header.seed,"v3_native_replay":{
   454	        "exporter":EXPORTER,"provenance":header.provenance,"complete":tape.complete,
   455	        "execution":"produced by native replay, not by the Python framework",
   456	        "trace_placeholders":"initial/schedules/terminal_banks/transitions are inert placeholders; only two player counts initialize seed replay"
   457	    }}));
   458	    Ok(Value::Object(result))
   459	}
