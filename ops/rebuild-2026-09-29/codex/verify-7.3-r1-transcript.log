   461	fn restored_observation(episode: &Value, index: usize, seat: usize) -> Result<Value> {
   462	    let p = format!("/steps/{index}/{seat}/observation");
   463	    let mut obs = object(&episode["steps"][index][seat]["observation"], &p)?.clone();
   464	    if seat == 1 {
   465	        for (key, schema) in object(
   466	            &episode["specification"]["observation"],
   467	            "/specification/observation",
   468	        )? {
   469	            if schema["shared"] == true && !obs.contains_key(key) {
   470	                let value = required(
   471	                    &episode["steps"][index][0]["observation"],
   472	                    key,
   473	                    &format!("/steps/{index}/0/observation"),
   474	                )?;
   475	                obs.insert(key.clone(), value.clone());
   476	            }
   477	        }
   478	    }
   479	    Ok(Value::Object(obs))
   480	}
