   269	pub fn replay_from_seed(header: &SeedHeader, tape: &ActionTape) -> Result<Vec<StepSnapshot>> {
   270	    let mut game = Game::from_seed_header(&header.trace_header()?)
   271	        .map_err(|e| Divergence::new("/header", e))?;
   272	    let config = ObservationConfig::new(&header.configuration)
   273	        .map_err(|e| Divergence::new("/configuration", e.to_string()))?;
   274	    let mut snapshots = vec![game.snapshot()];
   275	    for (t, row) in tape.transitions.iter().enumerate() {
   276	        let p = format!("/transitions/{t}");
   277	        let pre = &snapshots[t];
   278	        if pre.done {
   279	            return Err(Divergence::new(p, "steps after DONE"));
   280	        }
   281	        if row.actions.len() != 2 {
   282	            return Err(Divergence::new(
   283	                format!("{p}/actions"),
   284	                "exactly two actions required",
   285	            ));
   286	        }
   287	        if let Some(seats) = &row.tokens {
   288	            if seats.len() != 2 {
   289	                return Err(Divergence::new(
   290	                    format!("{p}/tokens"),
   291	                    "exactly two token rows required",
   292	                ));
   293	            }
   294	            for (seat, token) in seats.iter().enumerate() {
   295	                let actors = i64::try_from(pre.public.farms[seat].hands.len() + 1)
   296	                    .map_err(|e| Divergence::new(&p, e.to_string()))?;
   297	                // Hands are cleared at end of day (engine end_of_day), so
   298	                // actors + hires never reaches turnsPerDay * orders + 1 (<= 241 by
   299	                // the envelope): this cap never rejects a reachable program, and
   300	                // decode renders identically under any non-binding cap.
   301	                let plan = grammar::plan(
   302	                    actors,
   303	                    config.orders,
   304	                    config.turns_per_day * config.orders + 1,
   305	                )
   306	                .map_err(|e| Divergence::new(&p, e))?;
   307	                let action = grammar::decode(&plan, &token.tokens, token.length)
   308	                    .map_err(|e| Divergence::new(format!("{p}/tokens/{seat}"), e))?;
   309	                if action != row.actions[seat] {
   310	                    return Err(Divergence::new(
   311	                        format!("{p}/actions/{seat}"),
   312	                        "native decoded tokens differ from submitted action",
   313	                    ));
   314	                }
   315	            }
   316	        }
   317	        game.step(&row.actions)
   318	            .map_err(|e| Divergence::new(&p, format!("native step error: {e}")))?;
   319	        let next = game.snapshot();
   320	        if next.public.farms.iter().any(|f| f.hands.len() >= 241) {
   321	            return Err(Divergence::new(p, "observed actor count exceeds 241"));
   322	        }
   323	        snapshots.push(next);
   324	    }
   325	    if tape.complete && !snapshots.last().expect("initial snapshot").done {
   326	        return Err(Divergence::new(
   327	            "/transitions",
   328	            "tape shorter than game while completion claimed",
   329	        )
   330	        .at(tape.transitions.len().checked_sub(1)));
   331	    }
   332	    Ok(snapshots)
   333	}
