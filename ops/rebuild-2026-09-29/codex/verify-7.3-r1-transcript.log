   868	/// Foreign comparison ignores only host/runtime fields: top-level info except
   869	/// seed, per-seat info, remainingOverageTime, actTimeout/runTimeout. core.toJSON
   870	/// copies info; core.__loop_through_interpreter charges measured agent duration
   871	/// against remainingOverageTime. Config time budgets do not affect this kernel.
   872	/// Schema-shared omission is normalized by restoring only marked properties.
   873	fn semantic_view(episode: &Value) -> Result<Value> {
   874	    let mut result = episode.clone();
   875	    result["info"] = json!({"seed":episode["info"]["seed"]});
   876	    if let Some(config) = result["configuration"].as_object_mut() {
   877	        config.shift_remove("actTimeout");
   878	        config.shift_remove("runTimeout");
   879	    }
   880	    for i in 0..array(&episode["steps"], "/steps")?.len() {
   881	        for seat in 0..2 {
   882	            let mut obs = restored_observation(episode, i, seat)?;
   883	            let map = obs.as_object_mut().expect("restored object");
   884	            map.shift_remove("remainingOverageTime");
   885	            // Restored shared fields occupy schema order, not append order.
   886	            // Payload object order stays completely untouched.
   887	            let props = object(
   888	                &episode["specification"]["observation"],
   889	                "/specification/observation",
   890	            )?;
   891	            let mut ordered = Map::new();
   892	            for key in props.keys() {
   893	                if let Some(value) = map.shift_remove(key) {
   894	                    ordered.insert(key.clone(), value);
   895	                }
   896	            }
   897	            ordered.extend(std::mem::take(map));
   898	            result["steps"][i][seat]["observation"] = Value::Object(ordered);
   899	            result["steps"][i][seat]
   900	                .as_object_mut()
   901	                .expect("validated state")
   902	                .shift_remove("info");
   903	        }
   904	    }
   905	    Ok(result)
   906	}
