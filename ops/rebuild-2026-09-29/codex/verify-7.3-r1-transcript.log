   652	fn child(p: &str, key: &str) -> String {
   653	    format!("{p}/{}", key.replace('~', "~0").replace('/', "~1"))
   654	}
   655	// JSON integers remain exact, including when compared with a float spelling.
   656	// Normalize decimal coefficient/exponent without ever converting to f64.
   657	/// JSON number kind: Python's json writes every float with '.' or an exponent.
   658	fn is_float_spelling(n: &Number) -> bool {
   659	    n.to_string().contains(['.', 'e', 'E'])
   660	}
   661	fn decimal(n: &Number) -> (String, num_bigint::BigInt) {
   662	    let raw = n.to_string();
   663	    let (mantissa, exponent) = raw
   664	        .split_once(['e', 'E'])
   665	        .map_or((raw.as_str(), num_bigint::BigInt::from(0)), |(m, e)| {
   666	            (m, e.parse::<num_bigint::BigInt>().expect("JSON exponent"))
   667	        });
   668	    let fraction = mantissa.split_once('.').map_or(0, |(_, f)| f.len() as i64);
   669	    let mut digits = mantissa
   670	        .replace('.', "")
   671	        .parse::<num_bigint::BigInt>()
   672	        .expect("JSON mantissa")
   673	        .to_string();
   674	    let mut exponent = exponent - fraction;
   675	    while digits.ends_with('0') {
   676	        digits.pop();
   677	        exponent += 1;
   678	    }
   679	    if digits.is_empty() || digits == "-" {
   680	        return ("0".into(), num_bigint::BigInt::from(0));
   681	    }
   682	    (digits, exponent)
   683	}
   684	fn value_difference(actual: &Value, expected: &Value, p: &str) -> Option<Divergence> {
   685	    match (actual, expected) {
   686	        (Value::Object(a), Value::Object(e)) => {
   687	            for (key, v) in e {
   688	                let path = child(p, key);
   689	                match a.get(key) {
   690	                    Some(other) => {
   691	                        if let Some(d) = value_difference(other, v, &path) {
   692	                            return Some(d);
   693	                        }
   694	                    },
   695	                    None => return Some(Divergence::new(path, "missing field")),
   696	                }
   697	            }
   698	            a.keys()
   699	                .find(|k| !e.contains_key(*k))
   700	                .map(|k| Divergence::new(child(p, k), "extra field"))
   701	        },
   702	        (Value::Array(a), Value::Array(e)) => {
   703	            for (i, (av, ev)) in a.iter().zip(e).enumerate() {
   704	                if let Some(d) = value_difference(av, ev, &format!("{p}/{i}")) {
   705	                    return Some(d);
   706	                }
   707	            }
   708	            (a.len() != e.len()).then(|| Divergence::new(p, "array length differs"))
   709	        },
   710	        (Value::Number(a), Value::Number(e)) => (is_float_spelling(a) != is_float_spelling(e)
   711	            || decimal(a) != decimal(e))
   712	        .then(|| Divergence::new(p, format!("value differs: {a} != {e}"))),
   713	        _ => (actual != expected)
   714	            .then(|| Divergence::new(p, format!("value differs: {actual} != {expected}"))),
   715	    }
   716	}
   717	fn order_difference(actual: &Value, expected: &Value, p: &str) -> Option<Divergence> {
   718	    match (actual, expected) {
   719	        (Value::Object(a), Value::Object(e)) => {
   720	            if !a.keys().eq(e.keys()) {
   721	                return Some(Divergence::new(p, "object key order differs"));
   722	            }
   723	            a.iter()
   724	                .find_map(|(k, v)| order_difference(v, &e[k], &child(p, k)))
   725	        },
   726	        (Value::Array(a), Value::Array(e)) => a
   727	            .iter()
   728	            .zip(e)
   729	            .enumerate()
   730	            .find_map(|(i, (a, e))| order_difference(a, e, &format!("{p}/{i}"))),
   731	        _ => None,
   732	    }
   733	}
   734	pub fn compare_tree(actual: &Value, expected: &Value, p: &str) -> Result<()> {
   735	    if let Some(d) =
   736	        value_difference(actual, expected, p).or_else(|| order_difference(actual, expected, p))
   737	    {
   738	        Err(d)
   739	    } else {
   740	        Ok(())
   741	    }
   742	}
   743	
   744	fn number_spelling_difference(actual: &Value, expected: &Value, p: &str) -> Option<Divergence> {
   745	    match (actual, expected) {
   746	        (Value::Object(a), Value::Object(e)) => a
   747	            .iter()
   748	            .find_map(|(key, value)| number_spelling_difference(value, &e[key], &child(p, key))),
   749	        (Value::Array(a), Value::Array(e)) => a
   750	            .iter()
   751	            .zip(e)
   752	            .enumerate()
   753	            .find_map(|(i, (a, e))| number_spelling_difference(a, e, &format!("{p}/{i}"))),
   754	        (Value::Number(a), Value::Number(e)) => {
   755	            let actual = a.to_string();
   756	            let expected = e.to_string();
   757	            (actual != expected).then(|| Divergence::new(p, "canonical number bytes differ"))
   758	        },
   759	        _ => None,
   760	    }
   761	}
