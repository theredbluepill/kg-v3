   909	pub struct Report {
   910	    pub mode: &'static str,
   911	    pub transitions: usize,
   912	    pub canonical_json: String,
   913	    pub captured: Value,
   914	}
   915	
   916	impl Report {
   917	    pub fn to_json(&self) -> Value {
   918	        json!({"ok":true,"mode":self.mode,"transitions":self.transitions,
   919	            "canonical_json":self.canonical_json,"captured":self.captured})
   920	    }
   921	}
   922	
   923	pub fn verify_round_trip(episode_json: &str, captured: Option<&Value>) -> Result<Report> {
   924	    let episode: Value = serde_json::from_str(episode_json)
   925	        .map_err(|e| Divergence::new("", format!("JSON parse: {e}")))?;
   926	    let (header, tape) = import_kaggle_episode(&episode)?;
   927	    let snapshots = replay_from_seed(&header, &tape)?;
   928	    let replayed = export_snapshots(&header, &tape, &snapshots)?;
   929	    let canonical_json = replayed.to_string();
   930	    let own = episode["info"]["v3_native_replay"]["exporter"] == EXPORTER;
   931	    if own {
   932	        compare_tree(&replayed, &episode, "")?;
   933	        let input_canonical = episode.to_string();
   934	        if canonical_json.as_bytes() != input_canonical.as_bytes() {
   935	            return Err(number_spelling_difference(&replayed, &episode, "")
   936	                .unwrap_or_else(|| Divergence::new("", "canonical byte serialization differs")));
   937	        }
   938	    } else {
   939	        compare_tree(&semantic_view(&replayed)?, &semantic_view(&episode)?, "")?;
   940	    }
   941	    let evidence = match captured {
   942	        Some(c) => compare_captured(&snapshots, c)?,
   943	        None => json!({"initial":false,"terminal":false,"banks":0,"snapshots":0}),
   944	    };
   945	    Ok(Report {
   946	        mode: if own { "byte" } else { "semantic" },
   947	        transitions: tape.transitions.len(),
   948	        canonical_json,
   949	        captured: evidence,
   950	    })
   951	}
