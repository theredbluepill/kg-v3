   763	/// Captured evidence is a native `StepSnapshot`, whose `rewards` are typed f64:
   764	/// parse them as f64 (Kaggle's integer default 0 becomes 0.0). Every other
   765	/// field keeps strict value, number-kind and key-order comparison.
   766	fn native_snapshot_evidence(evidence: &Value, p: &str) -> Result<Value> {
   767	    let mut evidence = object(evidence, p)?.clone();
   768	    let rewards = array(
   769	        required(&Value::Object(evidence.clone()), "rewards", p)?,
   770	        &format!("{p}/rewards"),
   771	    )?
