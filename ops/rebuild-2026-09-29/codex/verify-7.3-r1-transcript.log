   383	/// Pinned kaggriculture.py:963 assigns `float(money)` only when a seat turns
   384	/// DONE; before that the framework keeps the schema reward default (integer 0).
   385	fn kaggle_reward(header: &SeedHeader, snapshot: &StepSnapshot, seat: usize) -> Result<Value> {
   386	    let reward = snapshot.rewards[seat];
   387	    match snapshot.statuses[seat].as_str() {
   388	        "DONE" => Ok(json!(reward)),
   389	        "ACTIVE" if reward == 0.0 => required(
   390	            &header.specification["reward"],
   391	            "default",
   392	            "/specification/reward",
   393	        )
   394	        .cloned(),
   395	        status => Err(Divergence::new(
   396	            "/snapshot/rewards",
   397	            format!("unexpected native reward {reward} for status {status}"),
   398	        )),
   399	    }
   400	}
