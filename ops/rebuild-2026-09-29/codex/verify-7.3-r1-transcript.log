   335	const EXPORTER: &str = "owl.kaggriculture.native-replay-v1";
   336	const PUBLIC_FIELDS: [&str; 6] = ["step", "day", "hour", "farms", "market", "town"];
   337	
   338	fn observation(header: &SeedHeader, snapshot: &StepSnapshot, seat: usize) -> Result<Value> {
   339	    let public = serde_json::to_value(&snapshot.public)
   340	        .map_err(|e| Divergence::new("/snapshot", e.to_string()))?;
   341	    let private = serde_json::to_value(&snapshot.privates[seat])
   342	        .map_err(|e| Divergence::new("/snapshot", e.to_string()))?;
   343	    let props = object(
   344	        &header.specification["observation"],
   345	        "/specification/observation",
   346	    )?;
   347	    let mut obs = Map::new();
   348	    // core.__get_state removes schema-shared defaults for non-first seats.
   349	    // _initialize/_interpreter then append their public assignments to seat 1.
   350	    for (key, schema) in props {
   351	        if seat == 1 && schema["shared"] == true {
   352	            continue;
   353	        }
   354	        let value = match key.as_str() {
   355	            "player" => json!(seat),
   356	            "private" => private.clone(),
   357	            "remainingOverageTime" => required(
   358	                schema,
   359	                "default",
   360	                "/specification/observation/remainingOverageTime",
   361	            )?
   362	            .clone(),
   363	            key if PUBLIC_FIELDS.contains(&key) => public[key].clone(),
   364	            _ => {
   365	                return Err(Divergence::new(
   366	                    format!("/specification/observation/{key}"),
   367	                    "unsupported observation field",
   368	                ))
   369	            },
   370	        };
   371	        obs.insert(key.clone(), value);
   372	    }
   373	    if seat == 1 {
   374	        // This assignment order is pinned kaggriculture.py:268-275, 952-956;
   375	        // `step` is written only on seat 0 by core.__loop_through_interpreter.
   376	        for key in ["farms", "market", "town", "day", "hour"] {
   377	            obs.insert(key.into(), public[key].clone());
   378	        }
   379	    }
   380	    Ok(Value::Object(obs))
   381	}
