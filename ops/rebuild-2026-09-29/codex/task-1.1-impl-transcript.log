p.write_text(broken)
Path('"'ops/rebuild-2026-09-29/1.1/replay-state-red.diff').write_text(''.join(difflib.unified_diff(s.splitlines(keepends=True),broken.splitlines(keepends=True),fromfile='correct-replay',tofile='deliberately-broken-initial-state')))
PY
