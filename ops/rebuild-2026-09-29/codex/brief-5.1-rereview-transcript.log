   114	fn exact_usize(value: usize, field: &str) -> Result<i64, ObserveError> {
   115	    i64::try_from(value).map_err(|_| {
   116	        ObserveError::new(
   117	            ObserveErrorKind::IntegerRange,
   118	            field,
   119	            "integer outside int64",
   120	        )
   121	    })
   122	}
