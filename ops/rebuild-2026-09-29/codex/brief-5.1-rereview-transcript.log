   218	fn global_values(public: &PublicState, config: &ObservationConfig) -> [f64; 15] {
   219	    let episode = config.episode_steps as f64;
   220	    let day_length = config.turns_per_day as f64;
   221	    let remaining = (i128::from((config.episode_steps - 1).max(1)) - public.step as i128).max(0);
   222	    [
   223	        public.step as f64 / episode,
   224	        public.hour as f64 / day_length,
   225	        public.day as f64 / (episode / day_length),
   226	        remaining as f64 / episode,
   227	        day_length / 24.0,
   228	        config.orders as f64 / 10.0,
   229	        config.shed_capacity as f64 / 1000.0,
   230	        config.farm_hand_cost_mult as f64 / 100.0,
   231	        episode / 1000.0,
   232	        config.weed_spawn_chance,
   233	        config.town_shop_unlock_interval as f64 / day_length,
   234	        config.town_shop_sell_interval as f64 / day_length,
   235	        config.town_center_sell_interval as f64 / day_length,
   236	        config.starting_money as f64 / 200000.0,
   237	        public.town.unlocked_shops.len() as f64 / 8.0,
   238	    ]
   239	}
   240	
   241	fn validate_public_context(
   242	    public: &PublicState,
   243	    config: &ObservationConfig,
   244	) -> Result<(), ObserveError> {
   245	    if public.farms.len() != 2 {
   246	        return Err(ObserveError::new(
   247	            ObserveErrorKind::State,
   248	            "public.farms",
   249	            "must contain exactly two farms",
   250	        ));
   251	    }
   252	    if public
   253	        .market
   254	        .params
   255	        .as_ref()
   256	        .is_some_and(|params| !params.is_empty())
   257	    {
   258	        return Err(ObserveError::new(
   259	            ObserveErrorKind::State,
   260	            "public.market.params",
   261	            "must be absent or empty",
   262	        ));
   263	    }
   264	    let step = exact_usize(public.step, "public.step")?;
   265	    let day = exact_usize(public.day, "public.day")?;
   266	    let hour = exact_usize(public.hour, "public.hour")?;
   267	    if day != step / config.turns_per_day {
   268	        return Err(ObserveError::new(
   269	            ObserveErrorKind::State,
   270	            "public.day",
   271	            "must equal step / turnsPerDay",
   272	        ));
   273	    }
   274	    if hour != step % config.turns_per_day {
   275	        return Err(ObserveError::new(
   276	            ObserveErrorKind::State,
   277	            "public.hour",
   278	            "must equal step % turnsPerDay",
   279	        ));
   280	    }
   281	    if public.town.unlocked_shops.len() > 8 {
   282	        return Err(ObserveError::new(
   283	            ObserveErrorKind::State,
   284	            "public.town.unlocked_shops",
   285	            "at most eight shops are representable",
   286	        ));
   287	    }
   288	    for seat in [Seat::Zero, Seat::One] {
   289	        for (role, farm_index) in [seat.index(), 1 - seat.index()].into_iter().enumerate() {
   290	            let farm = &public.farms[farm_index];
   291	            let hire_field = ["globals_int[12]", "globals_int[13]"][role];
   292	            exact_usize(farm.hires_today, hire_field).map_err(|error| error.at_seat(seat))?;
   293	            if farm.hands.len() > 240 {
   294	                return Err(ObserveError::new(
   295	                    ObserveErrorKind::State,
   296	                    ["globals_int[14]", "globals_int[15]"][role],
   297	                    "at most 241 actors per farm are representable",
   298	                )
   299	                .at_seat(seat));
   300	            }
   301	            checked_f32(
   302	                farm.money / 200000.0,
   303	                ["player_features[0,0]", "player_features[1,0]"][role],
   304	                Some(seat),
   305	            )?;
   306	            checked_f32(
   307	                (farm.hands.len() + 1) as f64 / 241.0,
   308	                ["player_features[0,1]", "player_features[1,1]"][role],
   309	                Some(seat),
   310	            )?;
