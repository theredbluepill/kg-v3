    60	impl ObservationConfig {
    61	    pub fn new(config: &Config) -> Result<Self, ObserveError> {
    62	        if config.board_size != 10 {
    63	            return Err(ObserveError::new(
    64	                ObserveErrorKind::Config,
    65	                "boardSize",
    66	                "must equal 10",
    67	            ));
    68	        }
