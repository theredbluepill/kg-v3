    18	SOURCE_VOLUME = "4llk4uaf20"
    19	DAYS = tuple(range(21, 28))
    20	SEED_BASE = 20260929
    21	TRAIN_PER_DAY = 32
    22	VALIDATION_PER_DAY = 4
    23	SAMPLING = (
    24	    "seeded32 train+4 validation episodes/day,2026-09-21..27; "
    25	    "both seats; no outcome filtering"
    26	)
    27	
