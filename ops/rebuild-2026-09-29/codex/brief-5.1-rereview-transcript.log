   149	            ("episodeSteps", episode_steps as f64 / 1000.0),
   150	            ("startingMoney", starting_money as f64 / 200000.0),
   151	            ("maxMarketOrdersPerTurn", orders as f64 / 10.0),
   152	            ("turnsPerDay", turns_per_day as f64 / 24.0),
   153	            ("shedCapacity", shed_capacity as f64 / 1000.0),
   154	            ("weedSpawnChance", weed_spawn_chance),
