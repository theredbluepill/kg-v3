   922	    let hands = raw["hands"]
   923	        .as_array()
   924	        .ok_or("hands syntax: hands must be an array")?;
   925	    let actors = plan.shape.actors();
   926	    if hands.len() != actors - 1 {
   927	        let category = if hands.len() > actors - 1 {
   928	            "extra hand commands"
   929	        } else {
   930	            "hand count"
   931	        };
   932	        return Err(format!(
   933	            "{category}: hands expected {}, got {}",
   934	            actors - 1,
   935	            hands.len()
   936	        ));
   937	    }
   938	    let market = raw["market"]
   939	        .as_array()
   940	        .ok_or("market syntax: market must be an array")?;
   941	    if market.len() > plan.shape.order_limit() {
   942	        return Err(format!(
   943	            "market queue limit: market has {}, limit {}",
   944	            market.len(),
   945	            plan.shape.order_limit()
   946	        ));
   947	    }
   948	    let mut tokens = vec![0; TOKENS_PER_SEAT];
   949	    for (actor, command) in std::iter::once(&raw["farmer"])
   950	        .chain(hands.iter())
   951	        .enumerate()
   952	    {
   953	        encode_unit(
   954	            command,
   955	            actor,
   956	            &mut tokens[actor * SLOTS..(actor + 1) * SLOTS],
   957	        )?;
   958	    }
   959	    for (index, command) in market.iter().enumerate() {
   960	        let start = (actors + index) * SLOTS;
   961	        encode_market(command, index, &mut tokens[start..start + SLOTS])?;
   962	    }
   963	    let stop = actors + market.len();
   964	    tokens[stop * SLOTS + Slot::Stop as usize] = 1;
   965	    let length = i64::try_from(stop + 1).map_err(|e| format!("encode length: {e}"))?;
   966	    validate_program(plan, &tokens, length)?;
   967	    out.copy_from_slice(&tokens);
   968	    Ok(length)
   969	}
