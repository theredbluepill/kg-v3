    34	fn integer(value: &PyInt, field: &str, positive: bool) -> Result<i64, ObserveError> {
    35	    // Pinned PyInt has Serialize, but no Display or public integer getter.
    36	    // Serialize its exact decimal only at config admission, never live state.
    37	    let decimal = serde_json::to_string(value)
    38	        .map_err(|error| ObserveError::new(ObserveErrorKind::Config, field, error.to_string()))?;
    39	    let value = decimal.parse::<i64>().map_err(|_| {
    40	        ObserveError::new(
    41	            ObserveErrorKind::IntegerRange,
    42	            field,
    43	            "integer outside int64",
    44	        )
    45	    })?;
    46	    if value < i64::from(positive) {
    47	        return Err(ObserveError::new(
    48	            ObserveErrorKind::Config,
    49	            field,
    50	            if positive {
    51	                "must be positive"
    52	            } else {
    53	                "must be nonnegative"
    54	            },
    55	        ));
    56	    }
    57	    Ok(value)
    58	}
