    78	                return Err(ObserveError::new(
    79	                    ObserveErrorKind::Config,
    80	                    name,
    81	                    "unknown configuration key",
    82	                ));
    83	            }
    84	        }
    85	        let episode_steps = integer(&config.episode_steps, "episodeSteps", true)?;
    86	        let starting_money = integer(&config.starting_money, "startingMoney", false)?;
    87	        let orders = integer(
    88	            &config.max_market_orders_per_turn,
    89	            "maxMarketOrdersPerTurn",
    90	            true,
    91	        )?;
    92	        let turns_per_day = integer(&config.turns_per_day, "turnsPerDay", true)?;
    93	        let shed_capacity = integer(&config.shed_capacity, "shedCapacity", true)?;
    94	        let town_shop_unlock_interval = integer(
    95	            &config.town_shop_unlock_interval,
    96	            "townShopUnlockInterval",
    97	            true,
    98	        )?;
    99	        let town_shop_sell_interval = integer(
   100	            &config.town_shop_sell_interval,
   101	            "townShopSellInterval",
   102	            true,
   103	        )?;
   104	        let town_center_sell_interval = integer(
   105	            &config.town_center_sell_interval,
   106	            "townCenterSellInterval",
   107	            true,
   108	        )?;
   109	        let farm_hand_cost_mult = integer(&config.farm_hand_cost_mult, "farmHandCostMult", false)?;
   110	        if orders > 10 {
   111	            return Err(ObserveError::new(
   112	                ObserveErrorKind::Config,
   113	                "maxMarketOrdersPerTurn",
   114	                "must be in 1..=10",
   115	            ));
   116	        }
   117	        if turns_per_day
   118	            .checked_mul(orders)
   119	            .is_none_or(|product| product > 240)
   120	        {
   121	            return Err(ObserveError::new(
   122	                ObserveErrorKind::Config,
   123	                "turnsPerDay * maxMarketOrdersPerTurn",
   124	                "checked product must be at most 240",
   125	            ));
   126	        }
   127	        if !config.weed_spawn_chance.is_number() {
   128	            return Err(ObserveError::new(
   129	                ObserveErrorKind::Config,
   130	                "weedSpawnChance",
   131	                "must be numeric",
   132	            ));
