    65	impl fmt::Display for ObserveError {
    66	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    67	        if let Some(env) = self.env {
    68	            write!(f, "env={env} ")?;
    69	        }
    70	        if let Some(seat) = self.seat {
    71	            write!(
    72	                f,
    73	                "seat={} ",
    74	                match seat {
    75	                    Seat::Zero => 0,
    76	                    Seat::One => 1,
    77	                }
    78	            )?;
    79	        }
    80	        write!(f, "{}: {}", self.field, self.detail)
    81	    }
    82	}
