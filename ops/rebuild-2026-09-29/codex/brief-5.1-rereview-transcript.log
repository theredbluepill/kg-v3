   123	                                    "source_archive": archive.name,
   124	                                    "source_member": member,
   125	                                    "sha256": hashlib.sha256(payload).hexdigest(),
   126	                                    "bytes": len(payload),
   127	                                }
   128	                            )
   129	                destination.writestr("selection.json", json.dumps(manifest, indent=2))
   130	        except BaseException:
