   222	        '_,
   223	        bool,
   224	    >,
   225	    #[pyo3(from_py_with = extract_array::<i64, 27>)] mut order_limits: PyReadwriteArrayDyn<'_, i64>,
   226	    #[pyo3(from_py_with = extract_array::<bool, 28>)] mut can_act: PyReadwriteArrayDyn<'_, bool>,
   227	) -> PyResult<()> {
   228	    let json: Value = serde_json::from_str(headers).map_err(|error| {
   229	        python_error(ObserveError::new(
   230	            ObserveErrorKind::State,
   231	            "headers",
   232	            error.to_string(),
   233	        ))
   234	    })?;
   235	    let Value::Array(headers) = json else {
   236	        return Err(python_error(ObserveError::new(
   237	            ObserveErrorKind::Shape,
   238	            "headers",
   239	            "expected a JSON array of full TraceHeaders",
   240	        )));
   241	    };
   242	    if headers.is_empty() {
   243	        return Err(python_error(ObserveError::new(
   244	            ObserveErrorKind::Shape,
   245	            "headers",
   312	        order_limits: array_slice::<i64, 27>(&mut order_limits).map_err(python_error)?,
   313	        can_act: array_slice::<bool, 28>(&mut can_act).map_err(python_error)?,
   314	    }
   315	    .validate(n_envs)
   316	    .map_err(python_error)?;
   317	    // Every typed borrow guard remains alive outside the detached operation.
   318	    // Scratch holds only parsing/config/snapshots, never another output array.
   319	    py.detach(move || -> Result<(), ObserveError> {
   320	        let mut prepared = Vec::new();
   321	        prepared.try_reserve_exact(n_envs).map_err(|error| {
   322	            ObserveError::new(
   323	                ObserveErrorKind::Shape,
   324	                "headers",
   325	                format!("cannot reserve preparation scratch: {error}"),
   326	            )
   327	        })?;
   328	        for (env, value) in headers.into_iter().enumerate() {
   329	            let header: TraceHeader =
   330	                serde_json::from_value(value).map_err(|error| ObserveError {
   331	                    env: Some(env),
   332	                    ..ObserveError::new(
   333	                        ObserveErrorKind::State,
   334	                        format!("headers[{env}]"),
   335	                        error.to_string(),
   336	                    )
   337	                })?;
   338	            let observation = ObservationGame::from_header(&header)
   339	                .and_then(|game| game.prepare())
   340	                .map_err(|mut error| {
   341	                    error.env = Some(env);
   342	                    error
   343	                })?;
   344	            prepared.push(observation);
   345	        }
   346	        // All rows preflighted. Only infallible writes follow the first mutation.
   347	        for (env, mut rows) in output.envs_mut().enumerate() {
   348	            write_env(&prepared[env], &mut rows);
   349	        }
   350	        Ok(())
   351	    })
   352	    .map_err(python_error)
   353	}
