    29	class SelectedEpisode(TypedDict):
    30	    member: str
    31	    split: Literal["train", "validation"]
    32	    source_archive: str
    33	    source_member: str
    34	    sha256: str
    35	    bytes: int
    36	
    37	
    38	class SelectionManifest(TypedDict):
    39	    volume: str
    40	    source_root: str
    41	    sampling: str
    42	    episodes: list[SelectedEpisode]
    43	
    44	
    45	def select_members(names: list[str], day: int) -> list[str]:
    46	    """Apply the reference sort, per-day seed and 36-episode cutoff."""
    47	    if day not in DAYS:
    48	        raise ValueError(f"Unsupported September source day: {day}")
    49	    members = sorted(name for name in names if name.endswith(".json"))
    50	    if len(set(members)) != len(members):
    51	        raise ValueError(f"Duplicate JSON ZIP member on September {day}")
    52	    count = TRAIN_PER_DAY + VALIDATION_PER_DAY
    53	    if len(members) < count:
    54	        raise ValueError(
    55	            f"September {day}: expected at least {count} episodes, got {len(members)}"
    56	        )
    57	    random.Random(SEED_BASE + day).shuffle(members)
    58	    return members[:count]
    59	
    60	
    61	def validate_episode_identity(members: list[str]) -> None:
    62	    """Reject repeated episode basenames, including across dates and splits.
    63	
    64	    Public archives name episodes by ID (for example 111677381.json). This is
    65	    the identity check previously performed by the reference prepare.py.
    66	    """
    67	    seen: set[str] = set()
    68	    for member in members:
    69	        path = PurePosixPath(member)
    70	        if path.is_absolute() or ".." in path.parts or path.suffix != ".json":
    71	            raise ValueError(f"Invalid episode member: {member!r}")
    72	        identity = path.name
    73	        if identity in seen:
    74	            raise ValueError(f"Duplicate episode identity: {identity}")
    75	        seen.add(identity)
    76	
    77	
    78	def select_replays(source_root: Path, output: Path) -> SelectionManifest:
    79	    """Export all seven days and return their payload-hashed selection manifest.
    80	
    81	    Refuse incomplete daily samples and identity leakage before writing. Existing
    82	    outputs are never replaced; a failed copy removes its incomplete output.
    83	    """
    84	    planned: list[tuple[Path, list[str], int]] = []
    85	    all_members: list[str] = []
    86	    for day in DAYS:
    87	        archive = source_root / "archives" / f"kaggriculture-episodes-2026-09-{day}.zip"
    88	        with zipfile.ZipFile(archive) as source:
    89	            members = select_members(source.namelist(), day)
    90	        planned.append((archive, members, day))
    91	        all_members.extend(members)
    92	    validate_episode_identity(all_members)
    93	
    94	    manifest: SelectionManifest = {
    95	        "volume": SOURCE_VOLUME,
    96	        "source_root": str(source_root),
    97	        "sampling": SAMPLING,
    98	        "episodes": [],
    99	    }
   100	    # Exclusive creation also prevents accidentally overwriting a source archive.
   101	    with output.open("xb") as output_file:
   102	        try:
   103	            with zipfile.ZipFile(
   104	                output_file,
   105	                "w",
   106	                compression=zipfile.ZIP_DEFLATED,
   107	                compresslevel=1,
   108	            ) as destination:
   109	                for archive, members, day in planned:
   110	                    with zipfile.ZipFile(archive) as source:
   111	                        for index, member in enumerate(members):
   112	                            payload = source.read(member)
   113	                            target = f"{day}/{member}"
   114	                            destination.writestr(target, payload)
   115	                            manifest["episodes"].append(
   116	                                {
   117	                                    "member": target,
   118	                                    "split": (
   119	                                        "validation"
