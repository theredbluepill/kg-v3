   136	def main() -> None:
   137	    parser = argparse.ArgumentParser(description=__doc__)
   138	    parser.add_argument("source_root", type=Path, help="Read-only source corpus root")
   139	    parser.add_argument("output", type=Path, help="New selected replay ZIP path")
   140	    args = parser.parse_args()
