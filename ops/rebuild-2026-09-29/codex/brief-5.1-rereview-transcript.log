   174	    def check_contract(self) -> None:
   175	        """Check contract v4; raise ``ValueError`` naming the first bad field."""
   176	        lead = self.still_playing.shape
   177	        if len(lead) != 2 or lead[1] != PLAYERS:
   178	            raise ValueError(
   179	                f"still_playing must have shape [env, {PLAYERS}], got {tuple(lead)}"
   180	            )
   181	        # Iterating the pinned schema's known field names is the sanctioned
   182	        # dynamic-access case (AGENTS.md).
   183	        for name, (dtype, trailing, low, high) in _SCHEMA.items():
   184	            tensor: torch.Tensor = getattr(self, name)
   185	            if tensor.dtype != dtype:
   186	                raise ValueError(f"{name} must be {dtype}, got {tensor.dtype}")
   187	            if tuple(tensor.shape) != (*lead, *trailing):
   188	                raise ValueError(
   189	                    f"{name} must have shape {(*lead, *trailing)}, "
   190	                    f"got {tuple(tensor.shape)}"
   191	                )
   192	            if tensor.numel() and low is not None and int(tensor.min()) < low:
   193	                raise ValueError(f"{name} values must be >= {low}")
   194	            if tensor.numel() and high is not None and int(tensor.max()) >= high:
   195	                raise ValueError(f"{name} values must be < {high}")
   196	            if dtype in (_F32, _F64) and not bool(torch.isfinite(tensor).all()):
   197	                raise ValueError(f"{name} contains non-finite values")
   198	        tile_counts = self.tiles_int[..., list(_TILE_COUNT_CHANNELS)]
   199	        if tile_counts.numel() and int(tile_counts.min()) < 0:
   200	            raise ValueError(
   201	                f"tiles_int count channels {_TILE_COUNT_CHANNELS} must be >= 0"
   202	            )
   203	        can_act = self.action_mask.can_act
   204	        if can_act.dtype != _BOOL or tuple(can_act.shape) != (*lead, MAX_FRAMES):
   205	            raise ValueError(
   206	                f"action_mask.can_act must be bool {(*lead, MAX_FRAMES)}, "
   207	                f"got {can_act.dtype} {tuple(can_act.shape)}"
   208	            )

