   157	        // The kernel recomputes day/hour. Check the imported clock before it can
   158	        // erase evidence of an inconsistent input header.
   159	        validate_public_context(&header.initial.public, &config)?;
   160	        validate_private_count(header.initial.privates.len())?;
   161	        let game = Game::from_header(header).map_err(|error| engine_error("header", error))?;
   162	        Ok(Self { game, config })
