    95	pub(super) fn checked_f32(
    96	    value: f64,
    97	    field: &str,
    98	    seat: Option<Seat>,
    99	) -> Result<f32, ObserveError> {
   100	    let narrowed = value as f32;
   101	    if !value.is_finite() || !narrowed.is_finite() {
   102	        return Err(ObserveError {
   103	            seat,
   104	            ..ObserveError::new(
   105	                ObserveErrorKind::NonFinite,
   106	                field,
   107	                "derived value must be finite in float64 and float32",
   108	            )
   109	        });
   110	    }
   111	    Ok(narrowed)
   112	}
