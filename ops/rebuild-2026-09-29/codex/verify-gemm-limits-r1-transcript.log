     1	"""Summarize generated Inductor code per case: which GEMM backend each compiled
     2	graph used (Triton template vs extern cuBLAS), and each template kernel's size-arg
     3	dtypes and 32-bit-prone index lines. Reads only the per-case cache dirs."""
     4	
     5	from __future__ import annotations
     6	
     7	import json
     8	import re
     9	import sys
    10	from pathlib import Path
    11	
    12	RUN = Path(__file__).resolve().parent
    13	SIG = re.compile(r"'signature': \{([^}]*)\}")
    14	INTERESTING = ("xindex =", "INDEX_DTYPE", "rm = ", "idx_m = ", "offs_a_m =",
    15	               "offs_k", "for k_idx", "tl.store", "tl.load(A", "tl.load(in_ptr")
    16	
    17	
    18	def main() -> None:
    19	    report: dict = {}
    20	    for case_dir in sorted((RUN / "inductor_cache").iterdir()):
    21	        templates: dict = {}
    22	        wrappers = []
    23	        for f in case_dir.rglob("*.py"):
    24	            text = f.read_text(errors="replace")
    25	            if "def call(" in text and ("extern_kernels" in text or "triton_" in text):
    26	                wrappers.append({
    27	                    "file": str(f.relative_to(RUN)),
    28	                    "extern_mm": len(re.findall(r"extern_kernels\.(?:mm|addmm|bmm)\(", text)),
    29	                    "template_launches": len(re.findall(r"triton_tem_\w+\.run\(", text)),
    30	                    "template_names": sorted(set(re.findall(r"(triton_tem_\w+)\.run\(", text))),
    31	                })
    32	            for m in re.finditer(r"def (triton_tem_\w+)\(", text):
    33	                name = m.group(1)
    34	                sig = SIG.search(text)
    35	                lines = [ln.strip() for ln in text.splitlines()
    36	                         if any(tok in ln for tok in INTERESTING)]
    37	                templates.setdefault(name, []).append({
    38	                    "file": str(f.relative_to(RUN)),
    39	                    "signature": sig.group(1) if sig else None,
    40	                    "index_lines": lines[:40],
    41	                })
    42	        report[case_dir.name] = {"wrappers": wrappers, "templates": templates}
    43	    out = RUN / "kernel_analysis.json"
    44	    out.write_text(json.dumps(report, indent=1))
    45	    for case, info in report.items():
    46	        print(f"== {case}: {len(info['wrappers'])} wrappers, "
    47	              f"{len(info['templates'])} template kernels")
    48	        for w in info["wrappers"]:
    49	            print(f"   wrapper extern_mm={w['extern_mm']} "
    50	                  f"templates={w['template_launches']} {w['template_names'][:6]}")
    51	        for name, variants in info["templates"].items():
    52	            v = variants[0]
    53	            print(f"   {name}: sig={v['signature']}")
    54	            for ln in v["index_lines"]:
    55	                if "xindex" in ln or "INDEX_DTYPE" in ln:
    56	                    print(f"      {ln}")
    57	    sys.stdout.flush()
    58	
    59	
    60	if __name__ == "__main__":
    61	    main()

