    98	def make_mask(spec: str, gen: torch.Generator) -> torch.Tensor:
    99	    kind, _, value = spec.partition(":")
   100	    if kind == "sparse":  # always-on 219 tokens + a few actors/shops per row
   101	        rows = int(value)
   102	        mask = torch.zeros((rows, TOKENS), dtype=torch.bool)
   103	        actors = torch.randint(0, 41, (rows,), generator=gen)
   104	        shops = torch.randint(0, SHOP_SLOTS + 1, (rows,), generator=gen)
   105	        slot = torch.arange(ACTOR_SLOTS)
   106	        mask[:, :ACTOR_SLOTS] = slot[None] < actors[:, None]
   107	        mask[:, ACTOR_SLOTS:ACTOR_SLOTS + TILES] = True
   108	        sh = torch.arange(SHOP_SLOTS)
   109	        mask[:, ACTOR_SLOTS + TILES:ACTOR_SLOTS + TILES + SHOP_SLOTS] = (
   110	            sh[None] < shops[:, None]
   111	        )
   112	        mask[:, ACTOR_SLOTS + TILES + SHOP_SLOTS:] = True
   113	        return mask
   114	    if kind == "dense":  # every actor slot and shop live: 709 tokens per row
   115	        return torch.ones((int(value), TOKENS), dtype=torch.bool)
   116	    if kind == "packed":  # dense rows, total valid tokens exactly value
   117	        total = int(value)
   118	        rows = -(-total // TOKENS)
   119	        mask = torch.ones((rows, TOKENS), dtype=torch.bool)
   120	        last = total - TOKENS * (rows - 1)
   121	        mask[-1, last:] = False
   122	        return mask
