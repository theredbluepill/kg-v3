    63	def reference_varlen(q, k, v, cu):
    64	    outs = []
    65	    for i in range(cu.numel() - 1):
    66	        s, e = int(cu[i]), int(cu[i + 1])
    67	        o = torch.nn.functional.scaled_dot_product_attention(
    68	            q[s:e].transpose(0, 1).float(), k[s:e].transpose(0, 1).float(),
    69	            v[s:e].transpose(0, 1).float(),
    70	        )
    71	        outs.append(o.transpose(0, 1))
    72	    return torch.cat(outs)
