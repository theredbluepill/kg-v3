all_rs_code := "src/"

[group: 'docs']
docs-lint:
	uvx pymarkdownlnt scan *.md
	uvx pymarkdownlnt scan --recurse {{all_py_code}} {{all_rs_code}} {{docs}}
[group: 'docs']
docs-fresh:
	uv run python scripts/check_doc_freshness.py

[group: 'python']
py-format:
    uvx ruff check {{all_py_code}} --select I --fix
    uvx ruff format {{all_py_code}}
[group: 'python']
py-lint:
    uv run python scripts/check_python_311_syntax.py
    uvx ruff check {{all_py_code}}
[group: 'python']
py-static:
    uv run mypy {{py_src}} {{py_scripts}}
[group: 'python']
py-test:
    uv run pytest {{py_tests}} -m "not slow"
[group: 'python']
py-test-full:
    uv run pytest {{py_tests}}
[group: 'python']
py-prepare: py-format py-lint py-static py-test docs-fresh

[group: 'rust']
rs-format:
    cargo fmt
[group: 'rust']
rs-lint:
    cargo clippy --all-targets -- -D warnings
[group: 'rust']
scripts/check_doc_freshness.py
    "D1",
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.pymarkdown]
mode.strict-config = true
plugins.MD013.enabled = false
plugins.MD029.enabled = false

[tool.mypy]
plugins = ["pydantic.mypy"]
strict_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
disallow_any_generics = true
disallow_untyped_defs = true
allow_redefinition = true

[[tool.mypy.overrides]]
module = ["owl.*"]
no_implicit_reexport = true

[[tool.mypy.overrides]]
module = [
    "flash_attn.*",
    "kaggle.*",
]
ignore_missing_imports = true

[tool.pytest.ini_options]
addopts = "-ra"
strict_markers = true
markers = [
    "slow: long-running tests excluded from the default fast test target",
]
