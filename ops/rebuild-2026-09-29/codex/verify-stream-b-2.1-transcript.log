   165	    def check_contract(self) -> None:
   166	        """Check contract v4; raise ``ValueError`` naming the first bad field."""
   167	        lead = self.still_playing.shape
   168	        if len(lead) < 1 or lead[-1] != PLAYERS:
   169	            raise ValueError(
   170	                f"still_playing must end in the seat axis ({PLAYERS}), "
   171	                f"got {tuple(lead)}"
   172	            )
   173	        # Iterating the pinned schema's known field names is the sanctioned
   174	        # dynamic-access case (AGENTS.md).
   175	        for name, (dtype, trailing, bound) in _SCHEMA.items():
   176	            tensor: torch.Tensor = getattr(self, name)
   177	            if tensor.dtype != dtype:
   178	                raise ValueError(f"{name} must be {dtype}, got {tensor.dtype}")
   179	            if tuple(tensor.shape) != (*lead, *trailing):
   180	                raise ValueError(
   181	                    f"{name} must have shape {(*lead, *trailing)}, "
   182	                    f"got {tuple(tensor.shape)}"
   183	                )
   184	            if (
   185	                bound is not None
   186	                and tensor.numel()
   187	                and (int(tensor.min()) < 0 or int(tensor.max()) >= bound)
   188	            ):
   189	                raise ValueError(f"{name} categories must lie in [0, {bound})")
   190	            if dtype in (_F32, _F64) and not bool(torch.isfinite(tensor).all()):
   191	                raise ValueError(f"{name} contains non-finite values")
   192	        can_act = self.action_mask.can_act
   193	        if can_act.dtype != _BOOL or tuple(can_act.shape) != (*lead, MAX_FRAMES):
   194	            raise ValueError(
   195	                f"action_mask.can_act must be bool {(*lead, MAX_FRAMES)}, "
   196	                f"got {can_act.dtype} {tuple(can_act.shape)}"
   197	            )
