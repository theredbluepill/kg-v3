from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
DOCS_CURRENT_ENV = "DOCS_CURRENT"

DOC_RULES: tuple[tuple[str, tuple[str, ...], tuple[str, ...]], ...] = (
    (
