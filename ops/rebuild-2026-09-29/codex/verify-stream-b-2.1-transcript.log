   292	        market_float = obs.market_float.reshape(rows, kt.PRODUCT_COUNT, -1)
   293	        market_in = torch.cat(
   294	            (
   295	                market_float,
   296	                _one_hot(
   297	                    obs.market_product.reshape(rows, -1), kt.PRODUCT_COUNT, market_float
   298	                ),
   299	            ),
   300	            dim=-1,
   301	        )
   302	        global_x = self.global_proj(obs.global_features.reshape(rows, -1)).unsqueeze(1)
   303	        dtype = global_x.dtype
   304	        players = _expand_tokens(self.player_tokens, rows, dtype=dtype) + (
   305	            self.player_feature_proj(obs.player_features.reshape(rows, kt.PLAYERS, -1))
   306	        )
   307	        x = torch.cat(
   308	            (
   309	                self.actor_proj(actor_in),
   310	                self.tile_proj(tile_in),
   311	                self.shop_proj(shop_in),
   312	                self.market_proj(market_in),
   313	                players,
   314	                global_x,
   315	                _expand_tokens(self.board_tokens, rows, dtype=dtype),
   316	                _expand_tokens(self.actor_plan_tokens, rows, dtype=dtype),
   317	                _expand_tokens(self.critic_value_tokens, rows, dtype=dtype),
   318	            ),
   319	            dim=1,
   320	        )
   321	        playing = obs.still_playing.reshape(rows, 1)
   322	        device = x.device
   323	        token_mask = torch.cat(
   324	            (
   325	                obs.actor_mask.reshape(rows, -1),
   326	                torch.ones((rows, kt.TILES), dtype=torch.bool, device=device),
   327	                obs.shop_mask.reshape(rows, -1),
   328	                torch.ones((rows, kt.PRODUCT_COUNT), dtype=torch.bool, device=device),
   329	                playing.expand(rows, kt.PLAYERS),
   330	                torch.ones(
   331	                    (rows, 1 + self.config.n_scratch_tokens),
   332	                    dtype=torch.bool,
   333	                    device=device,
   334	                ),
   335	                playing,
   336	                playing.expand(rows, kt.PLAYERS),
   337	            ),
   338	            dim=1,
   339	        )
   340	        return x, token_mask
   341	
   342	    def _run_trunk(self, x: torch.Tensor, token_mask: torch.Tensor) -> torch.Tensor:
   343	        """Isaiah's dispatch, guarded against the compiled-GEMM overflow."""
   344	        should_use_flash = use_flash_attn(x)
   345	        if (
   346	            _requires_flash_attn(x, force_flash_attn=self.config.force_flash_attn)
   347	            and not should_use_flash
   348	        ):
   349	            raise RuntimeError(
   350	                "force_flash_attn=True requires CUDA fp16/bf16 tensors "
   351	                "and the flash-attn package"
   352	            )
   353	        trunk = self._compiled_transformer_trunk or self._forward_transformer_trunk
   354	        kmax = gemm_kmax(self.config)
   355	        if should_use_flash:
   356	            packed_x, packed = pack_sequence(x, token_mask, max_seqlen=x.shape[1])
   357	            if packed_x.shape[0] * kmax >= _GEMM_ELEMENT_LIMIT:
   358	                raise ValueError(
   359	                    f"packed trunk input has {packed_x.shape[0]} rows x {kmax}, "
   360	                    f"at or above 2**31; see {_OVERFLOW_REFERENCE}"
   361	                )
   362	            return unpack_sequence(trunk(packed_x, None, packed), packed)
   363	        chunk = rows_per_chunk(tokens=x.shape[1], kmax=kmax)
   364	        if chunk <= 0:
   365	            raise ValueError(
   366	                f"a single padded row of {x.shape[1]} tokens x {kmax} reaches the "
   367	                f"2**31 GEMM limit; see {_OVERFLOW_REFERENCE}"
   368	            )
   369	        if x.shape[0] <= chunk:
   370	            return trunk(x, token_mask, None)
   371	        return torch.cat(
   372	            [
   373	                trunk(x[start : start + chunk], token_mask[start : start + chunk], None)
   374	                for start in range(0, x.shape[0], chunk)
   375	            ],
   376	            dim=0,
   377	        )
   378	
   379	    def _forward_transformer_trunk(
   380	        self,
   381	        x: torch.Tensor,
   382	        token_mask: torch.Tensor | None,
   383	        packed: PackedSequence | None,
   384	    ) -> torch.Tensor:
   385	        for block in self.blocks:
   386	            x = block(x, token_mask, packed)
   387	        return self.final_norm(x)
   388	
   389	    def compile_transformer_trunk(self, *, mode: str) -> int:
   390	        self._compiled_transformer_trunk = torch.compile(
   391	            self._forward_transformer_trunk, mode=mode, dynamic=True
   392	        )
   393	        return 1
   394	
   395	    # --- policy / value API (Tasks 2.2 and 2.3) --------------------------------
   396	
   397	    @staticmethod
   398	    def _require_stateless(hidden_state: ModelHiddenState | None) -> None:
   399	        if hidden_state is not None:
   400	            raise ValueError(
   401	                "KaggricultureTransformer is stateless; hidden_state must be None"
   402	            )
   403	
   404	    def forward(
   405	        self,
   406	        obs: kt.KaggricultureObsBatch,
   407	        *,
   408	        deterministic: bool = False,
   409	        hidden_state: ModelHiddenState | None = None,
   410	    ) -> ModelOutput[kt.KaggricultureActions]:
   411	        del obs, deterministic
   412	        self._require_stateless(hidden_state)
   413	        raise NotImplementedError("action heads arrive with Task 2.3")
   414	
   415	    def evaluate_actions(
   416	        self,
   417	        obs: kt.KaggricultureObsBatch,
   418	        actions: kt.KaggricultureActions,
   419	        *,
   420	        hidden_state: ModelHiddenState | None = None,
   421	        dones: torch.Tensor | None = None,
   422	    ) -> ModelEvaluation:
   423	        del obs, actions, dones
   424	        self._require_stateless(hidden_state)
   425	        raise NotImplementedError("action heads arrive with Task 2.3")
   426	
   427	    def compute_value(
   428	        self,
   429	        obs: kt.KaggricultureObsBatch,
   430	        *,
   431	        hidden_state: ModelHiddenState | None = None,
   432	    ) -> torch.Tensor:
   433	        del obs
   434	        self._require_stateless(hidden_state)
   435	        raise NotImplementedError("critic arrives with Task 2.2")
# Kaggriculture encoder on Isaiah's stateless_transformer_6m ladder point:
# width 256, 8 heads (head_dim 32), GELU, mlp_ratio 2.0, 4 scratch tokens.
# Depth 8 meets the owner's 6-10M parameter budget (Isaiah's 6m uses depth 6).
model_arch: kaggriculture_transformer
embed_dim: 256
depth: 8
n_heads: 8
mlp_ratio: 2.0
activation: gelu
n_scratch_tokens: 4
force_flash_attn: true
# Kaggriculture model — conformance to Isaiah's stateless transformer

Reference: `StatelessTransformerV1` and upstream `docs/model-architecture.md` at `32b3ec9`. Each row reads **same**, **game form** (with the game reason) or **deviation → task**.

| Contract point | Kaggriculture | Status |
|---|---|---|
| Stems `raw → int(D·mlp_ratio) → D` | `ObservationInputStem` per entity group | same |
| Categorical inputs | One-hot channels concatenated to stem inputs; no `nn.Embedding` | same (Orbit also feeds one-hot channels) |
| Per-role learned tokens | Separate `player_tokens[2,D]`, `board_tokens[n,D]`, `actor_plan_tokens[1,D]`, `critic_value_tokens[2,D]` | game form: only the observed seat acts, so there's 1 plan token; the players are self and opponent |
| Player summary added to player tokens | `player_tokens + player_feature_proj(player_features)` before the trunk | same |
| Global feature token | `global_proj(global_features)` | same |
| Token order `[action entities][other entities][players][global][board][plan][critic]` | own actors first, then rival actors, tiles, shops, market | same |
| Masked tokens excluded as keys and zeroed | `token_mask`; output re-masked | same |
| Trunk `TransformerBlock × depth` + `final_norm` | Isaiah's classes via a typed `StatelessTransformerV1Config` | same |
| Flash packing and compile hook | `pack_sequence` / `unpack_sequence`, `torch.compile(..., dynamic=True)` | same, plus the compiled-GEMM overflow guard |
| Named encoded fields | `KaggricultureEncoded` offsets from named counts | same |
| No hidden state | Every API rejects `hidden_state`; tested | same |
| Initialization | `_init_module`, input gain 1, residual `1/sqrt(2·depth)`, token std `D^-0.5` | same |
| Ladder | Width 256, 8 heads (head_dim 32), GELU, `mlp_ratio` 2.0; depth 8 for the owner's 6–10M budget | same ladder, deeper point |
| Critic `OutputProjectionMLP` per critic-value token, winner softmax | — | → Task 2.2 |
| Actor `3D → D` input projection over [entity, player, plan]; action heads | — | → Task 2.3 (grammar heads are game-specific) |

Encoder parameters: 5,312,768 (trunk 4,216,832). The full-model count, including heads, is checked against 6–10M in Task 2.3.
