    70	def main() -> None:
    71	    t_start = time.monotonic()
    72	    only = set(sys.argv[1:])
    73	    summary = open(RUN / "driver.jsonl", "a")
    74	
    75	    def log(rec: dict) -> None:
    76	        rec["t"] = round(time.monotonic() - t_start, 1)
    77	        summary.write(json.dumps(rec) + "\n")
    78	        summary.flush()
    79	        print(json.dumps(rec), flush=True)
    80	
    81	    for name, kind, extra, points in CASES:
    82	        if only and name not in only:
    83	            continue
    84	        out = RUN / f"{name}.jsonl"
    85	        remaining = list(points)
    86	        for attempt in range(MAX_RESTARTS + 1):
    87	            elapsed = time.monotonic() - t_start
    88	            if elapsed > BUDGET_S - RESERVE_S:
    89	                log({"case": name, "status": "skipped_budget", "remaining": remaining})
    90	                break
    91	            env = dict(os.environ)
    92	            env.update(
    93	                CUDA_VISIBLE_DEVICES="0",
    94	                PYTHONPATH=SRC,
    95	                OWL_NATIVE_MODULE_DIR="/workspace/gemm-limits-src-1ddc71d/native",
    96	                TORCHINDUCTOR_CACHE_DIR=str(RUN / "inductor_cache" / name),
    97	                TORCH_LOGS="recompiles" if kind == "trunk" else "recompiles,guards",
    98	                PYTHONUNBUFFERED="1",
    99	            )
   100	            if kind == "trunk":
   101	                cmd = [PY, str(RUN / "probe_trunk.py"), *extra,
   102	                       "--points", ";".join(remaining), "--out", str(out)]
   103	            else:
   104	                cmd = [PY, str(RUN / "probe_linear.py"), *extra,
   105	                       "--ms", ",".join(remaining), "--out", str(out)]
   106	            n_before = len(read_events(out))
   107	            log({"case": name, "attempt": attempt, "cmd": cmd, "status": "launch"})
   108	            with open(RUN / f"{name}.attempt{attempt}.log", "w") as err:
   109	                try:
   110	                    proc = subprocess.run(cmd, env=env, stdout=err, stderr=err,
   111	                                          timeout=max(60, BUDGET_S - elapsed))
   112	                    rc = proc.returncode
   113	                except subprocess.TimeoutExpired:
   114	                    rc = "timeout"
   115	            events = read_events(out)[n_before:]
   116	            done = [e for e in events if e.get("event") == "result"
   117	                    and e.get("label") == "target"]
   118	            starts = [e for e in events if e.get("event") == "start"]
   119	            results = [e for e in events if e.get("event") == "result"]
   120	            log({"case": name, "attempt": attempt, "rc": rc,
   121	                 "targets_done": len(done), "status": "exit"})
   122	            if rc == 0:
   123	                break
   124	            if len(starts) > len(results):
   125	                crashed = starts[-1]
   126	                tail = (RUN / f"{name}.attempt{attempt}.log").read_text()[-3000:]
   127	                fault = {"event": "fault", "case": name, "label": crashed["label"],
   128	                         "rc": rc, "at": {k: v for k, v in crashed.items()
   129	                                          if k not in ("event",)},
   130	                         "stderr_tail": tail}
   131	                with open(out, "a") as fh:
   132	                    fh.write(json.dumps(fault) + "\n")
   133	                log({"case": name, "status": "fault", "at": fault["at"]})
   134	                if crashed["label"] == "warm":
   135	                    break
   136	                key = crashed.get("spec", str(crashed.get("M")))
   137	                idx = remaining.index(key)
   138	                remaining = remaining[idx + 1:]
   139	            else:
   140	                break
   141	            if not remaining:
   142	                break
   143	    log({"status": "driver_done", "elapsed_s": round(time.monotonic() - t_start, 1)})
   144	
   145	
   146	if __name__ == "__main__":
   147	    main()

