     1	"""Summarize generated Inductor code per case: which GEMM backend each compiled
     2	graph used (Triton template vs extern cuBLAS), and each template kernel's size-arg
     3	dtypes and 32-bit-prone index lines. Reads only the per-case cache dirs.
     4	
     5	Revision 2 (after Codex verify-gemm-limits-r1 finding 4). Revision 1 took the
     6	first ``'signature'`` in the whole file for every template (usually a pointwise
     7	kernel's ``xnumel: i32``), printed only the first variant of each template name,
     8	and its extern regex missed ``extern_kernels.bias_addmm``. This revision:
     9	
    10	- attributes to each ``def triton_*`` the ``triton_meta`` signature that sits in
    11	  the same kernel source block (between the previous kernel's ``def`` and this
    12	  one), and its index lines only from that kernel's body;
    13	- keeps every distinct variant (name, signature, index lines) with the files it
    14	  appears in;
    15	- counts every ``extern_kernels.<op>(`` call whose op name contains ``mm``.
    16	
    17	Pure text parsing; no torch/triton import.
    18	
    19	Usage: ``python analyze_kernels.py [RUN_DIR]``. RUN_DIR holds ``inductor_cache/``; it
    20	defaults to this file's directory, as laid out on the pod. The local rerun used
    21	``python3 probe/analyze_kernels.py pod-run > pod-run/kernel_analysis.txt``.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import json
    27	import re
    28	import sys
    29	from pathlib import Path
    30	
    31	RUN = Path(__file__).resolve().parent
    32	SIG = re.compile(r"'signature': \{([^}]*)\}")
    33	KERNEL_DEF = re.compile(r"^def (triton_\w+)\(", re.MULTILINE)
    34	EXTERN_MM = re.compile(r"extern_kernels\.(\w*mm\w*)\(")
    35	TEMPLATE_RUN = re.compile(r"(triton_tem_\w+)\.run\(([^\n]*)\)")
    36	INDEX_TOKENS = ("xindex =", "INDEX_DTYPE", "rm = ", "rn = ", "idx_m = ", "idx_n = ",
    37	                "tl.load(A", "tl.load(B", "tl.store(", "pid_m = ", "group_size",
    38	                ".to(tl.int64)")
    39	
    40	
    41	def kernel_blocks(text: str) -> list[tuple[str, str, str]]:
    42	    """Return (name, signature, body) for every Triton kernel defined in ``text``.
    43	
    44	    The signature is the last ``'signature': {...}`` between the previous kernel
    45	    definition and this ``def``; the body runs to the next ``'''`` (end of the
    46	    embedded source in a wrapper) or the next kernel ``def``.
    47	    """
    48	    defs = list(KERNEL_DEF.finditer(text))
    49	    out = []
    50	    for i, m in enumerate(defs):
    51	        start_hdr = defs[i - 1].end() if i else 0
    52	        sigs = list(SIG.finditer(text, start_hdr, m.start()))
    53	        sig = sigs[-1].group(1) if sigs else None
    54	        end = defs[i + 1].start() if i + 1 < len(defs) else len(text)
    55	        close = text.find("'''", m.end(), end)
    56	        body = text[m.start(): close if close != -1 else end]
    57	        out.append((m.group(1), sig, body))
    58	    return out
    59	
    60	
    61	def template_meta(sig: str | None, body: str) -> dict:
    62	    """Size-arg dtype, INDEX_DTYPE, and the A-load / output row strides of a template."""
    63	    ks0 = re.search(r"'ks0': '(\w+)'", sig or "")
    64	    idx = re.search(r"INDEX_DTYPE : tl.constexpr = tl\.(\w+)", body)
    65	    strides = re.findall(r"xindex = idx_n \+ (\d+)\*idx_m", body)
    66	    return {"ks0": ks0.group(1) if ks0 else "none (static M)",
    67	            "index_dtype": idx.group(1) if idx else None,
    68	            "a_row_stride": int(strides[0]) if strides else None,
    69	            "out_row_stride": int(strides[-1]) if strides else None}
    70	
    71	
    72	def main() -> None:
    73	    report: dict = {}
    74	    for case_dir in sorted((RUN / "inductor_cache").iterdir()):
    75	        wrappers = []
    76	        variants: dict[tuple, dict] = {}
    77	        for f in sorted(case_dir.rglob("*.py")):
    78	            rel = str(f.relative_to(RUN))
    79	            text = f.read_text(errors="replace")
    80	            blocks = kernel_blocks(text)
    81	            is_wrapper = "def call(" in text
    82	            local_sig: dict = {}
    83	            local_meta: dict = {}
    84	            for name, sig, body in blocks:
