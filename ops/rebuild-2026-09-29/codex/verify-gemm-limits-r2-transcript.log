    92	
    93	def _compile_transformer_mlp_modules(
    94	    model: BaseModelAPI,
    95	    *,
    96	    mode: ModelCompileMode,
    97	) -> int:
    98	    compiled = 0
    99	    for name, module in model.named_modules():
   100	        if not _is_transformer_mlp_module_name(name):
   101	            continue
   102	        module.compile(mode=mode, dynamic=True)
   103	        compiled += 1
   104	    if compiled == 0:
   105	        raise RuntimeError(
   106	            "rl.model_compile='mlp' found no transformer MLP modules to compile"
   107	        )
   108	    return compiled
