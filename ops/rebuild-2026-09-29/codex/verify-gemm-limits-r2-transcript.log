     1	"""Run every probe case in fresh subprocesses on GPU 0 within a wall budget.
     2	
     3	A CUDA illegal memory access poisons the process's context, so each case runs
     4	in its own process; when a process dies mid-point the driver records a fault
     5	for that point and resumes the remaining points in a new process (the
     6	per-case Inductor cache keeps the restart warm). No case starts after
     7	BUDGET_S - RESERVE_S; every process is killed at the budget.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import json
    13	import os
    14	import subprocess
    15	import sys
    16	import time
    17	from pathlib import Path
    18	
    19	RUN = Path(__file__).resolve().parent
    20	PY = "/workspace/kg-v3/.venv/bin/python"
    21	SRC = "/workspace/gemm-limits-src-1ddc71d/python"
    22	BUDGET_S = 45 * 60
    23	RESERVE_S = 4 * 60
    24	MAX_RESTARTS = 3
    25	
    26	L512 = 2**31 // 512
    27	L256 = 2**31 // 256
    28	L4096 = 2**31 // 4096
    29	L768 = 2**31 // 768
    30	
    31	
    32	def pts(limit: int) -> list[str]:
    33	    return [str(limit - 4096), str(limit), str(limit + 1), str(limit + 4096),
    34	            str(2 * limit)]
    35	
    36	
    37	CASES: list[tuple[str, str, list[str], list[str]]] = [
    38	    ("trunk_packed", "trunk",
    39	     ["--path", "packed"],
    40	     ["sparse:256", "dense:256", "dense:5914", "dense:5915", "packed:4194303",
    41	      "packed:4194304", "dense:5916", "dense:11830"]),
    42	    ("mlp_256_512_256", "lin", ["--case", "mlp:256:512:256"], pts(L512)),
    43	    ("lin_256_512", "lin", ["--case", "lin:256:512"], pts(L512)),
    44	    ("lin_512_256", "lin", ["--case", "lin:512:256"], pts(L512)),
    45	    ("trunk_packed_bypass", "trunk",
    46	     ["--path", "packed", "--bypass-guard"],
    47	     ["packed:4194305", "packed:4198400", "dense:5916", "dense:11830",
    48	      "dense:11832"]),
    49	    ("trunk_padded", "trunk",
    50	     ["--path", "padded"],
    51	     ["sparse:256", "dense:256", "dense:5914", "dense:5915", "dense:5916",
    52	      "dense:11830"]),
    53	    ("trunk_padded_bypass", "trunk",
    54	     ["--path", "padded", "--bypass-guard"], ["dense:5916", "dense:11830"]),
    55	    ("lin_16_4096", "lin", ["--case", "lin:16:4096"], pts(L4096)),
    56	    ("lin_4096_16", "lin", ["--case", "lin:4096:16"], pts(L4096)),
    57	    ("lin_256_256", "lin", ["--case", "lin:256:256"], pts(L256)),
    58	    ("lin_768_256", "lin", ["--case", "lin:768:256"], pts(L768)),
    59	    ("mlpbwd_256_512_256", "lin", ["--case", "mlpbwd:256:512:256"],
    60	     [str(L512 - 4096), str(L512 + 1), str(2 * L512)]),
    61	]
