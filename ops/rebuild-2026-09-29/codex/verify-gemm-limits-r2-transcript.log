    70	def configure_model_compile(model: BaseModelAPI, cfg: ModelCompileConfig) -> int:
    71	    match cfg.model_compile:
    72	        case "none":
    73	            return 0
    74	        case "mlp":
    75	            return _compile_transformer_mlp_modules(
    76	                model,
    77	                mode=cfg.model_compile_mode,
    78	            )
    79	        case "trunk":
    80	            if isinstance(model, RecurrentTransformerV1):
    81	                raise RuntimeError(
    82	                    "rl.model_compile='trunk' does not support recurrent_transformer_v1"
    83	                )
    84	            if not isinstance(model, StatelessTransformerV1):
    85	                raise RuntimeError(
    86	                    "rl.model_compile='trunk' requires stateless_transformer_v1"
    87	                )
    88	            return model.compile_transformer_trunk(mode=cfg.model_compile_mode)
    89	        case _:
    90	            assert_never(cfg.model_compile)
