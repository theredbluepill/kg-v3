    35	def configure_torch() -> None:
    36	    # PyTorch 2.9 Inductor still reads the legacy matmul allow_tf32 flag during
    37	    # lowering. Mixing the new fp32_precision setters with that read raises at
    38	    # compile time, so keep this on one API family until Inductor moves over.
    39	    with warnings.catch_warnings():
    40	        warnings.filterwarnings(
    41	            "ignore",
    42	            message="Please use the new API settings to control TF32 behavior.*",
    43	            category=UserWarning,
    44	        )
    45	        torch.backends.cuda.matmul.allow_tf32 = True
    46	        torch.backends.cudnn.allow_tf32 = True
    47	    torch.backends.cudnn.benchmark = True
    48	    # DDPOptimizer splits a torch.compile'd module under DDP into one subgraph per
    49	    # ~25MB gradient bucket. For the 1B trunk that is ~150 subgraphs, and a bucket
    50	    # boundary that falls mid-block trips an AOTAutograd functionalization bug
    51	    # ("tensor does not have a device") that desyncs ranks on the next collective.
    52	    # Compiling the trunk as a single graph avoids the split bug; we give up some
    53	    # comm/compute overlap but gradients are identical to the split path.
    54	    torch._dynamo.config.optimize_ddp = False
    55	
    56	
    57	def autocast_context(
    58	    cfg: DTypeConfig,
    59	    device: torch.device,
    60	) -> AbstractContextManager[None]:
    61	    match cfg.dtype:
    62	        case "bfloat16":
    63	            return torch.autocast(device_type=device.type, dtype=torch.bfloat16)
    64	        case "float32":
    65	            return nullcontext()
    66	        case _:
    67	            assert_never(cfg.dtype)
