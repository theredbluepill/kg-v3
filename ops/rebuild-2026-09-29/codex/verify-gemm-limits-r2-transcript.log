    86	                local_meta[name] = template_meta(sig, body)
    87	                if not name.startswith("triton_tem_"):
    88	                    continue
    89	                lines = tuple(ln.strip() for ln in body.splitlines()
    90	                              if any(tok in ln for tok in INDEX_TOKENS))
    91	                key = (name, sig, lines)
    92	                v = variants.setdefault(key, {"name": name, "signature": sig,
    93	                                              "index_lines": list(lines), "files": []})
    94	                v["files"].append(rel + (" (wrapper)" if is_wrapper else " (kernel)"))
    95	            if is_wrapper:
    96	                launches = [{"template": n, "signature": local_sig.get(n), "args": a,
    97	                             **local_meta.get(n, {})}
    98	                            for n, a in TEMPLATE_RUN.findall(text)]
    99	                wrappers.append({
   100	                    "file": rel,
   101	                    "extern_gemm": sorted(EXTERN_MM.findall(text)),
   102	                    "template_launches": launches,
   103	                })
   104	        report[case_dir.name] = {"wrappers": wrappers, "template_variants": list(variants.values())}
   105	    out = RUN / "kernel_analysis.json"
   106	    out.write_text(json.dumps(report, indent=1) + "\n")
   107	    for case, info in report.items():
   108	        print(f"== {case}: {len(info['wrappers'])} wrappers, "
   109	              f"{len(info['template_variants'])} distinct template variants")
   110	        for w in info["wrappers"]:
   111	            print(f"   wrapper {w['file']}")
   112	            print(f"      extern GEMM calls: {w['extern_gemm'] or 'none'}")
   113	            counts: dict[tuple, int] = {}
   114	            for t in w["template_launches"]:
   115	                key = (t["template"], t.get("ks0"), t.get("index_dtype"),
   116	                       t.get("a_row_stride"), t.get("out_row_stride"))
   117	                counts[key] = counts.get(key, 0) + 1
   118	            for (name, ks0, idt, a_st, o_st), n in counts.items():
   119	                print(f"      template x{n} {name}: ks0={ks0} INDEX_DTYPE={idt} "
   120	                      f"A-load {a_st}*idx_m, store {o_st}*idx_m")
   121	        for v in info["template_variants"]:
   122	            print(f"   variant {v['name']} sig={{{v['signature']}}}  [{len(v['files'])} file(s)]")
   123	            for ln in v["index_lines"]:
   124	                if any(tok in ln for tok in ("xindex =", "INDEX_DTYPE", "tl.load(A", "tl.load(B")):
   125	                    print(f"      {ln}")
   126	    sys.stdout.flush()
   127	
   128	
   129	if __name__ == "__main__":
   130	    if len(sys.argv) > 1:
