+    ):
+        if value % world_size != 0:
+            raise ValueError(
+                f"scaling_6m {name}={value} is not divisible by world size {world_size}"
+            )
+    n_envs = scaling.env.n_envs // world_size
+    spm = rl.segments_per_minibatch // world_size
