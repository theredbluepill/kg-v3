[package]
name = "kaggriculture-engine"
version = "0.1.0"
edition = "2024"
description = "Replay-verified Rust parity kernel for Kaggriculture"
license = "Apache-2.0"

# Compatibility target for the transition kernel, distinct from this crate's version.
[package.metadata.kaggriculture]
kaggle-environments-version = "1.32.7"
python-engine-sha256 = "bc8a54879ef02c7ea64b8b333d6a976f0ea65c4949149d01f463f23bccee653e"

[lib]
name = "kaggriculture_engine"
path = "src/lib.rs"
crate-type = ["rlib", "cdylib"]

[[bin]]
name = "re_engine"
path = "src/main.rs"

[dependencies]
indexmap = { version = "2.11", features = ["serde"] }
num-bigint = "0.4"
num-rational = "0.4"
num-traits = "0.2"
rayon = "1.12.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0", features = ["arbitrary_precision", "preserve_order"] }
