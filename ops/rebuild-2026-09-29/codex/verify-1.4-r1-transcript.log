// Only Send work/results cross the GIL boundary; Python guards stay in callers.
fn native_work<T: Send, F: FnOnce() -> T + Send>(py: Python<'_>, work: F) -> T {
    py.detach(|| {
        #[cfg(test)]
        detached_test::await_python_progress();
        work()
    })
}

