[package]
name = "owl"
version = "0.1.0"
edition = "2021"

[lib]
name = "rs"
# "cdylib" is necessary to produce a shared library for Python to import from.
crate-type = ["cdylib"]

[features]
extension-module = ["pyo3/extension-module"]

[dependencies]
kaggriculture-engine = { version = "0.1.0", path = "engine_rs" }
num-bigint = "0.4"
num-traits = "0.2"
