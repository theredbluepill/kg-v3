fn python_error(error: EnvError) -> PyErr {
    match error {
        EnvError::Value(message) => PyValueError::new_err(message),
        EnvError::Overflow(message) => PyOverflowError::new_err(message),
        EnvError::Panic(message) => PyRuntimeError::new_err(message),
    }
}

