            drought=1,
            ineffective=1,
            hires=1,
            animal_placements=1,
            sell_units=2,
            sell_cash=2,
        )
        for _ in range(16)
    ]
    manifest = recorder.make_manifest(arrays, coverage, recorder.source_identity())
    return manifest, arrays


