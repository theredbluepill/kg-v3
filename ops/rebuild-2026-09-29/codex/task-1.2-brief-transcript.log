   433	def encode_action(
   434	    action: Mapping[str, Any],
   435	    legal_input: Mapping[str, Any] | None = None,
   436	    *,
   437	    hire_limit: int = LEGACY_HIRE_LIMIT,
   438	) -> dict[str, Any]:
   439	    _require(
   440	        isinstance(action, Mapping)
   441	        and all(type(k) is str and k in _FIELDS for k in action),
   442	        "unsupported action mapping",
   443	    )
   444	    hands = action.get("hands", [])
   445	    markets = action.get("market", [])
   446	    _require(
   447	        isinstance(hands, list) and isinstance(markets, list),
   448	        "hands and market must be lists",
   449	    )
   450	    layout = {"keys": list(action), "hands_count": len(hands)}
   451	    _, limit = _layout(layout, legal_input)
   452	    _require(len(markets) <= limit, "market queue exceeds configured limit")
   453	    frames = []
   454	    if "farmer" in action:
   455	        frames.append(_unit_frame(action["farmer"], 0))
   456	    frames.extend(
   457	        _unit_frame(command, actor + 1) for actor, command in enumerate(hands)
   458	    )
   459	    frames.extend(_market_frame(command) for command in markets)
   460	    final = _token()
   461	    final["stop"] = 1
   462	    frames.append(final)
   463	    for index, frame in enumerate(frames):
   464	        frame_masks(
   465	            legal_input, frames[:index], frame, layout=layout, hire_limit=hire_limit
   466	        )
   467	    return {"schema": SCHEMA, "layout": layout, "frames": frames}
