   700	// The serial and parallel routes call the same per-game arithmetic in the same order.
   701	#[allow(clippy::too_many_arguments)]
   702	pub(crate) fn encode_myolie_game(
   703	    game: &Game,
   704	    index: usize,
   705	    width: usize,
   706	    version: u32,
   707	    features: &mut [f32],
   708	    context: &mut [i64],
   709	    banks: &mut [f64],
   710	    done: &mut u8,
   711	) -> Result<(), String> {
   712	    let limit = game.config.max_market_orders_per_turn.capped_usize();
   713	    if !(1..=10).contains(&limit) || game.farms.len() != 2 {
   714	        return Err("Myolie arrays require two seats and at most 10 market orders".to_string());
   715	    }
   716	    context[0] = i64::try_from(game.step).map_err(|_| "Myolie step exceeds int64")?;
   717	    context[3] = limit as i64;
   718	    for seat in 0..2 {
   719	        let actors = 1 + game.farms[seat].hands.len();
   720	        if actors > MYOLIE_MAX_ACTORS {
   721	            return Err(format!(
   722	                "Myolie arrays represent at most {MYOLIE_MAX_ACTORS} actors"
   723	            ));
   724	        }
   725	        context[1 + seat] = actors as i64;
   726	        banks[seat] = game.farms[seat].money;
   727	        if !banks[seat].is_finite() {
   728	            return Err(format!("game {index}, seat {seat}: nonfinite Myolie bank"));
   729	        }
   730	        let start = seat * width;
   731	        let encode = if version == 1 {
   732	            myolie_features::encode
   733	        } else {
   734	            myolie_features::encode_invest
   735	        };
   736	        encode(game, seat, &mut features[start..start + width])
   737	            .map_err(|error| format!("game {index}, seat {seat}: {error}"))?;
   738	        if let Some(feature) = features[start..start + width]
   739	            .iter()
   740	            .position(|value| !value.is_finite())
   741	        {
   742	            return Err(format!(
   743	                "game {index}, seat {seat}: nonfinite Myolie feature {feature}"
   744	            ));
   745	        }
   746	    }
   747	    *done = u8::from(game.done);
   748	    Ok(())
   749	}
