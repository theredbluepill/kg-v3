   303	class _SamplingGrammar:
   367	def _quantity(value):
   368	    _require(
   369	        type(value) is int and 0 <= value <= MAX_QUANTITY,
   370	        "quantity must be an integer in 0..1023",
   371	    )
   372	    return divmod(value, QUANTITY_BASE)
