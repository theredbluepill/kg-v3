   472	/// Validate and decode a complete canonical frame program into JSON action.
   473	/// frames_len counts i16 tokens, not frames/bytes; every frame has 12 tokens.
   474	/// The caller retains readable aligned storage for the duration of this call.
   475	/// Checkpoint HIRE support is validated in addition to the syntax/shape grammar.
   476	#[unsafe(no_mangle)]
   477	pub unsafe extern "C" fn re_myolie_sampler_decode(
   478	    actors: u32,
   479	    limit: u32,
   480	    hire_limit: u32,
   481	    frames: *const i16,
   482	    frames_len: usize,
   483	) -> ReBuffer {
   484	    ffi_result(ReBuffer::empty(), || {
   485	        crate::myolie_sampler::validate_decode_length(actors, limit, hire_limit, frames_len)?;
