   268	/// Compute all reachable masks/transitions. Node numbers are deterministic BFS
   269	/// discovery order, and each vocabulary is enumerated in ascending token order.
   270	pub fn plan(actors: u32, limit: u32, hire_limit: u32) -> Result<Vec<u8>, String> {
   271	    let shape = Shape::new(actors, limit, hire_limit)?;
   272	    let start = State::default();
   273	    let mut states = vec![start];
   274	    let mut interned = HashMap::from([(start, 0_i32)]);
   275	    let mut rows = Vec::<[u32; 4]>::new();
   276	    let mut masks = Vec::<u8>::new();
   277	    let mut next = Vec::<i32>::new();
   278	    let mut index = 0;
   279	    while index < states.len() {
   280	        let state = states[index];
   281	        let width = WIDTHS[usize::from(state.slot)];
   282	        rows.push([
   283	            u32::from(state.slot),
   284	            u32::from(state.hires),
   285	            masks.len() as u32,
   286	            width as u32,
   287	        ]);
   288	        for token in 0..width {
   289	            let allowed = state.allows(token, shape);
   290	            masks.push(u8::from(allowed));
   291	            next.push(if !allowed {
   292	                -2
   293	            } else if let Some(successor) = state.advance(token) {
   294	                if let Some(&number) = interned.get(&successor) {
   295	                    number
   296	                } else {
   297	                    let number = states.len() as i32;
   298	                    interned.insert(successor, number);
   299	                    states.push(successor);
   300	                    number
   301	                }
   302	            } else {
   303	                -1
   304	            });
   305	        }
   306	        index += 1;
   307	    }
   308	    // At most 24 states per unit and 32 per (orders, hires) pair. There are
   309	    // (10+1)*(10+2)/2 = 66 such pairs. This also bounds all integer conversions.
   310	    debug_assert!(states.len() <= MAX_ACTORS as usize * 24 + 66 * 32);
   311	    let mut bytes = Vec::with_capacity(20 + rows.len() * 16 + masks.len() * 5);
   312	    for value in [MAGIC, ABI, rows.len() as u32, 0, masks.len() as u32] {
   313	        bytes.extend_from_slice(&value.to_le_bytes());
   314	    }
   315	    for row in rows {
   316	        for value in row {
   317	            bytes.extend_from_slice(&value.to_le_bytes());
   318	        }
   319	    }
   320	    bytes.extend_from_slice(&masks);
   321	    for value in next {
   322	        bytes.extend_from_slice(&value.to_le_bytes());
   323	    }
   324	    Ok(bytes)
   325	}
