   411	    #[test]
   412	    fn exact_quantities_empty_and_canonical_fields() {
   413	        let mut buy = [0; SLOTS];
   414	        buy[7] = 3;
   415	        buy[8] = 1;
   416	        let mut empty = [0; SLOTS];
   417	        empty[7] = 7;
   418	        for quantity in [None, Some(1), Some(32), Some(1023)] {
   419	            let program = flatten(&[frame(6, 12, quantity), buy, empty, stop()]);
   420	            let mut unit = vec![json!("PICKUP"), json!("SHEEP")];
   421	            if let Some(quantity) = quantity {
   422	                unit.push(json!(quantity));
   423	            }
   424	            assert_eq!(
   425	                decode(1, 2, 16, &program).unwrap(),
   426	                json!({"farmer": unit, "hands": [], "market": [["BUY_SEED", "WHEAT", 0], []]})
   427	            );
   428	        }
