    76	
    77	impl PlayerMap {
    78	    pub(super) fn identity() -> Self {
    79	        Self::from_outer_slots(OUTER_PLAYER_SLOTS, [0, 1, 2, 3])
    80	    }
    81	
    82	    pub(super) fn random(player_count: usize) -> Self {
    83	        assert!(
    84	            player_count == 2 || player_count == MAX_PLAYERS,
    85	            "Orbit Wars supports exactly 2 or 4 players"
    86	        );
    87	
    88	        let mut slots = [0, 1, 2, 3];
    89	        let mut rng = rand::rng();
    90	        for index in (1..OUTER_PLAYER_SLOTS).rev() {
    91	            let swap_index = rng.random_range(0..=index);
    92	            slots.swap(index, swap_index);
    93	        }
    94	
    95	        Self::from_outer_slots(player_count, slots)
    96	    }
    97	
    98	    pub(super) fn internal_to_outer(&self, player: usize) -> usize {
    99	        self.internal_to_outer[player]
   100	    }
   101	
   102	    pub(super) fn outer_to_internal(&self, player: usize) -> Option<usize> {
   103	        self.outer_to_internal[player]
   104	    }
   105	
   106	    pub(super) fn owner_channel(&self, owner: i32) -> usize {
   107	        if owner == -1 {
   108	            return OWNER_CHANNELS_WITH_NEUTRAL - 1;
   109	        }
   110	        self.internal_to_outer(owner as usize)
   111	    }
   112	
   113	    pub(super) fn from_outer_slots(
   114	        player_count: usize,
   115	        slots: [usize; OUTER_PLAYER_SLOTS],
   116	    ) -> Self {
   117	        assert!(
   118	            player_count == 2 || player_count == MAX_PLAYERS,
   119	            "Orbit Wars supports exactly 2 or 4 players"
   120	        );
   121	
   122	        let mut internal_to_outer = [0; OUTER_PLAYER_SLOTS];
   123	        let mut outer_to_internal = [None; OUTER_PLAYER_SLOTS];
   124	        for internal in 0..OUTER_PLAYER_SLOTS {
   125	            let outer = slots[internal];
   126	            internal_to_outer[internal] = outer;
   127	            if internal < player_count {
   128	                outer_to_internal[outer] = Some(internal);
   129	            }
   130	        }
   131	
   132	        Self {
   133	            internal_to_outer,
   134	            outer_to_internal,
   135	        }
   136	    }
   137	}
