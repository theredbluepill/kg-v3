    81	        if !(1..=MAX_ACTORS).contains(&hire_limit) {
    82	            return Err("Myolie sampler hire limit must be in 1..241".into());
    83	        }
    84	        Ok(Self {
    85	            actors: actors as u16,
    86	            orders: orders as u8,
    87	            hire_limit: hire_limit as u16,
    88	        })
    89	    }
    90	
    91	    fn validate_length(self, tokens: usize) -> Result<(), String> {
    92	        let frames = tokens / SLOTS;
    93	        if !tokens.is_multiple_of(SLOTS)
    94	            || frames < usize::from(self.actors) + 1
    95	            || frames > usize::from(self.actors) + usize::from(self.orders) + 1
    96	        {
    97	            return Err(format!("invalid Myolie sampler token length {tokens}"));
    98	        }
    99	        Ok(())
   100	    }
   101	}
