   257	def _allowed_for_slot(slot, actor, ready, can_market, can_hire, unit, market, prefix):
   258	    """Syntax choices for an already checked shape/prefix; no neural or RNG work."""
   259	    if slot == "unit_actor":
   260	        allowed = (actor,)
   261	    elif slot == "unit_kind":
   262	        allowed = (0,) if ready else tuple(range(1, 19))
   263	    elif slot == "unit_target":
   264	        allowed = (0,)
   265	    elif slot == "unit_item":
   266	        allowed = _indices(unit)
   267	    elif slot == "unit_quantity_present":
   268	        allowed = (0, 1) if unit in _TRANSFERS else (0,)
   269	    elif slot in {"unit_quantity_high", "unit_quantity"}:
   270	        allowed = (
   271	            tuple(range(32))
   272	            if unit in _TRANSFERS and prefix.get("unit_quantity_present")
   273	            else (0,)
   274	        )
   275	        # The official interpreter permits unit quantity zero, but the frozen
   276	        # evaluator's unit validator rejects it. The saved corpus has no such
   277	        # targets. Keep market zero/empty slots exact; restrict only emission
   278	        # of explicit transfer quantities at this declared support boundary.
   279	        if (
   280	            slot == "unit_quantity"
   281	            and unit in _TRANSFERS
   282	            and prefix.get("unit_quantity_present")
   283	            and prefix.get("unit_quantity_high") == 0
   284	        ):
   285	            allowed = tuple(range(1, 32))
   286	    elif slot == "market_kind":
   287	        allowed = tuple(range(8)) if ready and unit == "NONE" and can_market else (0,)
   288	        # Checkpoint-owned policy support is separate from actor representation.
   289	        # Migrated models retain the historical 16-actor HIRE mask. Explicit
   290	        # activation can widen it; failed HIRE requests still consume capacity.
   291	        if not can_hire:
   292	            allowed = tuple(index for index in allowed if index != 1)
   293	    elif slot == "market_item":
   294	        allowed = _indices(market, market=True)
   295	    elif slot in {"market_quantity_high", "market_quantity"}:
   296	        allowed = tuple(range(32)) if market in _QUANTITY_ORDERS else (0,)
   297	    else:
   298	        # Always append a distinct sentinel, including after a full queue.
   299	        allowed = (int(ready and unit == "NONE" and market == "NONE"),)
   300	    return allowed
