   389	    fn frame(kind: i16, item: i16, quantity: Option<i16>) -> [i16; SLOTS] {
   390	        let mut frame = [0; SLOTS];
   391	        frame[1] = kind;
   392	        frame[3] = item;
   393	        if let Some(quantity) = quantity {
   394	            frame[4] = 1;
   395	            frame[5] = quantity / 32;
   396	            frame[6] = quantity % 32;
   397	        }
   398	        frame
   399	    }
   400	
   401	    fn stop() -> [i16; SLOTS] {
   402	        let mut frame = [0; SLOTS];
   403	        frame[11] = 1;
   404	        frame
   405	    }
   406	
   407	    fn flatten(frames: &[[i16; SLOTS]]) -> Vec<i16> {
   408	        frames.iter().flatten().copied().collect()
   409	    }
