   131	pub(super) fn fleet_bin_to_ships(fleet_bin: usize, available_ships: i64, n_bins: usize) -> i64 {
   132	    debug_assert!(n_bins >= 2);
   133	    if fleet_bin == 0 || available_ships <= 0 {
   134	        return 0;
   135	    }
   136	    let numerator = fleet_bin as u128 * available_ships as u128;
   137	    let denominator = (n_bins - 1) as u128;
   138	    ((numerator * 2 + denominator) / (2 * denominator)) as i64
   139	}
   140	
   141	#[cfg(test)]
   142	fn ships_to_fleet_bin(ships: i64, available_ships: i64, n_bins: usize) -> usize {
   143	    debug_assert!(n_bins >= 2);
   144	    if ships <= 0 || available_ships <= 0 {
   145	        return 0;
   146	    }
   147	    let clamped_ships = ships.min(available_ships) as u128;
   148	    let numerator = clamped_ships * (n_bins - 1) as u128;
   149	    let denominator = available_ships as u128;
   150	    ((numerator * 2 + denominator) / (2 * denominator)) as usize
   151	}
   152	
   153	fn fleet_bin_keeps_ship_count(fleet_bin: usize, available_ships: i64, n_bins: usize) -> bool {
   154	    let ship_count = fleet_bin_to_ships(fleet_bin, available_ships, n_bins);
   155	    (fleet_bin + 1..n_bins)
   156	        .all(|later_bin| fleet_bin_to_ships(later_bin, available_ships, n_bins) != ship_count)
   157	}
