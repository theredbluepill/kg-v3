   360	
   361	## Appendix A: Manifest schema and checker
   362	
   363	`TRIM_MANIFEST.json` uses strict schema version 1. Paths are repository-relative, with forward slashes. `retained` has exactly the 12 paths above; `excluded` has the other 113. Each retained entry includes both reference and resulting SHA-256 and an ordered array of line edits. An edit uses **one-based original** `start_line`, `delete_lines` (zero means insertion), exact UTF-8 `insert` text, and a nonempty `reason`. Reconstruct the final file from original bytes and the declared edits; a changed digest alone is insufficient. Binary fixtures must have an empty edit list. `authored` lists new engine files with resulting hashes and reasons. The manifest cannot hash itself; it is the sole explicit inventory exception. Build output under `engine_rs/target/` is ignored, but extra source, test, fixture or metadata files fail verification.
   364	
   365	The generator in Appendix C supplies all values directly; there are no placeholder hashes. This checker is a consistency/provenance check, not a signature or semantic proof. A reviewer must assess declared edits, and Cargo/tests must assess behavior.
   366	
   367	Create `scripts/check_engine_trim.mjs` with:
   368	
   369	```javascript
   370	import assert from 'node:assert/strict'
   371	import { createHash } from 'node:crypto'
   372	import { execFileSync } from 'node:child_process'
   373	import { readFileSync, readdirSync, lstatSync } from 'node:fs'
   374	import { resolve, join } from 'node:path'
   375	import { pathToFileURL } from 'node:url'
   376	
   377	export const PIN = '65f0eac5bb00b18a9d3acce319c2a231cbd5dff0'
   378	export const sha = bytes => createHash('sha256').update(bytes).digest('hex')
   379	const keys = (value, expected) =>
   380	  assert.deepEqual(Object.keys(value).sort(), [...expected].sort(), 'schema keys')
   381	const reason = value => assert.equal(typeof value === 'string' && value.trim().length > 0, true, 'reason')
   382	const validPath = path => {
   383	  assert.equal(typeof path, 'string')
   384	  assert.match(path, /^engine_rs\//)
   385	  assert.equal(path.includes('\\'), false)
   386	  assert.equal(path.split('/').some(part => ['', '.', '..'].includes(part)), false)
   387	  assert.equal(path.startsWith('engine_rs/target/'), false)
   388	  assert.notEqual(path, 'engine_rs/TRIM_MANIFEST.json')
   389	}
   390	const sameSet = (a, b, label) => assert.deepEqual([...a].sort(), [...b].sort(), label)
   391	
   392	export function verify(manifest, originals, current) {
   393	  keys(manifest, ['schema_version', 'reference_commit', 'retained', 'excluded', 'authored'])
   394	  assert.equal(manifest.schema_version, 1)
   395	  assert.equal(manifest.reference_commit, PIN)
   396	  const seen = new Set()
   397	  for (const entry of [...manifest.retained, ...manifest.excluded, ...manifest.authored]) {
   398	    validPath(entry.path)
   399	    assert.equal(seen.has(entry.path), false, `duplicate: ${entry.path}`)
   400	    seen.add(entry.path)
   401	  }
   402	  sameSet([...manifest.retained, ...manifest.excluded].map(e => e.path), originals.keys(), 'reference inventory')
   403	  sameSet([...manifest.retained, ...manifest.authored].map(e => e.path), current.keys(), 'current inventory')
   404	  for (const entry of manifest.excluded) {
   405	    keys(entry, ['path', 'reference_sha256', 'reason'])
   406	    reason(entry.reason)
   407	    assert.equal(sha(originals.get(entry.path)), entry.reference_sha256, `${entry.path}: reference hash`)
   408	    assert.equal(current.has(entry.path), false, `${entry.path}: excluded file present`)
   409	  }
   410	  for (const entry of manifest.retained) {
   411	    keys(entry, ['path', 'reference_sha256', 'sha256', 'edits'])
   412	    const original = originals.get(entry.path)
   413	    const actual = current.get(entry.path)
   414	    assert.equal(sha(original), entry.reference_sha256, `${entry.path}: reference hash`)
   415	    assert.equal(sha(actual), entry.sha256, `${entry.path}: current hash`)
   416	    let expected = original
   417	    if (entry.edits.length) {
   418	      const text = original.toString('utf8')
   419	      assert.deepEqual(Buffer.from(text), original, `${entry.path}: edits require UTF-8`)
   420	      const lines = text.match(/[^\n]*\n|[^\n]+$/g) ?? []
   421	      let cursor = 0
   422	      const parts = []
   423	      for (const edit of entry.edits) {
   424	        keys(edit, ['start_line', 'delete_lines', 'insert', 'reason'])
   425	        reason(edit.reason)
   426	        assert.equal(Number.isSafeInteger(edit.start_line), true)
   427	        assert.equal(Number.isSafeInteger(edit.delete_lines), true)
   428	        assert.equal(typeof edit.insert, 'string')
   429	        const start = edit.start_line - 1
   430	        assert.equal(start >= cursor && start <= lines.length && edit.delete_lines >= 0, true, `${entry.path}: edit range`)
   431	        assert.equal(start + edit.delete_lines <= lines.length, true, `${entry.path}: edit end`)
   432	        parts.push(lines.slice(cursor, start).join(''), edit.insert)
   433	        cursor = start + edit.delete_lines
   434	      }
   435	      parts.push(lines.slice(cursor).join(''))
   436	      expected = Buffer.from(parts.join(''))
   437	    }
   438	    assert.deepEqual(actual, expected, `${entry.path}: undeclared edit`)
   439	    if (entry.path.endsWith('.rs') && entry.path !== 'engine_rs/src/lib.rs') {
   440	      assert.equal(entry.edits.length, 0, `${entry.path}: retained Rust must be unchanged`)
   441	    }
   442	  }
   443	  for (const entry of manifest.authored) {
   444	    keys(entry, ['path', 'sha256', 'reason'])
   445	    reason(entry.reason)
   446	    assert.equal(sha(current.get(entry.path)), entry.sha256, `${entry.path}: authored hash`)
   447	  }
   448	}
   449	
   450	export function check(root) {
   451	  // Largest pinned blob is 5,099,830 bytes; include excluded blobs in custody.
   452	  const git = args => execFileSync('git', args, { cwd: root, maxBuffer: 16 * 1024 * 1024 })
   453	  const paths = git(['ls-tree', '-r', '--name-only', PIN, 'engine_rs']).toString().trim().split('\n')
   454	  const originals = new Map(paths.map(path => [path, git(['show', `${PIN}:${path}`])]))
   455	  const current = new Map()
   456	  function walk(relative) {
   457	    for (const name of readdirSync(join(root, relative))) {
   458	      const path = `${relative}/${name}`
   459	      if (path === 'engine_rs/target' || path === 'engine_rs/TRIM_MANIFEST.json') continue
   460	      const stat = lstatSync(join(root, path))
   461	      assert.equal(stat.isSymbolicLink(), false, `${path}: symlink`)
   462	      if (stat.isDirectory()) walk(path)
   463	      else {
   464	        assert.equal(stat.isFile(), true, `${path}: not a regular file`)
   465	        current.set(path, readFileSync(join(root, path)))
   466	      }
   467	    }
   468	  }
   469	  const manifest = JSON.parse(readFileSync(join(root, 'engine_rs/TRIM_MANIFEST.json'), 'utf8'))
   470	  walk('engine_rs')
   471	  verify(manifest, originals, current)
   472	  const retained = ['Cargo.toml', 'Cargo.lock', 'LICENSE', 'VENDORED_FROM.md',
   473	    'src/lib.rs', 'src/py_random.rs', 'src/econ_attrib.rs', 'tests/py_random.rs',
   474	    ...[95324500, 95901360, 95921764, 95990191].map(id => `fixtures/episode-${id}.jsonl.gz`)]
   475	  sameSet(manifest.retained.map(e => e.path), retained.map(p => `engine_rs/${p}`), 'Task 1.1 retained set')
   476	  const newPaths = manifest.authored.map(e => e.path)
   477	  assert.equal(newPaths.every(p => p === 'engine_rs/tests/replay_parity.rs'), true, 'Task 1.1 authored set')
   478	  const removed = new Set([19, 21, 22, 23, 24, 25, 27])
   479	  const lib = originals.get('engine_rs/src/lib.rs').toString().split(/(?<=\n)/)
   480	  const expectedLib = Buffer.from(lib.filter((_, i) => !removed.has(i + 1)).join(''))
   481	  assert.deepEqual(current.get('engine_rs/src/lib.rs'), expectedLib, 'exact seven removals')
   482	  assert.equal(sha(expectedLib), 'c4b9bac5057be3a435d2f1035aae17bcd15e7f95ea8557322e4929877c8231fd')
   483	  const cargo = originals.get('engine_rs/Cargo.toml').toString()
   484	    .replace('crate-type = ["rlib", "cdylib"]\n', '')
   485	    .replace('[[bin]]\nname = "re_engine"\npath = "src/main.rs"\n\n', '')
   486	    .replace('rayon = "1.12.0"\n', '')
   487	  assert.equal(current.get('engine_rs/Cargo.toml').toString(), cargo, 'Cargo target/dependency removals only')
   488	  const oldProvenance = originals.get('engine_rs/VENDORED_FROM.md')
   489	  assert.deepEqual(current.get('engine_rs/VENDORED_FROM.md').subarray(0, oldProvenance.length), oldProvenance, 'append-only provenance')
   490	}
   491	
   492	if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
   493	  try {
   494	    check(resolve(process.argv[2] ?? '.'))
   495	    console.log('engine trim manifest: OK')
   496	  } catch (error) {
   497	    console.error(error.message)
   498	    process.exitCode = 1
   499	  }
   500	}
   501	```
