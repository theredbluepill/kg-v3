   497	/// Check a raw buffer before making a Rust slice. The caller still owns the
   498	/// allocation/lifetime contract: an address cannot establish that memory exists.
   499	fn array_region<T>(
   500	    pointer: *const T,
   501	    len: usize,
   502	    expected: usize,
   503	    name: &str,
   504	) -> Result<(usize, usize), String> {
   505	    if len != expected {
   506	        return Err(format!("{name}: expected {expected} elements, got {len}"));
   507	    }
   508	    if pointer.is_null() && len != 0 {
   509	        return Err(format!("{name}: null pointer"));
   510	    }
   511	    if !(pointer as usize).is_multiple_of(std::mem::align_of::<T>()) {
   512	        return Err(format!("{name}: misaligned pointer"));
   513	    }
   514	    let bytes = len
   515	        .checked_mul(std::mem::size_of::<T>())
   516	        .filter(|&bytes| bytes <= isize::MAX as usize)
   517	        .ok_or_else(|| format!("{name}: byte length overflows"))?;
   518	    let end = (pointer as usize)
   519	        .checked_add(bytes)
   520	        .ok_or_else(|| format!("{name}: address overflows"))?;
   521	    Ok((pointer as usize, end))
