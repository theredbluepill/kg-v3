   832	            let mut command = vec![Value::String(MYOLIE_UNIT_NAMES[kind].to_string())];
   833	            if transfer || kind == 8 {
   834	                command.push(Value::String(MYOLIE_ITEMS[item].to_string()));
   835	            }
   836	            if transfer && frame[4] == 1 {
   837	                command.push(Value::from(i64::from(frame[5]) * 32 + i64::from(frame[6])));
   838	            }
   839	            units.push(Value::Array(command));
   840	        } else if index == length - 1 {
   841	            if frame[..11].iter().any(|&v| v != 0) || frame[11] != 1 {
   842	                return Err("Myolie program lacks distinct final STOP".to_string());
   843	            }
   844	        } else {
   845	            let kind = frame[7] as usize;
   846	            let item = frame[8] as usize;
   847	            let quantity = (3..=6).contains(&kind);
   848	            let allowed_item = match kind {
   849	                3 => (1..=5).contains(&item),
   850	                4 => item == 1 || item == 9,
   851	                5 => (10..=12).contains(&item),
   852	                6 => (1..=9).contains(&item),
   853	                _ => item == 0,
   854	            };
   855	            if frame[..7].iter().any(|&v| v != 0)
   856	                || !(1..=7).contains(&kind)
   857	                || frame[11] != 0
   858	                || !allowed_item
   859	                || (!quantity && (frame[9] != 0 || frame[10] != 0))
   860	            {
   861	                return Err(format!("frame {index} violates canonical market syntax"));
   862	            }
   863	            let mut command = if kind == 7 {
   864	                Vec::new()
   865	            } else {
   866	                vec![Value::String(MYOLIE_MARKET_NAMES[kind].to_string())]
   867	            };
   868	            if quantity {
   869	                command.push(Value::String(MYOLIE_ITEMS[item].to_string()));
   870	                command.push(Value::from(i64::from(frame[9]) * 32 + i64::from(frame[10])));
   871	            }
   872	            markets.push(Value::Array(command));
   873	        }
   874	    }
   875	    let mut raw = serde_json::Map::new();
   876	    raw.insert("farmer".to_string(), units.remove(0));
   877	    raw.insert("hands".to_string(), Value::Array(units));
   878	    raw.insert("market".to_string(), Value::Array(markets));
   879	    Ok(Value::Object(raw))
   880	}
