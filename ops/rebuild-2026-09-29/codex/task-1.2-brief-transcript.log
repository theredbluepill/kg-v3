   536	def validate_action(
   537	    action: Mapping[str, Any],
   538	    legal_input: Mapping[str, Any] | None,
   539	    *,
   540	    hire_limit: int = LEGACY_HIRE_LIMIT,
   541	) -> None:
   542	    """Validate versioned representability and exact raw syntax; no mutation.
   543	
   544	    Legal no-effects/partial fills are deliberately admitted. This does not
   545	    certify an outcome, claim all official syntax is representable, or call an
   546	    engine. HIRE support is explicitly bounded by the checkpoint-owned hire_limit.
   547	    Explicit zero unit transfer quantities are outside frozen-validator support.
   548	    The caller records the official engine's real result separately.
   549	    """
   550	    encoded = encode_action(action, legal_input, hire_limit=hire_limit)
   551	    restored = decode_action(encoded, legal_input, hire_limit=hire_limit)
   552	    _require(
   553	        list(restored) == list(action) and restored == action, "codec altered action"
   554	    )
