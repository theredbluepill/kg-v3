    41	/// Terminal reward shaping for the vectorized environment.
    42	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    43	enum RewardMode {
    44	    /// Sole winner `+1`, losers `-1`, tied winners share via `split_won_reward`.
    45	    WinLoss,
    46	    /// Winner probability target: tied winners split one unit; everyone else `0`.
    47	    WinOnly,
    48	    /// Winner(s) receive `winner_ships / total_player_ships`; everyone else `0`.
    49	    ShipRatio,
    50	}
    51	
    52	impl RewardMode {
    53	    fn parse(value: &str) -> Result<Self, String> {
    54	        match value {
    55	            "win_loss" => Ok(Self::WinLoss),
    56	            "win_only" => Ok(Self::WinOnly),
    57	            "ship_ratio" => Ok(Self::ShipRatio),
    58	            other => Err(format!(
    59	                "unknown reward_mode '{other}'; expected 'win_loss', 'win_only', or 'ship_ratio'"
    60	            )),
    61	        }
    62	    }
    63	}
