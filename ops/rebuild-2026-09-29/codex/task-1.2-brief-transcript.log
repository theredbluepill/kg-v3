    44	def batched_slot_masks(
    45	    native: MyolieSampler, device: torch.device | str
    46	) -> BatchedSlotMasks:
    47	    """Read local mask tables from one checked native plan, then upload once.
    48	
    49	    These are extracted by following admitted token prefixes, never by copying
    50	    the grammar's allowed-item rules into Torch. Construct once per model/device.
    51	    No native cursor or CPU round trip is needed when indexing these tables.
    52	    """
    53	    plan = native.plan(1, 1, 241)
    54	
    55	    def options(prefix: Sequence[int]) -> list[bool]:
    56	        node = plan.start
    57	        for token in prefix:
    58	            if node < 0 or not plan.nodes[node][0][token]:
    59	                raise RuntimeError("native grammar no longer admits mask probe")
    60	            node = int(plan.nodes[node][2][token])
    61	        if node < 0:
    62	            raise RuntimeError("native mask probe ended before its target slot")
    63	        return list(plan.nodes[node][0])
    64	
    65	    def first(mask: Sequence[bool]) -> int:
    66	        return next(index for index, allowed in enumerate(mask) if allowed)
    67	
    68	    unit_kind = options([0])
    69	    unit_item = [options([0, 1, 0]) for _ in range(20)]
    70	    unit_present = [options([0, 1, 0, 0]) for _ in range(20)]
    71	    for kind, allowed in enumerate(unit_kind):
    72	        if allowed:
    73	            unit_item[kind] = options([0, kind, 0])
    74	            unit_present[kind] = options([0, kind, 0, first(unit_item[kind])])
    75	    high = [options([0, 6, 0, 1, present]) for present in range(2)]
    76	    low = [
    77	        [
    78	            options([0, 6, 0, 1, present, 0 if high_is_zero or not present else 1])
    79	            for high_is_zero in range(2)
    80	        ]
    81	        for present in range(2)
    82	    ]
