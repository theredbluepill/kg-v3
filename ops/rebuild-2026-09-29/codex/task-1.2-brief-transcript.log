   470	def decode_action(
   471	    encoded: Mapping[str, Any],
   472	    legal_input: Mapping[str, Any] | None = None,
   473	    *,
   474	    hire_limit: int = LEGACY_HIRE_LIMIT,
   475	) -> dict[str, Any]:
   476	    _require(
   477	        isinstance(encoded, Mapping)
   478	        and set(encoded) == {"schema", "layout", "frames"}
   479	        and encoded["schema"] == SCHEMA,
   480	        "encoded action schema differs",
   481	    )
   482	    layout, frames = encoded["layout"], encoded["frames"]
   483	    _layout(layout, legal_input)
   484	    _require(
   485	        isinstance(frames, Sequence)
   486	        and not isinstance(frames, (str, bytes))
   487	        and bool(frames),
   488	        "empty program",
   489	    )
   490	    previous: list[dict[str, int]] = []
   491	    for raw in frames:
   492	        frame = _frame(raw)
   493	        frame_masks(legal_input, previous, frame, layout=layout, hire_limit=hire_limit)
   494	        previous.append(frame)
   495	    return _action_from_admitted_frames(layout, previous)
   496	
   497	
   498	def _action_from_admitted_frames(layout, frames):
   499	    """Render mask-admitted frames. Only the validator and private sampler call this."""
   500	    _require(bool(frames), "empty program")
   501	    _require(frames[-1]["stop"] == 1, "program lacks final STOP")
   502	    units, market = {}, []
   503	    for frame in frames:
   504	        kind = UNIT_KIND_VALUES[frame["unit_kind"]]
   505	        if kind != "NONE":
   506	            command = [kind]
   507	            if kind in _TRANSFERS or kind == "PLANT":
   508	                command.append(ITEM_VALUES[frame["unit_item"]])
   509	            if kind in _TRANSFERS and frame["unit_quantity_present"]:
   510	                command.append(
   511	                    32 * frame["unit_quantity_high"] + frame["unit_quantity"]
   512	                )
   513	            units[frame["unit_actor"]] = command
   514	        kind = MARKET_KIND_VALUES[frame["market_kind"]]
   515	        if kind != "NONE":
   516	            command = [] if kind == "EMPTY" else [kind]
   517	            if kind in _QUANTITY_ORDERS:
   518	                command.extend(
   519	                    (
   520	                        ITEM_VALUES[frame["market_item"]],
   521	                        32 * frame["market_quantity_high"] + frame["market_quantity"],
   522	                    )
   523	                )
   524	            market.append(command)
   525	    result = {}
   526	    for key in layout["keys"]:
   527	        if key == "farmer":
   528	            result[key] = units[0]
   529	        elif key == "hands":
   530	            result[key] = [units[i + 1] for i in range(layout["hands_count"])]
   531	        else:
   532	            result[key] = market
   533	    return result
