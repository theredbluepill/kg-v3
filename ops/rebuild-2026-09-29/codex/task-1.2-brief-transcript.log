   567	## Appendix C: Deterministic manifest generation
   568	
   569	Run from the repository root after Task A's trim, then again after Task B adds/formats the replay test. This emits **per-file** inventory and exact line hunks, with no manual digest maintenance. Review the resulting diff, especially Cargo's generated lockfile hunks; this is not authorization to accept arbitrary edits.
   570	
   571	```bash
   572	.venv/bin/python - <<'PY'
   573	from pathlib import Path
   574	import difflib, hashlib, json, subprocess
   575	
   576	pin = '65f0eac5bb00b18a9d3acce319c2a231cbd5dff0'
   577	prefix = 'engine_rs/'
   578	kept = {'Cargo.toml', 'Cargo.lock', 'LICENSE', 'VENDORED_FROM.md', 'src/lib.rs',
   579	        'src/py_random.rs', 'src/econ_attrib.rs', 'tests/py_random.rs'}
   580	kept |= {f'fixtures/episode-{i}.jsonl.gz' for i in (95324500, 95901360, 95921764, 95990191)}
   581	why_edit = {
   582	    'src/lib.rs': 'Remove only excluded module declarations at reference lines 19, 21-25, 27; see brief dependency table.',
   583	    'Cargo.toml': 'Remove unused cdylib, re_engine binary and Rayon dependency; preserve numeric features and compatibility metadata.',
   584	    'Cargo.lock': 'Generated by cargo remove --offline rayon; prune only unused Rayon dependency closure, no manual edits.',
   585	    'VENDORED_FROM.md': 'Append current trim scope while preserving all historical provenance bytes.',
   586	}
   587	excluded_sources = {
   588	    'ffi': 'C5 C ABI/ctypes replaced by native adapter in Task 1.4',
   589	    'joint_matching': 'C2 policy matching enumeration is outside rules kernel',
   590	    'myolie_features': 'C4 flat v2 encoder rebuilt in Task 1.3',
   591	    'myolie_sampler': 'C3 grammar port after review in Task 1.2',
   592	    'native_agents': 'C2 scripted opponents deferred to selected Phase 7 imports',
   593	    'policy_rows': 'C2 policy action-row machinery is outside rules kernel',
   594	    'training': 'C5 old training lifecycle/collector rebuilt in Task 1.4',
   595	    'main': 'Replay/benchmark CLI excluded; direct replay integration test replaces test purpose',
   596	}
   597	def exclusion(path):
   598	    if path.startswith('src/native_agents/'):
   599	        return excluded_sources['native_agents']
   600	    if path.startswith('src/bin/') or path.startswith('examples/'):
   601	        return 'C2 bot executable/oracle not required for rules transitions'
   602	    if path.startswith('src/') and Path(path).stem in excluded_sources:
   603	        return excluded_sources[Path(path).stem]
   604	    if path.startswith('fixtures/'):
   605	        return 'Bot/controller/matching oracle unused by retained rules and RNG tests'
   606	    if path == 'tests/shoprouter_parity.rs':
   607	        return 'Requires excluded ShopRouterController; tests controller actions, zero engine transitions'
   608	    if path == 'README.md':
   609	        return 'Describes excluded full engine/ABI/matching surfaces and unavailable sibling tools'
   610	    if path == 'V3_IMPORT.json':
   611	        return 'Full prior import manifest superseded by exhaustive TRIM_MANIFEST.json'
   612	    raise ValueError(f'unclassified reference path: {path}')
   613	sha = lambda data: hashlib.sha256(data).hexdigest()
   614	paths = subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', pin, 'engine_rs'], text=True).splitlines()
   615	manifest = dict(schema_version=1, reference_commit=pin, retained=[], excluded=[], authored=[])
   616	for path in paths:
   617	    relative = path.removeprefix(prefix)
   618	    before = subprocess.check_output(['git', 'show', f'{pin}:{path}'])
   619	    if relative not in kept:
   620	        manifest['excluded'].append(dict(path=path, reference_sha256=sha(before), reason=exclusion(relative)))
   621	        continue
   622	    after = Path(path).read_bytes()
   623	    edits = []
   624	    if before != after:
   625	        reason = why_edit[relative]  # Deliberately fail for an unauthorized edited file.
   626	        a = before.decode('utf-8').splitlines(keepends=True)
   627	        b = after.decode('utf-8').splitlines(keepends=True)
   628	        for tag, i, j, x, y in difflib.SequenceMatcher(a=a, b=b, autojunk=False).get_opcodes():
   629	            if tag != 'equal':
   630	                edits.append(dict(start_line=i+1, delete_lines=j-i, insert=''.join(b[x:y]), reason=reason))
   631	    manifest['retained'].append(dict(path=path, reference_sha256=sha(before), sha256=sha(after), edits=edits))
   632	new = Path('engine_rs/tests/replay_parity.rs')
   633	if new.exists():
   634	    manifest['authored'].append(dict(path=new.as_posix(), sha256=sha(new.read_bytes()),
   635	                                     reason='New direct native-reset official-trace parity and comparator regressions'))
   636	assert len(paths) == 125 and len(manifest['retained']) == 12 and len(manifest['excluded']) == 113
   637	Path('engine_rs/TRIM_MANIFEST.json').write_text(json.dumps(manifest, indent=2) + '\n')
   638	PY
