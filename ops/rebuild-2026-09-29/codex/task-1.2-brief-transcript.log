   375	def _token():
   376	    return dict.fromkeys(SLOT_NAMES, 0)
   377	
   378	
   379	def _unit_frame(command, actor):
   380	    _require(
   381	        isinstance(command, list) and bool(command) and type(command[0]) is str,
   382	        "unit command must be a nonempty list",
   383	    )
   384	    kind = command[0]
   385	    _require(kind in UNIT_KIND_VALUES[1:-1], "unknown unit command")
   386	    expected = (2, 3) if kind in _TRANSFERS else ((2,) if kind == "PLANT" else (1,))
   387	    _require(len(command) in expected, "unsupported unit command arguments")
   388	    frame = _token()
   389	    frame.update(unit_actor=actor, unit_kind=UNIT_KIND_VALUES.index(kind))
   390	    if kind in _TRANSFERS or kind == "PLANT":
   391	        _require(
   392	            type(command[1]) is str and command[1] in ITEM_VALUES,
   393	            "unsupported unit item",
   394	        )
   395	        frame["unit_item"] = ITEM_VALUES.index(command[1])
   396	    if kind in _TRANSFERS and len(command) == 3:
   397	        high, low = _quantity(command[2])
   398	        frame.update(
   399	            unit_quantity_present=1, unit_quantity_high=high, unit_quantity=low
   400	        )
   401	    return frame
   402	
   403	
   404	def _market_frame(command):
   405	    _require(isinstance(command, list), "market command must be a list")
   406	    frame = _token()
   407	    if not command:
   408	        frame["market_kind"] = MARKET_KIND_VALUES.index("EMPTY")
   409	        return frame
   410	    kind = command[0]
   411	    _require(
   412	        type(kind) is str and kind in MARKET_KIND_VALUES[1:-1], "unknown market command"
   413	    )
   414	    _require(
   415	        len(command) == (3 if kind in _QUANTITY_ORDERS else 1),
   416	        "unsupported market arguments",
   417	    )
   418	    frame["market_kind"] = MARKET_KIND_VALUES.index(kind)
   419	    if kind in _QUANTITY_ORDERS:
   420	        _require(
   421	            type(command[1]) is str and command[1] in ITEM_VALUES,
   422	            "unsupported market item",
   423	        )
   424	        high, low = _quantity(command[2])
   425	        frame.update(
   426	            market_item=ITEM_VALUES.index(command[1]),
   427	            market_quantity_high=high,
   428	            market_quantity=low,
   429	        )
   430	    return frame
