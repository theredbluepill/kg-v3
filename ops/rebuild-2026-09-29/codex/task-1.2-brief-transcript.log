    61	impl RlActionSpec {
    62	    pub(super) fn parse(value: &str, n_bins: usize, targeting_mode: &str) -> Result<Self, String> {
    63	        match value {
    64	            "pure" => {
    65	                TargetingMode::parse(targeting_mode)?;
    66	                Ok(Self::Pure)
    67	            }
    68	            "discrete_targets" => Ok(Self::DiscreteTargets {
    69	                targeting_mode: TargetingMode::parse(targeting_mode)?,
    70	            }),
    71	            "discrete_target_bins" => {
    72	                let targeting_mode = TargetingMode::parse(targeting_mode)?;
    73	                if n_bins < 2 {
    74	                    return Err("n_bins must be >= 2 for action_spec \"discrete_target_bins\""
    75	                        .to_string());
    76	                }
    77	                let spec = Self::DiscreteTargetBins {
    78	                    n_bins,
    79	                    targeting_mode,
    80	                };
    81	                spec.checked_can_act_len().ok_or_else(|| {
    82	                    "n_bins is too large for the discrete_target_bins can_act shape".to_string()
    83	                })?;
    84	                Ok(spec)
    85	            },
    86	            _ => Err(format!(
    87	                "unsupported action_spec {value:?}; expected \"pure\", \"discrete_targets\", or \"discrete_target_bins\""
    88	            )),
    89	        }
    90	    }
    91	
    92	    pub(super) fn can_act_len(self) -> usize {
    93	        self.checked_can_act_len()
    94	            .expect("validated action spec can_act shape should fit in usize")
    95	    }
    96	
    97	    fn checked_can_act_len(self) -> Option<usize> {
    98	        match self {
    99	            Self::Pure => OUTER_PLAYER_SLOTS.checked_mul(ACTION_ENTITY_SLOTS),
   100	            Self::DiscreteTargets { .. } => OUTER_PLAYER_SLOTS
   101	                .checked_mul(ACTION_ENTITY_SLOTS)?
   102	                .checked_mul(ACTION_ENTITY_SLOTS),
   103	            Self::DiscreteTargetBins { n_bins, .. } => OUTER_PLAYER_SLOTS
   104	                .checked_mul(ACTION_ENTITY_SLOTS)?
   105	                .checked_mul(ACTION_ENTITY_SLOTS)?
   106	                .checked_mul(n_bins),
   107	        }
   108	    }
   109	
   110	    pub(super) const fn max_launch_len(self) -> usize {
   111	        match self {
   112	            Self::Pure | Self::DiscreteTargets { .. } => OUTER_PLAYER_SLOTS * ACTION_ENTITY_SLOTS,
   113	            Self::DiscreteTargetBins { .. } => 0,
   114	        }
   115	    }
   116	}
