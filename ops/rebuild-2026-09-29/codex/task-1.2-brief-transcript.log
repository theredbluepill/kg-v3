   492	    #[test]
   493	    fn plans_are_bounded_deterministic_and_well_formed() {
   494	        for (actors, limit, hire) in [
   495	            (1, 1, 1),
   496	            (1, 10, 241),
   497	            (16, 10, 16),
   498	            (231, 10, 241),
   499	            (241, 10, 241),
   500	        ] {
   501	            let bytes = plan(actors, limit, hire).unwrap();
   502	            assert_eq!(bytes, plan(actors, limit, hire).unwrap());
   503	            let number = |offset| u32::from_le_bytes(bytes[offset..offset + 4].try_into().unwrap());
   504	            let nodes = number(8) as usize;
   505	            let edges = number(16) as usize;
   506	            assert!(nodes <= 24 * MAX_ACTORS as usize + 66 * 32);
   507	            assert!(edges < 1_000_000);
   508	            assert_eq!(number(0), MAGIC);
   509	            assert_eq!(number(4), ABI);
   510	            assert_eq!(number(12), 0);
   511	            assert_eq!(bytes.len(), 20 + nodes * 16 + edges * 5);
   512	            for id in 0..nodes {
   513	                let row = 20 + id * 16;
   514	                let slot = number(row) as usize;
   515	                let offset = number(row + 8) as usize;
   516	                let width = number(row + 12) as usize;
   517	                assert_eq!(width, WIDTHS[slot]);
   518	                let mask = &bytes[20 + nodes * 16 + offset..20 + nodes * 16 + offset + width];
   519	                assert!(mask.contains(&1));
   520	                for (token, &admitted) in mask.iter().enumerate() {
   521	                    let edge = 20 + nodes * 16 + edges + (offset + token) * 4;
   522	                    let target = i32::from_le_bytes(bytes[edge..edge + 4].try_into().unwrap());
   523	                    assert_eq!(target == -2, admitted == 0);
   524	                    assert!(target < nodes as i32);
   525	                    if target == -1 {
   526	                        assert_eq!((slot, token), (11, 1));
   527	                    }
   528	                }
   529	            }
   530	            println!(
   531	                "sampler_plan actors={actors} limit={limit} hire={hire}: nodes={nodes} edges={edges} bytes={}",
   532	                bytes.len()
   533	            );
   534	        }
   535	    }
   536	}
