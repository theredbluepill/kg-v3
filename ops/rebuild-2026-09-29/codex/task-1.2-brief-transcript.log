  3442	fn parse_order(value: &Value) -> Result<Option<OrderState>, String> {
  3443	    let Some(parts) = value.as_array() else {
  3444	        return Ok(None);
  3445	    };
  3446	    let Some(op) = parts.first().and_then(Value::as_str) else {
  3447	        return Ok(None);
  3448	    };
  3449	    if op == "HIRE" {
  3450	        return Ok(Some(OrderState {
  3451	            kind: OrderKind::Hire,
  3452	            item: String::new(),
  3453	            remaining: 0,
  3454	        }));
  3455	    }
  3456	    if op == "BUY_LAND" {
  3457	        return Ok(Some(OrderState {
  3458	            kind: OrderKind::BuyLand,
  3459	            item: String::new(),
  3460	            remaining: 0,
  3461	        }));
  3462	    }
  3463	    let kind = match op {
  3464	        "BUY_SEED" => OrderKind::BuySeed,
  3465	        "BUY_PRODUCT" => OrderKind::BuyProduct,
  3466	        "BUY_ANIMAL" => OrderKind::BuyAnimal,
  3467	        "SELL" => OrderKind::Sell,
  3468	        _ => return Ok(None),
  3469	    };
  3470	    let Some(item) = parts.get(1).and_then(Value::as_str) else {
  3471	        return Ok(None);
  3472	    };
  3473	    let Some(count) = parts.get(2) else {
  3474	        return Ok(None);
  3475	    };
  3476	    let remaining = match python_int_i64(count, "market order count") {
  3477	        Ok(remaining) => remaining,
  3478	        Err(PyIntError::Invalid(_)) => return Ok(None),
  3479	        Err(PyIntError::Overflow(error)) => return Err(error),
  3480	    };
  3481	    Ok((remaining > 0).then_some(OrderState {
  3482	        kind,
  3483	        item: item.to_string(),
  3484	        remaining,
  3485	    }))
  3486	}
  3487	
  3488	fn shape(kind: &str, x: f64, t: Option<f64>) -> f64 {
  3489	    let x = x.max(0.0);
  3490	    match kind {
  3491	        "linear" => x,
  3492	        "sq" => x * x,
  3493	        "sqrt" => x.sqrt(),
  3494	        "log" => (1.0 + x).ln(),
  3495	        "log10" => (1.0 + x).log10(),
  3496	        "hinge" => {
  3497	            let Some(t) = t.filter(|t| *t > 0.0) else {
  3498	                return x;
  3499	            };
  3500	            let u = x / t;
  3501	            u + HINGE_GAIN * (u - 1.0).max(0.0).powi(2)
  3502	        }
  3503	        _ => x,
  3504	    }
  3505	}
