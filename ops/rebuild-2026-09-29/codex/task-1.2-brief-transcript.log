   650	
   651	fn assert_public(actual: &Value, expected: &Value, context: &str) {
   652	    assert_eq!(actual, expected, "public state: {context}");
   653	}
   654	
   655	fn assert_private(actual: &Value, expected: &Value, context: &str) {
   656	    assert_eq!(actual, expected, "private state: {context}");
   657	    for (a, e) in actual.as_array().unwrap().iter().zip(expected.as_array().unwrap()) {
   658	        for field in ["shed", "seeds"] {
   659	            assert_eq!(
   660	                a[field].as_object().unwrap().keys().collect::<Vec<_>>(),
   661	                e[field].as_object().unwrap().keys().collect::<Vec<_>>(),
   662	                "private map key order: {context}: {field}"
   663	            );
   664	        }
   665	        for (a, e) in a["inventories"].as_array().unwrap().iter()
   666	            .zip(e["inventories"].as_array().unwrap())
   667	        {
   668	            assert_eq!(
   669	                a.as_object().unwrap().keys().collect::<Vec<_>>(),
   670	                e.as_object().unwrap().keys().collect::<Vec<_>>(),
   671	                "private map key order: {context}: inventory"
   672	            );
   673	        }
   674	    }
   675	}
