   487	        // SAFETY: scalar/length/alignment checks precede slice construction;
   488	        // readable allocation and lifetime are the documented caller contract.
   489	        let frames = unsafe { slice::from_raw_parts(frames, frames_len) };
   490	        let action = crate::myolie_sampler::decode(actors, limit, hire_limit, frames)?;
   491	        serde_json::to_vec(&action)
   492	            .map(ReBuffer::from_vec)
   493	            .map_err(|error| format!("serialize Myolie sampler action: {error}"))
   494	    })
   495	}
