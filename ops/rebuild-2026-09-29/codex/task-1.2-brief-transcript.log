   296	    pub fn step(
   297	        &mut self,
   298	        frames: &[i64],
   299	        lengths: &[i64],
   300	    ) -> Result<HashMap<String, Vec<f64>>, String> {
   301	        std::mem::swap(&mut self.output, &mut self.staging);
   302	        let result = catch_unwind(AssertUnwindSafe(|| self.step_staged(frames, lengths)))
   303	            .unwrap_or_else(|_| Err("native training step panicked before commit".into()));
   304	        if result.is_err() {
   305	            std::mem::swap(&mut self.output, &mut self.staging);
   306	        }
   307	        result
   308	    }
   309	    fn step_staged(
   310	        &mut self,
   311	        frames: &[i64],
   312	        lengths: &[i64],
   313	    ) -> Result<HashMap<String, Vec<f64>>, String> {
   314	        let n = self.games.len();
   315	        if frames.len() != self.frames.len() || lengths.len() != n * 2 {
   316	            return Err("action tensor sizes differ from native ABI".into());
   317	        }
   318	        for (source, target) in frames.iter().zip(&mut self.frames) {
   319	            *target = i16::try_from(*source)
   320	                .map_err(|_| "action tokens exceed native signed-int16 domain")?;
   321	            if *target < 0 {
   322	                return Err("action tokens exceed native signed-int16 domain".into());
   323	            }
   324	        }
   325	        if lengths.iter().any(|value| !(1..=252).contains(value)) {
   326	            return Err("action lengths must be in 1..252".into());
   327	        }
   328	        // One clone preserves rollback for any lane's decode, step or encode error.
   329	        let mut candidates = self.games.clone();
   330	        let width = self.width;
   331	        let version = self.version;
   332	        let frame_buffer = &self.frames;
   333	        let work = || {
   334	            candidates
   335	                .par_iter_mut()
   336	                .zip(self.output.features.par_chunks_mut(2 * width))
   337	                .zip(self.output.context.par_chunks_mut(4))
   338	                .enumerate()
   339	                .map(|(i, ((game, features), context))| {
   340	                    let start = i * 2 * FRAMES * SLOTS;
