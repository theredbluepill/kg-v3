   714	
   715	fn replay(file: &str, episode_id: u64) {
   716	    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join(file);
   717	    let output = Command::new("gzip").arg("-dc").arg(&path).output()
   718	        .expect("gzip is required for pinned replay fixtures");
   719	    assert!(output.status.success(), "{}: {}", path.display(), String::from_utf8_lossy(&output.stderr));
   720	    let text = String::from_utf8(output.stdout).unwrap();
   721	    let mut lines = text.lines();
   722	    let raw: Value = serde_json::from_str(lines.next().expect("trace header")).unwrap();
   723	    assert_eq!(raw["type"], "header");
   724	    assert_eq!(raw["source"]["episode_id"].as_u64().unwrap(), episode_id);
   725	    assert_eq!(raw["source"]["module_version"], "1.32.7");
   726	    assert_eq!(raw["source"]["engine_sha256"],
   727	        "bc8a54879ef02c7ea64b8b333d6a976f0ea65c4949149d01f463f23bccee653e");
   728	    let header: TraceHeader = serde_json::from_value(raw.clone()).unwrap();
   729	    assert_eq!(header.transitions, 719);
   730	    let mut game = Game::new(header.configuration.clone(), header.seed.as_i64().unwrap(), 2).unwrap();
   731	    let initial = game.snapshot();
   732	    assert_public(&serde_json::to_value(&initial.public).unwrap(), &raw["initial"]["public"], file);
   733	    assert_private(&serde_json::to_value(&initial.privates).unwrap(), &raw["initial"]["privates"], file);
   734	    assert_eq!(initial.statuses, vec!["ACTIVE", "ACTIVE"]);
   735	    assert_eq!(initial.rewards, vec![0.0, 0.0]);
   736	    assert!(!initial.done);
   737	    let mut count = 0;
   738	    for (index, line) in lines.enumerate() {
   739	        let row: Value = serde_json::from_str(line).unwrap();
   740	        let context = format!("{file}, transition {index}");
   741	        assert_eq!(row["type"], "transition", "{context}");
   742	        assert_eq!(row["from_step"].as_u64().unwrap(), index as u64, "{context}");
   743	        game.step(row["actions"].as_array().unwrap())
   744	            .unwrap_or_else(|error| panic!("{context}: {error}"));
   745	        let actual = game.snapshot();
   746	        assert_public(&serde_json::to_value(&actual.public).unwrap(), &row["expected"], &context);
   747	        assert_private(&serde_json::to_value(&actual.privates).unwrap(), &row["privates"], &context);
   748	        let statuses: Vec<String> = serde_json::from_value(row["statuses"].clone()).unwrap();
   749	        let rewards: Vec<f64> = serde_json::from_value(row["rewards"].clone()).unwrap();
   750	        assert_eq!(actual.statuses, statuses, "{context}");
   751	        assert_eq!(actual.rewards, rewards, "{context}");
   752	        assert_eq!(actual.done, index == 718, "{context}");
   753	        assert_eq!(actual.public.step, index + 1, "{context}");
   754	        count += 1;
   755	    }
   756	    assert_eq!(count, header.transitions);
   757	    assert_eq!(game.terminal_banks().unwrap(), header.terminal_banks.as_slice(), "{file}");
   758	}
