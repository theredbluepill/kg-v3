   103	/// Validate scalar shape/length before an FFI caller constructs a raw slice.
   104	pub fn validate_decode_length(
   105	    actors: u32,
   106	    limit: u32,
   107	    hire_limit: u32,
   108	    tokens: usize,
   109	) -> Result<(), String> {
   110	    Shape::new(actors, limit, hire_limit)?.validate_length(tokens)
   111	}
   112	
   113	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
   114	enum Unit {
   115	    #[default]
   116	    None,
   117	    Ordinary,
   118	    Transfer,
   119	    Plant,
   120	}
   121	
   122	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
   123	enum Market {
   124	    #[default]
   125	    None,
   126	    Hire,
   127	    Other,
   128	    Seed,
   129	    Product,
   130	    Animal,
   131	    Sell,
   132	}
   133	
   134	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
   135	struct State {
   136	    units: u16,
   137	    orders: u8,
   138	    hires: u8,
   139	    slot: u8,
   140	    unit: Unit,
   141	    market: Market,
   142	    quantity_present: bool,
   143	    quantity_high_zero: bool,
   144	}
   145	
   146	impl State {
   147	    fn allows(self, token: usize, shape: Shape) -> bool {
   148	        if token >= WIDTHS[usize::from(self.slot)] {
   149	            return false;
   150	        }
   151	        let ready = self.units == shape.actors;
   152	        match self.slot {
   153	            0 => token == if ready { 0 } else { usize::from(self.units) },
   154	            1 => {
   155	                if ready {
   156	                    token == 0
   157	                } else {
   158	                    (1..=18).contains(&token)
   159	                }
   160	            }
   161	            2 => token == 0,
   162	            3 => match self.unit {
   163	                Unit::Transfer => (1..=12).contains(&token),
   164	                Unit::Plant => (1..=5).contains(&token),
   165	                _ => token == 0,
   166	            },
   167	            4 => self.unit == Unit::Transfer || token == 0,
   168	            5 => self.quantity_present || token == 0,
   169	            6 => {
   170	                if self.quantity_present {
   171	                    !self.quantity_high_zero || token != 0
   172	                } else {
   173	                    token == 0
   174	                }
   175	            }
   176	            7 => {
   177	                if ready && self.unit == Unit::None && self.orders < shape.orders {
   178	                    token != 1 || shape.actors + u16::from(self.hires) < shape.hire_limit
   179	                } else {
   180	                    token == 0
   181	                }
   182	            }
   183	            8 => match self.market {
   184	                Market::Seed => (1..=5).contains(&token),
   185	                Market::Product => token == 1 || token == 9,
   186	                Market::Animal => (10..=12).contains(&token),
   187	                Market::Sell => (1..=9).contains(&token),
   188	                _ => token == 0,
   189	            },
   190	            9 | 10 => self.market == Market::Seed || token == 0,
   191	            11 => {
   192	                token
   193	                    == usize::from(ready && self.unit == Unit::None && self.market == Market::None)
   194	            }
   195	            _ => unreachable!("private state has a fixed slot range"),
   196	        }
   197	    }
   198	
   199	    /// Advance an admitted token. None means the unique terminal STOP.
   200	    fn advance(mut self, token: usize) -> Option<Self> {
   201	        match self.slot {
   202	            1 => {
   203	                self.unit = match token {
   204	                    0 => Unit::None,
   205	                    6 | 7 => Unit::Transfer,
   206	                    8 => Unit::Plant,
   207	                    _ => Unit::Ordinary,
   208	                };
   209	            }
   210	            3 => {
   211	                if self.unit == Unit::Plant {
   212	                    self.unit = Unit::Ordinary;
   213	                }
   214	            }
   215	            4 => {
   216	                self.quantity_present = token == 1;
   217	                if self.unit == Unit::Transfer && !self.quantity_present {
   218	                    self.unit = Unit::Ordinary;
   219	                }
   220	            }
   221	            5 => self.quantity_high_zero = self.quantity_present && token == 0,
   222	            6 => {
   223	                self.quantity_present = false;
   224	                self.quantity_high_zero = false;
   225	                if self.unit == Unit::Transfer {
   226	                    self.unit = Unit::Ordinary;
   227	                }
   228	            }
   229	            7 => {
   230	                self.market = match token {
   231	                    0 => Market::None,
   232	                    1 => Market::Hire,
   233	                    3 => Market::Seed,
   234	                    4 => Market::Product,
   235	                    5 => Market::Animal,
   236	                    6 => Market::Sell,
   237	                    _ => Market::Other,
   238	                };
   239	            }
   240	            8 => {
   241	                if matches!(self.market, Market::Product | Market::Animal | Market::Sell) {
   242	                    self.market = Market::Seed;
   243	                }
   244	            }
   245	            10 => {
   246	                if self.market == Market::Seed {
   247	                    self.market = Market::Other;
   248	                }
   249	            }
   250	            11 => {
   251	                if token == 1 {
   252	                    return None;
   253	                }
   254	                return Some(Self {
   255	                    units: self.units + u16::from(self.unit != Unit::None),
   256	                    orders: self.orders + u8::from(self.market != Market::None),
   257	                    hires: self.hires + u8::from(self.market == Market::Hire),
   258	                    ..Self::default()
   259	                });
   260	            }
   261	            _ => {}
   262	        }
   263	        self.slot += 1;
   264	        Some(self)
   265	    }
   266	}
