    94	def load_pinned_framework() -> dict[str, Any]:
    95	    """Load the installed specification through the hash-pinned framework.
    96	
    97	    ``state={}`` bypasses Environment.reset; the no-op interpreter is never run.
    98	    Environment itself expands the specification with its own schemas, including
    99	    shared ``step``. No hand-maintained copy of the framework schema is used.
   100	    Every call rechecks the files before importing or deriving the specification.
   101	    """
   102	    try:
   103	        distribution = importlib.metadata.distribution("kaggle-environments")
   104	    except importlib.metadata.PackageNotFoundError as error:
   105	        raise ValueError("pinned kaggle-environments is unavailable") from error
   106	    if distribution.version != FRAMEWORK_VERSION:
   107	        raise ValueError(
   108	            f"kaggle-environments must be {FRAMEWORK_VERSION}, "
   109	            f"got {distribution.version}"
   110	        )
   111	    hashes: dict[str, str] = {}
   112	    verified_bytes: dict[str, bytes] = {}
   113	    for name, expected in FRAMEWORK_HASHES.items():
   114	        path = Path(str(distribution.locate_file(f"kaggle_environments/{name}")))
   115	        try:
   116	            payload = path.read_bytes()
   117	            actual = hashlib.sha256(payload).hexdigest()
   118	        except OSError as error:
   119	            raise ValueError(f"pinned framework file is unavailable: {path}") from error
   120	        if actual != expected:
   121	            raise ValueError(
   122	                f"{name} SHA-256 differs: expected {expected}, got {actual}"
   123	            )
   124	        hashes[name] = actual
   125	        verified_bytes[name] = payload
   126	
   127	    core = importlib.import_module("kaggle_environments.core")
   128	
   129	    raw_specification = json.loads(
   130	        verified_bytes["envs/kaggriculture/kaggriculture.json"]
   131	    )
   132	    environment = core.Environment(
   133	        specification=raw_specification,
   134	        interpreter=lambda state, _environment: state,
   135	        renderer=lambda *_args: "",
   136	        html_renderer=lambda *_args: "",
   137	        state={},
   138	    )
   139	    episode = environment.toJSON()
   140	    return {
   141	        "specification": episode["specification"],
   142	        "default_configuration": episode["configuration"],
   143	        "envelope": {
   144	            key: episode[key]
   145	            for key in (
   146	                "id",
   147	                "name",
   148	                "title",
   149	                "description",
   150	                "version",
   151	                "module_version",
   152	                "schema_version",
   153	            )
   154	        },
   155	        "hashes": hashes,
   156	    }
   157	
   158	
   159	def _schema_difference(actual: Any, expected: Any, pointer: str) -> str | None:
   160	    if isinstance(expected, dict):
   161	        if not isinstance(actual, dict):
   162	            return pointer
   163	        for key, value in expected.items():
   164	            child = pointer + "/" + key.replace("~", "~0").replace("/", "~1")
   165	            if key not in actual:
   166	                return child
   167	            difference = _schema_difference(actual[key], value, child)
   168	            if difference is not None:
   169	                return difference
   170	        if list(actual) != list(expected):
   171	            return pointer
   172	        return None
   173	    if isinstance(expected, list):
   174	        if not isinstance(actual, list):
   175	            return pointer
   176	        if len(actual) != len(expected):
   177	            return pointer
   178	        for index, (left, right) in enumerate(zip(actual, expected, strict=True)):
   179	            difference = _schema_difference(left, right, f"{pointer}/{index}")
   180	            if difference is not None:
   181	                return difference
   182	        return None
   183	    return None if type(actual) is type(expected) and actual == expected else pointer
   184	
