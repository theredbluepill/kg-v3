    50	def _publish_new_file(path: Path, payload: bytes, published: list[Path]) -> None:
    51	    """Durably publish ``payload`` at ``path``, which must not exist yet.
    52	
    53	    The bytes go to a dot-prefixed temporary file in the same directory (never
    54	    matched by ``game_*`` globs), are flushed and fsynced, then hard-linked into
    55	    place. Unlike rename, linking atomically refuses to replace a path created
    56	    meanwhile. ``path`` is appended to ``published`` as soon as it exists, so
    57	    the caller can remove exactly what this attempt created. The temporary file
    58	    is always removed.
    59	    """
    60	    temporary = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    61	    try:
    62	        with temporary.open("xb") as stream:
    63	            stream.write(payload)
    64	            stream.flush()
    65	            os.fsync(stream.fileno())
    66	        os.link(temporary, path)
    67	        published.append(path)
    68	    finally:
    69	        temporary.unlink(missing_ok=True)
    70	
    71	
    72	def _fsync_directory(directory: Path) -> None:
    73	    """Make published directory entries durable."""
    74	    descriptor = os.open(directory, os.O_RDONLY)
    75	    try:
    76	        os.fsync(descriptor)
    77	    finally:
    78	        os.close(descriptor)
    79	
    80	
    81	def _publish(directory: Path, files: Sequence[tuple[Path, bytes]]) -> None:
    82	    """Publish ``files`` in order; on any failure remove what was published."""
    83	    published: list[Path] = []
    84	    try:
    85	        for path, payload in files:
    86	            _publish_new_file(path, payload, published)
    87	        _fsync_directory(directory)
    88	    except BaseException:
    89	        for path in reversed(published):
    90	            path.unlink(missing_ok=True)
    91	        raise
