   292	@dataclass
   293	class _ActiveReplay:
   294	    game_ordinal: int
   295	    env_index: int
   296	    seed_header: dict[str, Any]
   297	    seat_assignment: int
   298	    checkpoint_hashes: dict[str, str]
   299	    versions: dict[str, Any]
   300	    transitions: list[dict[str, Any]] = field(default_factory=list)
   301	    captured: dict[str, Any] = field(default_factory=dict)
   302	
   303	
   304	class ReplayRecorder:
   305	    """Record selected games and materialize them only after completion/truncation.
   306	
   307	    ``config`` is the caller's ``cfg.rl``; its ``eval_replay_games`` is the default
   308	    count (eight in the two supported rank configs). Failed export or evidence
   309	    comparison writes an error custody record and no successful episode.
   310	    """
   311	
   312	    def __init__(
   313	        self,
   314	        *,
   315	        output_dir: Path,
   316	        evaluation_identity: str,
   317	        total_games: int,
   318	        config: ReplayConfig,
   319	        count: int | None = None,
   320	        seat_assignments: Sequence[int] | None = None,
   321	    ) -> None:
   322	        self.output_dir = output_dir
   323	        self.evaluation_identity = evaluation_identity
   324	        self.selected_games = select_replay_games(
   325	            evaluation_identity,
   326	            total_games,
   327	            config.eval_replay_games if count is None else count,
   328	            seat_assignments=seat_assignments,
   329	        )
   330	        self._seat_assignments = (
   331	            tuple(seat_assignments) if seat_assignments is not None else None
   332	        )
   333	        self._active: dict[int, _ActiveReplay] = {}
   334	        self._finished: set[int] = set()
   335	        self._framework = load_pinned_framework() if self.selected_games else None
   336	
   337	    def start_game(
   338	        self,
   339	        game_ordinal: int,
   340	        env_index: int,
   341	        resolved_seed: int,
   342	        configuration: Mapping[str, Any],
   343	        seat_assignment: int,
   344	        checkpoint_hashes: Mapping[str, str],
   345	        versions: Mapping[str, Any],
   346	        *,
   347	        captured_initial: Mapping[str, Any] | None = None,
   348	    ) -> None:
   349	        if game_ordinal not in self.selected_games:
   350	            return
   351	        if game_ordinal in self._active or game_ordinal in self._finished:
   352	            raise ValueError(f"game {game_ordinal} was already started")
   353	        if type(resolved_seed) is not int or resolved_seed < 0:
   354	            raise ValueError("resolved_seed must be an exact non-negative integer")
   355	        if type(env_index) is not int or env_index < 0:
   356	            raise ValueError("env_index must be a non-negative integer")
   357	        if type(seat_assignment) is not int or seat_assignment not in (0, 1):
   358	            raise ValueError("seat_assignment must be 0 or 1")
   359	        if (
   360	            self._seat_assignments is not None
   361	            and self._seat_assignments[game_ordinal] != seat_assignment
   362	        ):
   363	            raise ValueError("seat_assignment differs from the selection schedule")
   364	        for key in ("source", "engine", "schema_version"):
   365	            if key not in versions:
   366	                raise ValueError(f"versions lacks {key}")
   367	        for key in ("source", "engine"):
   368	            if not isinstance(versions[key], str) or not versions[key]:
   369	                raise ValueError(f"versions.{key} must identify the source")
   370	        for key in ("candidate", "incumbent"):
   371	            digest = checkpoint_hashes.get(key)
   372	            if (
   373	                not isinstance(digest, str)
   374	                or len(digest) != 64
   375	                or any(char not in "0123456789abcdefABCDEF" for char in digest)
   376	            ):
   377	                raise ValueError(f"checkpoint_hashes.{key} must be a SHA-256")
   378	        if self._framework is None:
   379	            raise ValueError("selected replay has no pinned framework")
   380	        provenance = {
   381	            key: versions[key] for key in ("source", "engine", "schema_version")
   382	        }
   383	        provenance["target_framework_version"] = FRAMEWORK_VERSION
   384	        envelope = deepcopy(self._framework["envelope"])
   385	        envelope["id"] = f"{self.evaluation_identity}:game:{game_ordinal}"
   386	        resolved_configuration = deepcopy(self._framework["default_configuration"])
   387	        resolved_configuration.update(deepcopy(dict(configuration)))
   388	        resolved_configuration["seed"] = None
   389	        header = {
   390	            "seed": resolved_seed,
   391	            "configuration": resolved_configuration,
   392	            "provenance": deepcopy(provenance),
   393	            "specification": deepcopy(self._framework["specification"]),
   394	            "envelope": envelope,
   395	        }
   396	        captured = (
   397	            {}
   398	            if captured_initial is None
   399	            else {"initial": deepcopy(dict(captured_initial))}
   400	        )
   401	        self._active[game_ordinal] = _ActiveReplay(
   402	            game_ordinal,
   403	            env_index,
   404	            header,
   405	            seat_assignment,
   406	            deepcopy(dict(checkpoint_hashes)),
   407	            deepcopy(dict(versions)),
   408	            captured=captured,
   409	        )
   410	
   411	    def record_transition(
   412	        self,
   413	        game_ordinal: int,
   414	        actions: Sequence[Mapping[str, Any]],
   415	        *,
   416	        tokens: Sequence[Mapping[str, Any]] | None = None,
   417	        captured: Mapping[str, Any] | None = None,
   418	    ) -> None:
   419	        if game_ordinal not in self.selected_games:
   420	            return
   421	        replay = self._require_active(game_ordinal)
   422	        if len(actions) != 2:
   423	            message = "transition requires exactly two seat actions"
   424	            self.fail_game(game_ordinal, error=message)
   425	            raise ValueError(message)
   426	        transition: dict[str, Any] = {"actions": deepcopy(list(actions))}
   427	        if tokens is not None:
   428	            if len(tokens) != 2:
   429	                message = "tokens requires exactly two seat rows"
   430	                self.fail_game(game_ordinal, error=message)
   431	                raise ValueError(message)
   432	            transition["tokens"] = deepcopy(list(tokens))
   433	        if captured is not None:
   434	            evidence = deepcopy(dict(captured))
   435	            try:
   436	                if "public" in evidence:
   437	                    banks = [farm["money"] for farm in evidence["public"]["farms"]]
   438	                else:
   439	                    banks = evidence["banks"]
   440	                if not isinstance(banks, list) or len(banks) != 2:
   441	                    raise TypeError("expected two seat banks")
   442	            except (KeyError, TypeError) as error:
   443	                message = f"captured evidence needs a snapshot or two banks: {error}"
   444	                self.fail_game(game_ordinal, error=message)
   445	                raise ValueError(message) from error
   446	            if "public" in evidence:
   447	                replay.captured.setdefault("snapshots", []).append(
   448	                    {"transition": len(replay.transitions), "snapshot": evidence}
   449	                )
   450	            replay.captured.setdefault("banks", []).append(banks)
   451	        replay.transitions.append(transition)
   452	
   453	    def finish_game(self, game_ordinal: int, terminal: Mapping[str, Any]) -> None:
   454	        if game_ordinal not in self.selected_games:
   455	            return
   456	        replay = self._require_active(game_ordinal)
   457	        replay.captured["terminal"] = deepcopy(dict(terminal))
   458	        self._write(replay, status="complete")
   459	
   460	    def truncate_game(self, game_ordinal: int, *, reason: str) -> None:
   461	        if game_ordinal not in self.selected_games:
   462	            return
   463	        self._write(
   464	            self._require_active(game_ordinal), status="truncated", reason=reason
   465	        )
   466	
   467	    def fail_game(self, game_ordinal: int, *, error: str) -> None:
   468	        """Record a caller-observed native failure without pretending it committed."""
   469	        if game_ordinal not in self.selected_games:
   470	            return
   471	        self._write(self._require_active(game_ordinal), status="error", reason=error)
   472	
   473	    @property
   474	    def active_games(self) -> frozenset[int]:
   475	        """Selected games started but not yet written as complete/partial/error."""
   476	        return frozenset(self._active)
   477	
   478	    def fail_active_games(self, *, error: str) -> list[tuple[int, Exception]]:
   479	        """Write error custody for every active game, e.g. when evaluation aborts.
   480	
   481	        Each game keeps only its committed transitions. A game whose record
   482	        cannot be published stays active; its ordinal and publication error are
   483	        returned so the caller can report them without masking the abort cause.
   484	        """
   485	        failures: list[tuple[int, Exception]] = []
   486	        for game_ordinal in sorted(self._active):
   487	            try:
   488	                self.fail_game(game_ordinal, error=error)
   489	            except Exception as publication_error:
   490	                failures.append((game_ordinal, publication_error))
   491	        return failures
   492	
   493	    def _require_active(self, game_ordinal: int) -> _ActiveReplay:
   494	        if game_ordinal not in self._active:
   495	            raise ValueError(f"selected game {game_ordinal} is not active")
   496	        return self._active[game_ordinal]
   497	
   498	    def _write(
   499	        self, replay: _ActiveReplay, *, status: str, reason: str | None = None
   500	    ) -> None:
   501	        tape = {"complete": status == "complete", "transitions": replay.transitions}
   502	        sidecar: dict[str, Any] = {
   503	            "schema_version": 1,
   504	            "evaluation_identity": self.evaluation_identity,
   505	            "game_ordinal": replay.game_ordinal,
   506	            "env_index": replay.env_index,
   507	            "status": status,
   508	            "complete": status == "complete",
   509	            "seed_header": replay.seed_header,
   510	            "action_tape": tape,
   511	            "checkpoint_hashes": replay.checkpoint_hashes,
   512	            "seat_assignment": replay.seat_assignment,
   513	            "versions": replay.versions,
   514	            "framework_hashes": self._framework["hashes"] if self._framework else {},
   515	            "captured": replay.captured,
   516	            "producer": "v3 native replay; not executed by the Python framework",
   517	        }
   518	        if reason is not None:
   519	            sidecar["error" if status == "error" else "reason"] = reason
   520	        episode_bytes: bytes | None = None

