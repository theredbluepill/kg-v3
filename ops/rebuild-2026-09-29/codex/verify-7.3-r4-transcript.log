   186	def validate_native_replay_input(json_text: str, episode: bool) -> None:
   187	    """Guard every PyO3 entry against the installed, hash-verified framework.
   188	
   189	    Pure Rust replay accepts its caller-supplied specification as trusted. The
   190	    Python-facing boundary admits only the processed pinned schema and a fully
   191	    resolved configuration; framework time budgets may differ only within that
   192	    schema. This function validates metadata and never transforms game state.
   193	    """
   194	    framework = load_pinned_framework()
   195	    try:
   196	        data = json.loads(json_text)
   197	    except (ValueError, TypeError) as error:
   198	        raise ValueError(f"/ (transition None): invalid JSON: {error}") from error
   199	    if not isinstance(data, dict):
   200	        raise ValueError("/ (transition None): expected replay object")
   201	    if "specification" not in data:
   202	        raise ValueError("/specification (transition None): required pinned schema")
   203	    difference = _schema_difference(
   204	        data["specification"], framework["specification"], "/specification"
   205	    )
   206	    if difference is not None:
   207	        raise ValueError(f"{difference} (transition None): differs from pinned schema")
   208	    envelope = data if episode else data.get("envelope")
   209	    envelope_pointer = "" if episode else "/envelope"
   210	    if not isinstance(envelope, dict):
   211	        raise ValueError(f"{envelope_pointer} (transition None): expected envelope")
   212	    if not isinstance(envelope.get("id"), str):
   213	        raise ValueError(f"{envelope_pointer}/id (transition None): expected string")
   214	    for key, expected in framework["envelope"].items():
   215	        if key == "id":
   216	            continue
   217	        if (
   218	            key not in envelope
   219	            or type(envelope[key]) is not type(expected)
   220	            or envelope[key] != expected
   221	        ):
   222	            raise ValueError(
   223	                f"{envelope_pointer}/{key} (transition None): "
   224	                "differs from pinned envelope"
   225	            )
   226	    configuration = data.get("configuration")
   227	    if not isinstance(configuration, dict):
   228	        raise ValueError("/configuration (transition None): expected resolved object")
   229	    expected_keys = set(framework["specification"]["configuration"])
   230	    actual_keys = set(configuration)
   231	    if actual_keys != expected_keys:
   232	        key = sorted(actual_keys ^ expected_keys)[0]
   233	        raise ValueError(
   234	            f"/configuration/{key} (transition None): missing or unknown resolved field"
   235	        )
   236	    utils = importlib.import_module("kaggle_environments.utils")
   237	    for key, field_schema in framework["specification"]["configuration"].items():
   238	        error, _processed = utils.process_schema(
   239	            field_schema, deepcopy(configuration[key])
   240	        )
   241	        if error:
   242	            raise ValueError(f"/configuration/{key} (transition None): {error}")
   243	    if configuration["seed"] is not None:
   244	        raise ValueError(
   245	            "/configuration/seed (transition None): resolved seed must be null"
   246	        )
   247	
   248	
   249	def select_replay_games(
   250	    evaluation_identity: str,
   251	    total_games: int,
   252	    count: int,
   253	    *,
   254	    seat_assignments: Sequence[int] | None = None,
   255	) -> frozenset[int]:
   256	    """Select stable ordinals, stratified by the supplied model-seat schedule.
   257	
   258	    The caller supplies the actual evaluation schedule when both assignments
   259	    occur; ordinal parity is never treated as an implicit seat assignment.
   260	    Count zero disables recording. A positive count below the number of seat
   261	    assignments cannot cover both and is rejected explicitly.
   262	    """
   263	    if not evaluation_identity:
   264	        raise ValueError("evaluation_identity must be non-empty")
   265	    if type(total_games) is not int or total_games < 0:
   266	        raise ValueError("total_games must be a non-negative integer")
   267	    if type(count) is not int or not 0 <= count <= total_games:
   268	        raise ValueError("count must be a non-negative integer <= total_games")
   269	    groups: dict[int, list[int]] = {}
   270	    if seat_assignments is not None:
   271	        if len(seat_assignments) != total_games:
   272	            raise ValueError("seat_assignments length must equal total_games")
   273	        for ordinal, seat in enumerate(seat_assignments):
   274	            if type(seat) is not int or seat not in (0, 1):
   275	                raise ValueError("seat_assignments entries must be 0 or 1")
   276	            groups.setdefault(seat, []).append(ordinal)
   277	    if count == 0:
   278	        return frozenset()
   279	    if count < len(groups):
   280	        raise ValueError("count cannot cover both model-seat assignments")
   281	    seed = int.from_bytes(hashlib.sha256(evaluation_identity.encode("utf-8")).digest())
   282	    rng = random.Random(seed)
   283	    selected = {rng.choice(groups[seat]) for seat in sorted(groups)}
   284	    selected.update(
   285	        rng.sample(
   286	            [i for i in range(total_games) if i not in selected], count - len(selected)
   287	        )
   288	    )
   289	    return frozenset(selected)
   290	
