[project]
name = "owl"
version = "0.1.0"
description = "An RL library for the Kaggle 2026 Orbit Wars competition"
readme = "README.md"
authors = [
    { name = "IsaiahPressman" }
]
requires-python = ">=3.11"
dependencies = [
    "kaggle-environments>=1.28.0",
    "numpy>=2.4.4",
    "pydantic>=2.13.2",
    "pyyaml>=6.0.3",
    "torch==2.9.0",
    "tqdm>=4.67.3",
    "wandb>=0.26.0",
]

[dependency-groups]
dev = [
    "kaggle>=2.1.0",
    "maturin>=1.13.1,<2.0",
    "mypy",
