   606	def pairing_sample(
   607	    tasks: Sequence[EpisodeTask], count: int, mapper: Any
   608	) -> dict[str, Any]:
   609	    step = max(1, len(tasks) // count)
   610	    chosen = list(tasks[::step][:count])
   611	    results = list(mapper(_pairing_task, chosen))
   612	    matches = sum(r["matches"] for r in results)
   613	    total = sum(r["total"] for r in results)
   614	    return {
   615	        "engine": _engine_identity(),
   616	        "episodes": results,
   617	        "matches": matches,
   618	        "total": total,
   619	        "fraction": matches / total if total else 0.0,
   620	    }
