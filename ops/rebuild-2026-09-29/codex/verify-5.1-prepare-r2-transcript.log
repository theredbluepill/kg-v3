   765	def main(argv: Sequence[str] | None = None) -> int:
   766	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   767	    parser.add_argument("archives", type=Path, help="directory of day archive ZIPs")
   768	    parser.add_argument(
   769	        "out_dir", type=Path, help="dataset root (outside the checkout)"
   770	    )
   771	    parser.add_argument("--month", default="2026-09")
   772	    parser.add_argument("--days", default="22-28", help="e.g. 22-28 or 22,23")
   773	    parser.add_argument(
   774	        "--workers", type=int, default=max(1, min(16, (os.cpu_count() or 2) - 2))
   775	    )
   776	    parser.add_argument("--validation-fraction", type=float, default=0.03)
   777	    stride = parser.add_mutually_exclusive_group()
   778	    stride.add_argument("--turn-stride", type=int, default=None)
   779	    stride.add_argument(
   780	        "--resident-budget-gib",
   781	        type=float,
   782	        default=None,
   783	        help="derive the turn stride so all turn rows fit this host-memory budget",
   784	    )
   785	    parser.add_argument("--limit-episodes", type=int, default=None)
   786	    parser.add_argument("--pairing-sample", type=int, default=0)
   787	    parser.add_argument("--pairing-only", action="store_true")
   788	    args = parser.parse_args(argv)
   789	    if not 0.0 < args.validation_fraction < 1.0:
   790	        raise ValueError("--validation-fraction must be in (0, 1)")
   791	    if args.workers < 1:
   792	        raise ValueError("--workers must be >= 1")
   793	    repo = Path(__file__).resolve().parents[1]
   794	    out_dir: Path = args.out_dir.resolve()
   795	    if out_dir.is_relative_to(repo):
   796	        raise ValueError("out_dir must lie outside the checkout")
   797	    if (out_dir / "manifest.json").exists():
   798	        raise FileExistsError(f"{out_dir}/manifest.json exists; dataset is complete")
   799	    run = _source_identity(repo)
   800	    days = _parse_days(args.days)
   801	    tasks = list_tasks(
   802	        args.archives,
   803	        month=args.month,
   804	        days=days,
   805	        validation_fraction=args.validation_fraction,
   806	        turn_stride=1,
   807	    )
   808	    if args.limit_episodes is not None:
   809	        tasks = tasks[: args.limit_episodes]
   810	    if not tasks:
   811	        raise ValueError("no episodes found")
   812	    turn_stride = args.turn_stride or 1
   813	    if args.resident_budget_gib is not None:
   814	        turn_stride = stride_for_budget(len(tasks), args.resident_budget_gib)
   815	    tasks = [
   816	        EpisodeTask(t.archive, t.member, t.day, t.episode_id, t.split, turn_stride)
   817	        for t in tasks
   818	    ]
   819	    out_dir.mkdir(parents=True, exist_ok=True)
   820	    archive_sha256 = {
   821	        Path(archive).name: _sha256(Path(archive))
   822	        for archive in sorted({t.archive for t in tasks})
   823	    }
   824	    _bind_identity(
   825	        out_dir,
   826	        {
   827	            "run": run,
   828	            "month": args.month,
   829	            "days": days,
   830	            "validation_fraction": args.validation_fraction,
   831	            "turn_stride": turn_stride,
   832	            "hire_limit": HIRE_LIMIT,
   833	            "label_pairing": LABEL_PAIRING,
   834	            "archive_sha256": archive_sha256,
   835	        },
   836	    )
   837	    print(
   838	        f"episodes={len(tasks)} days={days} turn_stride={turn_stride} "
   839	        f"bytes_per_turn_row={resident_bytes_per_turn()} workers={args.workers}",
   840	        flush=True,
   841	    )
   842	    with _mapper(args.workers) as mapper:
   843	        if args.pairing_sample > 0:
   844	            pairing = pairing_sample(tasks, args.pairing_sample, mapper)
   845	            (out_dir / PAIRING_NAME).write_text(json.dumps(pairing, indent=2) + "\n")
   846	            print(
   847	                f"pairing: {pairing['matches']}/{pairing['total']} transitions match "
   848	                f"({pairing['fraction']:.4f}) over {len(pairing['episodes'])} episodes",
   849	                flush=True,
   850	            )
   851	            if args.pairing_only:
   852	                return 0
   853	        records: list[dict[str, Any]] = []
   854	        todo: list[EpisodeTask] = []
   855	        for task in tasks:
   856	            path = _record_path(out_dir, task)
   857	            if path.is_file():
   858	                records.append(json.loads(path.read_text(encoding="utf-8")))
   859	            else:
   860	                todo.append(task)
   861	        print(f"resuming: {len(records)} done, {len(todo)} to do", flush=True)
   862	        for index, record in enumerate(
   863	            mapper(_run_task, [(t, str(out_dir)) for t in todo]), 1
   864	        ):
   865	            records.append(record)
   866	            if index % 50 == 0 or index == len(todo):
   867	                print(f"episodes {index}/{len(todo)}", flush=True)
   868	    pairing_path = out_dir / PAIRING_NAME
   869	    manifest = build_manifest(
   870	        out_dir,
   871	        records,
   872	        {
   873	            "run": run
   874	            | {
   875	                "command": [sys.executable, *sys.argv],
   876	                "workers": args.workers,
   877	                "hire_limit": HIRE_LIMIT,
   878	                "turn_stride": turn_stride,
   879	                "bytes_per_turn_row": resident_bytes_per_turn(),
   880	                "validation_fraction": args.validation_fraction,
   881	                "label_pairing": LABEL_PAIRING,
   882	                "policy_seats": "winner by final bank; both on a draw",
   883	            },
   884	            "source": {
