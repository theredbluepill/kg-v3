   125	# --- pure helpers (unit tested) ---------------------------------------------------
   126	
   127	
   128	def validation_split(episode_id: str, fraction: float) -> bc_data.Split:
   129	    """Deterministic episode-level split: a hash of the id, never of its content."""
   130	    bucket = int(hashlib.sha256(episode_id.encode()).hexdigest()[:8], 16) % 10_000
   131	    return "validation" if bucket < round(fraction * 10_000) else "train"
   132	
   133	
   134	def kept_turns(episode_id: str, stride: int) -> list[int]:
   135	    """Turns ``t`` in ``0..718`` kept under ``stride``, phase-shifted per episode."""
   136	    if stride < 1:
   137	        raise ValueError(f"turn stride must be >= 1, got {stride}")
   138	    offset = int(hashlib.sha256(f"turn:{episode_id}".encode()).hexdigest()[:8], 16)
   139	    return [t for t in range(PAIRED_TURNS) if (t + offset) % stride == 0]
   140	
   141	
   142	def winner_seats(banks: Sequence[float]) -> tuple[bool, bool]:
   143	    """Policy seats: the larger final bank, both on a draw."""
   144	    return (banks[0] >= banks[1], banks[1] >= banks[0])
   145	
   146	
   147	def check_envelope(data: dict[str, Any], episode_id: str) -> None:
   148	    steps = data.get("steps")
   149	    if not isinstance(steps, list) or len(steps) != EPISODE_STEPS:
   150	        count = len(steps) if isinstance(steps, list) else None
   151	        raise EpisodeRejected(f"steps: expected {EPISODE_STEPS}, got {count}")
   152	    if any(not isinstance(step, list) or len(step) != 2 for step in steps):
   153	        raise EpisodeRejected("steps: every step needs exactly two seats")
   154	    info = data.get("info")
   155	    if not isinstance(info, dict) or str(info.get("EpisodeId")) != episode_id:
   156	        raise EpisodeRejected("info.EpisodeId differs from the member name")
   157	    seed = info.get("seed")
   158	    if isinstance(seed, bool) or not isinstance(seed, int):
   159	        raise EpisodeRejected("info.seed is not an integer")
   160	    statuses = [seat.get("status") for seat in steps[-1]]
   161	    if statuses != ["DONE", "DONE"]:
   162	        raise EpisodeRejected(f"final statuses {statuses}")
   163	    config = data.get("configuration")
   164	    if not isinstance(config, dict):
   165	        raise EpisodeRejected("configuration missing")
   166	    missing = CONFIG_KEYS - set(config)
   167	    extra = set(config) - CONFIG_KEYS - CONFIG_EXTRA_KEYS
   168	    if missing or extra:
   169	        raise EpisodeRejected(
   170	            f"configuration keys: missing {sorted(missing)}, extra {sorted(extra)}"
   171	        )
   172	    if config["episodeSteps"] != EPISODE_STEPS:
   173	        raise EpisodeRejected(f"episodeSteps {config['episodeSteps']}")
   174	
   175	
   176	def final_banks(data: dict[str, Any]) -> tuple[float, float]:
   177	    farms = data["steps"][-1][0]["observation"]["farms"]
   178	    banks = (float(farms[0]["money"]), float(farms[1]["money"]))
   179	    if not all(math.isfinite(bank) for bank in banks):
   180	        raise EpisodeRejected(f"final banks not finite: {banks}")
   181	    return banks
   182	
   183	
   184	def turn_header(data: dict[str, Any], t: int, *, seed: int = 0) -> dict[str, Any]:
   185	    """Explicit-state header for ``steps[t]``; seat 1's shared keys from seat 0.
   186	
   187	    Encoding always uses the placeholder seed 0, so the recorded seed never
   188	    reaches observation buffers.
   189	    """
   190	    obs0 = data["steps"][t][0]["observation"]
   191	    obs1 = data["steps"][t][1]["observation"]
   192	    return {
   193	        "format": "kaggriculture-re-parity-v1",
   194	        "seed": seed,
   195	        "configuration": data["configuration"],
   196	        "shop_schedule": [],
   197	        "rng_schedule": [],
   198	        "initial": {
   199	            "public": {key: obs0[key] for key in PUBLIC_KEYS},
   200	            "privates": [obs0["private"], obs1["private"]],
   201	        },
   202	        "terminal_banks": [],
   203	        "transitions": 0,
   204	    }
   205	
   206	
   207	def _falsy_kind(value: object) -> str | None:
   208	    """The reference's ``raw.get(k) or []``: which falsy value became ``[]``."""
   209	    if value is _ABSENT:
   210	        return "absent"
   211	    if value is None:
   212	        return "null"
   213	    if value is False:
   214	        return "false"
   215	    if isinstance(value, (int, float)) and not isinstance(value, bool) and value == 0:
   216	        return "zero"
   217	    if isinstance(value, str) and value == "":
   218	        return "empty_string"
   219	    if isinstance(value, dict) and not value:
   220	        return "empty_object"
   221	    return None
   222	
   223	
   224	def normalize_action(raw: object) -> tuple[dict[str, Any], list[str]]:
   225	    """Reference envelope normalization; raises ``ValueError`` on a bad envelope."""
   226	    if not isinstance(raw, dict) or not set(raw) <= ACTION_KEYS:
   227	        raise ValueError("action envelope")
   228	    action: dict[str, Any] = {"farmer": raw.get("farmer")}
   229	    normalized: list[str] = []
   230	    for key in ("hands", "market"):
   231	        value = raw.get(key, _ABSENT)
   232	        kind = _falsy_kind(value)
   233	        if kind is not None:
   234	            normalized.append(f"normalized_{key}_{kind}")
   235	            value = []
   236	        elif not isinstance(value, list):
   237	            raise ValueError("action envelope")
   238	        action[key] = value
   239	    return action, normalized
   240	
   241	
   242	def pass_action(actors: int) -> dict[str, Any]:
   243	    return {"farmer": ["PASS"], "hands": [["PASS"]] * (actors - 1), "market": []}
   244	
