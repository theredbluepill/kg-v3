   623	def _engine_identity() -> dict[str, str]:
   624	    from importlib import metadata
   625	
   626	    kaggriculture = importlib.import_module(
   627	        "kaggle_environments.envs.kaggriculture.kaggriculture"
   628	    )
   629	
