   683	def _sha256(path: Path) -> str:
   684	    digest = hashlib.sha256()
   685	    with path.open("rb") as handle:
   686	        for block in iter(lambda: handle.read(1 << 20), b""):
   687	            digest.update(block)
   688	    return digest.hexdigest()
