   393	                    rejections[f"placeholder {rejection_reason(error)}"] += 1
   394	                    ok = False
   395	                continue
   396	            # Step+1 pairing: the action answering steps[t] is recorded at steps[t + 1].
   397	            raw = data["steps"][t + 1][seat]["action"]
   398	            try:
