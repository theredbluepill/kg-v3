   250	def resident_bytes_per_turn() -> int:
   251	    """Host bytes one turn row occupies in ``load_bc_dataset``'s compact store."""
   252	    sizes = {torch.int64: 4, torch.float32: 4, torch.float64: 8, torch.bool: 1}
   253	    per_seat = sum(
   254	        sizes[dtype] * math.prod(shape) for dtype, shape, _, _ in kt._SCHEMA.values()
   255	    )
   256	    labels = kt.MAX_FRAMES + 2 * kt.MAX_FRAMES * kt.ACTION_SLOTS + 4 + 1
   257	    return kt.PLAYERS * (per_seat + labels) + 4 + 8
