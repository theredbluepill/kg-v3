   640	def build_manifest(
   641	    out_dir: Path, records: Sequence[dict[str, Any]], custody: dict[str, Any]
   642	) -> bc_data.BCManifest:
   643	    kept = sorted(
   644	        (r for r in records if "rejected" not in r),
   645	        key=lambda r: (r["day"], r["episode_id"]),
   646	    )
   647	    rejected = sorted(
   648	        (r for r in records if "rejected" in r),
   649	        key=lambda r: (r["day"], r["episode_id"]),
   650	    )
   651	    totals: dict[str, dict[str, int]] = {}
   652	    for split in ("train", "validation"):
   653	        mine = [r for r in kept if r["split"] == split]
   654	        totals[split] = {
   655	            "episodes": len(mine),
   656	            "admitted_turns": sum(r["admitted"] for r in mine),
   657	            "policy_seat_rows": sum(
   658	                r["admitted"] * len(r["policy_seats"]) for r in mine
   659	            ),
   660	            "draw_episodes": sum(len(r["policy_seats"]) == 2 for r in mine),
   661	        }
   662	    turn_rejections: Counter[str] = Counter()
   663	    normalizations: Counter[str] = Counter()
   664	    for r in kept:
   665	        turn_rejections.update(r["rejections"])
   666	        normalizations.update(r["normalizations"])
   667	    episode_rejections = Counter(
   668	        rejection_reason(Exception(r["rejected"])) for r in rejected
   669	    )
   670	    episodes = [bc_data.BCManifestEpisode.model_validate(r) for r in kept]
   671	    return bc_data.write_bc_manifest(
   672	        out_dir,
   673	        episodes,
   674	        **custody,
   675	        totals=totals,
   676	        turn_rejections=dict(sorted(turn_rejections.items())),
   677	        normalizations=dict(sorted(normalizations.items())),
   678	        episode_rejections=dict(sorted(episode_rejections.items())),
   679	        rejected_episodes=rejected,
   680	    )
