   738	def _bind_identity(out_dir: Path, identity: dict[str, Any]) -> None:
   739	    """Record the preparation identity, or require an exact match on resume."""
   740	    records = out_dir / RECORD_DIR
   741	    path = records / IDENTITY_NAME
   742	    if path.is_file():
   743	        stored = json.loads(path.read_text(encoding="utf-8"))
   744	        if stored != identity:
   745	            changed = sorted(
   746	                key
   747	                for key in stored.keys() | identity.keys()
   748	                if stored.get(key) != identity.get(key)
   749	            )
   750	            raise RuntimeError(
   751	                f"{path} differs from this run in {changed}; "
   752	                "prepare into a fresh out_dir"
   753	            )
   754	        return
   755	    if records.is_dir() and any(records.glob("*.json")):
   756	        raise RuntimeError(
   757	            f"{records} has records but no {IDENTITY_NAME}; use a fresh out_dir"
   758	        )
   759	    records.mkdir(parents=True, exist_ok=True)
   760	    path.write_text(
   761	        json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
   762	    )
