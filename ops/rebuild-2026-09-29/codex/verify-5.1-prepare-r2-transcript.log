   691	def _source_identity(repo: Path) -> dict[str, Any]:
   692	    head = subprocess.run(
   693	        ["git", "-C", str(repo), "rev-parse", "HEAD"],
   694	        check=True,
   695	        capture_output=True,
   696	        text=True,
   697	    ).stdout.strip()
   698	    dirty = subprocess.run(
   699	        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=no"],
   700	        check=True,
   701	        capture_output=True,
   702	        text=True,
   703	    ).stdout.strip()
   704	    if dirty:
   705	        raise RuntimeError(f"refusing to prepare from a dirty checkout:\n{dirty}")
   706	    extension = Path(str(rs.__file__))
   707	    return {
   708	        "git_head": head,
   709	        "uv_lock_sha256": _sha256(repo / "uv.lock"),
   710	        "cargo_lock_sha256": _sha256(repo / "Cargo.lock"),
   711	        "prepare_sha256": _sha256(Path(__file__)),
   712	        "owl_rs_extension": extension.name,
   713	        "owl_rs_sha256": _sha256(extension),
   714	    }
