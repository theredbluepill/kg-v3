   507	# --- pairing sanity with Kaggle's own engine --------------------------------------
   508	
   509	
   510	def pairing_check(data: dict[str, Any]) -> tuple[int, list[dict[str, Any]]]:
   511	    """Step Kaggle's interpreter from ``steps[t]`` with ``steps[t + 1].action``.
   512	
   513	    Returns the number of the 719 transitions whose public state and both
   514	    privates equal ``steps[t + 1]`` (value equality), plus the mismatches.
   515	    """
   516	    # kaggle_environments ships no type information; bind it through importlib.
   517	    interpreter = importlib.import_module(
   518	        "kaggle_environments.envs.kaggriculture.kaggriculture"
   519	    ).interpreter
   520	    utils = importlib.import_module("kaggle_environments.utils")
   521	    Struct, structify = utils.Struct, utils.structify
   522	
   523	    env = Struct(
   524	        configuration=structify(copy.deepcopy(data["configuration"])),
   525	        info={"seed": data["info"]["seed"]},
   526	        done=False,
   527	    )
   528	    steps = data["steps"]
   529	    matches = 0
   530	    mismatches: list[dict[str, Any]] = []
   531	    for t in range(PAIRED_TURNS):
   532	        # structify copies every container. Kaggle shares one public
   533	        # farms/market/town object across seats, so both seats get the same one.
   534	        public = structify({k: steps[t][0]["observation"][k] for k in PUBLIC_KEYS})
   535	        state = []
   536	        for seat in (0, 1):
   537	            own = structify(
   538	                {
   539	                    k: v
   540	                    for k, v in steps[t][seat]["observation"].items()
   541	                    if k not in PUBLIC_KEYS
   542	                }
   543	            )
   544	            state.append(
   545	                Struct(
   546	                    observation=Struct(**own, **public),
   547	                    action=structify(steps[t + 1][seat]["action"]),
   548	                    status="ACTIVE",
   549	                    reward=0,
   550	                )
   551	            )
   552	        interpreter(state, env)
   553	        predicted: dict[str, Any] = _plain(
   554	            {
   555	                "public": {k: state[0].observation[k] for k in PAIRING_PUBLIC_KEYS},
   556	                "privates": [state[s].observation["private"] for s in (0, 1)],
   557	            }
   558	        )
   559	        nxt = steps[t + 1][0]["observation"]
   560	        expected: dict[str, Any] = {
   561	            "public": {k: nxt[k] for k in PAIRING_PUBLIC_KEYS},
   562	            "privates": [steps[t + 1][s]["observation"]["private"] for s in (0, 1)],
   563	        }
   564	        if predicted == expected:
   565	            matches += 1
   566	        else:
   567	            differing = [
   568	                k
   569	                for k in PAIRING_PUBLIC_KEYS
   570	                if predicted["public"][k] != expected["public"][k]
   571	            ] + [
   572	                f"private{s}"
   573	                for s in (0, 1)
   574	                if predicted["privates"][s] != expected["privates"][s]
   575	            ]
   576	            mismatches.append({"turn": t, "differs": differing})
   577	    return matches, mismatches
