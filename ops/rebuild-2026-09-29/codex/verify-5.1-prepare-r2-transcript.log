   720	@contextlib.contextmanager
   721	def _mapper(workers: int) -> Iterator[Callable[..., Iterable[Any]]]:
   722	    """In-process ``map`` for one worker, else a bounded spawn pool."""
   723	    if workers == 1:
   724	        yield map
   725	        return
   726	    context = multiprocessing.get_context("spawn")
   727	    with context.Pool(workers, maxtasksperchild=64) as pool:
   728	        yield pool.imap_unordered
