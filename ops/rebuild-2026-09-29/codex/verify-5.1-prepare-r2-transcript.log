   252	    sizes = {torch.int64: 4, torch.float32: 4, torch.float64: 8, torch.bool: 1}
   253	    per_seat = sum(
   254	        sizes[dtype] * math.prod(shape) for dtype, shape, _, _ in kt._SCHEMA.values()
   255	    )
