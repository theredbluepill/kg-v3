   490	def _record_path(out_dir: Path, task: EpisodeTask) -> Path:
   491	    return out_dir / RECORD_DIR / f"{task.day}-{task.episode_id}.json"
   492	
   493	
   494	def _write_record(out_dir: Path, task: EpisodeTask, record: dict[str, Any]) -> None:
   495	    path = _record_path(out_dir, task)
   496	    path.parent.mkdir(parents=True, exist_ok=True)
   497	    tmp = path.with_suffix(".tmp")
   498	    tmp.write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8")
   499	    os.replace(tmp, path)
