   260	def stride_for_budget(episodes: int, budget_gib: float) -> int:
   261	    rows = episodes * PAIRED_TURNS
   262	    budget_rows = int(budget_gib * 2**30) // resident_bytes_per_turn()
   263	    if budget_rows < 1:
   264	        raise ValueError(f"resident budget {budget_gib} GiB holds no turn row")
   265	    return max(1, math.ceil(rows / budget_rows))
