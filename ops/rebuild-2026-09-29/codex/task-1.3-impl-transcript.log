        min_one(optional_number(tile, "yield_units", 0.0)? / 8.0)
            + 0.25 * f64::from(truthy(tile.get("watered_today")))
            + 0.125 * f64::from(nonnegative_int(tile.get("fertilized_until_day"))?)
    } else if tile.contains_key("animal") {
