use kaggriculture_engine::{ATTRIB_FIELDS, Config, ECON_FIELDS, ECON_PASS, Game, TraceHeader};
use serde_json::{Value, json};
use std::path::Path;
use std::process::Command;

fn assert_public(actual: &Value, expected: &Value, context: &str) {
    assert_eq!(actual, expected, "public state: {context}");
    assert_key_order(actual, expected, "public", context);
}

fn assert_private(actual: &Value, expected: &Value, context: &str) {
    assert_eq!(actual, expected, "private state: {context}");
    assert_key_order(actual, expected, "private", context);
}

/// `Value` equality ignores object key order, but IndexMap insertion order is
/// engine state (market inventory/prices, sheds, seeds, inventories). Check the
/// key sequence of every object at every depth; callers assert equality first,
/// so both trees have identical shape here.
fn assert_key_order(actual: &Value, expected: &Value, label: &str, path: &str) {
    match (actual, expected) {
        (Value::Object(a), Value::Object(e)) => {
            assert_eq!(
                a.keys().collect::<Vec<_>>(),
                e.keys().collect::<Vec<_>>(),
                "{label} map key order: {path}"
            );
            for (key, value) in a {
                assert_key_order(value, &e[key], label, &format!("{path}.{key}"));
            }
        },
        (Value::Array(a), Value::Array(e)) => {
            for (index, (value, other)) in a.iter().zip(e).enumerate() {
                assert_key_order(value, other, label, &format!("{path}[{index}]"));
            }
        },
        _ => {},
    }
}

#[test]
#[should_panic(expected = "private map key order")]
fn private_order_mismatch_is_rejected() {
    let a: Value =
        serde_json::from_str(r#"[{"shed":{},"seeds":{},"inventories":[{"WHEAT":1,"MILK":2}]}]"#)
            .unwrap();
    let b: Value =
        serde_json::from_str(r#"[{"shed":{},"seeds":{},"inventories":[{"MILK":2,"WHEAT":1}]}]"#)
            .unwrap();
    assert_private(&a, &b, "negative comparator case");
}

#[test]
#[should_panic(expected = "public map key order")]
fn public_order_mismatch_is_rejected() {
    let a: Value =
