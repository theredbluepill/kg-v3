pub struct ObsBuffersMut<'a> { /* same 29 named fields as flat &mut [T] */ }
pub struct ValidatedObsBuffersMut<'a> { /* private slices + n_envs */ }
impl<'a> ObsBuffersMut<'a> {
    pub fn validate(self, n_envs: usize)
        -> Result<ValidatedObsBuffersMut<'a>, ObserveError>;
}
impl<'a> ValidatedObsBuffersMut<'a> {
