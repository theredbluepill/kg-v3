    if (problems.length) {
      process.stderr.write(`cookbook source references:\n${problems.join('\n')}\n`)
      process.exit(1)
    }
    process.exit(0)
  } catch (error) {
    process.stderr.write(`cookbook source references: ${error.message}\n`)
    process.exit(1)
  }
