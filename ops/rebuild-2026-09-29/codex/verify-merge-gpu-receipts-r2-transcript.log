                or not r[k]["kl_event_min"] >= -1e-4):
            errs.append(f"{k} {kl} self_mean={self_mean} event_min={r[k]['kl_event_min']}")
    vals = [("sample", r["sample"]["values"]), ("replay_256", r["replay_256"]["values"]),
