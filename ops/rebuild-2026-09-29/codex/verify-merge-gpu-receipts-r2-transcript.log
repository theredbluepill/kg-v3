    for k, self_k in (("teacher_perturbed_combined", "teacher_self_combined"),
                      ("teacher_perturbed_cached", "teacher_self_cached")):
        kl = r[k]["kl_per_row"]
        self_mean = r[self_k]["kl_per_row"]["mean"]
