        self,
        student_encoded: EncodedObservations,
        teacher_params: DiscreteTargetPolicyParams,
        obs: ObsBatch,
        actions: ModelActions,
        *,
        student_actor_inputs: _ActorInputs | None,
    ) -> ModelActionKLDivergences:
