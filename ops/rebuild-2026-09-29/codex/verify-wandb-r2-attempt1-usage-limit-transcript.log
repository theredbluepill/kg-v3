   216	def wandb_host(environ: Mapping[str, str]) -> str:
   217	    """The netrc machine name wandb uses: the base URL's host and port.
   218	
   219	    Rejects, without quoting it, a base URL that is not http(s) with a host or
   220	    that embeds credentials.
   221	    """
   222	    base_url = environ.get("WANDB_BASE_URL") or DEFAULT_WANDB_BASE_URL
   223	    try:
   224	        parts = urlsplit(base_url)
   225	        parts.port  # noqa: B018 - raises for a malformed port
   226	    except ValueError:
   227	        raise ValueError("WANDB_BASE_URL is not a valid URL") from None
   228	    if parts.username is not None or parts.password is not None:
   229	        raise ValueError("WANDB_BASE_URL must not embed credentials; use netrc")
   230	    if parts.scheme not in ("http", "https") or not parts.hostname:
   231	        raise ValueError("WANDB_BASE_URL must be an http(s) URL with a host")
   232	    return parts.netloc
