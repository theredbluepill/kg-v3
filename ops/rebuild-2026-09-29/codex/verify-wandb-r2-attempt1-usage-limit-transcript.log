   399	
   400	def _check_attempt_types(record: dict[str, Any], *, where: str) -> None:
   401	    def is_int(value: object) -> bool:
   402	        return isinstance(value, int) and not isinstance(value, bool)
   403	
   404	    def is_text(value: object) -> bool:
   405	        return isinstance(value, str) and bool(value)
   406	
   407	    commits = record["attempt_source_commits"]
   408	    checks = {
   409	        "attempt": is_int(record["attempt"]),
   410	        "experiment_id": isinstance(record["experiment_id"], str)
   411	        and _EXPERIMENT_ID_RE.fullmatch(record["experiment_id"]) is not None,
   412	        "job_type": is_text(record["job_type"]),
   413	        "source_commit": is_text(record["source_commit"]),
   414	        "attempt_source_commits": isinstance(commits, list)
   415	        and all(is_text(commit) for commit in commits),
   416	        "config_sha256": isinstance(record["config_sha256"], str)
   417	        and _SHA256_RE.fullmatch(record["config_sha256"]) is not None,
   418	        "telemetry_mode": record["telemetry_mode"] in set(TelemetryMode),
   419	        "start_env_steps": is_int(record["start_env_steps"])
   420	        and record["start_env_steps"] >= 0,

 succeeded in 0ms:
   420	        and record["start_env_steps"] >= 0,
   421	        "started_at": is_text(record["started_at"]),
   422	        **{
   423	            key: record[key] is None or is_text(record[key])
   424	            for key in ("wandb_project", "wandb_entity", "wandb_run_id", "wandb_url")
   425	        },
   426	    }
   427	    bad = sorted(key for key, ok in checks.items() if not ok)
   428	    if bad:
   429	        raise ValueError(f"{where} has malformed fields: {', '.join(bad)}")
