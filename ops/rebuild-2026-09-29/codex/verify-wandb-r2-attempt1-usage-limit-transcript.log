   108	def _read_netrc(path: Path) -> netrc.netrc | None:
   109	    try:
   110	        return netrc.netrc(str(path))
   111	    except FileNotFoundError:
   112	        return None
   113	    except netrc.NetrcParseError as error:
   114	        # The parser's message can quote a token from the file; keep it out.
   115	        raise MissingWandbCredentialsError(
   116	            f"cannot parse {path} (line {error.lineno}); repair it with "
   117	            f"{WANDB_CREDENTIAL_WORKFLOW}"
   118	        ) from None
   119	    except OSError as error:
   120	        raise MissingWandbCredentialsError(
   121	            f"cannot read {path}: {error.strerror}"
   122	        ) from None
