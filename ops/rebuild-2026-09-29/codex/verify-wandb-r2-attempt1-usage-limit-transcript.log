    80	def wandb_credential_source(environ: Mapping[str, str], *, home: Path) -> str | None:
    81	    """Where online W&B would read its API key, or ``None`` when it has none.
    82	
    83	    Mirrors wandb's lookup: ``WANDB_API_KEY`` when set, else the ``NETRC``
    84	    file (default ``~/.netrc``) entry for the ``WANDB_BASE_URL`` host (default
    85	    ``api.wandb.ai``, or netrc's ``default``) with a non-empty password.
    86	    Settings wandb would reject later (a malformed base URL, a blank or padded
    87	    environment key) fail here instead. Never returns or prints the key.
    88	    """
    89	    host = wandb_host(environ)
