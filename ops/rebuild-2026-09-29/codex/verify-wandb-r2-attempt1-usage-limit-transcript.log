   128	def wandb_netrc_entry(environ: Mapping[str, str], *, home: Path) -> str:
   129	    """The netrc line for the W&B host alone, for copying to a pod via stdin.
   130	
   131	    Only an explicit ``machine <host>`` entry qualifies (never ``default``), and
   132	    every token must serialize unquoted. Errors never quote the file.
   133	    """
   134	    host = wandb_host(environ)
   135	    netrc_path = _netrc_path(environ, home=home)
   136	    parsed = _read_netrc(netrc_path)
   137	    entry = None if parsed is None else parsed.hosts.get(host)
   138	    if entry is None or not entry[2]:
   139	        raise MissingWandbCredentialsError(
   140	            f"{netrc_path} has no 'machine {host}' entry with a password"
   141	        )
   142	    login, _account, password = entry
   143	    login = login or "user"
   144	    if any(char in _NETRC_UNSAFE for char in login + password):
   145	        raise MissingWandbCredentialsError(
   146	            f"the 'machine {host}' entry in {netrc_path} has a login or password "
   147	            "that netrc cannot hold unquoted; repair it before copying"
   148	        )
   149	    return f"machine {host} login {login} password {password}\n"
