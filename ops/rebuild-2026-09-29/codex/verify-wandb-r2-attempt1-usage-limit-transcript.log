   370	def read_attempts(path: Path) -> list[dict[str, Any]]:
   371	    if not path.is_file():
   372	        raise FileNotFoundError(f"resume needs the run's attempt records: {path}")
   373	    records = [
   374	        json.loads(line)
   375	        for line in path.read_text(encoding="utf-8").splitlines()
   376	        if line
   377	    ]
   378	    if not records:
   379	        raise ValueError(f"{path} has no attempt records")
   380	    commits: list[str] = []
   381	    for index, record in enumerate(records):
   382	        where = f"{path} line {index + 1}"
   383	        if not isinstance(record, dict) or set(record) != _ATTEMPT_KEYS:
   384	            raise ValueError(f"{where} must have exactly {sorted(_ATTEMPT_KEYS)}")
   385	        _check_attempt_types(record, where=where)
   386	        if record["attempt"] != index:
   387	            raise ValueError(f"{where} is not attempt {index}")
   388	        for key in ("experiment_id", "job_type"):
   389	            if record[key] != records[0][key]:
   390	                raise ValueError(f"{where} changes {key} from line 1")
   391	        commits.append(record["source_commit"])
   392	        if record["attempt_source_commits"] != commits:
   393	            raise ValueError(f"{where} attempt_source_commits breaks the history")
   394	    return records
