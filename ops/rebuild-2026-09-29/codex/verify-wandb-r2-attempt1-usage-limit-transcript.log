   445	        "experiment_id": identity.experiment_id,
   446	        "job_type": identity.job_type,
   447	        "source_commit": identity.source_commit,
   448	        "attempt_source_commits": list(identity.attempt_source_commits),
   449	        "config_sha256": identity.config_sha256,
   450	        "telemetry_mode": str(identity.telemetry),
   451	        "wandb_project": None if run is None else run.project,
   452	        "wandb_entity": None if run is None else run.entity,
   453	        "wandb_run_id": logger.run_id,
   454	        "wandb_url": None if run is None else run.url,
   455	        "start_env_steps": start_env_steps,
   456	        "started_at": datetime.now().astimezone().isoformat(timespec="seconds"),
   457	    }
