from owl.train import FullConfig

CONFIGS = Path(__file__).resolve().parents[2] / "configs"


def _workload(cfg: FullConfig, world_size: int) -> dict[str, int]:
    rl = cfg.rl
    per_step = rl.segments_per_minibatch * rl.gradient_accumulation_steps
    return {
        "global_envs": cfg.env.n_envs * world_size,
        "optimizer_steps_per_iteration": cfg.env.n_envs // per_step,
        "global_segments_per_optimizer_step": per_step * world_size,
