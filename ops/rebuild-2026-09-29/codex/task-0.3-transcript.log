class MetricLogger:
    ...
    def close(self, *, exit_code: int = 0) -> None:
        raise NotImplementedError


class DebugLogger(MetricLogger):
    ...
    def close(self, *, exit_code: int = 0) -> None:  # noqa: ARG002
