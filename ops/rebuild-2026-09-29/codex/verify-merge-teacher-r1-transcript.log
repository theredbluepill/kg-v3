def _market_view(event: torch.Tensor, market_frame: torch.Tensor) -> torch.Tensor:
    """``[R, 252, 12]`` -> ``[R, 11, 12]`` at the market frames."""
    return event.gather(1, market_frame[..., None].expand(-1, -1, K))


