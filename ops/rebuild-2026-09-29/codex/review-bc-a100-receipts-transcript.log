   401	@dataclass
   402	class HeldOutSelection:
   403	    """Lowest-held-out-NLL selection and the sustained-non-improvement stop.
   404	
   405	    Selection and patience are separate. ``best_nll``/``best_step`` follow every
   406	    strict new minimum, whose checkpoint is kept. ``improvement_nll`` is the NLL
   407	    of the last scheduled evaluation that beat the previous one by more than
   408	    ``min_delta``; ``evals_since_improvement`` counts scheduled evaluations since
   409	    then, so gains smaller than ``min_delta`` still update the best checkpoint but
   410	    do not reset the patience count.
   411	
   412	    An unscheduled evaluation (the terminal one when a budget or runtime stop
   413	    falls between ``eval_interval_steps``) takes part in selection only. Patience
   414	    stays on the scheduled cadence, so a run resumed from such a stop evaluates
   415	    and stops at the same steps as the uninterrupted run.
   416	    """
   417	
   418	    patience_evals: int
   419	    min_delta: float
   420	    best_nll: float = math.inf
   421	    best_step: int = -1
   422	    improvement_nll: float = math.inf
   423	    evals_since_improvement: int = 0
   424	    last_nll: float = math.nan
   425	    last_step: int = -1
   426	
   427	    def observe(self, nll: float, *, step: int, scheduled: bool = True) -> bool:
   428	        """Record one evaluation; ``True`` when it is the new lowest NLL."""
   429	        if not math.isfinite(nll):
   430	            raise ValueError(f"held-out NLL must be finite, got {nll} at step {step}")
   431	        if step <= self.last_step:
   432	            raise ValueError(
   433	                f"evaluations must advance: step {step} after {self.last_step}"
   434	            )
   435	        self.last_nll = nll
   436	        self.last_step = step
   437	        if scheduled:
   438	            if nll < self.improvement_nll - self.min_delta:
   439	                self.improvement_nll = nll
   440	                self.evals_since_improvement = 0
   441	            else:
   442	                self.evals_since_improvement += 1
   443	        if nll < self.best_nll:
   444	            self.best_nll = nll
   445	            self.best_step = step
   446	            return True
   447	        return False
   448	
   449	    @property
   450	    def should_stop(self) -> bool:
   451	        return self.evals_since_improvement >= self.patience_evals
