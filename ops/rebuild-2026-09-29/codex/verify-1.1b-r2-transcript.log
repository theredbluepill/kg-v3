   124	
   125	def ascii_digits(value: Any) -> Any:
   126	    """Replace each Unicode digit string with the ASCII digits Python int() reads."""
   127	    if isinstance(value, str):
   128	        return str(int(value)) if _is_unicode_digits(value) else value
   129	    if isinstance(value, list):
   130	        return [ascii_digits(item) for item in value]
   131	    if isinstance(value, dict):
   132	        return {key: ascii_digits(item) for key, item in value.items()}
   133	    return value
