   136	def _d2_observed(record: dict[str, Any], divergence: dict[str, Any]) -> bool:
   137	    """D2's mismatch: Python raised an unhashable TypeError; Rust accepted."""
   138	    return (
   139	        record.get("type") == "rejected"
   140	        and str(record.get("python_error", "")).startswith("TypeError: unhashable type")
   141	        and divergence["kind"] == "rust_accepted"
   142	        and divergence["field"] == "step"
   143	    )
