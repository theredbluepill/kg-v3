+fn rollback_check_accepts_an_untouched_state() {
+    let before = view(r#"{"a":1,"b":2}"#, ["ACTIVE", "ACTIVE"], [0.0, 0.0], false);
+    assert!(rollback_difference(&before, &before.clone(), 4, Some(3)).is_ok());
+}
