   780	            if env.state[0].observation.step != step:
   781	                raise ParityGeneratorError(
   782	                    f"{spec.name}: failed step mutated the step counter"
   783	                ) from error
   784	            if all(choice.fallback is None for choice in choices):
   785	                raise ParityGeneratorError(
   786	                    f"{spec.name}: step {step} raised without a probe: {error!r}"
   787	                ) from error
   788	            message = f"{type(error).__name__}: {error}"
   789	            rejected_errors.append(message)
   790	            records.append(
   791	                {
   792	                    "type": "rejected",
   793	                    "from_step": step,
   794	                    "actions": actions,
   795	                    "python_error": message,
   796	                }
   797	            )
   798	            actions = _plain(
   799	                [
   800	                    choice.action if choice.fallback is None else choice.fallback
   801	                    for choice in choices
   802	                ]
   803	            )
   804	            with _silenced():
   805	                env.step(copy.deepcopy(actions))
   806	        if (step + 1) % turns_per_day == 0:
   807	            end_days.append(step // turns_per_day)
   808	        records.append(
   809	            {
   810	                "type": "transition",
   811	                "from_step": step,
   812	                "actions": actions,
   813	                "expected": _public(env),
   814	                "privates": _privates(env),
   815	                "statuses": [agent.status for agent in env.state],
   816	                "rewards": [agent.reward for agent in env.state],
   817	            }
   818	        )
   819	        transitions += 1
   820	    seed = env.info["seed"]
   821	    header = {
   822	        "type": "header",
   823	        "format": TRACE_FORMAT,
   824	        "source": {
   825	            "generator": GENERATOR,
   826	            "module_version": pin.version,
   827	            "engine_sha256": engine_sha256,
   828	            "name": spec.name,
   829	            "policies": list(spec.policies),
   830	            "policy_seed": spec.policy_seed,
   831	            "config_variant": spec.variant,
   832	            **({"probe": spec.probe} if spec.probe else {}),
   833	        },
   834	        "seed": seed,
   835	        "configuration": dict(sorted(config.items())),
   836	        "shop_schedule": list(env.state[0].observation.town["unlocked_shops"]),
   837	        "rng_schedule": [
   838	            {"day": day, "weed_rolls": _weed_rolls(seed, day)} for day in end_days
   839	        ],
   840	        "initial": initial,
   841	        "terminal_banks": [float(agent.reward) for agent in env.state],
   842	        "transitions": transitions,
   843	    }
   844	    return GameResult(
   845	        spec=spec,
   846	        records=[header, *records],
   847	        transitions=transitions,
   848	        rejected=len(rejected_errors),
   849	        seconds=time.perf_counter() - started,
   850	        rejected_errors=rejected_errors,
   851	    )
   852	
   853	
   854	def _weed_rolls(seed: int, day: int) -> list[float]:
   855	    """The first rolls of Python's end-of-day RNG, as in the official traces."""
   856	    rng = random.Random((seed * 1_000_003) ^ day)
   857	    return [rng.random() for _ in range(ROLLS_PER_DAY)]
   858	
   859	
   860	def encode_trace(records: list[dict[str, Any]]) -> bytes:
   861	    """Deterministic gzip JSONL (fixed mtime, no filename) for stable hashes."""
   862	    text = "".join(
   863	        json.dumps(record, separators=(",", ":"), allow_nan=False) + "\n"
   864	        for record in records
   865	    )
   866	    buffer = io.BytesIO()
   867	    with gzip.GzipFile(filename="", mode="wb", fileobj=buffer, mtime=0) as handle:
   868	        handle.write(text.encode("utf-8"))
   869	    return buffer.getvalue()
