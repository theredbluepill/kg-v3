    62	def _commands(action: Any) -> tuple[list[Any], list[Any]]:
    63	    """(unit commands, market orders) of one submitted action."""
    64	    if not isinstance(action, dict):
    65	        return [], []
    66	    hands = action.get("hands")
    67	    market = action.get("market")
    68	    units = [action.get("farmer"), *(hands if isinstance(hands, list) else [])]
    69	    return units, market if isinstance(market, list) else []
