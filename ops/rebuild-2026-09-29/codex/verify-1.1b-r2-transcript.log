   109	def input_classes(actions: list[Any]) -> list[str]:
   110	    """Documented divergence classes whose inputs occur in a step's actions.
   111	
   112	    D1: a non-ASCII Unicode decimal digit string (Python int() accepts it).
   113	    D2: an unhashable verb or item that reaches one of Python's dict lookups:
   114	    a unit verb, a PLANT/PICKUP/PLACE item, or a BUY_SEED/BUY_ANIMAL item.
   115	
   116	    An input match alone never classifies a divergence; see ``confirmed_class``.
   117	    """
   118	    return [
   119	        name
   120	        for name, present in (("D1", _has_d1(actions)), ("D2", _has_d2(actions)))
   121	        if present
   122	    ]
