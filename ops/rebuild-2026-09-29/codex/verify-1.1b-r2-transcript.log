   146	def _d1_observed(
   147	    record: dict[str, Any],
   148	    divergence: dict[str, Any],
   149	    recheck: dict[str, Any] | None,
   150	) -> bool:
   151	    """D1's mismatch: Python acted on the step, and an ASCII recheck passes it.
   152	
   153	    The recheck is the same trace with only that line's Unicode digits spelled
   154	    in ASCII; it must get Rust past the divergent line.
   155	    """
   156	    if record.get("type") != "transition" or recheck is None:
   157	        return False
   158	    return bool(recheck["ok"]) or recheck["divergence"]["line"] > divergence["line"]
