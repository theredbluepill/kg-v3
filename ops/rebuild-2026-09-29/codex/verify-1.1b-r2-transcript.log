   629	/// Traces generated live from Kaggle's engine with seeded random, edge-case,
   630	/// built-in and mixed-seat policies (see the manifest for each game's inputs).
   631	///
   632	/// Entries with `expected_divergence` are minimal repros of documented
   633	/// divergences (D1, D2 in docs/rules-parity-coverage.md): one-step games whose
   634	/// first action is the divergent input, carrying only the divergent field. The
   635	/// vendored kernel is byte-pinned, so they are expected failures: each must still
   636	/// diverge at exactly the recorded line, step, kind and field, or this test fails.
   637	#[test]
   638	fn generated_fixtures_replay() {
   639	    let traces = generated_manifest();
   640	    assert!(traces.len() >= 6, "expected the committed generated set");
   641	    let mut failures = vec![];
   642	    let mut expected_failures = 0;
   643	    for entry in &traces {
   644	        let name = entry["path"].as_str().unwrap();
   645	        let result = replay_text(&generated_trace(name));
   646	        match (&entry["expected_divergence"], result) {
   647	            (Value::Null, Ok(stats)) => {
   648	                assert_eq!(
   649	                    stats.transitions as u64,
   650	                    entry["transitions"].as_u64().unwrap(),
   651	                    "{name}"
   652	                );
   653	                assert_eq!(
   654	                    stats.rejected as u64,
   655	                    entry["rejected"].as_u64().unwrap(),
   656	                    "{name}"
   657	                );
   658	            },
   659	            (Value::Null, Err(divergence)) => failures.push(format!("{name}: {divergence}")),
   660	            (expected, Ok(_)) => failures.push(format!(
   661	                "{name}: expected divergence did not occur ({expected}); update the record"
   662	            )),
   663	            (expected, Err(divergence)) => {
   664	                let reason = expected["reason"].as_str().unwrap_or_default();
   665	                assert!(
   666	                    !reason.trim().is_empty(),
   667	                    "{name}: expected failure needs a reason"
   668	                );
   669	                let observed = json!({
   670	                    "line": divergence.line,
   671	                    "from_step": divergence.from_step,
   672	                    "kind": divergence.kind,
   673	                    "field": divergence.field,
   674	                });
   675	                for key in ["line", "from_step", "kind", "field"] {
   676	                    if observed[key] != expected[key] {
   677	                        failures.push(format!(
   678	                            "{name}: {key} {} != recorded {}",
   679	                            observed[key], expected[key]
   680	                        ));
   681	                    }
   682	                }
   683	                expected_failures += 1;
   684	            },
   685	        }
   686	    }
   687	    eprintln!(
   688	        "{} generated traces, {expected_failures} documented expected divergences",
   689	        traces.len()
   690	    );
   691	    assert!(
   692	        failures.is_empty(),
   693	        "generated parity divergences:\n{}",
   694	        failures.join("\n")
   695	    );
   696	}
