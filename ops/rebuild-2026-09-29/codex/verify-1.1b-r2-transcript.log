   493	        return Err(
   494	            Divergence::new(0, None, "initial", "statuses/rewards/done").values(
   495	                "ACTIVE, 0, not done",
   496	                format!("{:?}", (initial.statuses, initial.rewards, initial.done)),
   497	            ),
   498	        );
   499	    }
