    58	def test_hash_guard_accepts_only_the_pinned_engine(tmp_path: Path) -> None:
    59	    engine = tmp_path / "kaggriculture.py"
    60	    engine.write_bytes(b"pinned engine bytes\n")
    61	    digest = hashlib.sha256(engine.read_bytes()).hexdigest()
    62	    pin = generator.EnginePin(version="1.32.7", sha256=digest)
    63	    assert generator.verify_engine(engine, "1.32.7", pin) == digest
    64	
    65	    engine.write_bytes(b"pinned engine bytes, edited\n")
    66	    with pytest.raises(generator.ParityGeneratorError, match="Refusing to generate"):
    67	        generator.verify_engine(engine, "1.32.7", pin)
