   185	def test_scripted_null_action_is_submitted_not_replaced() -> None:
   186	    """A probe of a null whole action must submit null, not PASS."""
   187	    spec = generator._probe_spec("probe-null", None)
   188	    choices = generator.scripted_choices(spec, len(generator.PROBE_PREAMBLE))
   189	    assert [choice.action for choice in choices] == [None, generator.PASS_ACTION]
   190	    assert all(choice.fallback == generator.PASS_ACTION for choice in choices)
   191	    after = generator.scripted_choices(spec, len(generator.PROBE_PREAMBLE) + 1)
   192	    assert [choice.action for choice in after] == [generator.PASS_ACTION] * 2
   193	    labels = dict(generator.probe_cases())
   194	    assert any(action is None for kind, action in generator.probe_cases()), labels
