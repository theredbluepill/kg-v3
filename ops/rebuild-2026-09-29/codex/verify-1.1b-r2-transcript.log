   553	                if actual.done != last {
   554	                    return Err(
   555	                        Divergence::new(index, from_step, "done", "done").values(last, actual.done)
   556	                    );
   557	                }
   558	                if actual.public.step != current + 1 {
   559	                    return Err(Divergence::new(index, from_step, "step", "public.step")
   560	                        .values(current + 1, actual.public.step));
   561	                }
   562	            },
   563	            _ => {
   564	                return Err(Divergence::new(index, from_step, "format", "type")
   565	                    .values("transition or rejected", &row["type"]));
   566	            },
   567	        }
   568	    }
   569	    if stats.transitions != header.transitions {
   570	        return Err(Divergence::new(0, None, "format", "transitions")
   571	            .values(header.transitions, stats.transitions));
   572	    }
   573	    let banks = game.terminal_banks().unwrap_or(&[]);
   574	    if banks != header.terminal_banks.as_slice() {
   575	        return Err(Divergence::new(0, None, "terminal_banks", "terminal_banks")
   576	            .values(format!("{:?}", header.terminal_banks), format!("{banks:?}")));
   577	    }
   578	    Ok(stats)
   579	}
