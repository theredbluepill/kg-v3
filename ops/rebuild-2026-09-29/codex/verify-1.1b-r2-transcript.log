  1101	def main(argv: list[str] | None = None) -> int:
  1102	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
  1103	    parser.add_argument("--out", type=Path, required=True)
  1104	    parser.add_argument(
  1105	        "--preset", choices=["committed", "sweep", "probes"], required=True
  1106	    )
  1107	    parser.add_argument("--games", type=int, default=40, help="sweep games")
  1108	    parser.add_argument("--base-seed", type=int, default=20260929, help="sweep seed")
  1109	    parser.add_argument("--manifest", action="store_true", help="write MANIFEST.json")
  1110	    parser.add_argument("--summary", type=Path, help="per-game JSON summary")
  1111	    parser.add_argument(
  1112	        "--include-known-divergences",
  1113	        action="store_true",
  1114	        help="let the edge policy emit the documented divergent inputs (D1/D2)",
  1115	    )
  1116	    args = parser.parse_args(argv)
  1117	    try:
  1118	        pin = pinned_engine()
  1119	        kaggle, module, digest = load_pinned_kaggle(pin)
  1120	    except ParityGeneratorError as error:
  1121	        print(f"refusing to generate: {error}", file=sys.stderr)
  1122	        return 2
  1123	    if args.preset == "committed":
  1124	        specs = committed_specs()
  1125	    elif args.preset == "sweep":
  1126	        specs = sweep_specs(args.games, args.base_seed)
  1127	    else:
  1128	        specs = probe_specs()
  1129	    args.out.mkdir(parents=True, exist_ok=True)
  1130	    results = []
  1131	    for spec in specs:
  1132	        result = play(spec, kaggle, module, pin, digest, args.include_known_divergences)
  1133	        path = args.out / f"{spec.name}.jsonl.gz"
  1134	        path.write_bytes(encode_trace(result.records))
  1135	        results.append(result)
  1136	        print(
  1137	            f"{path.name}: {result.transitions} transitions, {result.rejected} "
  1138	            f"rejected, {path.stat().st_size:,} B, {result.seconds:.1f}s",
  1139	            flush=True,
  1140	        )
  1141	    if args.manifest:
  1142	        write_manifest(args.out, results, pin)
  1143	    if args.summary:
  1144	        summary = [
  1145	            {
  1146	                "path": f"{r.spec.name}.jsonl.gz",
  1147	                "seed": r.spec.seed,
  1148	                "policies": list(r.spec.policies),
  1149	                "policy_seed": r.spec.policy_seed,
  1150	                "config_variant": r.spec.variant,
  1151	                **({"probe": r.spec.probe} if r.spec.probe else {}),
  1152	                "transitions": r.transitions,
  1153	                "rejected": r.rejected,
  1154	                "rejected_errors": sorted(set(r.rejected_errors)),
  1155	                "seconds": round(r.seconds, 3),
  1156	            }
  1157	            for r in results
  1158	        ]
  1159	        args.summary.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
  1160	    return 0
