    98	def test_generated_traces_use_the_official_trace_schema() -> None:
    99	    official = _records(OFFICIAL)
   100	    header, transition = official[0], official[1]
   101	    manifest = _manifest()
   102	    assert manifest["python_engine_sha256"] == FULL_ENGINE_SHA
   103	    kinds = set()
   104	    for entry in manifest["traces"]:
   105	        records = _records(GENERATED / entry["path"])
   106	        generated_header = records[0]
   107	        assert list(generated_header) == list(header)
   108	        assert generated_header["format"] == header["format"]
   109	        assert set(generated_header["configuration"]) == set(header["configuration"])
   110	        assert list(generated_header["initial"]) == list(header["initial"])
   111	        assert list(generated_header["initial"]["public"]) == list(
   112	            header["initial"]["public"]
   113	        )
   114	        source = generated_header["source"]
   115	        assert source["module_version"] == header["source"]["module_version"]
   116	        assert source["engine_sha256"] == header["source"]["engine_sha256"]
   117	        for day in generated_header["rng_schedule"]:
   118	            assert set(day) == set(header["rng_schedule"][0])
   119	        assert generated_header["transitions"] == entry["transitions"]
   120	        for record in records[1:]:
   121	            kinds.add(record["type"])
   122	            if record["type"] == "transition":
   123	                assert list(record) == list(transition)
   124	                assert list(record["expected"]) == list(transition["expected"])
   125	            else:
   126	                assert list(record) == ["type", "from_step", "actions", "python_error"]
   127	    assert kinds == {"transition", "rejected"}
