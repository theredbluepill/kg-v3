    86	def pinned_engine(cargo_toml: Path = CARGO_TOML) -> EnginePin:
    87	    """Read the compatibility target from the vendored crate's Cargo metadata."""
    88	    metadata = tomllib.loads(cargo_toml.read_text(encoding="utf-8"))
    89	    target = metadata["package"]["metadata"]["kaggriculture"]
    90	    version = target["kaggle-environments-version"]
    91	    digest = target["python-engine-sha256"]
    92	    if not isinstance(version, str) or not isinstance(digest, str):
    93	        raise ParityGeneratorError(f"{cargo_toml}: malformed kaggriculture metadata")
    94	    if len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
    95	        raise ParityGeneratorError(f"{cargo_toml}: python-engine-sha256 is not hex")
    96	    return EnginePin(version=version, sha256=digest)
