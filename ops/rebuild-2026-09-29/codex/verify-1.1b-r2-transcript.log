+            "public.a",
+        ),
+    ] {
+        let divergence = rollback_difference(&before, &after, 4, Some(3)).unwrap_err();
+        assert!(divergence.kind.starts_with("rust_mutated"), "{divergence}");
+        assert_eq!(divergence.field, field);
