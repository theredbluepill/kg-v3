    25	def _load(name: str) -> ModuleType:
    26	    path = REPO_ROOT / f"scripts/kaggriculture_parity/{name}.py"
    27	    spec = importlib.util.spec_from_file_location(f"kaggriculture_parity_{name}", path)
    28	    assert spec is not None
    29	    assert spec.loader is not None
    30	    module = importlib.util.module_from_spec(spec)
    31	    sys.modules[spec.name] = module
    32	    spec.loader.exec_module(module)
    33	    return module
