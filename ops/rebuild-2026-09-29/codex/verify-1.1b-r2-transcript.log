   166	    """The documented class that explains the observed first divergence, if any."""
   167	    actions = record.get("actions")
   168	    classes = input_classes(actions if isinstance(actions, list) else [])
   169	    if "D2" in classes and _d2_observed(record, divergence):
   170	        return "D2"
   171	    if "D1" in classes and _d1_observed(record, divergence, recheck):
   172	        return "D1"
   173	    return None
   174	
   175	
   176	def write_d1_rechecks(
   177	    report: list[dict[str, Any]], traces_dir: Path, recheck_dir: Path
   178	) -> list[str]:
   179	    """Write ASCII rechecks of traces whose divergent line has D1 inputs.
   180	
   181	    Each copy in ``recheck_dir`` rewrites only that line's Unicode digits in
   182	    ASCII. Returns the rewritten trace names.
   183	    """
   184	    names = []
   185	    for result in report:
   186	        if result["ok"]:
   187	            continue
   188	        line = result["divergence"]["line"]
   189	        with gzip.open(traces_dir / result["file"], "rt", encoding="utf-8") as handle:
   190	            records = [json.loads(text) for text in handle]
   191	        if line == 0 or line >= len(records):
   192	            continue
   193	        actions = records[line].get("actions")
   194	        if not isinstance(actions, list) or "D1" not in input_classes(actions):
   195	            continue
   196	        records[line] = {**records[line], "actions": ascii_digits(actions)}
   197	        recheck_dir.mkdir(parents=True, exist_ok=True)
   198	        text = "".join(
   199	            json.dumps(record, separators=(",", ":"), allow_nan=False) + "\n"
   200	            for record in records
   201	        )
   202	        with gzip.GzipFile(recheck_dir / result["file"], "wb", mtime=0) as handle:
   203	            handle.write(text.encode("utf-8"))
   204	        names.append(result["file"])
   205	    return names
   206	
   207	
   208	def _record(path: Path, line: int) -> dict[str, Any]:
   209	    with gzip.open(path, "rt", encoding="utf-8") as handle:
   210	        for index, text in enumerate(handle):
   211	            if index == line:
   212	                return dict(json.loads(text))
   213	    raise ValueError(f"{path}: no line {line}")
   214	
   215	
   216	def summarize(
   217	    generated: list[dict[str, Any]],
   218	    report: list[dict[str, Any]],
   219	    traces_dir: Path,
   220	    recheck_report: list[dict[str, Any]] | None = None,
   221	) -> dict[str, Any]:
   222	    by_file = {entry["path"]: entry for entry in generated}
   223	    replayed = {entry["file"]: entry for entry in report}
   224	    rechecked = {entry["file"]: entry for entry in recheck_report or []}
   225	    missing = sorted(set(by_file) - set(replayed))
   226	    if missing:
   227	        raise RuntimeError(f"Rust did not replay: {missing}")
   228	    policies: dict[str, Counter[str]] = defaultdict(Counter)
   229	    variants: dict[str, Counter[str]] = defaultdict(Counter)
   230	    divergences = []
   231	    for name, entry in sorted(by_file.items()):
   232	        result = replayed[name]
   233	        kind = "probe" if "probe" in entry else "game"
   234	        labels = [
   235	            "script" if kind == "probe" and seat == 0 else policy
   236	            for seat, policy in enumerate(entry["policies"])
   237	        ]
   238	        for label in labels:
   239	            policies[label]["seats"] += 1
   240	        for label in set(labels):
   241	            policies[label]["probes" if kind == "probe" else "games"] += 1
   242	            policies[label]["transitions"] += entry["transitions"]
   243	        variants[entry["config_variant"]]["traces"] += 1
   244	        variants[entry["config_variant"]]["transitions"] += entry["transitions"]
   245	        if result["ok"]:
   246	            continue
   247	        divergence = result["divergence"]
   248	        record = _record(traces_dir / name, divergence["line"])
   249	        divergences.append(
   250	            {
   251	                "file": name,
   252	                "kind": kind,
   253	                "seed": entry["seed"],
   254	                "policies": entry["policies"],
   255	                "config_variant": entry["config_variant"],
   256	                **({"probe": entry["probe"]} if "probe" in entry else {}),
   257	                "first_divergence": divergence,
   258	                "known_class": confirmed_class(record, divergence, rechecked.get(name)),
   259	            }
   260	        )
   261	    games = [e for e in generated if "probe" not in e]
   262	    probes = [e for e in generated if "probe" in e]
   263	    new = [d for d in divergences if d["known_class"] is None]
   264	    return {
   265	        "games": len(games),
   266	        "probes": len(probes),
   267	        "traces": len(generated),
   268	        "transitions": sum(e["transitions"] for e in generated),
   269	        "game_transitions": sum(e["transitions"] for e in games),
   270	        "python_rejected_steps": sum(e["rejected"] for e in generated),
   271	        "traces_agreeing": sum(1 for r in report if r["ok"]),
   272	        "traces_diverging": len(divergences),
   273	        "divergences_by_class": dict(
   274	            Counter(d["known_class"] or "unclassified" for d in divergences)
   275	        ),
   276	        "new_divergences": len(new),
   277	        "per_policy": {k: dict(v) for k, v in sorted(policies.items())},
   278	        "per_config_variant": {k: dict(v) for k, v in sorted(variants.items())},
   279	        "seeds": sorted({e["seed"] for e in games}),
   280	        "divergences": divergences,
   281	    }
   282	
