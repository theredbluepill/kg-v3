   707	    text.lines()
   708	        .position(|line| {
   709	            let row: Value = serde_json::from_str(line).unwrap();
   710	            row["type"] == record_type && row["from_step"] == from_step
   711	        })
   712	        .unwrap_or_else(|| panic!("no {record_type} record from step {from_step}"))
   713	}
   714	
   715	const PERTURBED: &str = "gen-edge-vs-edge.jsonl.gz";
   775	    let (line, step) = text
   776	        .lines()
   777	        .enumerate()
   778	        .find_map(|(index, line)| {
   779	            let row: Value = serde_json::from_str(line).unwrap();
   780	            (row["type"] == "rejected").then(|| (index, row["from_step"].as_u64().unwrap()))
   781	        })
   782	        .expect("the edge trace records Python rejections");
   783	    let relabelled = edit_line(&text, line, |row| row["type"] = json!("transition"));
   784	    let divergence = replay_text(&relabelled).unwrap_err();
   785	    assert_eq!(divergence.kind, "rust_error");
   786	    assert_eq!(divergence.from_step, Some(step as usize));
   787	}
