    99	def sha256_file(path: Path) -> str:
   100	    return hashlib.sha256(path.read_bytes()).hexdigest()
   101	
   102	
   103	def verify_engine(engine_path: Path, installed_version: str, pin: EnginePin) -> str:
   104	    """Refuse to generate unless the installed engine is the pinned bytes."""
   105	    if installed_version != pin.version:
   106	        raise ParityGeneratorError(
   107	            f"kaggle-environments {installed_version} is installed; the Rust kernel "
   108	            f"targets {pin.version}. Run in an isolated env with "
   109	            f"--with kaggle-environments=={pin.version}."
   110	        )
   111	    digest = sha256_file(engine_path)
   112	    if digest != pin.sha256:
   113	        raise ParityGeneratorError(
   114	            f"{engine_path} has SHA-256 {digest}; engine_rs/Cargo.toml pins "
   115	            f"{pin.sha256}. Refusing to generate parity traces from another engine."
   116	        )
   117	    return digest
