   698	fn edit_line(text: &str, line: usize, edit: impl FnOnce(&mut Value)) -> String {
   699	    let mut lines: Vec<String> = text.lines().map(str::to_string).collect();
   700	    let mut row: Value = serde_json::from_str(&lines[line]).unwrap();
   701	    edit(&mut row);
   702	    lines[line] = row.to_string();
