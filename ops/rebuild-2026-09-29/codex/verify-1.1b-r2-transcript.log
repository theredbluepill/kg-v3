  1066	def write_manifest(out: Path, results: list[GameResult], pin: EnginePin) -> Path:
  1067	    entries = []
  1068	    for result in results:
  1069	        path = out / f"{result.spec.name}.jsonl.gz"
  1070	        entries.append(
  1071	            {
  1072	                "path": path.name,
  1073	                "sha256": sha256_file(path),
  1074	                "bytes": path.stat().st_size,
  1075	                "seed": result.spec.seed,
  1076	                "policies": list(result.spec.policies),
  1077	                "policy_seed": result.spec.policy_seed,
  1078	                "config_variant": result.spec.variant,
  1079	                "transitions": result.transitions,
  1080	                "rejected": result.rejected,
  1081	                **(
  1082	                    {"probe": result.spec.probe, "expected_divergence": expected}
  1083	                    if (expected := known_divergence(result.spec.name))
  1084	                    else {}
  1085	                ),
  1086	            }
  1087	        )
  1088	    manifest = {
  1089	        "schema_version": 1,
  1090	        "format": TRACE_FORMAT,
  1091	        "generator": GENERATOR,
  1092	        "kaggle_environments_version": pin.version,
  1093	        "python_engine_sha256": pin.sha256,
  1094	        "traces": entries,
  1095	    }
  1096	    path = out / "MANIFEST.json"
  1097	    path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
  1098	    return path
  1099	
