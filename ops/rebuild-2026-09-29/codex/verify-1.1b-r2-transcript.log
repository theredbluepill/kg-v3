    52	def _strings(value: Any) -> list[str]:
    53	    if isinstance(value, str):
    54	        return [value]
    55	    if isinstance(value, list):
    56	        return [text for item in value for text in _strings(item)]
    57	    if isinstance(value, dict):
    58	        return [text for item in value.values() for text in _strings(item)]
    59	    return []
