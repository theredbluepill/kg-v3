  1011	def probe_cases() -> list[tuple[str, Any]]:
  1012	    """(label, seat-0 action at step 2) for every minimal input probe."""
  1013	    units: list[Any] = [*MALFORMED_UNITS, *CRASH_UNITS, *DIVERGENT_CRASH_UNITS]
  1014	    units += [["PICKUP", "WHEAT", q] for q in QUANTITY_FORMS]
  1015	    units += [["PLACE", "WHEAT", q] for q in QUANTITY_FORMS]
  1016	    for bad in UNHASHABLE:
  1017	        units += [["PICKUP", bad], ["PLACE", bad], ["PLACE", bad, 1], ["PLANT", bad]]
  1018	        units += [[bad], [bad, "WHEAT"]]
  1019	    units += [["PLANT", 3], ["PLANT", None], ["PLANT", True], ["PLANT", "CARROT"]]
  1020	    cases: list[tuple[str, Any]] = [
  1021	        ("unit", {"farmer": cmd, "hands": [["PASS"]], "market": []}) for cmd in units
  1022	    ]
  1023	    for cmd in [["PLANT", ["WHEAT"]], [["NORTH"]], ["PLACE", ["WHEAT"]], ["PASS"]]:
  1024	        cases.append(
  1025	            ("hand", {"farmer": ["PASS"], "hands": [["PASS"], cmd], "market": []})
  1026	        )
  1027	    orders: list[Any] = [*MALFORMED_ORDERS, *UNKNOWN_ORDERS, *DIVERGENT_CRASH_ORDERS]
  1028	    for verb, item in [
  1029	        ("BUY_SEED", "WHEAT"),
  1030	        ("SELL", "WHEAT"),
  1031	        ("BUY_PRODUCT", "FERTILIZER"),
  1032	        ("BUY_ANIMAL", "GOOSE"),
  1033	    ]:
  1034	        orders += [[verb, item, q] for q in QUANTITY_FORMS]
  1035	        orders += [[verb, bad, 1] for bad in UNHASHABLE]
  1036	        orders += [[verb, ["WHEAT"], 0], [verb, item]]
  1037	    cases += [
  1038	        ("market", {"farmer": ["PASS"], "hands": [], "market": [order]})
  1039	        for order in orders
  1040	    ]
  1041	    cases += [("action", action) for action in MALFORMED_ACTIONS]
  1042	    return cases
  1043	
  1044	
  1045	def probe_specs() -> list[GameSpec]:
  1046	    return [
  1047	        _probe_spec(f"probe-{index:03d}-{kind}", action)
  1048	        for index, (kind, action) in enumerate(probe_cases())
  1049	    ]
  1050	
  1051	
  1052	def known_divergence(name: str) -> dict[str, Any] | None:
  1053	    for known, _, kind, field_path, reason in KNOWN_DIVERGENCES:
  1054	        if known == name:
  1055	            # Line 1 is step 0: the repro's divergent action is its first step.
  1056	            return {
  1057	                "line": 1,
  1058	                "from_step": 0,
  1059	                "kind": kind,
  1060	                "field": field_path,
  1061	                "reason": reason,
  1062	            }
  1063	    return None
  1064	
