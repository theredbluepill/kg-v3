   698	fn edit_line(text: &str, line: usize, edit: impl FnOnce(&mut Value)) -> String {
   699	    let mut lines: Vec<String> = text.lines().map(str::to_string).collect();
   700	    let mut row: Value = serde_json::from_str(&lines[line]).unwrap();
   701	    edit(&mut row);
   702	    lines[line] = row.to_string();
   703	    lines.join("\n") + "\n"
   704	}
   705	
   706	fn line_for_step(text: &str, record_type: &str, from_step: u64) -> usize {
   707	    text.lines()
   708	        .position(|line| {
   709	            let row: Value = serde_json::from_str(line).unwrap();
   710	            row["type"] == record_type && row["from_step"] == from_step
   711	        })
   712	        .unwrap_or_else(|| panic!("no {record_type} record from step {from_step}"))
   713	}
