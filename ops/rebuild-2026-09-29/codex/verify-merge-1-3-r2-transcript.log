def test_custody_rejects_corruption_even_with_rehashed_files(
    tmp_path: Path, damage: str
) -> None:
    manifest, rows, features = fixture(tmp_path)
    if damage == "byte":
        features = bytes([features[0] ^ 1]) + features[1:]
