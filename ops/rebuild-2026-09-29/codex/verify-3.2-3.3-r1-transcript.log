  1436	def _evaluation_seed(*, base_seed: int, env_steps: int) -> int:
  1437	    """Fresh, reproducible starting worlds for the evaluation at ``env_steps``.
  1438	
  1439	    A bijective 61-bit mix of ``(base_seed, env_steps)`` placed in the evaluation
  1440	    seed band: for a fixed base seed every evaluation step gets a distinct seed
  1441	    (and vice versa), repeating an evaluation repeats its seed, and the games of
  1442	    different evaluations or runs do not share consecutive seed ranges.
  1443	    """
  1444	    limit = 1 << _EVAL_SEED_BITS
  1445	    for name, value in (("base_seed", base_seed), ("env_steps", env_steps)):
  1446	        if not 0 <= value < limit:
  1447	            raise ValueError(
  1448	                f"{name} must be in [0, 2**{_EVAL_SEED_BITS}), got {value}"
  1449	            )
  1450	    return _EVAL_SEED_FLOOR + _mix_eval_seed_bits(
  1451	        _mix_eval_seed_bits(base_seed) ^ env_steps
  1452	    )
