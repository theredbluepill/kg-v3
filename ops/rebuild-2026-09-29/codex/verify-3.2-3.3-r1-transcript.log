  1454	
  1455	def _mix_eval_seed_bits(value: int) -> int:
  1456	    """Bijection on ``[0, 2**61)``: xor-shifts and odd multiplies mod ``2**61``."""
  1457	    mask = (1 << _EVAL_SEED_BITS) - 1
  1458	    value ^= value >> 31
  1459	    value = (value * 0x7FB5D329728EA185) & mask
  1460	    value ^= value >> 27
  1461	    value = (value * 0x81DADEF4BC2DD44D) & mask
  1462	    value ^= value >> 33
  1463	    return value
