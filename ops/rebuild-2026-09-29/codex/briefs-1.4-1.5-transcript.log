   214	    fn reset(
   214	    fn reset(
   215	        &mut self,
   215	        &mut self,
   216	        planet_obs: PyReadwriteArrayDyn<'_, f32>,
   216	        planet_obs: PyReadwriteArrayDyn<'_, f32>,
   217	        orbiting_planet_obs: PyReadwriteArrayDyn<'_, bool>,
   217	        orbiting_planet_obs: PyReadwriteArrayDyn<'_, bool>,
   218	        fleet_obs: PyReadwriteArrayDyn<'_, f32>,
   218	        fleet_obs: PyReadwriteArrayDyn<'_, f32>,
   219	        comet_obs: PyReadwriteArrayDyn<'_, f32>,
   220	        entity_mask: PyReadwriteArrayDyn<'_, bool>,
   221	        still_playing: PyReadwriteArrayDyn<'_, bool>,
   222	        global_obs: PyReadwriteArrayDyn<'_, f32>,
   223	        can_act: PyReadwriteArrayDyn<'_, bool>,
   224	        max_launch: PyReadwriteArrayDyn<'_, i64>,
   225	        player_features: Option<PyReadwriteArrayDyn<'_, f32>>,
   226	        fleet_target: Option<PyReadwriteArrayDyn<'_, i64>>,
   227	        target_incoming_features: Option<PyReadwriteArrayDyn<'_, f32>>,
   228	    ) -> PyResult<()> {
   229	        self.require_obs_shapes(
   230	            &planet_obs,
   231	            &orbiting_planet_obs,
   232	            &fleet_obs,
   233	            &comet_obs,
   234	            &entity_mask,
   235	            &still_playing,
   236	            &global_obs,
   237	            player_features.as_ref(),
   238	            fleet_target.as_ref(),
   239	            target_incoming_features.as_ref(),
   240	            &can_act,
   241	            &max_launch,
   242	        )?;
   243	
   244	        let mut planet_obs = planet_obs;
   245	        let mut orbiting_planet_obs = orbiting_planet_obs;
   246	        let mut fleet_obs = fleet_obs;
   247	        let mut comet_obs = comet_obs;
   248	        let mut entity_mask = entity_mask;
   249	        let mut still_playing = still_playing;
   250	        let mut global_obs = global_obs;
   251	        let mut player_features = player_features;
   252	        let mut fleet_target = fleet_target;
   253	        let mut target_incoming_features = target_incoming_features;
   254	        let mut can_act = can_act;
   255	        let mut max_launch = max_launch;
   256	
   257	        let planets_per_env = MAX_PLANETS * self.planet_channels;
   258	        let orbiting_planets_per_env = MAX_PLANETS;
   259	        let fleets_per_env = self.max_fleets * self.fleet_channels;
   260	        let comets_per_env = MAX_COMETS * COMET_CHANNELS;
   261	        let global_channels = self.global_channels;
   262	        let player_features_per_env = OUTER_PLAYER_SLOTS * self.player_feature_channels;
   263	        let target_incoming_per_env = ACTION_ENTITY_SLOTS * self.target_incoming_channels;
   264	        let action_masks_per_env = self.action_spec.can_act_len();
   265	        let two_player_weight = self.two_player_weight;
   266	        let max_fleets = self.max_fleets;
   267	        let planet_channels = self.planet_channels;
   268	        let fleet_channels = self.fleet_channels;
   269	        let mut player_feature_chunks = player_feature_chunks_mut(
   270	            player_features.as_mut(),
   271	            self.n_envs,
   272	            player_features_per_env,
   273	        )?;
   274	        let mut fleet_target_chunks =
   275	            fleet_target_chunks_mut(fleet_target.as_mut(), self.n_envs, self.max_fleets)?;
   276	        let mut target_incoming_chunks = target_incoming_feature_chunks_mut(
   277	            target_incoming_features.as_mut(),
   278	            self.n_envs,
   279	            target_incoming_per_env,
   280	        )?;
   281	        let ship_count_one_hot_max = self.ship_count_one_hot_max;
   282	        let min_fleet_size = self.min_fleet_size;
   283	        let action_spec = self.action_spec;
   284	        let max_launch_per_env = OUTER_PLAYER_SLOTS * ACTION_ENTITY_SLOTS;
   285	
   286	        self.states
   287	            .par_iter_mut()
   288	            .zip_eq(self.player_maps.par_iter_mut())
   289	            .zip_eq(self.action_slots.par_iter_mut())
   290	            .zip_eq(self.player_finished.par_iter_mut())
   291	            .zip_eq(self.episode_stats.par_iter_mut())
   292	            .zip_eq(planet_obs.as_slice_mut()?.par_chunks_mut(planets_per_env))
   293	            .zip_eq(
   294	                orbiting_planet_obs
   295	                    .as_slice_mut()?
   296	                    .par_chunks_mut(orbiting_planets_per_env),
   297	            )
   298	            .zip_eq(fleet_obs.as_slice_mut()?.par_chunks_mut(fleets_per_env))
   299	            .zip_eq(comet_obs.as_slice_mut()?.par_chunks_mut(comets_per_env))
   300	            .zip_eq(
   301	                entity_mask
   302	                    .as_slice_mut()?
   303	                    .par_chunks_mut(self.max_entities),
   304	            )
   305	            .zip_eq(
   306	                still_playing
   307	                    .as_slice_mut()?
   308	                    .par_chunks_mut(OUTER_PLAYER_SLOTS),
   309	            )
   310	            .zip_eq(global_obs.as_slice_mut()?.par_chunks_mut(global_channels))
   311	            .zip_eq(player_feature_chunks.par_iter_mut())
   312	            .zip_eq(fleet_target_chunks.par_iter_mut())
   313	            .zip_eq(target_incoming_chunks.par_iter_mut())
   314	            .zip_eq(can_act.as_slice_mut()?.par_chunks_mut(action_masks_per_env))
   315	            .zip_eq(
   316	                max_launch
   317	                    .as_slice_mut()?
   318	                    .par_chunks_mut(max_launch_per_env),
   319	            )
   320	            .for_each(|item| {
   321	                let (item, max_launch) = item;
   322	                let (item, can_act) = item;
   323	                let (item, target_incoming_features) = item;
   324	                let (item, fleet_target) = item;
   325	                let (item, player_features) = item;
   326	                let (item, global_obs) = item;
   327	                let (item, still_playing) = item;
   328	                let (item, entity_mask) = item;
   329	                let (item, comet_obs) = item;
   330	                let (item, fleet_obs) = item;
   331	                let (item, orbiting_planet_obs) = item;
   332	                let (item, planet_obs) = item;
   333	                let ((((state, player_map), action_slots), player_finished), episode_stats) = item;
   334	
   335	                {
   336	                    let (new_state, new_player_map) = reset_one_env(two_player_weight);
   337	                    *state = new_state;
   338	                    *player_map = new_player_map;
   339	                    player_finished.fill(false);
   340	                    *episode_stats = EpisodeStats::default();
   341	                    write_one_obs(
   342	                        state,
   343	                        player_map,
   344	                        action_slots,
   345	                        player_finished,
   346	                        action_spec,
   347	                        max_fleets,
   348	                        planet_channels,
   349	                        fleet_channels,
   350	                        ship_count_one_hot_max,
   351	                        min_fleet_size,
   352	                        planet_obs,
   353	                        orbiting_planet_obs,
   354	                        fleet_obs,
   355	                        comet_obs,
   356	                        entity_mask,
   357	                        still_playing,
   358	                        global_obs,
   359	                        player_features.as_deref_mut(),
   360	                        fleet_target.as_deref_mut(),
   361	                        target_incoming_features.as_deref_mut(),
   362	                        can_act,
   363	                        Some(max_launch),
   364	                    )
   365	                }
   366	            });
   367	
   368	        self.last_terminal_metrics.fill(None);
   369	        self.last_terminal_snapshots.fill(None);
   370	        Ok(())
   371	    }
