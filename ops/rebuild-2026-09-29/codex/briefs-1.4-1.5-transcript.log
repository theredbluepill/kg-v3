     1	"""Kaggriculture grammar support tables for the batched action heads.
     2	
     3	``GrammarTables`` holds the eight factored boolean tables of contract v4
     4	"Action" (``docs/kaggriculture-contract.md``). The action heads index them with
     5	the frame's already-chosen values to get each slot's prefix-dependent support
     6	mask; the runtime overlays (unit liveness, queue availability, HIRE capacity and
     7	STOP marginalization) are applied by the heads, not stored here.
     8	
     9	The native grammar (Task 1.2's ``grammar_tables()`` exposed by Task 1.4's
    10	``kaggriculture_grammar_tables`` binding) is the single source of truth.
    11	Until that binding exists, :func:`expected_grammar_tables` builds the same
    12	tables from the support rules the Task 2.3 brief re-derives from the reference
    13	grammar (``myolie_sampler.rs`` ``State::allows``/``advance``); a test compares
    14	the two once :func:`native_grammar_tables` is implemented.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	from collections.abc import Collection, Mapping
    20	from dataclasses import dataclass
    21	
    22	import numpy as np
    23	import torch
    24	
    25	from owl.kaggriculture import types as kt
    26	
    27	UNIT_KIND_WIDTH = kt.SLOT_WIDTHS[1]
    28	ITEM_WIDTH = kt.SLOT_WIDTHS[3]
    29	PRESENT_WIDTH = kt.SLOT_WIDTHS[4]
    30	DIGIT_WIDTH = kt.SLOT_WIDTHS[5]
    31	MARKET_KIND_WIDTH = kt.SLOT_WIDTHS[7]
    32	
    33	MARKET_NONE = kt.MARKET_KINDS.index("NONE")
    34	MARKET_HIRE = kt.MARKET_KINDS.index("HIRE")
    35	MARKET_EMPTY = kt.MARKET_KINDS.index("EMPTY")
    36	
    37	# Field name -> exact table shape. Names match Task 1.2's native ``GrammarTables``.
    38	TABLE_SHAPES: dict[str, tuple[int, ...]] = {
    39	    "unit_kind": (UNIT_KIND_WIDTH,),
    40	    "unit_item": (UNIT_KIND_WIDTH, ITEM_WIDTH),
    41	    "unit_quantity_present": (UNIT_KIND_WIDTH, PRESENT_WIDTH),
    42	    "unit_quantity_high": (PRESENT_WIDTH, DIGIT_WIDTH),
    43	    "unit_quantity_low": (PRESENT_WIDTH, 2, DIGIT_WIDTH),
    44	    "market_kind": (MARKET_KIND_WIDTH,),
    45	    "market_item": (MARKET_KIND_WIDTH, ITEM_WIDTH),
    46	    "market_quantity": (MARKET_KIND_WIDTH, DIGIT_WIDTH),
    47	}
    48	
    49	
    50	@dataclass(frozen=True)
    51	class GrammarTables:
    52	    """Factored grammar support tables (``torch.bool``, one device).
    53	
    54	    Indexing (Task 2.3 brief §2):
    55	
    56	    - ``unit_item[kind]``, ``unit_quantity_present[kind]``
    57	    - ``unit_quantity_high[present]``
    58	    - ``unit_quantity_low[present, high == 0]`` (index 1 = the high digit is 0)
    59	    - ``market_item[kind]``; ``market_quantity[kind]`` serves both digit slots
    60	
    61	    Construct through :func:`validate_grammar_tables` or a builder; the class
    62	    itself carries no checks so the compiled head core can rebuild it freely.
    63	    """
    64	
    65	    unit_kind: torch.Tensor
    66	    unit_item: torch.Tensor
    67	    unit_quantity_present: torch.Tensor
    68	    unit_quantity_high: torch.Tensor
    69	    unit_quantity_low: torch.Tensor
    70	    market_kind: torch.Tensor
    71	    market_item: torch.Tensor
    72	    market_quantity: torch.Tensor
    73	
    74	    def as_dict(self) -> dict[str, torch.Tensor]:
    75	        return {
    76	            "unit_kind": self.unit_kind,
    77	            "unit_item": self.unit_item,
    78	            "unit_quantity_present": self.unit_quantity_present,
    79	            "unit_quantity_high": self.unit_quantity_high,
    80	            "unit_quantity_low": self.unit_quantity_low,
    81	            "market_kind": self.market_kind,
    82	            "market_item": self.market_item,
    83	            "market_quantity": self.market_quantity,
    84	        }
    85	
    86	
    87	def validate_grammar_tables(tables: GrammarTables) -> GrammarTables:
    88	    """Check dtypes, shapes, device and the invariants the heads rely on.
    89	
    90	    - every table row admits at least one value, so each masked categorical
    91	      has support (placeholder rows for unreachable prefixes included)
    92	    - market ``NONE`` is admitted, so STOP is reachable at every queue position
    93	    - market ``HIRE`` is not the only admitted kind, so the capacity correction
    94	      always has a non-HIRE outcome
    95	    """
    96	    fields = tables.as_dict()
    97	    device = tables.unit_kind.device
    98	    for name, shape in TABLE_SHAPES.items():
    99	        table = fields[name]
   100	        if table.dtype != torch.bool:
   101	            raise ValueError(
   102	                f"grammar table {name} must be torch.bool, got {table.dtype}"
   103	            )
   104	        if tuple(table.shape) != shape:
   105	            raise ValueError(
   106	                f"grammar table {name} must have shape {shape}, "
   107	                f"got {tuple(table.shape)}"
   108	            )
   109	        if table.device != device:
   110	            raise ValueError(
   111	                f"grammar table {name} is on {table.device}, expected {device}"
   112	            )
   113	        if not bool(table.any(dim=-1).all()):
   114	            raise ValueError(f"grammar table {name} has a row with no admitted value")
   115	    if not bool(tables.market_kind[MARKET_NONE]):
   116	        raise ValueError("grammar table market_kind must admit NONE (STOP)")
   117	    others = tables.market_kind.clone()
   118	    others[MARKET_HIRE] = False
   119	    if not bool(others.any()):
   120	        raise ValueError("grammar table market_kind must admit a kind other than HIRE")
   121	    return tables
   122	
   123	
   124	def grammar_tables_from_arrays(
   125	    arrays: Mapping[str, np.ndarray | torch.Tensor],
   126	    *,
   127	    device: torch.device | str = "cpu",
   128	) -> GrammarTables:
   129	    """Typed tables from exactly the eight named boolean arrays.
   130	
   131	    This is the conversion the native binding feeds (Task 1.2 brief: C-contiguous
   132	    ``numpy.bool_`` arrays, no env/seat dimension). Non-bool input is rejected
   133	    rather than cast.
   134	    """
   135	    missing = sorted(set(TABLE_SHAPES) - set(arrays))
   136	    extra = sorted(set(arrays) - set(TABLE_SHAPES))
   137	    if missing or extra:
   138	        raise ValueError(
   139	            f"grammar tables need exactly {sorted(TABLE_SHAPES)}; "
   140	            f"missing {missing}, unexpected {extra}"
   141	        )
   142	    converted: dict[str, torch.Tensor] = {}
   143	    for name in TABLE_SHAPES:
   144	        value = arrays[name]
   145	        tensor = (
   146	            value if isinstance(value, torch.Tensor) else torch.from_numpy(value.copy())
   147	        )
   148	        if tensor.dtype != torch.bool:
   149	            raise ValueError(f"grammar table {name} must be bool, got {tensor.dtype}")
   150	        converted[name] = tensor.to(device=device)
   151	    return validate_grammar_tables(GrammarTables(**converted))
   152	
   153	
   154	def _mask(width: int, allowed: Collection[int]) -> list[bool]:
   155	    return [index in allowed for index in range(width)]
   156	
   157	
   158	def expected_grammar_tables(device: torch.device | str = "cpu") -> GrammarTables:
   159	    """The tables the Task 2.3 brief derives from the reference grammar rules.
   160	
   161	    Synthetic stand-in until :func:`native_grammar_tables` exists:
   162	
   163	    - unit kind ``1..18`` (PASS … DIG)
   164	    - unit item ``1..12`` for PICKUP/PLACE (6/7), ``1..5`` for PLANT (8), else
   165	      ``{0}``; rows 0 and 19 are ``{0}`` placeholders (kind admission rejects
   166	      them first)
   167	    - only PICKUP/PLACE may set ``present = 1``; an absent quantity forces both
   168	      digits to 0; a present quantity excludes low digit 0 only when the high
   169	      digit is 0 (so an explicit unit zero is rejected, 1..1023 accepted)
   170	    - market item ``1..5`` / ``{1, 9}`` / ``10..12`` / ``1..9`` for BUY_SEED /
   171	      BUY_PRODUCT / BUY_ANIMAL / SELL, else ``{0}``
   172	    - market quantity digits ``0..31`` for kinds 3..6 (explicit zero accepted),
   173	      else ``{0}``
   174	    """
   175	    unit_kind = _mask(UNIT_KIND_WIDTH, range(1, 19))
   176	    transfer = (kt.UNIT_KINDS.index("PICKUP"), kt.UNIT_KINDS.index("PLACE"))
   177	    plant = kt.UNIT_KINDS.index("PLANT")
   178	    unit_item: list[list[bool]] = []
   179	    unit_present: list[list[bool]] = []
   180	    for kind in range(UNIT_KIND_WIDTH):
   181	        if kind in transfer:
   182	            unit_item.append(_mask(ITEM_WIDTH, range(1, kt.ITEM_COUNT + 1)))
   183	            unit_present.append(_mask(PRESENT_WIDTH, (0, 1)))
   184	        elif kind == plant:
   185	            unit_item.append(_mask(ITEM_WIDTH, range(1, len(kt.CROPS))))
   186	            unit_present.append(_mask(PRESENT_WIDTH, (0,)))
   187	        else:
   188	            unit_item.append(_mask(ITEM_WIDTH, (0,)))
   189	            unit_present.append(_mask(PRESENT_WIDTH, (0,)))
   190	    digits = range(DIGIT_WIDTH)
   191	    unit_high = [_mask(DIGIT_WIDTH, (0,)), _mask(DIGIT_WIDTH, digits)]
   192	    unit_low = [
   193	        [_mask(DIGIT_WIDTH, (0,)), _mask(DIGIT_WIDTH, (0,))],
   194	        [_mask(DIGIT_WIDTH, digits), _mask(DIGIT_WIDTH, range(1, DIGIT_WIDTH))],
   195	    ]
   196	    market_kind = _mask(MARKET_KIND_WIDTH, range(MARKET_KIND_WIDTH))
   197	    item_support = {
   198	        kt.MARKET_KINDS.index("BUY_SEED"): range(1, 6),
   199	        kt.MARKET_KINDS.index("BUY_PRODUCT"): (1, 9),
   200	        kt.MARKET_KINDS.index("BUY_ANIMAL"): range(10, 13),
   201	        kt.MARKET_KINDS.index("SELL"): range(1, 10),
   202	    }
   203	    market_item = [
   204	        _mask(ITEM_WIDTH, item_support.get(kind, (0,)))
   205	        for kind in range(MARKET_KIND_WIDTH)
   206	    ]
   207	    market_quantity = [
   208	        _mask(DIGIT_WIDTH, digits if kind in item_support else (0,))
   209	        for kind in range(MARKET_KIND_WIDTH)
   210	    ]
   211	
   212	    def tensor(values: object) -> torch.Tensor:
   213	        return torch.tensor(values, dtype=torch.bool, device=device)
   214	
   215	    return validate_grammar_tables(
   216	        GrammarTables(
   217	            unit_kind=tensor(unit_kind),
   218	            unit_item=tensor(unit_item),
   219	            unit_quantity_present=tensor(unit_present),
   220	            unit_quantity_high=tensor(unit_high),
   221	            unit_quantity_low=tensor(unit_low),
   222	            market_kind=tensor(market_kind),
   223	            market_item=tensor(market_item),
   224	            market_quantity=tensor(market_quantity),
   225	        )
   226	    )
   227	
   228	
   229	def native_grammar_tables(device: torch.device | str = "cpu") -> GrammarTables:
   230	    """Hook for the native builder: tables extracted from the Rust grammar plans.
   231	
   232	    Task 1.2 adds ``grammar_tables()`` in Rust and Task 1.4 binds it as
   233	    ``owl.rs.kaggriculture_grammar_tables() -> dict[str, numpy.ndarray]`` (plus
   234	    ``kaggriculture_grammar_constants()`` for version/name/width checks). The
   235	    implementation is then ``grammar_tables_from_arrays(binding(), device=...)``
   236	    after the constants check. Until then this raises instead of silently
   237	    substituting :func:`expected_grammar_tables`.
   238	    """
   239	    del device
   240	    raise NotImplementedError(
   241	        "native grammar tables arrive with Task 1.2/1.4 "
   242	        "(owl.rs.kaggriculture_grammar_tables); use expected_grammar_tables "
   243	        "until the binding exists"
   244	    )

