   435	    def _run_trunk(self, x: torch.Tensor, token_mask: torch.Tensor) -> torch.Tensor:
   436	        """Isaiah's dispatch, guarded against the compiled-GEMM overflow."""
   437	        should_use_flash = use_flash_attn(x)
   438	        if (
   439	            _requires_flash_attn(x, force_flash_attn=self.config.force_flash_attn)
   440	            and not should_use_flash
   441	        ):
   442	            raise RuntimeError(
   443	                "force_flash_attn=True requires CUDA fp16/bf16 tensors "
   444	                "and the flash-attn package"
   445	            )
   446	        trunk = self._compiled_transformer_trunk or self._forward_transformer_trunk
   447	        width = trunk_gemm_width(self.config)
   448	        if should_use_flash:
   449	            return self._run_packed_trunk(trunk, x, token_mask, width)
   450	        chunk = rows_per_chunk(tokens=x.shape[1], width=width)
   451	        if chunk <= 0:
   452	            raise ValueError(
   453	                f"a single padded row of {x.shape[1]} tokens x {width} reaches the "
   454	                f"2**31 GEMM limit; see {_OVERFLOW_REFERENCE}"
   455	            )
   456	        if x.shape[0] <= chunk:
   457	            return trunk(x, token_mask, None)
   458	        return torch.cat(
   459	            [
   460	                trunk(x[start : start + chunk], token_mask[start : start + chunk], None)
   461	                for start in range(0, x.shape[0], chunk)
   462	            ],
   463	            dim=0,
   464	        )
   465	
   466	    @staticmethod
   467	    def _run_packed_trunk(
   468	        trunk: Callable[
   469	            [torch.Tensor, torch.Tensor | None, PackedSequence | None], torch.Tensor
   470	        ],
   471	        x: torch.Tensor,
   472	        token_mask: torch.Tensor,
   473	        width: int,
   474	    ) -> torch.Tensor:
   475	        """Packed dispatch, chunked at row boundaries below the GEMM limit.
   476	
   477	        The padded bound needs no sync; only a batch whose padded size could
   478	        overflow transfers its per-row token counts to plan the chunks.
   479	        """
   480	        rows, tokens = x.shape[:2]
   481	        if rows * tokens * width < _GEMM_ELEMENT_LIMIT:
   482	            packed_x, packed = pack_sequence(x, token_mask, max_seqlen=tokens)
   483	            return unpack_sequence(trunk(packed_x, None, packed), packed)
   484	        row_tokens = [int(n) for n in token_mask.sum(dim=1).tolist()]
   485	        outputs = []
   486	        for start, stop in packed_row_chunks(row_tokens, width=width):
   487	            packed_x, packed = pack_sequence(
   488	                x[start:stop], token_mask[start:stop], max_seqlen=tokens
   489	            )
   490	            outputs.append(unpack_sequence(trunk(packed_x, None, packed), packed))
   491	        return torch.cat(outputs, dim=0)
   492	
