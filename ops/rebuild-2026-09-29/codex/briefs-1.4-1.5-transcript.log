   283	#[pyclass(name = "KaggricultureTrainingEnv")]
   284	struct PyKaggricultureTrainingEnv {
   285	    batch: Option<kaggriculture_engine::training::TrainingBatch>,
   286	}
   287	
   288	fn training_error(message: String) -> PyErr {
   289	    if message.contains("signed-int16") || message.contains("action lengths") {
   290	        PyValueError::new_err(message)
   291	    } else {
   292	        PyRuntimeError::new_err(message)
   293	    }
   294	}
   295	
   296	#[pymethods]
   297	impl PyKaggricultureTrainingEnv {
   298	    #[new]
   299	    #[allow(clippy::too_many_arguments)]
   300	    fn new(
   301	        py: Python<'_>,
   302	        n_envs: usize,
   303	        configuration: &str,
   304	        seed: &str,
   305	        stride: &str,
   306	        threads: usize,
   307	        version: u32,
   308	        reward: &str,
   309	    ) -> PyResult<Self> {
   310	        py.detach(|| {
   311	            kaggriculture_engine::training::TrainingBatch::from_json(
   312	                n_envs,
   313	                configuration,
   314	                seed,
   315	                stride,
   316	                threads,
   317	                version,
   318	                reward,
   319	            )
   320	            .map(|batch| Self { batch: Some(batch) })
   321	        })
   322	        .map_err(training_error)
   323	    }
   324	    #[allow(clippy::too_many_arguments)]
   325	    fn observe(
   575	        let mut dones = dones
   576	            .try_readwrite()
   577	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   578	        let dones = dones.as_slice_mut()?;
   579	        let mut previous_banks = previous_banks
   580	            .try_readwrite()
   581	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   582	        let previous_banks = previous_banks.as_slice_mut()?;
   583	        let mut current_banks = current_banks
   584	            .try_readwrite()
   585	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   586	        let current_banks = current_banks.as_slice_mut()?;
   587	        let mut previous_econ = previous_econ
   588	            .try_readwrite()
   589	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   590	        let previous_econ = previous_econ.as_slice_mut()?;
   591	        let mut current_econ = current_econ
   592	            .try_readwrite()
   593	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   594	        let current_econ = current_econ.as_slice_mut()?;
   595	        py.detach(|| {
   596	            let metrics = batch.step(tokens, lengths)?;
   597	            features.copy_from_slice(&batch.output.features);
   598	            context.copy_from_slice(&batch.output.context);
   599	            entity_mask.copy_from_slice(&batch.output.entity_mask);
   600	            still_playing.copy_from_slice(&batch.output.still_playing);
   601	            can_act.copy_from_slice(&batch.output.can_act);
   602	            rewards.copy_from_slice(&batch.output.rewards);
   603	            dones.copy_from_slice(&batch.output.dones);
   604	            previous_banks.copy_from_slice(&batch.output.previous_banks);
   605	            current_banks.copy_from_slice(&batch.output.current_banks);
   606	            previous_econ.copy_from_slice(&batch.output.previous_econ);
   607	            current_econ.copy_from_slice(&batch.output.current_econ);
   608	            Ok(metrics)
   609	        })
   610	        .map_err(training_error)
   611	    }
   612	    #[allow(clippy::too_many_arguments)]
   613	    fn reset(
   720	            .try_readwrite()
   721	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   722	        let dones = dones.as_slice_mut()?;
   723	        let mut previous_banks = previous_banks
   724	            .try_readwrite()
   725	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   726	        let previous_banks = previous_banks.as_slice_mut()?;
   727	        let mut current_banks = current_banks
   728	            .try_readwrite()
   729	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   730	        let current_banks = current_banks.as_slice_mut()?;
   731	        let mut previous_econ = previous_econ
   732	            .try_readwrite()
   733	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   734	        let previous_econ = previous_econ.as_slice_mut()?;
   735	        let mut current_econ = current_econ
   736	            .try_readwrite()
   737	            .map_err(|_| PyValueError::new_err("overlapping or borrowed training buffers"))?;
   738	        let current_econ = current_econ.as_slice_mut()?;
   739	        py.detach(|| {
   740	            batch.reset(selected, clear_transition)?;
   741	            features.copy_from_slice(&batch.output.features);
   742	            context.copy_from_slice(&batch.output.context);
   743	            entity_mask.copy_from_slice(&batch.output.entity_mask);
   744	            still_playing.copy_from_slice(&batch.output.still_playing);
   745	            can_act.copy_from_slice(&batch.output.can_act);
   746	            rewards.copy_from_slice(&batch.output.rewards);
   747	            dones.copy_from_slice(&batch.output.dones);
   748	            previous_banks.copy_from_slice(&batch.output.previous_banks);
   749	            current_banks.copy_from_slice(&batch.output.current_banks);
   750	            previous_econ.copy_from_slice(&batch.output.previous_econ);
   751	            current_econ.copy_from_slice(&batch.output.current_econ);
   752	            Ok(())
   753	        })
   754	        .map_err(training_error)
   755	    }
   756	
   757	    fn snapshot(&self, py: Python<'_>, index: usize, terminal: bool) -> PyResult<Option<String>> {
   758	        let batch = self
   759	            .batch
   760	            .as_ref()
   761	            .ok_or_else(|| PyRuntimeError::new_err("Kaggriculture environment is closed"))?;
   762	        py.detach(|| batch.snapshot_json(index, terminal))
   763	            .map_err(training_error)
   764	    }
   765	    fn terminal_metrics(
   766	        &self,
   767	        index: usize,
   768	    ) -> PyResult<Option<std::collections::HashMap<String, f64>>> {
   769	        self.batch
   770	            .as_ref()
   771	            .ok_or_else(|| PyRuntimeError::new_err("Kaggriculture environment is closed"))?
   772	            .terminal_metrics(index)
   773	            .map_err(training_error)
   774	    }
   775	    fn seed_state(&self) -> PyResult<(String, Vec<String>)> {
   776	        Ok(self
   777	            .batch
   778	            .as_ref()
   779	            .ok_or_else(|| PyRuntimeError::new_err("Kaggriculture environment is closed"))?
   780	            .seeds())
   781	    }
   782	    fn close(&mut self) {
   783	        self.batch.take();
   784	    }
   785	}
   786	
   787	pub fn add_to_module(m: &Bound<'_, PyModule>) -> PyResult<()> {
   788	    m.add_class::<PyKaggricultureBatch>()?;
   789	    m.add_class::<PyKaggricultureTrainingEnv>()?;
   790	    m.add_function(wrap_pyfunction!(kaggriculture_seed_header, m)?)?;
   791	    m.add_function(wrap_pyfunction!(kaggriculture_grammar_plan, m)?)?;
   792	    m.add_function(wrap_pyfunction!(kaggriculture_decode, m)?)?;
   793	    Ok(())
   794	}

