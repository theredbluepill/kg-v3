    56	pub(crate) fn product_index(item: &str) -> Option<usize> {
    57	    PRODUCTS.iter().position(|p| *p == item)
    58	}
    59	
    60	fn verb_index(op: &str) -> Option<usize> {
    61	    ATTRIB_VERBS.iter().position(|v| *v == op)
    62	}
    63	
    64	fn op_of(action: &Value) -> Option<&str> {
    65	    action.as_array().and_then(|parts| parts.first()).and_then(Value::as_str)
    66	}
    67	
    68	fn integer_cash(price: &Value) -> u64 {
    69	    price.as_u64().or_else(|| price.as_f64().map(|value| value.round().max(0.0) as u64)).unwrap_or(0)
    70	}
    71	
    72	/// The actor's carried count of a PICKUP/PLACE item before the command (None for other commands).
    73	pub(crate) fn transfer_before(private: &PrivateState, index: usize, action: &Value) -> Option<(String, i64)> {
    74	    let parts = action.as_array()?;
    75	    if !matches!(parts.first()?.as_str()?, "PICKUP" | "PLACE") {
    76	        return None;
    77	    }
    78	    let item = parts.get(1)?.as_str()?;
    79	    let held = private.inventories.get(index).and_then(|inv| inv.get(item)).copied().unwrap_or(0);
    80	    Some((item.to_string(), held))
    81	}
