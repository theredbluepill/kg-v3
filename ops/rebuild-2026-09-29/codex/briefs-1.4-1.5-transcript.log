   589	fn first_token(mask: &[bool]) -> Result<i64, String> {
   590	    let index = mask
   591	        .iter()
   592	        .position(|&bit| bit)
   593	        .ok_or("grammar table has empty support")?;
   594	    i64::try_from(index).map_err(|e| e.to_string())
   595	}
