   357	pub fn plan(actors: i64, order_limit: i64, hire_limit: i64) -> Result<GrammarPlan, String> {
   358	    for (field, value, max) in [
   359	        ("actors", actors, 241),
   360	        ("order_limit", order_limit, 10),
   361	        ("hire_limit", hire_limit, 241),
   362	    ] {
   363	        if !(1..=max).contains(&value) {
   364	            return Err(format!(
   365	                "grammar shape {field} value {value} must be in 1..={max}"
   366	            ));
   367	        }
   368	    }
   369	    Ok(GrammarPlan {
   370	        shape: Shape {
   371	            actors: u16::try_from(actors).map_err(|e| format!("grammar shape actors: {e}"))?,
   372	            orders: u8::try_from(order_limit)
   373	                .map_err(|e| format!("grammar shape order_limit: {e}"))?,
   374	            hire_limit: u16::try_from(hire_limit)
   375	                .map_err(|e| format!("grammar shape hire_limit: {e}"))?,
   376	        },
