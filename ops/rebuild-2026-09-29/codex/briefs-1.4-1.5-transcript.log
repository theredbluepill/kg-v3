  1625	    fn econ_malformed_unit(&self, player: usize, unit: usize, action: &Value) -> bool {
  1626	        if !malformed_unit(action) { return false; }
  1627	        // Animal placement does not inspect its optional quantity, even when inventory is empty.
  1628	        if let Some(parts) = action.as_array()
  1629	            && parts.first().and_then(Value::as_str) == Some("PLACE")
  1630	            && let Some(data) = parts.get(1).and_then(Value::as_str).and_then(animal)
  1631	            && let Some((x, y)) = farmer_position(&self.farms[player], unit)
  1632	            && x >= 0 && y >= 0
  1633	            && let Some(tile) = self.farms[player].tiles.get(y as usize).and_then(|r| r.get(x as usize)).and_then(Value::as_object)
  1634	            && map_str(tile, "kind") == Some(data.structure) && !tile.contains_key("animal") {
  1635	            return false;
  1636	        }
  1637	        true
  1638	    }
