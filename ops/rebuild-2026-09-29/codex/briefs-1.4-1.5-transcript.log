    91	#[pymethods]
    92	impl PyRlVecEnv {
    93	    #[new]
    94	    #[pyo3(signature = (n_envs, two_player_weight=0.5, obs_spec="entity_based", action_spec="pure", max_entities=DEFAULT_MAX_ENTITIES, ship_count_one_hot_max=0, max_per_planet_launches=1, min_fleet_size=1, n_bins=0, targeting_mode="full_mask", reward_mode="win_loss"))]
    95	    #[allow(clippy::too_many_arguments)]
    96	    fn new(
    97	        n_envs: usize,
    98	        two_player_weight: f64,
    99	        obs_spec: &str,
   100	        action_spec: &str,
   101	        max_entities: usize,
   102	        ship_count_one_hot_max: usize,
   103	        max_per_planet_launches: usize,
   104	        min_fleet_size: i64,
   105	        n_bins: usize,
   106	        targeting_mode: &str,
   107	        reward_mode: &str,
   108	    ) -> PyResult<Self> {
   109	        if n_envs == 0 {
   110	            return Err(PyValueError::new_err("n_envs must be positive"));
   111	        }
   112	        if !(0.0..=1.0).contains(&two_player_weight) {
   113	            return Err(PyValueError::new_err("two_player_weight must be in [0, 1]"));
   114	        }
   115	        let reward_mode = RewardMode::parse(reward_mode).map_err(PyValueError::new_err)?;
   116	        let obs_buffers =
   117	            parse_obs_spec_for_buffers(obs_spec, max_entities, ship_count_one_hot_max)?;
   118	        let action_spec = RlActionSpec::parse(action_spec, n_bins, targeting_mode)
   119	            .map_err(PyValueError::new_err)?;
   120	        if !(1..=4).contains(&max_per_planet_launches) {
   121	            return Err(PyValueError::new_err(
   122	                "max_per_planet_launches must be between 1 and 4",
   123	            ));
   124	        }
   125	        if matches!(action_spec, RlActionSpec::Pure) && max_per_planet_launches != 1 {
   126	            return Err(PyValueError::new_err(
   127	                "pure action_spec requires max_per_planet_launches=1",
   128	            ));
   129	        }
   130	        require_min_fleet_size(min_fleet_size)?;
   131	
   132	        let envs = (0..n_envs)
   133	            .map(|_| reset_one_env(two_player_weight))
   134	            .collect::<Vec<_>>();
   135	        let (states, player_maps): (Vec<_>, Vec<_>) = envs.into_iter().unzip();
   136	        let action_slots = states.iter().map(action_entity_slots).collect();
   137	
   138	        Ok(Self {
   139	            n_envs,
   140	            two_player_weight,
   141	            reward_mode,
   142	            max_entities: obs_buffers.max_entities,
   143	            max_fleets: obs_buffers.max_fleets,
   144	            planet_channels: obs_buffers.planet_channels,
   145	            fleet_channels: obs_buffers.fleet_channels,
   146	            global_channels: obs_buffers.global_channels,
   147	            player_feature_channels: obs_buffers.player_feature_channels,
   148	            fleet_target_required: obs_buffers.fleet_target_required,
   149	            target_incoming_channels: obs_buffers.target_incoming_channels,
   150	            ship_count_one_hot_max: obs_buffers.ship_count_one_hot_max,
   151	            action_spec,
   152	            max_per_planet_launches,
   153	            min_fleet_size,
   154	            states,
   155	            player_maps,
   156	            action_slots,
   157	            player_finished: vec![vec![false; OUTER_PLAYER_SLOTS]; n_envs],
   158	            episode_stats: vec![EpisodeStats::default(); n_envs],
   159	            last_terminal_metrics: vec![None; n_envs],
   160	            last_terminal_snapshots: vec![None; n_envs],
   161	        })
   162	    }
