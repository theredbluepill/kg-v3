   138	def trunk_gemm_width(config: KaggricultureTransformerConfig) -> int:
   139	    """Max GEMM operand/output width in the compiled trunk.
   140	
   141	    The maximum of ``max(in_features, out_features)`` over every ``nn.Linear``
   142	    in a ``TransformerBlock``: ``D -> D`` attention projections and the
   143	    ``D -> H -> D`` MLP (``H = int(D * mlp_ratio)``). A test enumerates the
   144	    blocks' Linear layers so a new block layout cannot silently exceed it.
   145	    """
   146	    return max(config.embed_dim, int(config.embed_dim * config.mlp_ratio))
   147	
   148	
   149	def rows_per_chunk(*, tokens: int, width: int) -> int:
   150	    """Largest padded row count whose GEMMs stay below the overflow limit."""
   151	    return (_GEMM_ELEMENT_LIMIT - 1) // (tokens * width)
   152	
   153	
   154	def packed_row_chunks(row_tokens: list[int], *, width: int) -> list[tuple[int, int]]:
   155	    """Split rows at row boundaries so each chunk's packed tokens x width < 2**31.
   156	
   157	    Greedy in row order; raises only when a single row cannot fit.
   158	    """
   159	    chunks: list[tuple[int, int]] = []
   160	    start, packed = 0, 0
   161	    for row, tokens in enumerate(row_tokens):
   162	        if tokens * width >= _GEMM_ELEMENT_LIMIT:
   163	            raise ValueError(
   164	                f"row {row} packs {tokens} tokens x {width}, at or above the 2**31 "
   165	                f"GEMM limit; see {_OVERFLOW_REFERENCE}"
   166	            )
   167	        if (packed + tokens) * width >= _GEMM_ELEMENT_LIMIT:
   168	            chunks.append((start, row))
   169	            start, packed = row, 0
   170	        packed += tokens
   171	    if row_tokens:
   172	        chunks.append((start, len(row_tokens)))
   173	    return chunks
   174	
