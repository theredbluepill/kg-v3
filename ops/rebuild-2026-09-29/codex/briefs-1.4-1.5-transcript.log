   709	    def compute_value(
   710	        self,
   711	        obs: kt.KaggricultureObsBatch,
   712	        *,
   713	        hidden_state: ModelHiddenState | None = None,
   714	    ) -> torch.Tensor:
   715	        """``win_loss`` value ``2 * p(self) - 1`` per seat, shape ``[env, seat]``."""
   716	        self._require_stateless(hidden_state)
   717	        values, _ = self._values(self.encode_observations(obs), obs)
   718	        return values
