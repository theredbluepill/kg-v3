   700	    def _values(
   701	        self, encoded: KaggricultureEncoded, obs: kt.KaggricultureObsBatch
   702	    ) -> tuple[torch.Tensor, torch.Tensor]:
   703	        """``(2 p(self) - 1 [env, seat], winner log-probs [env, seat, 2])``."""
   704	        winner_log_probs = self._winner_log_probabilities(encoded).reshape(
   705	            *obs.still_playing.shape, kt.PLAYERS
   706	        )
   707	        return 2.0 * winner_log_probs[..., 0].exp() - 1.0, winner_log_probs
