   534	    pub fn write_mask(self, plan: &GrammarPlan, out: &mut [bool]) -> Result<(), String> {
   535	        if self.shape != plan.shape {
   536	            return Err("grammar plan/state shape mismatch".into());
   537	        }
   538	        if out.len() != self.slot.width() {
   539	            return Err(format!(
   540	                "grammar mask slot {} shape: expected {}, got {}",
   541	                self.slot.name(),
   542	                self.slot.width(),
   543	                out.len()
   544	            ));
   545	        }
   546	        for (token, value) in out.iter_mut().enumerate() {
   547	            // Enumeration is bounded by the checked slot width (at most 241).
   548	            *value = self.allows(i64::try_from(token).map_err(|e| e.to_string())?, plan);
   549	        }
   550	        Ok(())
   551	    }
   552	}
   553	pub fn write_can_act(plan: &GrammarPlan, out: &mut [bool]) -> Result<(), String> {
   554	    if out.len() != MAX_FRAMES {
   555	        return Err(format!(
   556	            "can_act shape: expected {MAX_FRAMES}, got {}",
   557	            out.len()
   558	        ));
   559	    }
   560	    let active = plan.shape.actors() + plan.shape.order_limit() + 1;
   561	    for (frame, value) in out.iter_mut().enumerate() {
   562	        *value = frame < active;
   563	    }
   564	    Ok(())
   565	}
