   670	    @staticmethod
   671	    def _policy_outputs(
   672	        result: GrammarPolicyResult, obs: kt.KaggricultureObsBatch
   673	    ) -> tuple[kt.KaggricultureActions, ModelActionLogProbs, ModelActionEntropies]:
   674	        lead = tuple(obs.still_playing.shape)
   675	        shape = (*lead, kt.MAX_FRAMES, kt.ACTION_SLOTS)
   676	        event = result.log_probs.reshape(shape)
   677	        entropy = result.entropies.reshape(shape)
   678	        frame_log_probs = event.sum(dim=-1)
   679	        frame_entropies = entropy.sum(dim=-1)
   680	        return (
   681	            kt.KaggricultureActions(
   682	                tokens=result.tokens.reshape(shape),
   683	                lengths=result.lengths.reshape(lead),
   684	            ),
   685	            ModelActionLogProbs(
   686	                launch=torch.zeros_like(frame_log_probs),
   687	                event=event,
   688	                per_player_entity=frame_log_probs,
   689	            ),
   690	            ModelActionEntropies(
   691	                launch=torch.zeros_like(frame_entropies),
   692	                event=entropy,
   693	                per_player_entity=frame_entropies,
   694	                components={
   695	                    name: entropy[..., slot] for slot, name in enumerate(kt.SLOT_NAMES)
   696	                },
   697	            ),
   698	        )
