   762	/// Validate the entire i64 transport before rendering exact canonical syntax.
   763	/// Inputs are borrowed only for this call; no token is narrowed or repaired.
   764	pub fn decode(
   765	    plan: &GrammarPlan,
   766	    tokens: &[i64],
   767	    length: i64,
   768	) -> Result<serde_json::Value, String> {
   769	    use serde_json::{Map, Value};
   770	    let frames = validate_program(plan, tokens, length)?;
   771	    let actors = plan.shape.actors();
   772	    let farmer = render_unit(&tokens[..SLOTS])?;
   773	    let hands = tokens[SLOTS..actors * SLOTS]
   774	        .chunks_exact(SLOTS)
   775	        .map(render_unit)
   776	        .collect::<Result<Vec<_>, _>>()?;
   777	    let market = tokens[actors * SLOTS..(frames - 1) * SLOTS]
   778	        .chunks_exact(SLOTS)
   779	        .map(render_market)
   780	        .collect::<Result<Vec<_>, _>>()?;
   781	    let mut action = Map::new();
   782	    action.insert("farmer".into(), farmer);
   783	    action.insert("hands".into(), Value::Array(hands));
   784	    action.insert("market".into(), Value::Array(market));
   785	    Ok(Value::Object(action))
   786	}
