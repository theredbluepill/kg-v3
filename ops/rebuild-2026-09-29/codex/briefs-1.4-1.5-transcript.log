  1515	    fn apply_player_actions(
  1516	        &mut self,
  1517	        player: usize,
  1518	        action: &Value,
  1519	        day: i64,
  1520	    ) -> Result<UnitSeatMetrics, String> {
  1521	        let action_obj = action.as_object();
  1522	        let farmer_action = action_obj
  1523	            .and_then(|o| o.get("farmer"))
  1524	            .cloned()
  1525	            .unwrap_or_else(pass_action);
  1526	        let hands_actions = action_obj
  1527	            .and_then(|o| o.get("hands"))
  1528	            .and_then(Value::as_array)
  1529	            .cloned()
