    24	@dataclass(frozen=True)
    25	class BatchedSlotMasks:
    26	    """Native-derived local masks for fixed-depth, frame-parallel heads.
    27	
    28	    ``unit_quantity_low[present, high_is_zero]`` preserves explicit positive
    29	    transfer quantities. Invalid unit kinds have forced-zero placeholder rows;
    30	    callers must still apply ``unit_kind``. Global order count, first NONE and
    31	    HIRE budget are separate program constraints, checked by the native decoder.
    32	    """
    33	
    34	    unit_kind: torch.Tensor
    35	    market_kind: torch.Tensor
    36	    unit_item: torch.Tensor
    37	    unit_quantity_present: torch.Tensor
    38	    unit_quantity_high: torch.Tensor
    39	    unit_quantity_low: torch.Tensor
    40	    market_item: torch.Tensor
    41	    market_quantity: torch.Tensor
    42	
