   721	fn render_unit(frame: &[i64]) -> Result<serde_json::Value, String> {
   722	    use serde_json::Value;
   723	    let kind = UnitKind::try_from(frame[Slot::UnitKind as usize])?;
   724	    let mut command = vec![Value::from(kind.as_str())];
   725	    if matches!(kind, UnitKind::Pickup | UnitKind::Place | UnitKind::Plant) {
   726	        command.push(Value::from(
   727	            ActionItem::try_from(frame[Slot::UnitItem as usize])?.as_str(),
   728	        ));
   729	    }
   730	    if frame[Slot::UnitQuantityPresent as usize] == 1 {
   731	        command.push(Value::from(
   732	            QUANTITY_BASE * frame[Slot::UnitQuantityHigh as usize]
   733	                + frame[Slot::UnitQuantity as usize],
   734	        ));
   735	    }
   736	    Ok(Value::Array(command))
   737	}
   738	
   739	fn render_market(frame: &[i64]) -> Result<serde_json::Value, String> {
   740	    use serde_json::Value;
   741	    let kind = MarketKind::try_from(frame[Slot::MarketKind as usize])?;
   742	    let mut command = if kind == MarketKind::Empty {
   743	        vec![]
   744	    } else {
   745	        vec![Value::from(kind.as_str())]
   746	    };
   747	    if matches!(
   748	        kind,
   749	        MarketKind::BuySeed | MarketKind::BuyProduct | MarketKind::BuyAnimal | MarketKind::Sell
   750	    ) {
   751	        command.push(Value::from(
   752	            ActionItem::try_from(frame[Slot::MarketItem as usize])?.as_str(),
   753	        ));
   754	        command.push(Value::from(
   755	            QUANTITY_BASE * frame[Slot::MarketQuantityHigh as usize]
   756	                + frame[Slot::MarketQuantity as usize],
   757	        ));
   758	    }
   759	    Ok(Value::Array(command))
   760	}
