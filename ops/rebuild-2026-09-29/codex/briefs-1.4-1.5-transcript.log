    86	    episode_stats: Vec<EpisodeStats>,
    87	    last_terminal_metrics: Vec<Option<TerminalEpisodeMetrics>>,
    88	    last_terminal_snapshots: Vec<Option<StateSnapshot>>,
    89	}
