  1431	    pub fn step_with_market_metrics(&mut self, actions: &[Value]) -> Result<StepMetrics, String> {
  1432	        if self.done {
  1433	            return Err("cannot step a completed game".to_string());
  1434	        }
  1435	        if actions.len() != self.farms.len() {
  1436	            return Err(format!(
  1437	                "got {} actions for {} farms",
  1438	                actions.len(),
  1439	                self.farms.len()
  1440	            ));
  1441	        }
  1442	
  1443	        // The Kaggle framework interprets a copied action state and commits it only
  1444	        // when the interpreter returns successfully. Mirror that transaction so a
  1445	        // deferred config/custom-market/malformed-count error cannot leak mutations.
  1446	        let mut candidate = self.clone();
  1447	        let metrics = candidate.step_in_place(actions)?;
  1448	        *self = candidate;
  1449	        Ok(metrics)
  1450	    }
