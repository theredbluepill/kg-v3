   564	    fn truncate_envs(
   565	        &mut self,
   566	        truncate_mask: PyReadonlyArrayDyn<'_, bool>,
   567	        planet_obs: PyReadwriteArrayDyn<'_, f32>,
   568	        orbiting_planet_obs: PyReadwriteArrayDyn<'_, bool>,
   569	        fleet_obs: PyReadwriteArrayDyn<'_, f32>,
   570	        comet_obs: PyReadwriteArrayDyn<'_, f32>,
   571	        entity_mask: PyReadwriteArrayDyn<'_, bool>,
   572	        still_playing: PyReadwriteArrayDyn<'_, bool>,
   573	        global_obs: PyReadwriteArrayDyn<'_, f32>,
   574	        can_act: PyReadwriteArrayDyn<'_, bool>,
   575	        max_launch: Option<PyReadwriteArrayDyn<'_, i64>>,
   576	        player_features: Option<PyReadwriteArrayDyn<'_, f32>>,
   577	        fleet_target: Option<PyReadwriteArrayDyn<'_, i64>>,
   578	        target_incoming_features: Option<PyReadwriteArrayDyn<'_, f32>>,
   579	    ) -> PyResult<()> {
   580	        self.require_obs_shapes_without_max_launch(
   581	            &planet_obs,
   582	            &orbiting_planet_obs,
   583	            &fleet_obs,
   584	            &comet_obs,
   585	            &entity_mask,
   586	            &still_playing,
   587	            &global_obs,
   588	            player_features.as_ref(),
   589	            fleet_target.as_ref(),
   590	            target_incoming_features.as_ref(),
   591	            &can_act,
   592	        )?;
   593	        if self.action_spec.max_launch_len() > 0 {
   594	            let Some(max_launch) = max_launch.as_ref() else {
   595	                return Err(PyValueError::new_err(
   596	                    "max_launch is required for this action_spec",
   597	                ));
   598	            };
   599	            require_shape(
   600	                "max_launch",
   601	                max_launch.shape(),
   602	                &[self.n_envs, OUTER_PLAYER_SLOTS, ACTION_ENTITY_SLOTS],
   603	            )?;
   604	        }
   605	
   606	        let truncate_slice = truncate_mask.as_slice()?;
   607	        if truncate_slice.len() != self.n_envs {
   608	            return Err(PyValueError::new_err(format!(
   609	                "truncate_mask must have length {}, got {}",
   610	                self.n_envs,
   611	                truncate_slice.len()
   612	            )));
   613	        }
   614	
   615	        let mut planet_obs = planet_obs;
   616	        let mut orbiting_planet_obs = orbiting_planet_obs;
   617	        let mut fleet_obs = fleet_obs;
   618	        let mut comet_obs = comet_obs;
   619	        let mut entity_mask = entity_mask;
   620	        let mut still_playing = still_playing;
   621	        let mut global_obs = global_obs;
   622	        let mut player_features = player_features;
   623	        let mut fleet_target = fleet_target;
   624	        let mut target_incoming_features = target_incoming_features;
   625	        let mut can_act = can_act;
   626	        let mut max_launch = max_launch;
   627	
   628	        let planets_per_env = MAX_PLANETS * self.planet_channels;
   629	        let orbiting_planets_per_env = MAX_PLANETS;
   630	        let fleets_per_env = self.max_fleets * self.fleet_channels;
   631	        let comets_per_env = MAX_COMETS * COMET_CHANNELS;
   632	        let entity_mask_per_env = self.max_entities;
   633	        let global_channels = self.global_channels;
   634	        let player_features_per_env = OUTER_PLAYER_SLOTS * self.player_feature_channels;
   635	        let target_incoming_per_env = ACTION_ENTITY_SLOTS * self.target_incoming_channels;
   636	        let action_masks_per_env = self.action_spec.can_act_len();
   637	        let max_launch_per_env = self.action_spec.max_launch_len();
   638	        let n_envs = self.n_envs;
   639	        let two_player_weight = self.two_player_weight;
   640	        let max_fleets = self.max_fleets;
   641	        let planet_channels = self.planet_channels;
   642	        let fleet_channels = self.fleet_channels;
   643	        let ship_count_one_hot_max = self.ship_count_one_hot_max;
   644	        let min_fleet_size = self.min_fleet_size;
   645	        let action_spec = self.action_spec;
   646	
   647	        let planet_slice = planet_obs.as_slice_mut()?;
   648	        let orbiting_slice = orbiting_planet_obs.as_slice_mut()?;
   649	        let fleet_slice = fleet_obs.as_slice_mut()?;
   650	        let comet_slice = comet_obs.as_slice_mut()?;
   651	        let entity_mask_slice = entity_mask.as_slice_mut()?;
   652	        let still_playing_slice = still_playing.as_slice_mut()?;
   653	        let global_slice = global_obs.as_slice_mut()?;
   654	        let can_act_slice = can_act.as_slice_mut()?;
   655	        let mut max_launch_slice = match max_launch.as_mut() {
   656	            Some(array) => Some(array.as_slice_mut()?),
   657	            None => None,
   658	        };
   659	        let mut player_features_slice = match player_features.as_mut() {
   660	            Some(array) => Some(array.as_slice_mut()?),
   661	            None => None,
   662	        };
   663	        let mut fleet_target_slice = match fleet_target.as_mut() {
   664	            Some(array) => Some(array.as_slice_mut()?),
   665	            None => None,
   666	        };
   667	        let mut target_incoming_slice = match target_incoming_features.as_mut() {
   668	            Some(array) => Some(array.as_slice_mut()?),
   669	            None => None,
   670	        };
   671	
   672	        for env_index in 0..n_envs {
   673	            if !truncate_slice[env_index] {
   674	                continue;
   675	            }
   676	            let (new_state, new_player_map) = reset_one_env(two_player_weight);
   677	            self.player_finished[env_index].fill(false);
   678	            self.episode_stats[env_index] = EpisodeStats::default();
   679	            self.last_terminal_metrics[env_index] = None;
   680	            self.last_terminal_snapshots[env_index] = None;
   681	            let mut new_action_slots = action_entity_slots(&new_state);
   682	
   683	            let player_features_chunk = player_features_slice.as_deref_mut().map(|slice| {
   684	                &mut slice
   685	                    [env_index * player_features_per_env..(env_index + 1) * player_features_per_env]
   686	            });
   687	            let fleet_target_chunk = fleet_target_slice
   688	                .as_deref_mut()
   689	                .map(|slice| &mut slice[env_index * max_fleets..(env_index + 1) * max_fleets]);
   690	            let target_incoming_chunk = target_incoming_slice.as_deref_mut().map(|slice| {
   691	                &mut slice
   692	                    [env_index * target_incoming_per_env..(env_index + 1) * target_incoming_per_env]
   693	            });
   694	            let max_launch_chunk = max_launch_slice.as_deref_mut().map(|slice| {
   695	                &mut slice[env_index * max_launch_per_env..(env_index + 1) * max_launch_per_env]
   696	            });
   697	
   698	            write_one_obs(
   699	                &new_state,
   700	                &new_player_map,
   701	                &mut new_action_slots,
   702	                &self.player_finished[env_index],
   703	                action_spec,
   704	                max_fleets,
   705	                planet_channels,
   706	                fleet_channels,
   707	                ship_count_one_hot_max,
   708	                min_fleet_size,
   709	                &mut planet_slice[env_index * planets_per_env..(env_index + 1) * planets_per_env],
   710	                &mut orbiting_slice[env_index * orbiting_planets_per_env
   711	                    ..(env_index + 1) * orbiting_planets_per_env],
   712	                &mut fleet_slice[env_index * fleets_per_env..(env_index + 1) * fleets_per_env],
   713	                &mut comet_slice[env_index * comets_per_env..(env_index + 1) * comets_per_env],
   714	                &mut entity_mask_slice
   715	                    [env_index * entity_mask_per_env..(env_index + 1) * entity_mask_per_env],
   716	                &mut still_playing_slice
   717	                    [env_index * OUTER_PLAYER_SLOTS..(env_index + 1) * OUTER_PLAYER_SLOTS],
   718	                &mut global_slice[env_index * global_channels..(env_index + 1) * global_channels],
   719	                player_features_chunk,
   720	                fleet_target_chunk,
   721	                target_incoming_chunk,
   722	                &mut can_act_slice
   723	                    [env_index * action_masks_per_env..(env_index + 1) * action_masks_per_env],
   724	                max_launch_chunk,
   725	            );
   726	
   727	            self.states[env_index] = new_state;
   728	            self.player_maps[env_index] = new_player_map;
   729	            self.action_slots[env_index] = new_action_slots;
   730	        }
   731	
   732	        Ok(())
   733	    }
