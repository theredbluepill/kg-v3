   720	    def winner_log_probabilities(self, obs: kt.KaggricultureObsBatch) -> torch.Tensor:
   721	        """Winner distribution over (self, opponent) from each seat's own view.
   722	
   723	        Shape ``[env, seat, 2]``; index 0 is this seat winning.
   724	        """
