   290	def test_fused_native_lifecycle_matches_retained_array_oracle(mode, shaping) -> None:
   291	    from owl.kaggriculture.native_bridge import MyolieBuffers, RustBatch
   292	
   293	    full_season = mode == "win_loss" and not shaping.enabled
   294	    config = {"episodeSteps": 720 if full_season else 13}
   295	    next_seed = 31
   296	
   297	    def headers(count):
   298	        nonlocal next_seed
   299	        result = [native_seed_header(next_seed + i * 3, config) for i in range(count)]
   300	        next_seed += count * 3
   301	        return result
   302	
   303	    legacy = RustBatch(headers(2), threads=2)
   304	    arrays = MyolieBuffers(2, observation_version=2)
   305	    econ = np.zeros((2, 2, 32), dtype=np.uint64)
   306	    legacy.myolie_observe(arrays)
   307	    legacy.econ(econ)
   308	    try:
   309	        with KaggricultureVectorizedEnv(
   310	            n_envs=2,
   311	            pin_memory=False,
   312	            seed=31,
   313	            seed_stride=3,
   314	            configuration=config,
   315	            threads=2,
   316	            reward_mode=mode,
   317	            reward_shaping=shaping,
   318	        ) as env:
   319	            for turn in range(720 if full_season else 37):
   320	                actions = actions_for(env, buy_land=turn % 4 == 0)
   321	                actions.tokens[:, 0, 0, 1] = 10  # asymmetric ineffective HARVEST
   322	                before_banks = arrays.banks.copy()
   323	                before_econ = econ.copy()
   324	                legacy.myolie_step_frames(
   325	                    actions.tokens.numpy().astype(np.int16),
   326	                    actions.lengths.numpy().astype(np.int32),
   327	                    arrays,
   328	                )
   329	                legacy.econ(econ)
   330	                expected_reward = economic_rewards(
   331	                    torch.from_numpy(before_econ), torch.from_numpy(econ), shaping
   332	                ).float()
   333	                expected_done = arrays.done.astype(bool).copy()
   334	                terminal = legacy.snapshots() if expected_done.any() else None
   335	                for i in np.flatnonzero(expected_done):
   336	                    expected_reward[i].add_(
   337	                        terminal_rewards(
   338	                            torch.from_numpy(arrays.banks[i]), mode, shaping
   339	                        )
   340	                        * shaping.terminal_scale
   341	                    )
   342	                after_banks, after_econ = arrays.banks.copy(), econ.copy()
   343	                if expected_done.any():
   344	                    indices = np.flatnonzero(expected_done).astype(np.uint32)
   345	                    legacy.myolie_reset_indices(
   346	                        indices, headers(len(indices)), observation_version=2
   347	                    )
   348	                    legacy.myolie_observe(arrays)
   349	                    legacy.econ(econ)
   350	                obs, reward, done, _ = env.step(actions)
   351	                np.testing.assert_array_equal(obs.features.numpy(), arrays.features)
   352	                np.testing.assert_array_equal(obs.context.numpy(), arrays.context)
   353	                np.testing.assert_array_equal(env.previous_banks.numpy(), before_banks)
   354	                np.testing.assert_array_equal(env.current_banks.numpy(), after_banks)
   355	                np.testing.assert_array_equal(env.previous_econ.numpy(), before_econ)
   356	                np.testing.assert_array_equal(env.current_econ.numpy(), after_econ)
   357	                torch.testing.assert_close(reward, expected_reward, rtol=0, atol=0)
   358	                assert done[:, 0].tolist() == expected_done.tolist()
   359	                if terminal is not None:
   360	                    for i in np.flatnonzero(expected_done):
   361	                        assert env.terminal_snapshot(int(i)) == terminal[i]
   362	                        assert env.state_snapshot(int(i)) == legacy.snapshots()[i]
   363	    finally:
   364	        legacy.close()
