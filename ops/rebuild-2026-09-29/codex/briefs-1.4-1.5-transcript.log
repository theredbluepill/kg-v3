  1463	        }
  1464	        let market_metrics = self.process_market(actions)?;
  1465	        self.town_consume(previous_step)?;
  1466	        for (player, farm) in self.farms.iter_mut().enumerate() {
  1467	            let (deaths, units_lost) = decay_plants(farm, previous_step);
  1468	            *unit_metrics.by_seat[player]
  1469	                .upstream
  1470	                .get_mut("upstream_crop_expiry_deaths")
  1471	                .unwrap() += deaths;
  1472	            if let Some(counters) = econ_mut!(self, player) {
  1473	                counters[ECON_EXPIRY_UNITS] += units_lost;
  1474	            }
  1475	        }
  1476	        if self.config.turns_per_day.divides_usize(previous_step + 1) {
  1477	            self.end_of_day(day as usize, &mut unit_metrics)?;
  1478	        }
  1479	
  1480	        self.step = previous_step + 1;
  1481	        let (observation_day, _) = self.config.turns_per_day.div_rem_usize(self.step);
  1482	        for (player, farm) in self.farms.iter().enumerate() {
  1483	            record_upstream_stock(&mut unit_metrics.by_seat[player], farm, observation_day);
  1484	            let seat_metrics = unit_metrics.by_seat[player].clone();
  1485	            unit_metrics.accumulate_seat(&seat_metrics);
  1486	        }
  1487	        if BigInt::from(previous_step) >= &self.config.episode_steps.0 - BigInt::from(2) {
  1488	            self.done = true;
  1489	            self.rewards = Some(self.farms.iter().map(|farm| farm.money).collect());
  1490	            for player in 0..self.farms.len() {
  1491	                // econ v4: goods left unsold have no terminal value (reward = money only)
  1492	                let unsold = held_goods(&self.privates[player]) + held_tile_yield(&self.farms[player]);
  1493	                if let Some(counters) = econ_mut!(self, player) {
  1494	                    counters[ECON_UNSOLD_END] = unsold;
  1495	                    counters[ECON_SEEDS_UNUSED_END] = self.privates[player].seeds.values()
  1496	                        .map(|&n| n.max(0) as u64).sum();
  1497	                    counters[ECON_TERMINAL_FLAGS] = self.farms[player].tiles.iter().flatten()
  1498	                        .filter_map(Value::as_object).filter(|t| t.contains_key("animal"))
  1499	                        .map(|t| map_bool(t, "fertilizer_available") as u64
  1500	                            + map_i64(t, "pending_care_bonus").max(0) as u64
  1501	                            + map_bool(t, "fed_today") as u64).sum();
  1502	                    counters[ECON_UNUSED_LAND_CASH] = LAND_ORDER.iter().enumerate()
  1503	                        .filter(|(i, q)| !self.econ_land_used[player][*i]
  1504	                            && self.farms[player].unlocked_quadrants.iter().any(|v| v == **q))
  1505	                        .map(|(i, _)| LAND_PRICES[i] as u64).sum();
  1506	                }
  1507	            }
  1508	        }
  1509	        Ok(StepMetrics {
  1510	            market: market_metrics,
  1511	            unit: unit_metrics,
  1512	        })
  1513	    }
