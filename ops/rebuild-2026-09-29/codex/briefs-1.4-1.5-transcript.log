  1640	    // Capture only relevant tile commands; gameplay never reads this copy or these counters.
  1641	    fn econ_unit_before(&self, player: usize, unit: usize, action: &Value) -> Option<(usize, usize, Value)> {
  1642	        #[cfg(test)]
  1643	        if self.econ_counting_disabled { return None; }
  1644	        let op = action.as_array()?.first()?.as_str()?;
  1645	        if !matches!(op, "WATER" | "HARVEST" | "FERTILIZE" | "DIG" | "PLANT" | "PLACE") { return None; }
  1646	        let (x, y) = farmer_position(&self.farms[player], unit)?;
  1647	        if x < 0 || y < 0 { return None; }
  1648	        self.farms[player].tiles.get(y as usize)?.get(x as usize)
  1649	            .map(|tile| (x as usize, y as usize, tile.clone()))
  1650	    }
  1651	
  1652	    fn count_econ_tile(&mut self, player: usize, action: &Value, day: i64,
  1653	        before: Option<(usize, usize, Value)>, effect: UnitActionEffect) {
  1654	        if effect == UnitActionEffect::None { return; }
  1655	        let Some((x, y, value)) = before else { return; };
  1656	        let op = action.as_array().and_then(|a| a.first()).and_then(Value::as_str);
  1657	        let after = &self.farms[player].tiles[y][x];
  1658	        if matches!(op, Some("PLANT" | "PLACE")) && after.as_object().is_some_and(|t|
  1659	            map_str(t, "kind") == Some("PLANT") || t.contains_key("animal")) {
  1660	            if let Some(i) = LAND_ORDER.iter().position(|q| *q == quadrant_of(x, y, self.config.board_size)) {
  1661	                if let Some(used) = self.econ_land_used.get_mut(player) { used[i] = true; }
  1662	            }
  1663	        }
  1664	        let Some(t) = value.as_object().filter(|t| map_str(t, "kind") == Some("PLANT")) else { return; };
  1665	        let Some(data) = map_str(t, "crop").and_then(crop) else { return; };
  1666	        let Some(c) = econ_mut!(self, player) else { return; };
  1667	        let held = map_i64(t, "yield_units");
  1668	        let age = day - map_i64(t, "planted_day");
  1669	        let in_window = (data.max_yield_day + 1) / 2 <= age && age <= data.max_yield_day;
  1670	        match op {
  1671	            Some("WATER") if !data.ongoing && in_window => {
  1672	                let increment = if map_i64(t, "fertilized_until_day") >= day { 2 } else { 1 };
  1673	                c[ECON_CLIPPED_UNITS] += (held + increment - data.max_yield).max(0) as u64;
  1674	            }
  1675	            Some("HARVEST") if !data.ongoing && in_window =>
  1676	                c[ECON_MISSED_GROWTH_UNITS] += (data.max_yield - held).max(0) as u64,
  1677	            Some("DIG") => c[ECON_DUG_UNITS] += held.max(0) as u64 + 1,
  1678	            Some("FERTILIZE") if map_i64(t, "fertilized_until_day") >= day + 2 =>
  1679	                c[ECON_REDUNDANT_FERT] += 1,
  1680	            _ => {}
  1681	        }
  1682	    }
