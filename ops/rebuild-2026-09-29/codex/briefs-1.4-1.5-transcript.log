   577	fn prefix_mask<const N: usize>(plan: &GrammarPlan, prefix: &[i64]) -> Result<[bool; N], String> {
   578	    let mut state = plan.start();
   579	    for &token in prefix {
   580	        state = state
   581	            .advance(token, plan)?
   582	            .ok_or("grammar table prefix ended at STOP")?;
   583	    }
   584	    let mut out = [false; N];
   585	    state.write_mask(plan, &mut out)?;
   586	    Ok(out)
   587	}
