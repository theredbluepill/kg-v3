   735	    fn state_snapshot<'py>(&self, py: Python<'py>, env_index: usize) -> PyResult<Py<PyAny>> {
   736	        let snapshot = self.current_snapshot(env_index)?;
   737	        snapshot_to_py(py, &snapshot)
