   143	class _SamplerPlan:
   144	    """Immutable native masks and token transitions; no Python grammar rules."""
   145	
   146	    def __init__(self, payload: bytes) -> None:
   147	        if len(payload) < 20:
   148	            raise RuntimeError("truncated native sampler plan")
   149	        magic, version, count, start, edges = map(
   150	            int, np.frombuffer(payload, "<u4", count=5)
   151	        )
   152	        if (
   153	            magic != 0x4D534731
   154	            or version != 1
   155	            or not 0 < count <= 100_000
   156	            or start >= count
   157	        ):
   158	            raise RuntimeError("unsupported native sampler plan")
   159	        if edges > 2_000_000 or len(payload) != 20 + 16 * count + 5 * edges:
   160	            raise RuntimeError("invalid native sampler plan size")
   161	        metadata = np.frombuffer(payload, "<u4", count=4 * count, offset=20).reshape(
   162	            count, 4
   163	        )
   164	        masks = np.frombuffer(payload, np.uint8, count=edges, offset=20 + 16 * count)
   165	        transitions = np.frombuffer(
   166	            payload, "<i4", count=edges, offset=20 + 16 * count + edges
   167	        )
   168	        widths = (241, 20, 128, 16, 2, 32, 32, 8, 16, 32, 32, 2)
   169	        nodes: list[
   170	            tuple[tuple[bool, ...], tuple[int, ...], NDArray[Any], int, int]
   171	        ] = []
   172	        expected_offset = 0
   173	        size = sys.getsizeof(payload) + sys.getsizeof(nodes)
   174	        for slot, hires, offset, width in metadata:
   175	            slot, hires, offset, width = map(int, (slot, hires, offset, width))
   176	            if (
   177	                slot >= 12
   178	                or hires > 10
   179	                or width != widths[slot]
   180	                or offset != expected_offset
   181	                or offset + width > edges
   182	            ):
   183	                raise RuntimeError("invalid native sampler node")
   184	            bits = masks[offset : offset + width]
   185	            next_nodes = transitions[offset : offset + width]
   186	            if np.any(bits > 1) or not np.any(bits):
   187	                raise RuntimeError("invalid native sampler mask")
   188	            if np.any(next_nodes[bits == 0] != -2) or np.any(
   189	                (next_nodes[bits != 0] < -1) | (next_nodes[bits != 0] >= count)
   190	            ):
   191	                raise RuntimeError("invalid native sampler transition")
   192	            terminals = np.flatnonzero(next_nodes == -1)
   193	            if len(terminals) and (slot != 11 or terminals.tolist() != [1]):
   194	                raise RuntimeError("invalid native sampler terminal")
   195	            successors = next_nodes[next_nodes >= 0]
   196	            if np.any(metadata[successors, 0] != (slot + 1) % 12):
   197	                raise RuntimeError("invalid native sampler successor slot")
   198	            mask = tuple(bits.astype(bool).tolist())
   199	            allowed = tuple(np.flatnonzero(bits).tolist())
   200	            node = (mask, allowed, next_nodes, hires, slot)
   201	            nodes.append(node)
   202	            size += (
   203	                sys.getsizeof(node)
   204	                + sys.getsizeof(mask)
   205	                + sys.getsizeof(allowed)
   206	                + sys.getsizeof(next_nodes)
   207	                + 2 * sys.getsizeof(hires)
   208	            )
   209	            expected_offset += width
   210	        if expected_offset != edges:
   211	            raise RuntimeError("native sampler has unused edges")
   212	        self.nodes = tuple(nodes)
   213	        self.start = start
   214	        self.cache_bytes = size + sys.getsizeof(self.nodes)
   215	        self.payload = payload  # Keeps all read-only NumPy transition views alive.
