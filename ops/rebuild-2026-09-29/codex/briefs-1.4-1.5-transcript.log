def test_explicit_replay_state_uses_current_native_features() -> None:
    import json

    import numpy as np
    from owl.kaggriculture.env import native_seed_header
    from owl.kaggriculture.native_bridge import MyolieBuffers
    from owl.rs import KaggricultureBatch

    with KaggricultureVectorizedEnv(n_envs=1, pin_memory=False) as env:
        env.step(actions_for(env, buy_land=True))
        env.step(actions_for(env))
        state = env.state_snapshot(0)
        header = native_seed_header(0, {})
        header["initial"] = {"public": state["public"], "privates": state["privates"]}
        batch = KaggricultureBatch(json.dumps([header]), explicit_state=True)
        buffers = MyolieBuffers(1, observation_version=2)
        try:
            batch.observe(
                buffers.features, buffers.context, buffers.banks, buffers.done, 2
            )
            np.testing.assert_array_equal(
                buffers.features, env.observations.features.numpy()
            )
            np.testing.assert_array_equal(
                buffers.context, env.observations.context.numpy()
            )
            np.testing.assert_array_equal(buffers.banks, env.current_banks.numpy())
        finally:
            batch.close()
