   494	        self,
   495	        x: torch.Tensor,
   650	                    plan[:, None, :].expand(-1, actors, -1),
   651	                ),
   652	                dim=-1,
   653	            )
   654	        )
   655	        # No market entity exists: the plan hidden stands in for it.
   656	        market_input = self.actor_input_proj(torch.cat((plan, player, plan), dim=-1))
   657	        core = self._compiled_actor_core or self.actor.policy_core
   658	        return core(
   659	            unit_input,
   660	            market_input,
   661	            context.actor_counts[rows],
   662	            context.order_limits[rows],
   663	            context.live[rows],
   664	            self.action_spec.hire_limit,
   665	            None if tokens is None else tokens[rows],
   666	            None if lengths is None else lengths[rows],
   667	            deterministic,
   668	        )
