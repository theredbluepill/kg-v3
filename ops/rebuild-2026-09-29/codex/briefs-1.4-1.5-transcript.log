   218	class MyolieSampler:
   219	    """Rust-compiled grammar tables and Rust action decoding for canonical sampling.
   220	
   221	    Plans cross the ABI only on a cache miss, finished frames once per action.
   222	    The LRU is bounded by both entry count and an upper estimate of retained
   223	    payload/container bytes; evicted cursors retain their own immutable plan.
   224	    """
   225	
   226	    def __init__(
   227	        self, *, cache_entries: int = 16, cache_bytes: int = 32 * 1024 * 1024
   228	    ) -> None:
   229	        if cache_entries < 1 or cache_bytes < 1:
   230	            raise ValueError("native sampler cache bounds must be positive")
   231	        self._cache: OrderedDict[tuple[int, int, int], _SamplerPlan] = OrderedDict()
   232	        self._lock = threading.RLock()
   233	        self.cache_entries, self.cache_limit = cache_entries, cache_bytes
   234	        self.cache_bytes = self.plan_calls = self.decode_calls = 0
   235	
   236	    @staticmethod
   237	    def _shape(actors: int, limit: int, hire_limit: int) -> tuple[int, int, int]:
   238	        values = (actors, limit, hire_limit)
   239	        if any(type(v) is not int for v in values) or not (
   240	            1 <= actors <= 241 and 1 <= limit <= 10 and 1 <= hire_limit <= 241
   241	        ):
   242	            raise ValueError(
   243	                "native sampler requires actors 1..241, orders 1..10, HIRE limit 1..241"
   244	            )
   245	        return values
   246	
   247	    def plan(self, actors: int, limit: int, hire_limit: int) -> _SamplerPlan:
   248	        key = self._shape(actors, limit, hire_limit)
   249	        with self._lock:
   250	            if key in self._cache:
   251	                self._cache.move_to_end(key)
   252	                return self._cache[key]
   253	            plan = _SamplerPlan(kaggriculture_grammar_plan(*key))
   254	            self.plan_calls += 1
   255	            if plan.cache_bytes <= self.cache_limit:
   256	                while self._cache and (
   257	                    len(self._cache) >= self.cache_entries
   258	                    or self.cache_bytes + plan.cache_bytes > self.cache_limit
   259	                ):
   260	                    _, old = self._cache.popitem(last=False)
   261	                    self.cache_bytes -= old.cache_bytes
   262	                self._cache[key] = plan
   263	                self.cache_bytes += plan.cache_bytes
   264	            return plan
   265	
   266	    def decode(
   267	        self, actors: int, limit: int, hire_limit: int, frames: NDArray[Any]
   268	    ) -> dict[str, Any]:
   269	        key = self._shape(actors, limit, hire_limit)
   270	        if (
   271	            not isinstance(frames, np.ndarray)
   272	            or frames.ndim != 2
   273	            or frames.shape[1] != 12
   274	        ):
   275	            raise ValueError("native sampler frames must have shape [frames, 12]")
   276	        _checked_array(frames, np.int16, frames.shape, "frames")
   277	        if not 1 <= len(frames) <= 252:
   278	            raise ValueError("native sampler requires 1..252 frames")
   279	        with self._lock:
   280	            result = json.loads(kaggriculture_decode(*key, frames))
   281	            self.decode_calls += 1
   282	            return result
