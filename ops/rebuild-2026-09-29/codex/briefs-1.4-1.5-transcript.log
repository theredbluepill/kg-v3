  1458	            let seat_metrics = self.apply_player_actions(player, action, day)?;
  1459	            if let Some(counters) = econ_mut!(self, player) {
  1460	                counters[ECON_INEFFECTIVE] += seat_metrics.ineffective_unit_commands();
  1461	            }
