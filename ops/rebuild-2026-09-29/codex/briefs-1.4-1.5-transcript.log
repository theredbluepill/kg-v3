    16	def actions_for(
    17	    env: KaggricultureVectorizedEnv, *, buy_land: bool = False
    18	) -> KaggricultureActions:
    19	    tokens = torch.zeros((env.n_envs, 2, 252, 12), dtype=torch.int64)
    20	    lengths = torch.zeros((env.n_envs, 2), dtype=torch.int64)
    21	    for game in range(env.n_envs):
    22	        for seat in range(2):
    23	            count = int(env.observations.context[game, 1 + seat])
    24	            action = {
    25	                "farmer": ["PASS"],
    26	                "hands": [["PASS"] for _ in range(count - 1)],
    27	                "market": [["BUY_LAND"]] if buy_land and seat == 0 else [],
    28	            }
    29	            encoded = encode_action(action, hire_limit=241)
    30	            frames = torch.tensor(
    31	                [[frame[s] for s in SLOT_NAMES] for frame in encoded["frames"]]
    32	            )
    33	            tokens[game, seat, : len(frames)] = frames
    34	            lengths[game, seat] = len(frames)
    35	    return KaggricultureActions(tokens, lengths)
