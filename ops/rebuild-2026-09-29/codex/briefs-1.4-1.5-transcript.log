    33	@dataclass(frozen=True)
    34	class DistributedContext:
    35	    device: torch.device
    36	    rank: int
    37	    local_rank: int
    38	    world_size: int
    39	    initialized: bool
    40	
    41	    @classmethod
    42	    def from_runtime(cls) -> Self:
    43	        initialized = dist.is_available() and dist.is_initialized()
    44	        local_rank = int(os.environ.get("LOCAL_RANK", "0"))
    45	        if torch.cuda.is_available():
    46	            device = torch.device("cuda", local_rank)
    47	        elif local_rank != 0:
    48	            raise RuntimeError(
    49	                "CUDA is not available - can't create distributed context"
    50	            )
    51	        else:
    52	            device = torch.device("cpu")
    53	
    54	        if initialized:
    55	            return cls(
    56	                device=device,
    57	                rank=dist.get_rank(),
    58	                local_rank=local_rank,
    59	                world_size=dist.get_world_size(),
    60	                initialized=True,
    61	            )
    62	
    63	        return cls(
    64	            device=device,
    65	            rank=0,
    66	            local_rank=local_rank,
    67	            world_size=1,
    68	            initialized=False,
    69	        )
    70	
    71	    @classmethod
    72	    def single_process_cpu(cls) -> Self:
    73	        return cls(
    74	            device=torch.device("cpu"),
    75	            rank=0,
    76	            local_rank=0,
    77	            world_size=1,
    78	            initialized=False,
    79	        )
    80	
    81	    @property
    82	    def is_main_process(self) -> bool:
    83	        return self.rank == 0
    84	
    85	    def barrier(self) -> None:
    86	        if self.initialized:
    87	            dist.barrier()
    88	
    89	
    90	@contextmanager
    91	def distributed_session() -> Iterator[DistributedContext]:
    92	    local_rank = int(os.environ.get("LOCAL_RANK", "0"))
    93	    if torch.cuda.is_available():
    94	        torch.cuda.set_device(torch.device(f"cuda:{local_rank}"))
    95	
    96	    manage_process_group = int(os.environ.get("WORLD_SIZE", "1")) > 1
    97	    if manage_process_group:
    98	        if not torch.cuda.is_available():
    99	            raise RuntimeError(
   100	                "distributed session requires CUDA, but CUDA is not available"
   101	            )
   102	
   103	        if not dist.is_available():
   104	            raise RuntimeError("torch.distributed is not available")
   105	
   106	        if dist.is_initialized():
   107	            raise RuntimeError("torch.distributed is already initialized")
   108	
   109	        dist.init_process_group(
   110	            backend="nccl", device_id=torch.device(f"cuda:{local_rank}")
   111	        )
   112	
   113	    try:
   114	        yield DistributedContext.from_runtime()
   115	    except BaseException:
   116	        # Report before cleanup: destroy_process_group can wait on dead peers.
   117	        rank = os.environ.get("RANK", "0")
   118	        print(f"[rank{rank}] training failed:", file=sys.stderr, flush=True)
   119	        traceback.print_exc(file=sys.stderr)
   120	        sys.stderr.flush()
   121	        raise
   122	    finally:
   123	        if manage_process_group:
   124	            dist.destroy_process_group()
