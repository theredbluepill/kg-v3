   460	    pub fn reset(&mut self, selected: &[bool], clear_transition: bool) -> Result<(), String> {
   461	        self.staging.clone_from(&self.output);
   462	        std::mem::swap(&mut self.output, &mut self.staging);
   463	        let result = catch_unwind(AssertUnwindSafe(|| {
   464	            self.reset_staged(selected, clear_transition)
   465	        }))
   466	        .unwrap_or_else(|_| Err("native training reset panicked before commit".into()));
   467	        if result.is_err() {
   468	            std::mem::swap(&mut self.output, &mut self.staging);
   469	        }
   470	        result
   471	    }
   472	    fn reset_staged(&mut self, selected: &[bool], clear_transition: bool) -> Result<(), String> {
   473	        if selected.len() != self.games.len() {
   474	            return Err("reset mask shape differs".into());
   475	        }
   476	        let mut replacements = Vec::new();
   477	        let mut next_seed = self.next_seed.clone();
   478	        for (i, select) in selected.iter().enumerate() {
   479	            if *select {
   480	                let game = Game::new_with_seed(self.config.clone(), next_seed.clone(), 2)?;
   481	                encode(
   482	                    &game,
   483	                    i,
   484	                    self.width,
   485	                    self.version,
   486	                    &mut self.output.features[i * 2 * self.width..(i + 1) * 2 * self.width],
   487	                    &mut self.output.context[i * 4..(i + 1) * 4],
   488	                )?;
   489	                replacements.push((i, game, next_seed.to_string()));
   490	                next_seed += &self.stride;
   491	            }
   492	        }
   493	        for (i, game, seed) in replacements {
   494	            self.games[i] = game;
   495	            self.seeds[i] = seed;
   496	            self.terminal[i] = None;
   497	            self.terminal_metrics[i] = None;
   498	        }
   499	        self.next_seed = next_seed;
   500	        if clear_transition {
   501	            self.baselines();
   502	        }
   503	        self.output.masks();
   504	        Ok(())
   505	    }
   506	    pub fn snapshot(&self, index: usize, terminal: bool) -> Result<Option<StepSnapshot>, String> {
   507	        let game = self
   508	            .games
   509	            .get(index)
   510	            .ok_or("environment index out of range")?;
   511	        Ok(if terminal {
   512	            self.terminal[index].clone()
   513	        } else {
   514	            Some(game.snapshot())
   515	        })
   516	    }
   517	    pub fn terminal_metrics(&self, index: usize) -> Result<Option<HashMap<String, f64>>, String> {
   518	        self.terminal_metrics
   519	            .get(index)
   520	            .ok_or_else(|| "environment index out of range".into())
   521	            .map(|entry| {
   522	                entry.map(|[a, b, step]| {
   523	                    HashMap::from([
   524	                        ("bank_0".into(), a),
   525	                        ("bank_1".into(), b),
   526	                        ("margin_0".into(), a - b),
   527	                        ("episode_steps".into(), step),
   528	                    ])
   529	                })
   530	            })
   531	    }
   532	    pub fn seeds(&self) -> (String, Vec<String>) {
   533	        (self.next_seed.to_string(), self.seeds.clone())
   534	    }
   535	}
   536	fn encode(
   537	    game: &Game,
   538	    index: usize,
   539	    width: usize,
   540	    version: u32,
   541	    features: &mut [f32],
   542	    context: &mut [i64],
   543	) -> Result<(), String> {
   544	    ffi::encode_myolie_game(
   545	        game,
   546	        index,
   547	        width,
   548	        version,
