  1450	        // The Kaggle framework interprets a copied action state and commits it only
  1451	        // when the interpreter returns successfully. Mirror that transaction so a
  1452	        // deferred config/custom-market/malformed-count error cannot leak mutations.
  1453	        let mut candidate = self.clone();
  1454	        let metrics = candidate.step_in_place(actions)?;
  1455	        *self = candidate;
  1456	        Ok(metrics)
  1457	    }
