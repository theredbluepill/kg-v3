   227	fn total(counts: &Counts) -> Result<f64, String> {
   228	    // Python 3.11 sums floats sequentially; 3.12+ compensates rounding. Bound
   229	    // the absolute aggregate so every integer and every partial sum is exactly
   230	    // representable in f64 on both versions, including canceling signed inputs.
   231	    // Explicit exotic states outside this scope fail instead of drifting.
   232	    let mut remaining = 1_u64 << 53;
   233	    let mut sum = 0.0;
   234	    for &value in counts.values() {
   235	        remaining = remaining.checked_sub(value.unsigned_abs()).ok_or_else(|| {
   236	            "Myolie private count absolute aggregate exceeds exact f64 bound 2^53".to_string()
   237	        })?;
   238	        sum += value as f64;
   239	    }
   240	    Ok(sum)
   241	}
