   161	/// The official engine deliberately treats nested `marketParams` entries as
   162	/// permissive dictionaries. Keeping their JSON values avoids narrowing float-valued
   163	/// overrides, dropping unknown metadata keys, or rejecting non-dict patches that
   164	/// Python simply ignores.
   165	pub type MarketParam = IndexMap<String, Value>;
   166	pub type MarketParams = IndexMap<String, MarketParam>;
   167	
   168	fn market_param(
   169	    base: i64,
   170	    t: i64,
   171	    below_func: &str,
   172	    below_target: f64,
   173	    above_func: &str,
   174	    above_target: f64,
   175	) -> MarketParam {
   176	    IndexMap::from([
   177	        ("base".to_string(), Value::from(base)),
   178	        ("I0".to_string(), Value::from(10_000)),
   179	        ("T".to_string(), Value::from(t)),
   180	        ("below_func".to_string(), Value::from(below_func)),
   181	        ("below_target".to_string(), Value::from(below_target)),
   182	        ("above_func".to_string(), Value::from(above_func)),
   183	        ("above_target".to_string(), Value::from(above_target)),
   184	    ])
   185	}
   186	
   187	fn default_market_params() -> MarketParams {
   188	    let rows = [
   189	        ("WHEAT", 25, 400, "sqrt", 0.80, "log", 0.20),
   190	        ("CARROT", 35, 450, "hinge", 1.00, "sqrt", 0.70),
   191	        ("TOMATO", 60, 200, "hinge", 0.40, "sqrt", 0.60),
   192	        ("STRAWBERRY", 120, 100, "sqrt", 0.70, "linear", 1.60),
   193	        ("MELON", 250, 300, "log", 0.20, "sq", 3.60),
   194	        ("EGG", 50, 332, "hinge", 0.40, "log", 0.20),
   195	        ("MILK", 160, 122, "sqrt", 0.60, "linear", 1.60),
   196	        ("WOOL", 200, 105, "log", 0.20, "sq", 3.20),
   197	        ("FERTILIZER", 100, 200, "linear", 0.40, "linear", 0.40),
   198	    ];
   199	    rows.into_iter()
   200	        .map(
   201	            |(name, base, t, below_func, below_target, above_func, above_target)| {
   202	                (
   203	                    name.to_string(),
   204	                    market_param(base, t, below_func, below_target, above_func, above_target),
   205	                )
   206	            },
   207	        )
   208	        .collect()
   209	}
   210	
   211	fn resolve_market_params(patches: &IndexMap<String, Value>) -> MarketParams {
   212	    let mut params = default_market_params();
   213	    for (item, patch) in patches {
   214	        let Some(p) = params.get_mut(item) else {
   215	            continue;
   216	        };
   217	        let Some(patch) = patch.as_object() else {
   218	            // `_resolve_market_params` ignores non-dict entries.
   219	            continue;
   220	        };
   221	        for (key, value) in patch {
   222	            p.insert(key.clone(), value.clone());
   223	        }
   224	    }
   225	    params
   226	}
