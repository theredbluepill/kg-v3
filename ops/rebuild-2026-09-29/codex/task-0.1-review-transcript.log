    94	fn number(value: &Value, field: &str) -> Result<f64, String> {
    95	    // Ordinary engine numbers need no arbitrary-width integer/string adapter.
    96	    // Keep that shared Python conversion as a fallback for explicit fixtures.
    97	    if let Some(value) = value.as_i64() {
    98	        return Ok(value as f64);
    99	    }
   100	    if let Some(value) = value.as_u64() {
   101	        return Ok(value as f64);
   102	    }
   103	    if let Some(value) = value.as_f64() {
   104	        return Ok(value);
   105	    }
   106	    if let Some(value) = value.as_bool() {
   107	        return Ok(f64::from(value));
   108	    }
   109	    crate::python_float(value, field)
   110	}
