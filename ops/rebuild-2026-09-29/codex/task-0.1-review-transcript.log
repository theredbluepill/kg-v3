   117	fn truthy(value: Option<&Value>) -> bool {
   118	    match value {
   119	        None | Some(Value::Null) => false,
   120	        Some(Value::Bool(value)) => *value,
   121	        Some(Value::Number(value)) => value.as_f64() != Some(0.0),
   122	        Some(Value::String(value)) => !value.is_empty(),
   123	        Some(Value::Array(value)) => !value.is_empty(),
   124	        Some(Value::Object(value)) => !value.is_empty(),
   125	    }
   126	}
