   116	pub struct TrainingOutput {
   117	    pub features: Vec<f32>,
   118	    pub context: Vec<i64>,
   119	    pub entity_mask: Vec<bool>,
   120	    pub still_playing: Vec<bool>,
   121	    pub can_act: Vec<bool>,
   122	    pub rewards: Vec<f32>,
   123	    pub dones: Vec<bool>,
   124	    pub previous_banks: Vec<f64>,
   125	    pub current_banks: Vec<f64>,
   126	    pub previous_econ: Vec<u64>,
   127	    pub current_econ: Vec<u64>,
   128	}
   129	impl TrainingOutput {
   130	    fn new(n: usize, width: usize) -> Self {
   131	        Self {
   132	            features: vec![0.0; n * 2 * width],
   133	            context: vec![0; n * 4],
   134	            entity_mask: vec![false; n * 2 * ACTORS],
   135	            still_playing: vec![true; n * 2],
   136	            can_act: vec![false; n * 2 * FRAMES],
   137	            rewards: vec![0.0; n * 2],
   138	            dones: vec![false; n * 2],
   139	            previous_banks: vec![0.0; n * 2],
   140	            current_banks: vec![0.0; n * 2],
   141	            previous_econ: vec![0; n * 2 * ECON_FIELDS],
   142	            current_econ: vec![0; n * 2 * ECON_FIELDS],
   143	        }
   144	    }
   145	    fn masks(&mut self) {
   146	        for (i, row) in self.context.chunks_exact(4).enumerate() {
   147	            for seat in 0..2 {
   148	                let offset = i * 2 + seat;
   149	                let count = row[1 + seat] as usize;
   150	                for (ordinal, value) in self.entity_mask[offset * ACTORS..(offset + 1) * ACTORS]
   151	                    .iter_mut()
   152	                    .enumerate()
   153	                {
   154	                    *value = ordinal < count;
   155	                }
   156	                for (ordinal, value) in self.can_act[offset * FRAMES..(offset + 1) * FRAMES]
   157	                    .iter_mut()
   158	                    .enumerate()
   159	                {
   160	                    *value = ordinal < count + row[3] as usize + 1;
   161	                }
   162	            }
   163	        }
   164	        self.still_playing.fill(true); // Terminal games are synchronously reset.
   165	    }
   166	}
