   128	fn nonnegative_int(value: Option<&Value>) -> Result<bool, String> {
   129	    let Some(value) = value else { return Ok(false) };
   130	    if let Some(value) = value.as_i64() {
   131	        return Ok(value >= 0);
   132	    }
