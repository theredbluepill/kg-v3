   364	                let start = i * 2 * FRAMES * SLOTS;
   365	                let actions = (0..2)
   366	                    .map(|seat| {
   367	                        ffi::myolie_action(
   368	                            game,
   369	                            seat,
   370	                            &frame_buffer[start + seat * FRAMES * SLOTS
   371	                                ..start + (seat + 1) * FRAMES * SLOTS],
