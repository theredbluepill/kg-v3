  3820	fn do_hire(farm: &mut Farm, private: &mut PrivateState, board_size: usize, mult: &PyInt) -> bool {
  3821	    let cost = &mult.0 * fib(farm.hires_today);
  3822	    let cannot_afford = if farm.money.is_nan() {
  3823	        false
  3824	    } else if farm.money == f64::NEG_INFINITY {
  3825	        true
  3826	    } else if farm.money == f64::INFINITY {
  3827	        false
  3828	    } else {
  3829	        BigInt::from_f64(farm.money.floor()).is_none_or(|money| money < cost)
  3830	    };
  3831	    if cannot_afford {
  3832	        return false;
  3833	    }
  3834	    let Some(cost) = cost.to_f64() else {
  3835	        // A finite float bank cannot afford an integer outside the float domain.
  3836	        return false;
  3837	    };
  3838	    farm.money -= cost;
  3839	    farm.hires_today += 1;
  3840	    farm.hands.push(spawn_hand(farm, board_size));
  3841	    private.inventories.push(IndexMap::new());
  3842	    true
  3843	}
