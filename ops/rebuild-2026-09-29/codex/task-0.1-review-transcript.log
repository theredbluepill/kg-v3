   144	fn legacy_tile(tile: &Value, day: f64) -> Result<[f64; 3], String> {
   145	    if tile.is_null() {
   146	        return Ok([0.05, 0.0, 0.0]);
   147	    }
   148	    let Some(tile) = tile.as_object() else {
   149	        return Ok([0.0; 3]);
   150	    };
   151	    let kind = tile.get("kind").and_then(Value::as_str).unwrap_or("");
   152	    let animal = tile.get("animal").and_then(Value::as_str).unwrap_or("");
   153	    let code = match kind {
   154	        "WEED" => 0.1,
   155	        "PLANT" => {
   156	            let crop = tile.get("crop").and_then(Value::as_str).unwrap_or("");
   157	            CROP_NAMES
   158	                .iter()
   159	                .position(|name| *name == crop)
   160	                .map_or(0.2, |index| 0.2 + 0.025 * index as f64)
   161	        }
   162	        _ => ANIMAL_NAMES.iter().position(|name| *name == animal).map_or(
   163	            match kind {
   164	                "COOP" => 0.45,
   165	                "PASTURE" => 0.5,
   166	                _ => 0.0,
   167	            },
   168	            |index| 0.6 + 0.05 * index as f64,
   169	        ),
   170	    };
   171	    let age = match tile.get("planted_day") {
   172	        None | Some(Value::Null) => f64::from(truthy(tile.get("watered_today"))),
   173	        Some(value) => number(value, "planted_day").map_or(0.0, |planted| {
   174	            let age = min_one((day - planted) / 30.0);
   175	            if age > 0.0 { age } else { 0.0 }
   176	        }),
   177	    };
   178	    let state = if kind == "PLANT" {
   179	        min_one(optional_number(tile, "yield_units", 0.0)? / 8.0)
   180	            + 0.25 * f64::from(truthy(tile.get("watered_today")))
   181	            + 0.125 * f64::from(nonnegative_int(tile.get("fertilized_until_day"))?)
   182	    } else if tile.contains_key("animal") {
   183	        min_one(optional_number(tile, "yield_units", 0.0)? / 8.0)
   184	            + 0.25 * f64::from(truthy(tile.get("fed_today")))
   185	            + 0.125 * f64::from(truthy(tile.get("cared_today")))
   186	            + 0.0625 * f64::from(truthy(tile.get("fertilizer_available")))
   187	    } else {
   188	        0.0
   189	    };
   190	    Ok([code, age, state])
   191	}
