   193	fn maintenance(tile: &Value, out: &mut [f32]) -> Result<(), String> {
   194	    let Some(tile) = tile.as_object() else {
   195	        return Ok(());
   196	    };
   197	    let fields: &[(&str, usize)] = if tile.get("kind").and_then(Value::as_str) == Some("PLANT") {
   198	        out[0] = 1.0;
   199	        &PLANT_FIELDS
   200	    } else if tile.contains_key("animal") {
   201	        out[1] = 1.0;
   202	        &ANIMAL_FIELDS
   203	    } else {
   204	        return Ok(());
   205	    };
   206	    for &(name, index) in fields {
   207	        let value = tile
   208	            .get(name)
   209	            .ok_or_else(|| format!("missing v5 observation field: {name}"))?;
   210	        let value = number(value, name)?;
   211	        if !value.is_finite() {
   212	            return Err(format!("nonfinite v5 observation field: {name}"));
   213	        }
   214	        out[index] = value as f32;
   215	    }
   216	    Ok(())
   217	}
