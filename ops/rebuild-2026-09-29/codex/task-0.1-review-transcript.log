   637	        let base = param
   638	            .get("base")
   639	            .ok_or_else(|| format!("marketParams[{item:?}][\"base\"] is missing"))?;
   640	        inventory.insert(item.to_string(), i0.clone());
   641	        prices.insert(item.to_string(), base.clone());
   642	    }
   643	    Ok(Market {
   644	        inventory,
   645	        prices,
   646	        params: expose_params.then(|| params.clone()),
