    16	#[serde(default)]
    17	pub struct RewardConfig {
    18	    pub mode: String,
    19	    pub share_weight: f64,
    20	    pub econ_shaping: f64,
    21	    pub econ_starvation_weight: f64,
    22	    pub econ_drought_weight: f64,
    23	    pub econ_cap: f64,
    24	    pub econ_ineffective_weight: f64,
    25	    pub econ_ineffective_cap: f64,
    26	}
    27	impl Default for RewardConfig {
    28	    fn default() -> Self {
    29	        Self {
    30	            mode: "win_loss".into(),
    31	            share_weight: 0.1,
    32	            econ_shaping: 0.0,
    33	            econ_starvation_weight: 4.0,
    34	            econ_drought_weight: 1.0,
    35	            econ_cap: 0.25,
    36	            econ_ineffective_weight: 0.0,
    37	            econ_ineffective_cap: 0.1,
    38	        }
    39	    }
    40	}
    41	impl RewardConfig {
    42	    fn validate(&self) -> Result<(), String> {
    43	        if !["win_loss", "win_only", "win_share", "margin"].contains(&self.mode.as_str()) {
    44	            return Err("unsupported reward mode".into());
    45	        }
    46	        let values = [
    47	            self.share_weight,
    48	            self.econ_shaping,
    49	            self.econ_starvation_weight,
    50	            self.econ_drought_weight,
    51	            self.econ_cap,
    52	            self.econ_ineffective_weight,
    53	            self.econ_ineffective_cap,
    54	        ];
    55	        if values.iter().any(|v| !v.is_finite() || *v < 0.0)
    56	            || self.share_weight > 1.0
    57	            || !(0.0..1.0).contains(&self.econ_cap)
    58	            || !(0.0..1.0).contains(&self.econ_ineffective_cap)
    59	            || self.econ_cap == 0.0
    60	            || self.econ_ineffective_cap == 0.0
    61	            || self.terminal_scale() <= 0.0
    62	        {
    63	            return Err("invalid reward coefficient or budget".into());
    64	        }
    65	        if (self.econ_shaping > 0.0 || self.econ_ineffective_weight > 0.0)
    66	            && !["win_loss", "win_share"].contains(&self.mode.as_str())
    67	        {
    68	            return Err("economic shaping requires win_loss or win_share".into());
    69	        }
    70	        Ok(())
    71	    }
    72	    fn terminal_scale(&self) -> f64 {
    73	        1.0 - if self.econ_shaping > 0.0 {
    74	            self.econ_cap
    75	        } else {
    76	            0.0
    77	        } - if self.econ_ineffective_weight > 0.0 {
    78	            self.econ_ineffective_cap
    79	        } else {
    80	            0.0
    81	        }
    82	    }
    83	    fn penalty(&self, counts: &[u64; ECON_FIELDS]) -> f64 {
    84	        (self.econ_shaping
    85	            * (self.econ_starvation_weight * counts[0] as f64
    86	                + self.econ_drought_weight * counts[1] as f64))
    87	            .min(self.econ_cap)
    88	            + (self.econ_ineffective_weight * counts[2] as f64).min(self.econ_ineffective_cap)
    89	    }
    90	    fn terminal(&self, own: f64, other: f64) -> f64 {
    91	        let margin = own - other;
    92	        let sign = if margin > 0.0 {
    93	            1.0
    94	        } else if margin < 0.0 {
    95	            -1.0
    96	        } else {
    97	            0.0
    98	        };
    99	        match self.mode.as_str() {
   100	            "margin" => margin / 3000.0,
   101	            "win_only" => (sign + 1.0) / 2.0,
   102	            "win_share" => {
   103	                let share = if own + other > 0.0 {
   104	                    own / (own + other).max(1e-30)
   105	                } else {
   106	                    0.5
   107	                };
   108	                (1.0 - self.share_weight) * sign + self.share_weight * (2.0 * share - 1.0)
   109	            },
   110	            _ => sign,
   111	        }
   112	    }
   113	}
