   650	fn deserialize_integral_usize<'de, D>(deserializer: D) -> Result<usize, D::Error>
   651	where
   652	    D: serde::Deserializer<'de>,
   653	{
   654	    let value = Value::deserialize(deserializer)?;
   655	    if let Some(value) = value.as_u64() {
   656	        return usize::try_from(value).map_err(serde::de::Error::custom);
   657	    }
   658	    if let Some(value) = value.as_i64() {
   659	        return usize::try_from(value).map_err(serde::de::Error::custom);
   660	    }
   661	    if let Some(value) = value.as_f64()
   662	        && value.is_finite()
   663	        && value.fract() == 0.0
   664	        && value >= 0.0
   665	        && value <= usize::MAX as f64
   666	    {
   667	        return Ok(value as usize);
   668	    }
   669	    Err(serde::de::Error::custom(format!(
   670	        "expected a non-negative integral number, got {value}"
   671	    )))
   672	}
