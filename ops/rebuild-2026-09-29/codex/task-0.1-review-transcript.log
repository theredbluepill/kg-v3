  1438	    pub fn step_with_market_metrics(&mut self, actions: &[Value]) -> Result<StepMetrics, String> {
  1439	        if self.done {
  1440	            return Err("cannot step a completed game".to_string());
  1441	        }
  1442	        if actions.len() != self.farms.len() {
  1443	            return Err(format!(
  1444	                "got {} actions for {} farms",
  1445	                actions.len(),
  1446	                self.farms.len()
  1447	            ));
  1448	        }
