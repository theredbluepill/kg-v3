  3845	fn do_buy_land(farm: &mut Farm, board_size: usize) -> bool {
  3846	    let unlocked_extra = farm.unlocked_quadrants.len().saturating_sub(1);
  3847	    if unlocked_extra >= LAND_ORDER.len() {
  3848	        return false;
  3849	    }
  3850	    let cost = LAND_PRICES[unlocked_extra];
  3851	    if farm.money < cost as f64 {
  3852	        return false;
  3853	    }
  3854	    farm.money -= cost as f64;
  3855	    let quadrant = LAND_ORDER[unlocked_extra];
  3856	    farm.unlocked_quadrants.push(quadrant.to_string());
  3857	    for y in 0..board_size {
  3858	        for x in 0..board_size {
  3859	            if quadrant_of(x, y, board_size) == quadrant
  3860	                && farm.tiles[y][x].as_str() == Some("LOCKED")
  3861	            {
  3862	                farm.tiles[y][x] = Value::Null;
  3863	            }
  3864	        }
  3865	    }
  3866	    true
  3867	}
