   378	                    game,
   379	                    i,
   380	                    width,
   381	                    version,
   382	                    &mut self.output.features[i * 2 * width..(i + 1) * 2 * width],
   383	                    &mut self.output.context[i * 4..(i + 1) * 4],
   384	                )?;
   385	            }
   386	        }
   387	        let mut next_seed = self.next_seed.clone();
   388	        let mut seeds = self.seeds.clone();
   389	        let mut terminal = vec![None; n];
   390	        let mut terminal_metrics = vec![None; n];
   391	        let mut metrics = HashMap::new();
   392	        for (i, candidate) in candidates.iter_mut().enumerate() {
   393	            let before = &self.games[i];
