import ctypes,ctypes.util,datetime,json,os,signal,subprocess,time
lib=ctypes.CDLL(ctypes.util.find_library('proc'))
def rss_tree(pid):
    children=(ctypes.c_int*4096)()
    count=lib.proc_listchildpids(pid,children,ctypes.sizeof(children))
    info=(ctypes.c_uint64*12)()
    size=lib.proc_pidinfo(pid,4,0,info,ctypes.sizeof(info))
    own=info[1]//1024 if size==96 else 0
    return own+sum(rss_tree(p) for p in children if p>0)
from pathlib import Path
command=\"uv run --offline python scripts/check_doc_freshness.py\"
out=Path(\"ops/rebuild-2026-09-29/7.5\")/\"docs-fresh-final\"
head=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip()
start=time.monotonic()
peak=0
stop=None
with out.with_suffix(\".log\").open(\"w\") as f:
    f.write(\"Command: \"+command+\"\\nHEAD: \"+head+\"\\nDate: \"+datetime.datetime.now(datetime.timezone.utc).isoformat()+\"\\n\")
    f.flush()
    proc=subprocess.Popen(command,shell=True,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)
    while proc.poll() is None:
        rss=rss_tree(proc.pid)
        peak=max(peak,rss)
        if rss>960*1024: stop=\"960 MiB aggregate RSS limit\"
        if time.monotonic()-start>120: stop=\"120 second wall limit\"
        if stop:
            f.write(\"\\nWATCHDOG_STOP \"+json.dumps({\"reason\":stop,\"elapsed_s\":time.monotonic()-start,\"sampled_peak_process_tree_rss_kib\":peak})+\"\\n\")
            f.flush()
            os.killpg(proc.pid,signal.SIGTERM)
            time.sleep(1)
            if proc.poll() is None:
                try: os.killpg(proc.pid,signal.SIGKILL)
                except (ProcessLookupError,PermissionError): proc.kill()
            break
        time.sleep(.25)
    status=proc.wait()
    result={\"command\":command,\"head\":head,\"date_utc\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"exit_status\":status,\"elapsed_s\":round(time.monotonic()-start,3),\"sampled_peak_process_tree_rss_kib\":peak,\"stop_reason\":stop,\"limits\":{\"wall_s\":120,\"aggregate_rss_mib\":960},\"log\":str(out.with_suffix(\".log\"))}
    f.write(\"\\nBOUND_RESULT \"+json.dumps(result)+\"\\n\")
out.with_suffix(\".json\").write_text(json.dumps(result,indent=2)+\"\\n\")
print(json.dumps(result))
print(\"\\n\".join(out.with_suffix(\".log\").read_text().splitlines()[-9:]))

