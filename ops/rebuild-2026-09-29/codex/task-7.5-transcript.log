import datetime,json,os,signal,subprocess,time
from pathlib import Path
command=\"cargo test --locked --offline --manifest-path engine_rs/Cargo.toml\"
out=Path(\"ops/rebuild-2026-09-29/7.5\")/\"engine-tests\"
head=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip()
start=time.monotonic()
peak=0
stop=None
with out.with_suffix(\".log\").open(\"w\") as f:
    f.write(\"Command: \"+command+\"\\nHEAD: \"+head+\"\\nDate: \"+datetime.datetime.now(datetime.timezone.utc).isoformat()+\"\\n\")
    f.flush()
    proc=subprocess.Popen(command,shell=True,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)
    while proc.poll() is None:
        rows=subprocess.check_output([\"ps\",\"-axo\",\"pid=,ppid=,rss=\"],text=True).splitlines()
        parsed=[tuple(map(int,row.split())) for row in rows if len(row.split())==3]
        family={proc.pid}
        for _ in range(10):
            more={pid for pid,ppid,rss in parsed if ppid in family}
            if more<=family: break
            family|=more
        rss=sum(rss for pid,ppid,rss in parsed if pid in family)
        peak=max(peak,rss)
        if rss>960*1024: stop=\"960 MiB aggregate RSS limit\"
        if time.monotonic()-start>120: stop=\"120 second wall limit\"
        if stop:
            os.killpg(proc.pid,signal.SIGTERM)
            time.sleep(1)
            try: os.killpg(proc.pid,signal.SIGKILL)
            except ProcessLookupError: pass
            break
        time.sleep(.25)
    status=proc.wait()
