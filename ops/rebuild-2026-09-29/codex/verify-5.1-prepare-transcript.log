   413	def process_episode(task: EpisodeTask, out_dir: Path) -> dict[str, Any]:
   414	    """Prepare one episode and write its shard and record; return the record."""
   415	    record: dict[str, Any] = {
   416	        "episode_id": task.episode_id,
   417	        "day": task.day,
   418	        "member": task.member,
   419	        "split": task.split,
   420	    }
   421	    try:
   422	        data, sha256, size = _read_member(task)
   423	        record |= {"source_sha256": sha256, "source_bytes": size}
   424	        check_envelope(data, task.episode_id)
   425	        banks = final_banks(data)
   426	        policy = winner_seats(banks)
   427	        turns = kept_turns(task.episode_id, task.turn_stride)
   428	        arrays = encode_observations(data, turns)
   429	        admitted, tokens, lengths, rejections, normalizations = admit_turns(
   430	            data, turns, arrays, policy
   431	        )
   432	    except EpisodeRejected as error:
   433	        record["rejected"] = str(error)
   434	        _write_record(out_dir, task, record)
   435	        return record
   436	    record |= {
   437	        "info_seed": int(data["info"]["seed"]),
   438	        "terminal_banks": list(banks),
   439	        "policy_seats": [seat for seat in (0, 1) if policy[seat]],
   440	        "paired_turns": PAIRED_TURNS,
   441	        "kept_turns": len(turns),
   442	        "admitted": int(admitted.sum()),
   443	        "rejections": dict(sorted(rejections.items())),
   444	        "normalizations": dict(sorted(normalizations.items())),
   445	    }
   446	    del data
   447	    if record["admitted"] == 0:
   448	        record["rejected"] = "no admitted turns"
   449	        _write_record(out_dir, task, record)
   450	        return record
   451	    keep = np.flatnonzero(admitted)
   452	    tensors = {name: torch.from_numpy(a[keep]) for name, a in arrays.items()}
   453	    can_act = tensors.pop("can_act")
   454	    episode = bc_data.BCEpisode(
   455	        episode_id=task.episode_id,
   456	        split=task.split,
   457	        day=task.day,
   458	        obs=kt.KaggricultureObsBatch(
   459	            **tensors, action_mask=kt.KaggricultureActionMask(can_act=can_act)
   460	        ),
   461	        actions=kt.KaggricultureActions(
   462	            tokens=torch.from_numpy(tokens[keep]),
   463	            lengths=torch.from_numpy(lengths[keep]),
   464	        ),
   465	        policy_seat=torch.tensor([policy] * keep.size, dtype=torch.bool),
   466	        turn=torch.tensor([turns[i] for i in keep], dtype=torch.int64),
   467	        terminal_banks=banks,
   468	    )
   469	    episode.obs.check_contract()
   470	    shard = out_dir / bc_data.shard_path(task.split, task.day, task.episode_id)
   471	    shard.unlink(missing_ok=True)  # a crash before the record left a partial shard
   472	    written = bc_data.write_bc_episode(out_dir, episode)
   473	    record |= {
   474	        "shard_path": written.shard_path,
   475	        "shard_sha256": written.shard_sha256,
   476	        "shard_bytes": written.shard_bytes,
   477	    }
   478	    _write_record(out_dir, task, record)
   479	    return record
