   319	def _allocate(rows: int) -> dict[str, npt.NDArray[Any]]:
   320	    arrays = {
   321	        name: np.zeros((rows, kt.PLAYERS, *shape), dtype=_NUMPY_DTYPES[dtype])
   322	        for name, (dtype, shape, _, _) in kt._SCHEMA.items()
