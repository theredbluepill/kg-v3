   328	def encode_observations(
   329	    data: dict[str, Any], turns: Sequence[int]
   330	) -> dict[str, npt.NDArray[Any]]:
   331	    """Native Task 1.3 encoding of ``steps[t]`` for every kept turn, both seats."""
   332	    arrays = _allocate(len(turns))
   333	    for start in range(0, len(turns), ENCODE_BATCH):
   334	        chunk = turns[start : start + ENCODE_BATCH]
   335	        headers = json.dumps([turn_header(data, t) for t in chunk])
   336	        view = {name: a[start : start + len(chunk)] for name, a in arrays.items()}
   337	        try:
   338	            rs.encode_kaggriculture_headers_into(headers, **view)
   339	        except ValueError as error:
   340	            raise EpisodeRejected(
   341	                f"encoder: turns {chunk[0]}..{chunk[-1]}: {error}"
   342	            ) from error
   343	    return arrays
