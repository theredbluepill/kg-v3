   345	
   346	def admit_turns(
   347	    data: dict[str, Any],
   348	    turns: Sequence[int],
   349	    arrays: dict[str, npt.NDArray[Any]],
   350	    policy: tuple[bool, bool],
   351	) -> tuple[
   352	    npt.NDArray[np.bool_],
   353	    npt.NDArray[np.int64],
   354	    npt.NDArray[np.int64],
   355	    Counter[str],
   356	    Counter[str],
   357	]:
   358	    """Strict per-turn admission of the policy seats' step+1 actions."""
   359	    order_limit_config = int(data["configuration"]["maxMarketOrdersPerTurn"])
   360	    rows = len(turns)
   361	    admitted = np.zeros(rows, dtype=np.bool_)
   362	    tokens = np.zeros((rows, 2, kt.MAX_FRAMES, kt.ACTION_SLOTS), dtype=np.int64)
   363	    lengths = np.zeros((rows, 2), dtype=np.int64)
   364	    rejections: Counter[str] = Counter()
   365	    normalizations: Counter[str] = Counter()
   366	    for row, t in enumerate(turns):
   367	        farms = data["steps"][t][0]["observation"]["farms"]
   368	        ok = True
   369	        for seat in (0, 1):
   370	            actors = int(arrays["actor_mask"][row, seat, :HIRE_LIMIT].sum())
   371	            order_limit = int(arrays["order_limits"][row, seat])
   372	            if actors != 1 + len(farms[seat]["hands"]):
   373	                raise EpisodeRejected(f"turn {t} seat {seat}: actor count mismatch")
   374	            if order_limit != order_limit_config:
   375	                raise EpisodeRejected(f"turn {t} seat {seat}: order limit mismatch")
   376	            out = tokens[row, seat]
   377	            if not policy[seat]:
   378	                try:
   379	                    lengths[row, seat] = rs.kaggriculture_encode(
   380	                        json.dumps(pass_action(actors)),
   381	                        actors,
   382	                        order_limit,
   383	                        HIRE_LIMIT,
   384	                        out,
   385	                    )
   386	                except ValueError as error:
   387	                    rejections[f"placeholder {rejection_reason(error)}"] += 1
   388	                    ok = False
   389	                continue
   390	            # Step+1 pairing: the action answering steps[t] is recorded at steps[t + 1].
   391	            raw = data["steps"][t + 1][seat]["action"]
   392	            try:
   393	                action, kinds = normalize_action(raw)
   394	                length = rs.kaggriculture_encode(
   395	                    json.dumps(action), actors, order_limit, HIRE_LIMIT, out
   396	                )
   397	                decoded = json.loads(
   398	                    rs.kaggriculture_decode(out, length, actors, order_limit, HIRE_LIMIT)
   399	                )
   400	                if decoded != action:
   401	                    raise ValueError("decode round trip")
   402	            except ValueError as error:
   403	                rejections[rejection_reason(error)] += 1
   404	                out[:] = 0
   405	                ok = False
   406	                continue
   407	            normalizations.update(kinds)
   408	            lengths[row, seat] = length
   409	        admitted[row] = ok
   410	    return admitted, tokens, lengths, rejections, normalizations
