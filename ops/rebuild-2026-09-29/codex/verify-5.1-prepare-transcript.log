   666	def _source_identity(repo: Path) -> dict[str, Any]:
   667	    head = subprocess.run(
   668	        ["git", "-C", str(repo), "rev-parse", "HEAD"],
   669	        check=True,
   670	        capture_output=True,
   671	        text=True,
   672	    ).stdout.strip()
   673	    dirty = subprocess.run(
   674	        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=no"],
   675	        check=True,
   676	        capture_output=True,
   677	        text=True,
   678	    ).stdout.strip()
   679	    if dirty:
   680	        raise RuntimeError(f"refusing to prepare from a dirty checkout:\n{dirty}")
   681	    extension = Path(str(rs.__file__))
   682	    return {
   683	        "git_head": head,
   684	        "uv_lock_sha256": _sha256(repo / "uv.lock"),
   685	        "cargo_lock_sha256": _sha256(repo / "Cargo.lock"),
   686	        "prepare_sha256": _sha256(Path(__file__)),
   687	        "owl_rs_extension": extension.name,
   688	        "owl_rs_sha256": _sha256(extension),
   689	    }
