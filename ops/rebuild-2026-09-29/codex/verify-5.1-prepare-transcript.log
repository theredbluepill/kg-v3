   499	# --- pairing sanity with Kaggle's own engine --------------------------------------
   500	
   501	
   502	def pairing_check(data: dict[str, Any]) -> tuple[int, list[dict[str, Any]]]:
   503	    """Step Kaggle's interpreter from ``steps[t]`` with ``steps[t + 1].action``.
   504	
   505	    Returns the number of the 719 transitions whose public state and both
   506	    privates equal ``steps[t + 1]`` (value equality), plus the mismatches.
   507	    """
   508	    from kaggle_environments.envs.kaggriculture.kaggriculture import interpreter
   509	    from kaggle_environments.utils import Struct, structify
   510	
   511	    env = Struct(
   512	        configuration=structify(copy.deepcopy(data["configuration"])),
   513	        info={"seed": data["info"]["seed"]},
   514	        done=False,
   515	    )
   516	    steps = data["steps"]
   517	    matches = 0
   518	    mismatches: list[dict[str, Any]] = []
   519	    for t in range(PAIRED_TURNS):
   520	        # structify copies every container. Kaggle shares one public
   521	        # farms/market/town object across seats, so both seats get the same one.
   522	        public = structify({k: steps[t][0]["observation"][k] for k in PUBLIC_KEYS})
   523	        state = []
   524	        for seat in (0, 1):
   525	            own = structify(
   526	                {
   527	                    k: v
   528	                    for k, v in steps[t][seat]["observation"].items()
   529	                    if k not in PUBLIC_KEYS
   530	                }
   531	            )
   532	            state.append(
   533	                Struct(
   534	                    observation=Struct(**own, **public),
   535	                    action=structify(steps[t + 1][seat]["action"]),
   536	                    status="ACTIVE",
   537	                    reward=0,
   538	                )
   539	            )
   540	        interpreter(state, env)
   541	        predicted = _plain(
   542	            {
   543	                "public": {k: state[0].observation[k] for k in PAIRING_PUBLIC_KEYS},
   544	                "privates": [state[s].observation["private"] for s in (0, 1)],
   545	            }
   546	        )
   547	        nxt = steps[t + 1][0]["observation"]
   548	        expected = {
   549	            "public": {k: nxt[k] for k in PAIRING_PUBLIC_KEYS},
   550	            "privates": [steps[t + 1][s]["observation"]["private"] for s in (0, 1)],
   551	        }
   552	        if predicted == expected:
   553	            matches += 1
   554	        else:
   555	            differing = [
   556	                k for k in PAIRING_PUBLIC_KEYS
   557	                if predicted["public"][k] != expected["public"][k]
   558	            ] + [
   559	                f"private{s}" for s in (0, 1)
   560	                if predicted["privates"][s] != expected["privates"][s]
   561	            ]
   562	            mismatches.append({"turn": t, "differs": differing})
   563	    return matches, mismatches
   564	
