    39	Agent and team names are never read.
    40	
    41	``--pairing-sample N`` first steps N episodes through kaggle-environments' own
    42	Kaggriculture interpreter (with the recorded ``info.seed``) from every
    43	``steps[t]`` with ``steps[t + 1].action`` and counts how many transitions
    44	reproduce ``steps[t + 1]``: evidence for the step+1 pairing on this corpus.
    45	"""
    46	
    47	from __future__ import annotations
    48	
    49	import argparse
    50	import contextlib
    51	import copy
    52	import hashlib
    53	import json
