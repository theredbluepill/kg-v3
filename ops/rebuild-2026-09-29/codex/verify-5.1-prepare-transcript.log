    72	from owl.kaggriculture import types as kt
    73	
    74	EPISODE_STEPS = 720
    75	PAIRED_TURNS = EPISODE_STEPS - 1
    76	HIRE_LIMIT = 241
    77	ENCODE_BATCH = 32
    78	RECORD_DIR = "records"
    79	PAIRING_NAME = "pairing.json"
    80	ARCHIVE_PATTERN = "kaggriculture-episodes-{month}-{day:02d}.zip"
    81	PUBLIC_KEYS = ("step", "day", "hour", "farms", "market", "town")
    82	PAIRING_PUBLIC_KEYS = ("day", "hour", "farms", "market", "town")
    83	CONFIG_KEYS = frozenset(
    84	    {
    85	        "episodeSteps",
    86	        "boardSize",
    87	        "startingMoney",
    88	        "maxMarketOrdersPerTurn",
    89	        "turnsPerDay",
    90	        "shedCapacity",
    91	        "weedSpawnChance",
    92	        "townShopUnlockInterval",
    93	        "townShopSellInterval",
    94	        "townCenterSellInterval",
    95	        "farmHandCostMult",
    96	        "marketParams",
    97	    }
    98	)
    99	CONFIG_EXTRA_KEYS = frozenset({"actTimeout", "runTimeout", "seed"})
   100	ACTION_KEYS = frozenset({"farmer", "hands", "market"})
   101	_EPISODE_ID = re.compile(r"^[0-9A-Za-z_-]+$")
   102	_ABSENT = object()
   103	
   104	
   105	class EpisodeRejected(Exception):
   106	    """The whole episode is unusable; the message is the counted reason."""
   107	
   108	
   109	@dataclass(frozen=True)
   110	class EpisodeTask:
   111	    archive: str
   112	    member: str
   113	    day: str
   114	    episode_id: str
   115	    split: bc_data.Split
   116	    turn_stride: int
   117	
   118	
   119	# --- pure helpers (unit tested) ---------------------------------------------------
   120	
   121	
   122	def validation_split(episode_id: str, fraction: float) -> bc_data.Split:
   123	    """Deterministic episode-level split: a hash of the id, never of its content."""
   124	    bucket = int(hashlib.sha256(episode_id.encode()).hexdigest()[:8], 16) % 10_000
   125	    return "validation" if bucket < round(fraction * 10_000) else "train"
   126	
   127	
   128	def kept_turns(episode_id: str, stride: int) -> list[int]:
   129	    """Turns ``t`` in ``0..718`` kept under ``stride``, phase-shifted per episode."""
   130	    if stride < 1:
   131	        raise ValueError(f"turn stride must be >= 1, got {stride}")
   132	    offset = int(hashlib.sha256(f"turn:{episode_id}".encode()).hexdigest()[:8], 16)
   133	    return [t for t in range(PAIRED_TURNS) if (t + offset) % stride == 0]
   134	
   135	
   136	def winner_seats(banks: Sequence[float]) -> tuple[bool, bool]:
   137	    """Policy seats: the larger final bank, both on a draw."""
   138	    return (banks[0] >= banks[1], banks[1] >= banks[0])
   139	
   140	
   141	def check_envelope(data: dict[str, Any], episode_id: str) -> None:
   142	    steps = data.get("steps")
   143	    if not isinstance(steps, list) or len(steps) != EPISODE_STEPS:
   144	        count = len(steps) if isinstance(steps, list) else None
   145	        raise EpisodeRejected(f"steps: expected {EPISODE_STEPS}, got {count}")
   146	    if any(not isinstance(step, list) or len(step) != 2 for step in steps):
   147	        raise EpisodeRejected("steps: every step needs exactly two seats")
   148	    info = data.get("info")
   149	    if not isinstance(info, dict) or str(info.get("EpisodeId")) != episode_id:
   150	        raise EpisodeRejected("info.EpisodeId differs from the member name")
   151	    seed = info.get("seed")
   152	    if isinstance(seed, bool) or not isinstance(seed, int):
   153	        raise EpisodeRejected("info.seed is not an integer")
   154	    statuses = [seat.get("status") for seat in steps[-1]]
   155	    if statuses != ["DONE", "DONE"]:
   156	        raise EpisodeRejected(f"final statuses {statuses}")
   157	    config = data.get("configuration")
   158	    if not isinstance(config, dict):
   159	        raise EpisodeRejected("configuration missing")
   160	    missing = CONFIG_KEYS - set(config)
   161	    extra = set(config) - CONFIG_KEYS - CONFIG_EXTRA_KEYS
   162	    if missing or extra:
   163	        raise EpisodeRejected(
   164	            f"configuration keys: missing {sorted(missing)}, extra {sorted(extra)}"
   165	        )
   166	    if config["episodeSteps"] != EPISODE_STEPS:
   167	        raise EpisodeRejected(f"episodeSteps {config['episodeSteps']}")
   168	
   169	
   170	def final_banks(data: dict[str, Any]) -> tuple[float, float]:
   171	    farms = data["steps"][-1][0]["observation"]["farms"]
   172	    banks = (float(farms[0]["money"]), float(farms[1]["money"]))
   173	    if not all(math.isfinite(bank) for bank in banks):
   174	        raise EpisodeRejected(f"final banks not finite: {banks}")
   175	    return banks
   176	
   177	
   178	def turn_header(data: dict[str, Any], t: int, *, seed: int = 0) -> dict[str, Any]:
   179	    """Explicit-state header for ``steps[t]``; seat 1's shared keys from seat 0.
   180	
   181	    Encoding always uses the placeholder seed 0, so the recorded seed never
   182	    reaches observation buffers.
   183	    """
   184	    obs0 = data["steps"][t][0]["observation"]
   185	    obs1 = data["steps"][t][1]["observation"]
   186	    return {
   187	        "format": "kaggriculture-re-parity-v1",
   188	        "seed": seed,
   189	        "configuration": data["configuration"],
   190	        "shop_schedule": [],
   191	        "rng_schedule": [],
   192	        "initial": {
   193	            "public": {key: obs0[key] for key in PUBLIC_KEYS},
   194	            "privates": [obs0["private"], obs1["private"]],
   195	        },
   196	        "terminal_banks": [],
   197	        "transitions": 0,
   198	    }
   199	
   200	
   201	def _falsy_kind(value: object) -> str | None:
   202	    """The reference's ``raw.get(k) or []``: which falsy value became ``[]``."""
   203	    if value is _ABSENT:
   204	        return "absent"
   205	    if value is None:
   206	        return "null"
   207	    if value is False:
   208	        return "false"
   209	    if isinstance(value, (int, float)) and not isinstance(value, bool) and value == 0:
   210	        return "zero"
   211	    if isinstance(value, str) and value == "":
   212	        return "empty_string"
   213	    if isinstance(value, dict) and not value:
   214	        return "empty_object"
   215	    return None
   216	
   217	
   218	def normalize_action(raw: object) -> tuple[dict[str, Any], list[str]]:
   219	    """Reference envelope normalization; raises ``ValueError`` on a bad envelope."""
   220	    if not isinstance(raw, dict) or not set(raw) <= ACTION_KEYS:
   221	        raise ValueError("action envelope")
   222	    action: dict[str, Any] = {"farmer": raw.get("farmer")}
   223	    normalized: list[str] = []
   224	    for key in ("hands", "market"):
   225	        value = raw.get(key, _ABSENT)
   226	        kind = _falsy_kind(value)
   227	        if kind is not None:
   228	            normalized.append(f"normalized_{key}_{kind}")
   229	            value = []
   230	        elif not isinstance(value, list):
   231	            raise ValueError("action envelope")
   232	        action[key] = value
   233	    return action, normalized
   234	
   235	
   236	def pass_action(actors: int) -> dict[str, Any]:
   237	    return {"farmer": ["PASS"], "hands": [["PASS"]] * (actors - 1), "market": []}
   238	
   239	
   240	def rejection_reason(error: Exception) -> str:
   241	    return str(error).split(":", 1)[0].strip()[:80] or type(error).__name__
   242	
   243	
   244	def resident_bytes_per_turn() -> int:
   245	    """Host bytes one turn row occupies in ``load_bc_dataset``'s compact store."""
   246	    sizes = {torch.int64: 4, torch.float32: 4, torch.float64: 8, torch.bool: 1}
   247	    per_seat = sum(
   248	        sizes[dtype] * math.prod(shape) for dtype, shape, _, _ in kt._SCHEMA.values()
   249	    )
   250	    labels = kt.MAX_FRAMES + 2 * kt.MAX_FRAMES * kt.ACTION_SLOTS + 4 + 1
   251	    return kt.PLAYERS * (per_seat + labels) + 4 + 8
   252	
   253	
   254	def stride_for_budget(episodes: int, budget_gib: float) -> int:
   255	    rows = episodes * PAIRED_TURNS
   256	    budget_rows = int(budget_gib * 2**30) // resident_bytes_per_turn()
   257	    if budget_rows < 1:
   258	        raise ValueError(f"resident budget {budget_gib} GiB holds no turn row")
   259	    return max(1, math.ceil(rows / budget_rows))
   260	
   261	
   262	# --- archive listing --------------------------------------------------------------
   263	
   264	
   265	def list_tasks(
   266	    archives: Path,
   267	    *,
   268	    month: str,
   269	    days: Iterable[int],
   270	    validation_fraction: float,
   271	    turn_stride: int,
   272	) -> list[EpisodeTask]:
   273	    tasks: list[EpisodeTask] = []
   274	    seen: set[str] = set()
   275	    for day in days:
   276	        path = archives / ARCHIVE_PATTERN.format(month=month, day=day)
   277	        if not path.is_file():
   278	            raise FileNotFoundError(f"day archive missing: {path}")
   279	        with zipfile.ZipFile(path) as archive:
   280	            names = sorted(n for n in archive.namelist() if n.endswith(".json"))
   281	        for member in names:
   282	            episode_id = member[: -len(".json")]
   283	            if "/" in member or not _EPISODE_ID.match(episode_id):
   284	                raise ValueError(f"{path}: unexpected member {member!r}")
   285	            if episode_id in seen:
   286	                raise ValueError(f"episode {episode_id} appears in two archives")
   287	            seen.add(episode_id)
   288	            tasks.append(
   289	                EpisodeTask(
   290	                    archive=str(path),
   291	                    member=member,
   292	                    day=f"{month}-{day:02d}",
   293	                    episode_id=episode_id,
   294	                    split=validation_split(episode_id, validation_fraction),
   295	                    turn_stride=turn_stride,
   296	                )
   297	            )
   298	    return tasks
   299	
   300	

