   396	def _compact(
   397	    name: str, values: torch.Tensor, record: BCManifestEpisode
   398	) -> torch.Tensor:
   399	    """Declared lossless storage cast: int64 fields to int32 (tokens int16)."""
   400	    if values.dtype != torch.int64:
   401	        return values
   402	    storage = _TOKEN_STORAGE if name == "tokens" else _INTEGER_STORAGE
   403	    info = torch.iinfo(storage)
   404	    if values.numel() and (
   405	        int(values.min()) < info.min or int(values.max()) > info.max
   406	    ):
   272	
   273	
   274	def winner_targets(final_banks: torch.Tensor) -> torch.Tensor:
   275	    """Per-seat winner distribution ``[rows, seat, (self, opponent)]`` (L1).
   276	
   277	    ``final_banks`` is ``[rows, 2]`` in seat order; the larger raw bank wins and
   278	    equal banks are a draw (0.5 each).
   279	    """
   280	    if final_banks.ndim != 2 or final_banks.shape[1] != kt.PLAYERS:
   281	        raise ValueError(f"final_banks must be [rows, 2], got {final_banks.shape}")
   282	    seat0 = torch.where(
   283	        final_banks[:, 0] > final_banks[:, 1],
   284	        1.0,
   285	        torch.where(final_banks[:, 0] < final_banks[:, 1], 0.0, 0.5),
   286	    ).to(torch.float32)
   287	    self_wins = torch.stack((seat0, 1.0 - seat0), dim=1)
   288	    return torch.stack((self_wins, 1.0 - self_wins), dim=-1)
   289	
   290	
   291	@dataclass(frozen=True)
   292	class BCTerms:
   293	    """Per seat row ``[rows, 2]``, float32; ``policy`` is the 0/1 policy mask."""
   294	
   295	    turn_nll: torch.Tensor
   296	    program_nll: torch.Tensor
   297	    frames: torch.Tensor
   298	    value_ce: torch.Tensor
   299	    policy: torch.Tensor
   300	
   301	
   302	def bc_terms(evaluation: ModelEvaluation, batch: BCBatch) -> BCTerms:
   303	    if evaluation.winner_log_probabilities is None:
   304	        raise ValueError("BC needs winner log-probabilities from evaluate_actions")
   305	    program_nll = -evaluation.log_probs.per_player_entity.float().sum(dim=-1)
   306	    frames = batch.actions.lengths.to(program_nll.dtype)
   307	    targets = winner_targets(batch.final_banks).to(program_nll.device)
   308	    value_ce = -(targets * evaluation.winner_log_probabilities.float()).sum(dim=-1)
   309	    return BCTerms(
   310	        turn_nll=program_nll / frames,
   311	        program_nll=program_nll,
   312	        frames=frames,
   313	        value_ce=value_ce,
   314	        policy=batch.policy_seat.to(device=program_nll.device, dtype=program_nll.dtype),
   315	    )
   316	
   317	
   318	def bc_loss(terms: BCTerms, *, value_coef: float) -> torch.Tensor:
   319	    """Policy NLL over the policy seat rows plus the critic CE over all seat rows."""
   320	    policy_nll = (terms.turn_nll * terms.policy).sum() / terms.policy.sum()
   321	    return policy_nll + value_coef * terms.value_ce.mean()
   322	
   323	
   324	def evaluate_bc_batch(
   325	    model: BaseModelAPI[Any, Any, Any],
   326	    batch: BCBatch,
   327	    *,
   328	    ppo_config: FullConfig,
   329	    device: torch.device,
   330	) -> BCTerms:
   331	    with autocast_context(ppo_config.rl, device):
   332	        evaluation = model.evaluate_actions(batch.obs, batch.actions)
   333	    return bc_terms(evaluation, batch)
