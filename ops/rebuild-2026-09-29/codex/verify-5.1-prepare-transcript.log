   695	@contextlib.contextmanager
   696	def _mapper(workers: int) -> Iterator[Callable[..., Iterable[Any]]]:
   697	    """In-process ``map`` for one worker, else a bounded spawn pool."""
   698	    if workers == 1:
   699	        yield map
   700	        return
   701	    context = multiprocessing.get_context("spawn")
   702	    with context.Pool(workers, maxtasksperchild=64) as pool:
   703	        yield pool.imap_unordered
