   658	def _sha256(path: Path) -> str:
   659	    digest = hashlib.sha256()
   660	    with path.open("rb") as handle:
   661	        for block in iter(lambda: handle.read(1 << 20), b""):
   662	            digest.update(block)
   663	    return digest.hexdigest()
