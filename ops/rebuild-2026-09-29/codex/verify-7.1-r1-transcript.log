MOVES = ["NORTH", "SOUTH", "EAST", "WEST"]
CROPS = ["WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON"]
ANIMALS = ["GOOSE", "COW", "SHEEP"]
PRODUCTS = [*CROPS, "EGG", "MILK", "WOOL", "FERTILIZER"]
SHED_ITEMS = [*PRODUCTS, *ANIMALS]
TILE_OPS = [
    "WATER",
