MARKET_VERBS = ["BUY_SEED", "BUY_PRODUCT", "BUY_ANIMAL", "SELL", "HIRE", "BUY_LAND"]
PASS_ACTION: dict[str, Any] = {"farmer": ["PASS"], "hands": [], "market": []}

Json = Any
