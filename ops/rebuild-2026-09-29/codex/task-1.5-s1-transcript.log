        seen.append(tensor)
        return original(tensor)
    monkeypatch.setattr(torch.Tensor, \"numpy\", numpy_spy)
    for _ in range(2):
        actions = pass_actions()
        mask = torch.tensor([False, True])
        fake.step(actions)
        for view, tensor in zip(fake._native.inputs[-1], (actions.tokens, actions.lengths), strict=True):
