/bin/zsh -lc "uv run python - <<'PY'
import pathlib,subprocess,json,re
out=pathlib.Path('.codex-tmp/verify-merge-evidence')
r=subprocess.run(['git','diff','--check','2390c8e...HEAD'],capture_output=True,text=True)
(out/'diff-check.log').write_text(r.stdout+r.stderr)
paths=sorted(set(re.findall(r'"'^([''^'"\\n:]+):\\d+:',r.stdout,re.M)))
print('Full diff whitespace check exit:',r.returncode,'diagnostic paths:',len(paths),'all raw receipts:',all('/pod/' in p and p.endswith(('.log','.txt')) for p in paths))
r=subprocess.run(['git','diff','--check','2390c8e...HEAD','--','*.md','*.py','*.sh','*.json','*.sha256'],capture_output=True,text=True)
(out/'authored-diff-check.log').write_text(r.stdout+r.stderr)
print('Authored-file whitespace check:',r.returncode,repr(r.stdout+r.stderr)); assert r.returncode==0
r=subprocess.run(['uv','run','python','scripts/check_doc_freshness.py'],capture_output=True,text=True)
(out/'docs-fresh.log').write_text(r.stdout+r.stderr)
print('Docs freshness:',r.returncode,repr(r.stdout+r.stderr)); assert r.returncode==0
for d in ('sparse','mid','dense'):
