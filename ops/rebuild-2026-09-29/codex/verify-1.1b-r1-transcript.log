   496	fn generated_manifest() -> Vec<Value> {
   497	    let path = engine_path(&format!("{GENERATED_DIR}/MANIFEST.json"));
   498	    let manifest: Value = serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
   499	    assert_eq!(manifest["kaggle_environments_version"], MODULE_VERSION);
   500	    assert_eq!(manifest["python_engine_sha256"], ENGINE_SHA256);
   501	    manifest["traces"].as_array().unwrap().clone()
