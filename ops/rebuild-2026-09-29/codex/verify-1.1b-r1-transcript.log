   299	fn read_trace(path: &Path) -> String {
   300	    if path.extension().is_some_and(|ext| ext == "gz") {
   301	        let output = Command::new("gzip")
   302	            .arg("-dc")
   303	            .arg(path)
   304	            .output()
   305	            .expect("gzip is required for compressed replay fixtures");
   306	        assert!(
   307	            output.status.success(),
   308	            "{}: {}",
   309	            path.display(),
   310	            String::from_utf8_lossy(&output.stderr)
   311	        );
   312	        String::from_utf8(output.stdout).unwrap()
   313	    } else {
   314	        std::fs::read_to_string(path).unwrap_or_else(|error| panic!("{}: {error}", path.display()))
   315	    }
   316	}
