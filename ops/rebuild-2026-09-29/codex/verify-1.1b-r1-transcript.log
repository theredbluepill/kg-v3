   584	fn line_for_step(text: &str, record_type: &str, from_step: u64) -> usize {
   585	    text.lines()
   586	        .position(|line| {
   587	            let row: Value = serde_json::from_str(line).unwrap();
   588	            row["type"] == record_type && row["from_step"] == from_step
   589	        })
   590	        .unwrap_or_else(|| panic!("no {record_type} record from step {from_step}"))
   591	}
