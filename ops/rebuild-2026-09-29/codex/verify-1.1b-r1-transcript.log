   854	def encode_trace(records: list[dict[str, Any]]) -> bytes:
   855	    """Deterministic gzip JSONL (fixed mtime, no filename) for stable hashes."""
   856	    text = "".join(
   857	        json.dumps(record, separators=(",", ":"), allow_nan=False) + "\n"
   858	        for record in records
   859	    )
   860	    buffer = io.BytesIO()
   861	    with gzip.GzipFile(filename="", mode="wb", fileobj=buffer, mtime=0) as handle:
   862	        handle.write(text.encode("utf-8"))
   863	    return buffer.getvalue()
