   641	#[test]
   642	fn generated_trace_rejection_claims_are_checked() {
   643	    let text = generated_trace(PERTURBED);
   644	    // An accepted step relabelled as rejected: Rust accepts it.
   645	    let line = line_for_step(&text, "transition", 10);
   646	    let relabelled = edit_line(&text, line, |row| row["type"] = json!("rejected"));
   647	    let divergence = replay_text(&relabelled).unwrap_err();
   648	    assert_eq!(
   649	        (divergence.kind.as_str(), divergence.from_step),
   650	        ("rust_accepted", Some(10))
   651	    );
   652	    // A rejected step relabelled as accepted: Rust rejects it, as Python did.
   653	    let (line, step) = text
   654	        .lines()
