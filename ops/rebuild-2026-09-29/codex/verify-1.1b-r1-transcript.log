   118	def summarize(
   119	    generated: list[dict[str, Any]],
   120	    report: list[dict[str, Any]],
   121	    traces_dir: Path,
   122	) -> dict[str, Any]:
   123	    by_file = {entry["path"]: entry for entry in generated}
   124	    replayed = {entry["file"]: entry for entry in report}
   125	    missing = sorted(set(by_file) - set(replayed))
   126	    if missing:
   127	        raise RuntimeError(f"Rust did not replay: {missing}")
   128	    policies: dict[str, Counter[str]] = defaultdict(Counter)
   129	    variants: dict[str, Counter[str]] = defaultdict(Counter)
   130	    divergences = []
   131	    for name, entry in sorted(by_file.items()):
   132	        result = replayed[name]
   133	        kind = "probe" if "probe" in entry else "game"
   134	        labels = [
   135	            "script" if kind == "probe" and seat == 0 else policy
   136	            for seat, policy in enumerate(entry["policies"])
   137	        ]
   138	        for label in labels:
   139	            policies[label]["seats"] += 1
   140	        for label in set(labels):
   141	            policies[label]["probes" if kind == "probe" else "games"] += 1
   142	            policies[label]["transitions"] += entry["transitions"]
   143	        variants[entry["config_variant"]]["traces"] += 1
   144	        variants[entry["config_variant"]]["transitions"] += entry["transitions"]
   145	        if result["ok"]:
   146	            continue
   147	        divergence = result["divergence"]
   148	        record = _record(traces_dir / name, divergence["line"])
   149	        actions = record.get("actions", [])
   150	        divergences.append(
   151	            {
   152	                "file": name,
   153	                "kind": kind,
   154	                "seed": entry["seed"],
   155	                "policies": entry["policies"],
   156	                "config_variant": entry["config_variant"],
   157	                **({"probe": entry["probe"]} if "probe" in entry else {}),
   158	                "first_divergence": divergence,
   159	                "known_class": classify(actions if isinstance(actions, list) else []),
   160	            }
   161	        )
   162	    games = [e for e in generated if "probe" not in e]
   163	    probes = [e for e in generated if "probe" in e]
   164	    new = [d for d in divergences if d["known_class"] is None]
   165	    return {
   166	        "games": len(games),
   167	        "probes": len(probes),
   168	        "traces": len(generated),
   169	        "transitions": sum(e["transitions"] for e in generated),
   170	        "game_transitions": sum(e["transitions"] for e in games),
   171	        "python_rejected_steps": sum(e["rejected"] for e in generated),
   172	        "traces_agreeing": sum(1 for r in report if r["ok"]),
   173	        "traces_diverging": len(divergences),
   174	        "divergences_by_class": dict(
   175	            Counter(d["known_class"] or "unclassified" for d in divergences)
   176	        ),
   177	        "new_divergences": len(new),
   178	        "per_policy": {k: dict(v) for k, v in sorted(policies.items())},
   179	        "per_config_variant": {k: dict(v) for k, v in sorted(variants.items())},
   180	        "seeds": sorted({e["seed"] for e in games}),
   181	        "divergences": divergences,
   182	    }
