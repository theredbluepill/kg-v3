  1032	def known_divergence(name: str) -> dict[str, Any] | None:
  1033	    for known, _, kind, field_path, reason in KNOWN_DIVERGENCES:
  1034	        if known == name:
  1035	            # Probe line 3 is step 2 (header, two preamble transitions, probe).
  1036	            return {
  1037	                "line": 3,
  1038	                "from_step": 2,
  1039	                "kind": kind,
  1040	                "field": field_path,
  1041	                "reason": reason,
  1042	            }
  1043	    return None
