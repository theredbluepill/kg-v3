   542	
   543	def _edge_choice(
   544	    obs: dict[str, Any],
   545	    config: dict[str, Any],
   546	    rng: random.Random,
   547	    quantities: list[Any],
   548	    crash_units: list[Any],
   549	    crash_orders: list[Any],
   550	) -> Choice:
   551	    """Deliberately awkward inputs layered over the random policy."""
   552	    base = random_policy(obs, config, rng).action
   553	    action: dict[str, Any] = copy.deepcopy(base)
   554	    player = obs["player"]
   555	    farm = obs["farms"][player]
   556	    max_orders = int(config["maxMarketOrdersPerTurn"])
   557	    market: list[Any] = action["market"]
   558	    hands: list[Any] = action["hands"]
   559	
   560	    if rng.random() < 0.1:
   561	        action["market"] = market = []
   562	    free_hires = int(config["farmHandCostMult"]) == 0
   563	    if rng.random() < (0.95 if free_hires else 0.3):
   564	        # HIRE until and past the actor cap / order limit.
   565	        market[:0] = [["HIRE"]] * (max_orders + rng.choice([0, 0, 2]))
   566	    if rng.random() < 0.35:
   567	        for _ in range(rng.randint(1, 3)):
   568	            verb = rng.choice(["BUY_SEED", "SELL", "BUY_PRODUCT", "BUY_ANIMAL"])
   569	            item = {
   570	                "BUY_SEED": CROPS,
   571	                "SELL": PRODUCTS,
   572	                "BUY_PRODUCT": ["WHEAT", "FERTILIZER"],
   573	                "BUY_ANIMAL": ANIMALS,
   574	            }[verb]
   575	            market.insert(
   576	                rng.randrange(len(market) + 1),
   577	                [verb, rng.choice(item), rng.choice(quantities)],
   578	            )
   579	    if rng.random() < 0.15:
   580	        market.insert(rng.randrange(len(market) + 1), [])
   581	    if float(farm["money"]) >= 1_000_000 and rng.random() < 0.1:
   582	        # One-million-unit orders exhaust Python's 100,000-iteration market loop.
   583	        market.insert(0, ["BUY_SEED", rng.choice(CROPS), 10**12])
   584	    if rng.random() < 0.2 and market:
   585	        # Duplicates and reversed (out-of-order) queues.
   586	        market.append(copy.deepcopy(rng.choice(market)))
   587	        if rng.random() < 0.5:
   588	            market.reverse()
   589	    if rng.random() < 0.1:
   590	        market += [["BUY_LAND"]] * 4
   591	    if rng.random() < 0.2:
   592	        market.insert(rng.randrange(len(market) + 1), rng.choice(UNKNOWN_ORDERS))
   593	    if rng.random() < 0.2:
   594	        market.insert(rng.randrange(len(market) + 1), rng.choice(MALFORMED_ORDERS))
   595	    if rng.random() < 0.2:
   596	        slot = rng.randrange(len(hands) + 1)
   597	        malformed = copy.deepcopy(rng.choice(MALFORMED_UNITS))
   598	        if slot == 0:
   599	            action["farmer"] = malformed
   600	        else:
   601	            hands[slot - 1] = malformed
   602	    if rng.random() < 0.15:
   603	        # Commands for actors that do not exist.
   604	        hands += [_schema_unit(rng) for _ in range(rng.randint(1, 4))]
   605	    if rng.random() < 0.1:
   606	        # Oversubscribed PLANT: every actor plants one crop (atomic seed check).
   607	        crop = rng.choice(CROPS)
   608	        action["farmer"] = ["PLANT", crop]
   609	        for index in range(len(hands)):
   610	            hands[index] = ["PLANT", crop]
   611	    if rng.random() < 0.08:
   612	        action["hands"] = [] if rng.random() < 0.5 else hands[: len(farm["hands"]) // 2]
   613	
   614	    if rng.random() < 0.03:
   615	        return Choice(copy.deepcopy(rng.choice(MALFORMED_ACTIONS)))
   616	    if rng.random() < 0.025:
   617	        crashing = copy.deepcopy(action)
   618	        if crash_orders and rng.random() < 0.25:
   619	            crashing["market"] = [copy.deepcopy(rng.choice(crash_orders))]
   620	        else:
   621	            crashing["farmer"] = copy.deepcopy(rng.choice(crash_units))
   622	        return Choice(crashing, fallback=action)
   623	    return Choice(action)
