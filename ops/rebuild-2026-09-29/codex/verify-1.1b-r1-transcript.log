   848	def _weed_rolls(seed: int, day: int) -> list[float]:
   849	    """The first rolls of Python's end-of-day RNG, as in the official traces."""
   850	    rng = random.Random((seed * 1_000_003) ^ day)
   851	    return [rng.random() for _ in range(ROLLS_PER_DAY)]
