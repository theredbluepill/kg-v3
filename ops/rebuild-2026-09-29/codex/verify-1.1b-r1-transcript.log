   504	fn generated_trace(name: &str) -> String {
   505	    read_trace(&engine_path(&format!("{GENERATED_DIR}/{name}")))
   506	}
   507	
   508	/// Traces generated live from Kaggle's engine with seeded random, edge-case,
   509	/// built-in and mixed-seat policies (see the manifest for each game's inputs).
   510	///
   511	/// Entries with `expected_divergence` are minimized repros of documented
   512	/// divergences (D1, D2 in docs/rules-parity-coverage.md). The vendored kernel is
   513	/// byte-pinned, so they are expected failures: each must still diverge at exactly
   514	/// the recorded line, step, kind and field, or this test fails.
   515	#[test]
   516	fn generated_fixtures_replay() {
   517	    let traces = generated_manifest();
   518	    assert!(traces.len() >= 6, "expected the committed generated set");
   519	    let mut failures = vec![];
   520	    let mut expected_failures = 0;
   521	    for entry in &traces {
   522	        let name = entry["path"].as_str().unwrap();
   523	        let result = replay_text(&generated_trace(name));
   524	        match (&entry["expected_divergence"], result) {
   525	            (Value::Null, Ok(stats)) => {
   526	                assert_eq!(
   527	                    stats.transitions as u64,
   528	                    entry["transitions"].as_u64().unwrap(),
   529	                    "{name}"
   530	                );
   531	                assert_eq!(
   532	                    stats.rejected as u64,
   533	                    entry["rejected"].as_u64().unwrap(),
   534	                    "{name}"
   535	                );
   536	            },
   537	            (Value::Null, Err(divergence)) => failures.push(format!("{name}: {divergence}")),
   538	            (expected, Ok(_)) => failures.push(format!(
   539	                "{name}: expected divergence did not occur ({expected}); update the record"
   540	            )),
   541	            (expected, Err(divergence)) => {
   542	                let reason = expected["reason"].as_str().unwrap_or_default();
   543	                assert!(
   544	                    !reason.trim().is_empty(),
   545	                    "{name}: expected failure needs a reason"
   546	                );
   547	                let observed = json!({
   548	                    "line": divergence.line,
   549	                    "from_step": divergence.from_step,
   550	                    "kind": divergence.kind,
   551	                    "field": divergence.field,
   552	                });
   553	                for key in ["line", "from_step", "kind", "field"] {
   554	                    if observed[key] != expected[key] {
   555	                        failures.push(format!(
   556	                            "{name}: {key} {} != recorded {}",
   557	                            observed[key], expected[key]
   558	                        ));
   559	                    }
   560	                }
   561	                expected_failures += 1;
   562	            },
   563	        }
   564	    }
   565	    eprintln!(
   566	        "{} generated traces, {expected_failures} documented expected divergences",
   567	        traces.len()
   568	    );
   569	    assert!(
   570	        failures.is_empty(),
   571	        "generated parity divergences:\n{}",
   572	        failures.join("\n")
   573	    );
   574	}
