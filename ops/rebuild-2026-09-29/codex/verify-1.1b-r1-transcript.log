   460	fn engine_path(relative: &str) -> PathBuf {
   461	    Path::new(env!("CARGO_MANIFEST_DIR")).join(relative)
   462	}
   463	
   464	fn replay(file: &str, episode_id: u64) {
   465	    let text = read_trace(&engine_path(file));
   466	    let raw: Value = serde_json::from_str(text.lines().next().unwrap()).unwrap();
   467	    assert_eq!(raw["source"]["episode_id"].as_u64().unwrap(), episode_id);
   468	    assert_eq!(raw["transitions"], 719);
   469	    let stats = replay_text(&text).unwrap_or_else(|divergence| panic!("{file}: {divergence}"));
   470	    assert_eq!(
   471	        stats,
   472	        ReplayStats {
   473	            transitions: 719,
   474	            rejected: 0
   475	        }
   476	    );
   477	}
