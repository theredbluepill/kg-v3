   110	def _record(path: Path, line: int) -> dict[str, Any]:
   111	    with gzip.open(path, "rt", encoding="utf-8") as handle:
   112	        for index, text in enumerate(handle):
   113	            if index == line:
   114	                return dict(json.loads(text))
   115	    raise ValueError(f"{path}: no line {line}")
