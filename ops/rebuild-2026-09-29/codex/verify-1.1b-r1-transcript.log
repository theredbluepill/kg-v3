  1046	def write_manifest(out: Path, results: list[GameResult], pin: EnginePin) -> Path:
  1047	    entries = []
  1048	    for result in results:
  1049	        path = out / f"{result.spec.name}.jsonl.gz"
  1050	        entries.append(
  1051	            {
  1052	                "path": path.name,
  1053	                "sha256": sha256_file(path),
  1054	                "bytes": path.stat().st_size,
  1055	                "seed": result.spec.seed,
  1056	                "policies": list(result.spec.policies),
  1057	                "policy_seed": result.spec.policy_seed,
  1058	                "config_variant": result.spec.variant,
  1059	                "transitions": result.transitions,
  1060	                "rejected": result.rejected,
  1061	                **(
  1062	                    {"probe": result.spec.probe, "expected_divergence": expected}
  1063	                    if (expected := known_divergence(result.spec.name))
  1064	                    else {}
  1065	                ),
  1066	            }
  1067	        )
  1068	    manifest = {
  1069	        "schema_version": 1,
  1070	        "format": TRACE_FORMAT,
  1071	        "generator": GENERATOR,
  1072	        "kaggle_environments_version": pin.version,
  1073	        "python_engine_sha256": pin.sha256,
  1074	        "traces": entries,
  1075	    }
  1076	    path = out / "MANIFEST.json"
  1077	    path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
  1078	    return path
