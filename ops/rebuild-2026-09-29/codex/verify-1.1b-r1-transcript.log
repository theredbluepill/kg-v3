    86	def pinned_engine(cargo_toml: Path = CARGO_TOML) -> EnginePin:
    87	    """Read the compatibility target from the vendored crate's Cargo metadata."""
    88	    metadata = tomllib.loads(cargo_toml.read_text(encoding="utf-8"))
