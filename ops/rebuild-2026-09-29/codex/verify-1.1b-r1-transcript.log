   728	def play(
   729	    spec: GameSpec,
   730	    kaggle: ModuleType,
   731	    module: ModuleType,
   732	    pin: EnginePin,
   733	    engine_sha256: str,
   734	    include_known_divergences: bool = False,
   735	) -> GameResult:
   736	    """Run one seeded game in Kaggle's engine and record a parity trace."""
   737	    started = time.perf_counter()
   738	    policies = [
   739	        resolve_policy(name, module, include_known_divergences)
   740	        for name in ([] if spec.script else spec.policies)
   741	    ]
   742	    rngs = [random.Random(spec.policy_seed * 2 + seat) for seat in range(2)]
   743	    with _silenced():
   744	        env = kaggle.make("kaggriculture", configuration=spec.configuration)
   745	    if env.info.get("seed") != spec.seed:
   746	        raise ParityGeneratorError(f"{spec.name}: env did not adopt seed {spec.seed}")
   747	    config = _plain(dict(env.configuration))
   748	    turns_per_day = max(1, int(config["turnsPerDay"]))
   749	    initial = {"public": _public(env), "privates": _privates(env)}
   750	    records: list[dict[str, Any]] = []
   751	    rejected_errors: list[str] = []
   752	    end_days: list[int] = []
   753	    transitions = 0
   754	    while not env.done:
   755	        step = env.state[0].observation.step
   756	        observations = _observations(env)
   757	        if spec.script:
   758	            pair = spec.script[step] if step < len(spec.script) else (None, None)
   759	            choices = [
   760	                Choice(PASS_ACTION if act is None else act, fallback=PASS_ACTION)
   761	                for act in pair
   762	            ]
   763	        else:
   764	            choices = [
   765	                policy(obs, config, rng)
   766	                for policy, obs, rng in zip(policies, observations, rngs, strict=True)
   767	            ]
   768	        # Both engines see exactly the JSON bytes recorded in the trace.
   769	        actions = _plain([choice.action for choice in choices])
   770	        try:
   771	            with _silenced():
   772	                env.step(copy.deepcopy(actions))
   773	        except Exception as error:
   774	            if env.state[0].observation.step != step:
   775	                raise ParityGeneratorError(
   776	                    f"{spec.name}: failed step mutated the step counter"
   777	                ) from error
   778	            if all(choice.fallback is None for choice in choices):
   779	                raise ParityGeneratorError(
   780	                    f"{spec.name}: step {step} raised without a probe: {error!r}"
   781	                ) from error
   782	            message = f"{type(error).__name__}: {error}"
   783	            rejected_errors.append(message)
   784	            records.append(
   785	                {
   786	                    "type": "rejected",
   787	                    "from_step": step,
   788	                    "actions": actions,
   789	                    "python_error": message,
   790	                }
   791	            )
   792	            actions = _plain(
   793	                [
   794	                    choice.action if choice.fallback is None else choice.fallback
   795	                    for choice in choices
   796	                ]
   797	            )
   798	            with _silenced():
   799	                env.step(copy.deepcopy(actions))
   800	        if (step + 1) % turns_per_day == 0:
   801	            end_days.append(step // turns_per_day)
   802	        records.append(
   803	            {
   804	                "type": "transition",
   805	                "from_step": step,
   806	                "actions": actions,
   807	                "expected": _public(env),
   808	                "privates": _privates(env),
   809	                "statuses": [agent.status for agent in env.state],
   810	                "rewards": [agent.reward for agent in env.state],
   811	            }
   812	        )
   813	        transitions += 1
   814	    seed = env.info["seed"]
   815	    header = {
   816	        "type": "header",
   817	        "format": TRACE_FORMAT,
   818	        "source": {
   819	            "generator": GENERATOR,
   820	            "module_version": pin.version,
   821	            "engine_sha256": engine_sha256,
   822	            "name": spec.name,
   823	            "policies": list(spec.policies),
   824	            "policy_seed": spec.policy_seed,
   825	            "config_variant": spec.variant,
   826	            **({"probe": spec.probe} if spec.probe else {}),
   827	        },
   828	        "seed": seed,
   829	        "configuration": dict(sorted(config.items())),
   830	        "shop_schedule": list(env.state[0].observation.town["unlocked_shops"]),
   831	        "rng_schedule": [
   832	            {"day": day, "weed_rolls": _weed_rolls(seed, day)} for day in end_days
   833	        ],
   834	        "initial": initial,
   835	        "terminal_banks": [float(agent.reward) for agent in env.state],
   836	        "transitions": transitions,
   837	    }
   838	    return GameResult(
   839	        spec=spec,
   840	        records=[header, *records],
   841	        transitions=transitions,
   842	        rejected=len(rejected_errors),
   843	        seconds=time.perf_counter() - started,
   844	        rejected_errors=rejected_errors,
   845	    )
