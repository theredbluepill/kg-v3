   991	def probe_cases() -> list[tuple[str, Any]]:
   992	    """(label, seat-0 action at step 2) for every minimal input probe."""
   993	    units: list[Any] = [*MALFORMED_UNITS, *CRASH_UNITS, *DIVERGENT_CRASH_UNITS]
   994	    units += [["PICKUP", "WHEAT", q] for q in QUANTITY_FORMS]
   995	    units += [["PLACE", "WHEAT", q] for q in QUANTITY_FORMS]
   996	    for bad in UNHASHABLE:
   997	        units += [["PICKUP", bad], ["PLACE", bad], ["PLACE", bad, 1], ["PLANT", bad]]
   998	        units += [[bad], [bad, "WHEAT"]]
   999	    units += [["PLANT", 3], ["PLANT", None], ["PLANT", True], ["PLANT", "CARROT"]]
  1000	    cases: list[tuple[str, Any]] = [
  1001	        ("unit", {"farmer": cmd, "hands": [["PASS"]], "market": []}) for cmd in units
  1002	    ]
  1003	    for cmd in [["PLANT", ["WHEAT"]], [["NORTH"]], ["PLACE", ["WHEAT"]], ["PASS"]]:
  1004	        cases.append(
  1005	            ("hand", {"farmer": ["PASS"], "hands": [["PASS"], cmd], "market": []})
  1006	        )
  1007	    orders: list[Any] = [*MALFORMED_ORDERS, *UNKNOWN_ORDERS, *DIVERGENT_CRASH_ORDERS]
  1008	    for verb, item in [
  1009	        ("BUY_SEED", "WHEAT"),
  1010	        ("SELL", "WHEAT"),
  1011	        ("BUY_PRODUCT", "FERTILIZER"),
  1012	        ("BUY_ANIMAL", "GOOSE"),
  1013	    ]:
  1014	        orders += [[verb, item, q] for q in QUANTITY_FORMS]
  1015	        orders += [[verb, bad, 1] for bad in UNHASHABLE]
  1016	        orders += [[verb, ["WHEAT"], 0], [verb, item]]
  1017	    cases += [
  1018	        ("market", {"farmer": ["PASS"], "hands": [], "market": [order]})
  1019	        for order in orders
  1020	    ]
  1021	    cases += [("action", action) for action in MALFORMED_ACTIONS]
  1022	    return cases
