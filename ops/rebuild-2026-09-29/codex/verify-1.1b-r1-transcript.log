   205	fn assert_public(actual: &Value, expected: &Value, context: &str) {
   206	    if let Err(divergence) = compare_tree(actual, expected, "public", 0, None) {
   207	        panic!("{}: {context}: {divergence}", divergence.kind);
   208	    }
   209	}
   210	
   211	fn assert_private(actual: &Value, expected: &Value, context: &str) {
   212	    if let Err(divergence) = compare_tree(actual, expected, "private", 0, None) {
   213	        panic!("{}: {context}: {divergence}", divergence.kind);
   214	    }
   215	}
