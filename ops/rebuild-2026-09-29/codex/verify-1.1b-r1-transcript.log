  1081	def main(argv: list[str] | None = None) -> int:
  1082	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
  1083	    parser.add_argument("--out", type=Path, required=True)
  1084	    parser.add_argument(
  1085	        "--preset", choices=["committed", "sweep", "probes"], required=True
  1086	    )
  1087	    parser.add_argument("--games", type=int, default=40, help="sweep games")
  1088	    parser.add_argument("--base-seed", type=int, default=20260929, help="sweep seed")
  1089	    parser.add_argument("--manifest", action="store_true", help="write MANIFEST.json")
  1090	    parser.add_argument("--summary", type=Path, help="per-game JSON summary")
  1091	    parser.add_argument(
  1092	        "--include-known-divergences",
  1093	        action="store_true",
  1094	        help="let the edge policy emit the documented divergent inputs (D1/D2)",
  1095	    )
  1096	    args = parser.parse_args(argv)
  1097	    try:
  1098	        pin = pinned_engine()
  1099	        kaggle, module, digest = load_pinned_kaggle(pin)
  1100	    except ParityGeneratorError as error:
  1101	        print(f"refusing to generate: {error}", file=sys.stderr)
  1102	        return 2
  1103	    if args.preset == "committed":
  1104	        specs = committed_specs()
  1105	    elif args.preset == "sweep":
  1106	        specs = sweep_specs(args.games, args.base_seed)
  1107	    else:
  1108	        specs = probe_specs()
  1109	    args.out.mkdir(parents=True, exist_ok=True)
  1110	    results = []
  1111	    for spec in specs:
  1112	        result = play(spec, kaggle, module, pin, digest, args.include_known_divergences)
  1113	        path = args.out / f"{spec.name}.jsonl.gz"
  1114	        path.write_bytes(encode_trace(result.records))
  1115	        results.append(result)
  1116	        print(
  1117	            f"{path.name}: {result.transitions} transitions, {result.rejected} "
  1118	            f"rejected, {path.stat().st_size:,} B, {result.seconds:.1f}s",
  1119	            flush=True,
  1120	        )
  1121	    if args.manifest:
  1122	        write_manifest(args.out, results, pin)
  1123	    if args.summary:
  1124	        summary = [
  1125	            {
  1126	                "path": f"{r.spec.name}.jsonl.gz",
  1127	                "seed": r.spec.seed,
  1128	                "policies": list(r.spec.policies),
  1129	                "policy_seed": r.spec.policy_seed,
  1130	                "config_variant": r.spec.variant,
  1131	                **({"probe": r.spec.probe} if r.spec.probe else {}),
  1132	                "transitions": r.transitions,
  1133	                "rejected": r.rejected,
  1134	                "rejected_errors": sorted(set(r.rejected_errors)),
  1135	                "seconds": round(r.seconds, 3),
  1136	            }
  1137	            for r in results
  1138	        ]
  1139	        args.summary.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
