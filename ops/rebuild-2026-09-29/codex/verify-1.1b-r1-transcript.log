   626	def _builtin(name: str, module: ModuleType) -> Policy:
   627	    agent = module.agents[name]
   628	
   629	    def policy(
   630	        obs: dict[str, Any], config: dict[str, Any], rng: random.Random
   631	    ) -> Choice:
   632	        del config
   633	        if name == "random":
   634	            # random_agent seeds itself from OS entropy; lend it the policy RNG
   635	            # (only during the agent call; the interpreter's RNG is untouched).
   636	            shim = SimpleNamespace(Random=lambda *_: rng)
   637	            with mock.patch.object(module, "random", shim):
   638	                return Choice(agent(obs))
   639	        return Choice(agent(obs))
   640	
   641	    return policy
   642	
   643	
   644	def resolve_policy(
   645	    name: str, module: ModuleType, include_known_divergences: bool = False
   646	) -> Policy:
   647	    if name == "random":
   648	        return random_policy
   649	    if name == "edge":
   650	        return make_edge_policy(include_known_divergences)
   651	    if name.startswith("builtin:"):
   652	        builtin = name.removeprefix("builtin:")
   653	        if builtin not in module.agents:
   654	            raise ParityGeneratorError(
   655	                f"unknown built-in agent {builtin!r}; have {sorted(module.agents)}"
   656	            )
   657	        return _builtin(builtin, module)
   658	    raise ParityGeneratorError(f"unknown policy {name!r}")
