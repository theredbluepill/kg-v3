   576	fn edit_line(text: &str, line: usize, edit: impl FnOnce(&mut Value)) -> String {
   577	    let mut lines: Vec<String> = text.lines().map(str::to_string).collect();
   578	    let mut row: Value = serde_json::from_str(&lines[line]).unwrap();
   579	    edit(&mut row);
   580	    lines[line] = row.to_string();
   581	    lines.join("\n") + "\n"
   582	}
