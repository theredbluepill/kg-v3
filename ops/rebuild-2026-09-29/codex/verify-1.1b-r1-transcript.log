   323	fn snapshot_values(game: &Game) -> (Value, Value) {
   324	    let snapshot = game.snapshot();
   325	    (
   326	        serde_json::to_value(&snapshot.public).unwrap(),
   327	        serde_json::to_value(&snapshot.privates).unwrap(),
   328	    )
   329	}
   330	
   331	/// Replay one trace from its configuration and seed, stopping at the first
   332	/// divergence. Nothing from the expected states initializes the Rust game.
   333	fn replay_text(text: &str) -> Result<ReplayStats, Divergence> {
   334	    let mut lines = text.lines();
   335	    let raw = parse_line(lines.next().unwrap_or(""), 0)?;
   336	    let header_error = |field: &str, expected: &dyn ToString, actual: &Value| {
   337	        Divergence::new(0, None, "header", field).values(expected.to_string(), actual)
   338	    };
   339	    if raw["type"] != "header" {
   340	        return Err(header_error("type", &"header", &raw["type"]));
   341	    }
   342	    if raw["source"]["module_version"] != MODULE_VERSION {
   343	        return Err(header_error(
   344	            "source.module_version",
   345	            &MODULE_VERSION,
   346	            &raw["source"]["module_version"],
   347	        ));
   348	    }
   349	    if raw["source"]["engine_sha256"] != ENGINE_SHA256 {
   350	        return Err(header_error(
   351	            "source.engine_sha256",
   352	            &ENGINE_SHA256,
   353	            &raw["source"]["engine_sha256"],
   354	        ));
   355	    }
   356	    let header: TraceHeader = serde_json::from_value(raw.clone()).map_err(|error| {
   357	        Divergence::new(0, None, "header", "schema").values("TraceHeader", error)
   358	    })?;
   359	    let mut game =
   360	        Game::new_with_seed_decimal(header.configuration.clone(), &header.seed.to_string(), 2)
   361	            .map_err(|error| {
   362	                Divergence::new(0, None, "rust_error", "Game::new").values("Ok", error)
   363	            })?;
   364	    let initial = game.snapshot();
   365	    let (public, privates) = snapshot_values(&game);
   366	    compare_tree(&public, &raw["initial"]["public"], "public", 0, None)?;
   367	    compare_tree(&privates, &raw["initial"]["privates"], "private", 0, None)?;
   368	    if initial.statuses != ["ACTIVE", "ACTIVE"] || initial.rewards != [0.0, 0.0] || initial.done {
   369	        return Err(
   370	            Divergence::new(0, None, "initial", "statuses/rewards/done").values(
   371	                "ACTIVE, 0, not done",
   372	                format!("{:?}", (initial.statuses, initial.rewards, initial.done)),
   373	            ),
   374	        );
   375	    }
   376	
   377	    let mut stats = ReplayStats::default();
   378	    for (offset, line) in lines.enumerate() {
   379	        let index = offset + 1;
   380	        let row = parse_line(line, index)?;
   381	        let from_step = row["from_step"].as_u64().map(|step| step as usize);
   382	        let current = game.public_state().step;
   383	        if from_step != Some(current) {
   384	            return Err(Divergence::new(index, from_step, "format", "from_step")
   385	                .values(current, &row["from_step"]));
   386	        }
   387	        let Some(actions) = row["actions"].as_array() else {
   388	            return Err(Divergence::new(index, from_step, "format", "actions")
   389	                .values("array", &row["actions"]));
   390	        };
   391	        match row["type"].as_str() {
   392	            Some("rejected") => {
   393	                let before = snapshot_values(&game);
   394	                if game.step(actions).is_ok() {
   395	                    return Err(Divergence::new(index, from_step, "rust_accepted", "step")
   396	                        .values(format!("error ({})", row["python_error"]), "Ok"));
   397	                }
   398	                if snapshot_values(&game) != before {
   399	                    return Err(Divergence::new(index, from_step, "rust_mutated", "state")
   400	                        .values("unchanged after rejected step", "changed"));
   401	                }
   402	                stats.rejected += 1;
   403	            },
   404	            Some("transition") => {
   405	                if let Err(error) = game.step(actions) {
   406	                    return Err(
   407	                        Divergence::new(index, from_step, "rust_error", "step").values("Ok", error)
   408	                    );
   409	                }
   410	                stats.transitions += 1;
   411	                let actual = game.snapshot();
   412	                let (public, privates) = snapshot_values(&game);
   413	                compare_tree(&public, &row["expected"], "public", index, from_step)?;
   414	                compare_tree(&privates, &row["privates"], "private", index, from_step)?;
   415	                let statuses: Vec<String> = serde_json::from_value(row["statuses"].clone())
   416	                    .map_err(|e| {
   417	                        Divergence::new(index, from_step, "format", "statuses").values("strings", e)
   418	                    })?;
   419	                let rewards: Vec<f64> =
   420	                    serde_json::from_value(row["rewards"].clone()).map_err(|e| {
   421	                        Divergence::new(index, from_step, "format", "rewards").values("numbers", e)
   422	                    })?;
   423	                if actual.statuses != statuses {
   424	                    return Err(Divergence::new(index, from_step, "statuses", "statuses")
   425	                        .values(format!("{statuses:?}"), format!("{:?}", actual.statuses)));
   426	                }
   427	                if actual.rewards != rewards {
   428	                    return Err(Divergence::new(index, from_step, "rewards", "rewards")
   429	                        .values(format!("{rewards:?}"), format!("{:?}", actual.rewards)));
   430	                }
   431	                let last = stats.transitions == header.transitions;
   432	                if actual.done != last {
   433	                    return Err(
   434	                        Divergence::new(index, from_step, "done", "done").values(last, actual.done)
   435	                    );
   436	                }
   437	                if actual.public.step != current + 1 {
   438	                    return Err(Divergence::new(index, from_step, "step", "public.step")
   439	                        .values(current + 1, actual.public.step));
   440	                }
   441	            },
   442	            _ => {
   443	                return Err(Divergence::new(index, from_step, "format", "type")
   444	                    .values("transition or rejected", &row["type"]));
   445	            },
   446	        }
   447	    }
   448	    if stats.transitions != header.transitions {
   449	        return Err(Divergence::new(0, None, "format", "transitions")
   450	            .values(header.transitions, stats.transitions));
   451	    }
   452	    let banks = game.terminal_banks().unwrap_or(&[]);
   453	    if banks != header.terminal_banks.as_slice() {
   454	        return Err(Divergence::new(0, None, "terminal_banks", "terminal_banks")
   455	            .values(format!("{:?}", header.terminal_banks), format!("{banks:?}")));
   456	    }
   457	    Ok(stats)
   458	}
