    76	def classify(actions: list[Any]) -> str | None:
    77	    """Name the documented divergence class that a step's inputs belong to.
    78	
    79	    D1: a non-ASCII Unicode decimal digit string (Python int() accepts it).
    80	    D2: an unhashable verb or item that reaches one of Python's dict lookups:
    81	    a unit verb, a PLANT/PICKUP/PLACE item, or a BUY_SEED/BUY_ANIMAL item.
    82	    """
    83	    for text in _strings(actions):
    84	        if any(not c.isascii() for c in text) and text.strip().isdecimal():
    85	            return "D1"
    86	    for action in actions:
    87	        units, orders = _commands(action)
    88	        for command in units:
    89	            if not isinstance(command, list) or not command:
    90	                continue
    91	            if _unhashable(command[0]):
    92	                return "D2"
    93	            if (
    94	                command[0] in ("PLANT", "PICKUP", "PLACE")
    95	                and len(command) >= 2
    96	                and _unhashable(command[1])
    97	            ):
    98	                return "D2"
    99	        for order in orders:
   100	            if (
   101	                isinstance(order, list)
   102	                and len(order) >= 3
   103	                and order[0] in ("BUY_SEED", "BUY_ANIMAL")
   104	                and _unhashable(order[1])
   105	            ):
   106	                return "D2"
   107	    return None
