   695	def _public(env: Any) -> dict[str, Any]:
   696	    obs = env.state[0].observation
   697	    return {
   698	        "step": obs.step,
   699	        "day": obs.day,
   700	        "hour": obs.hour,
   701	        "farms": _plain(obs.farms),
   702	        "market": _plain(obs.market),
   703	        "town": _plain(obs.town),
   704	    }
