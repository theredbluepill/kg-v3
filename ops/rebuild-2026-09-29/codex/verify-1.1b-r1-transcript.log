   710	
   711	def _observations(env: Any) -> list[dict[str, Any]]:
   712	    public = env.state[0].observation
   713	    return [
   714	        {
   715	            "player": index,
   716	            "step": public.step,
   717	            "day": public.day,
   718	            "hour": public.hour,
   719	            "farms": _plain(public.farms),
   720	            "market": _plain(public.market),
   721	            "town": _plain(public.town),
   722	            "private": _plain(agent.observation.private),
   723	        }
   724	        for index, agent in enumerate(env.state)
   725	    ]
