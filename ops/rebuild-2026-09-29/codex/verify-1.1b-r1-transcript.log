   525	def make_edge_policy(include_known_divergences: bool = False) -> Policy:
   526	    """Build the edge-case policy, optionally with the known-divergent inputs."""
   527	    quantities = ODD_QUANTITIES + (
   528	        DIVERGENT_QUANTITIES if include_known_divergences else []
   529	    )
   530	    crash_units = CRASH_UNITS + (
   531	        DIVERGENT_CRASH_UNITS if include_known_divergences else []
   532	    )
   533	    crash_orders = DIVERGENT_CRASH_ORDERS if include_known_divergences else []
   534	
   535	    def policy(
   536	        obs: dict[str, Any], config: dict[str, Any], rng: random.Random
   537	    ) -> Choice:
   538	        return _edge_choice(obs, config, rng, quantities, crash_units, crash_orders)
   539	
   540	    return policy
