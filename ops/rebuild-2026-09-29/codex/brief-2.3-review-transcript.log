     1	"""Kaggriculture model on Isaiah's ``StatelessTransformerV1`` layer topology.
     2	
     3	The encoder reuses Isaiah's classes unchanged: ``ObservationInputStem`` per
     4	entity group, separate learned per-role tokens, ``TransformerBlock`` trunk with a
     5	final ``LayerNorm``, his flash-packing path, compile hook and initialization.
     6	Only the game I/O differs: stem input widths (float channels plus one-hot
     7	categorical fields from ``docs/kaggriculture-contract.md``) and, from Task 2.3,
     8	the grammar action heads. Each seat row is encoded independently.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import math
    14	from collections.abc import Callable
    15	from dataclasses import dataclass
    16	from typing import Literal
    17	
    18	import torch
    19	import torch.nn.functional as F
    20	from pydantic import Field
    21	from torch import nn
    22	
    23	from owl.config import BaseConfig
    24	from owl.kaggriculture import types as kt
    25	from owl.model.actor.common import OutputProjectionMLP
    26	from owl.model.attn import use_flash_attn
    27	from owl.model.base import (
    28	    BaseModelAPI,
    29	    InputLayer,
    30	    ModelEvaluation,
    31	    ModelHiddenState,
    32	    ModelOutput,
    33	)
    34	from owl.model.stateless_transformer_v1 import (
    35	    _CRITIC_HEAD_INIT_GAIN,
    36	    ObservationInputStem,
    37	    PackedSequence,
    38	    StatelessTransformerV1Config,
    39	    TransformerBlock,
    40	    _expand_tokens,
    41	    _init_input_layer,
    42	    _init_linear,
    43	    _init_module,
    44	    _requires_flash_attn,
    45	    pack_sequence,
    46	    unpack_sequence,
    47	)
    48	
    49	KAGGRICULTURE_TRANSFORMER: Literal["kaggriculture_transformer"] = (
    50	    "kaggriculture_transformer"
    51	)
    52	
    53	# Compiled GEMM templates in torch 2.9 overflow 32-bit offsets once
    54	# rows x inner dim reaches 2**31 (cookbook reference
    55	# compiled-gemm-template-overflows-above-2-21-rows).
    56	_GEMM_ELEMENT_LIMIT = 2**31
    57	_OVERFLOW_REFERENCE = (
    58	    "cookbook/references/compiled-gemm-template-overflows-above-2-21-rows.md"
    59	)
    60	
    61	_TILE_STEM_WIDTH = (
    62	    kt.TILE_FLOAT_CHANNELS
    63	    + len(kt.TILE_KINDS)
    64	    + len(kt.CROPS)
    65	    + len(kt.ANIMALS)
    66	    + kt.CELLS
    67	    + len(kt.TILE_ROLES)
    68	)
    69	_ACTOR_STEM_WIDTH = (
    70	    kt.ACTOR_FLOAT_CHANNELS + kt.MAX_ACTORS + kt.CELLS + len(kt.ACTOR_ROLES)
    71	)
    72	_SHOP_STEM_WIDTH = len(kt.SHOP_TYPES) + kt.SHOP_SLOTS
    73	_MARKET_STEM_WIDTH = kt.MARKET_FLOAT_CHANNELS + kt.PRODUCT_COUNT
    74	_ENTITY_TOKENS = kt.ACTOR_SLOTS + kt.TILES + kt.SHOP_SLOTS + kt.PRODUCT_COUNT
    75	_PLAN_TOKENS = 1
    76	
    77	
    78	class KaggricultureTransformerConfig(BaseConfig):
    79	    model_arch: Literal["kaggriculture_transformer"] = KAGGRICULTURE_TRANSFORMER
    80	    embed_dim: int = Field(default=256, ge=1)
    81	    depth: int = Field(default=8, ge=1)
    82	    n_heads: int = Field(default=8, ge=1)
    83	    mlp_ratio: float = Field(default=2.0, gt=0.0)
    84	    activation: Literal["gelu", "silu"] = "gelu"
    85	    n_scratch_tokens: int = Field(default=4, ge=0)
    86	    force_flash_attn: bool = False
    87	
    88	    def trunk_config(self) -> StatelessTransformerV1Config:
    89	        """Isaiah's typed trunk config built from the shared fields."""
    90	        return StatelessTransformerV1Config(
    91	            embed_dim=self.embed_dim,
    92	            depth=self.depth,
    93	            n_heads=self.n_heads,
    94	            mlp_ratio=self.mlp_ratio,
    95	            activation=self.activation,
    96	            n_scratch_tokens=self.n_scratch_tokens,
    97	            force_flash_attn=self.force_flash_attn,
    98	        )
    99	
   100	
   101	@dataclass(frozen=True)
   102	class KaggricultureEncoded:
   103	    hidden: torch.Tensor
   104	    token_mask: torch.Tensor
   105	    own_actor_hidden: torch.Tensor
   106	    player_hidden: torch.Tensor
   107	    global_hidden: torch.Tensor
   108	    board_hidden: torch.Tensor
   109	    actor_plan_hidden: torch.Tensor
   110	    critic_value_hidden: torch.Tensor
   111	
   112	
   113	def sequence_length(config: KaggricultureTransformerConfig) -> int:
   114	    """Tokens per seat row: entities, players, global, board, plan, critic."""
   115	    return (
   116	        _ENTITY_TOKENS
   117	        + kt.PLAYERS
   118	        + 1
   119	        + config.n_scratch_tokens
   120	        + _PLAN_TOKENS
   121	        + kt.PLAYERS
   122	    )
   123	
   124	
   125	def gemm_kmax(config: KaggricultureTransformerConfig) -> int:
   126	    """Largest GEMM inner dim in a block: D->D attention, D->H->D MLP."""
   127	    return max(config.embed_dim, int(config.embed_dim * config.mlp_ratio))
   128	
   129	
   130	def rows_per_chunk(*, tokens: int, kmax: int) -> int:
   131	    """Largest padded row count whose GEMMs stay below the overflow limit."""
   132	    return (_GEMM_ELEMENT_LIMIT - 1) // (tokens * kmax)
   133	
   134	
   135	def _one_hot(index: torch.Tensor, classes: int, like: torch.Tensor) -> torch.Tensor:
   136	    return F.one_hot(index, classes).to(dtype=like.dtype)
   137	
   138	
   139	class KaggricultureTransformer(
   140	    BaseModelAPI[
   141	        kt.KaggricultureObsBatch,
   142	        kt.KaggricultureActions,
   143	        kt.KaggricultureActionConfig,
   144	    ]
   145	):
   146	    def __init__(
   147	        self,
   148	        config: KaggricultureTransformerConfig,
   149	        *,
   150	        obs_spec: kt.KaggricultureObsConfig,
   151	        action_spec: kt.KaggricultureActionConfig,
   152	    ) -> None:
   153	        super().__init__()
   154	        self.config = config
   155	        self.obs_spec = obs_spec
   156	        self.action_spec = action_spec
   157	        trunk = config.trunk_config()
   158	        width = config.embed_dim
   159	        self.tile_proj = ObservationInputStem(_TILE_STEM_WIDTH, trunk)
   160	        self.actor_proj = ObservationInputStem(_ACTOR_STEM_WIDTH, trunk)
   161	        self.shop_proj = ObservationInputStem(_SHOP_STEM_WIDTH, trunk)
   162	        self.market_proj = ObservationInputStem(_MARKET_STEM_WIDTH, trunk)
   163	        self.player_feature_proj = ObservationInputStem(
   164	            kt.PLAYER_FEATURE_CHANNELS, trunk
   165	        )
   166	        self.global_proj = ObservationInputStem(kt.GLOBAL_FEATURE_CHANNELS, trunk)
   167	        self.player_tokens = nn.Parameter(torch.empty(kt.PLAYERS, width))
   168	        self.board_tokens = nn.Parameter(torch.empty(config.n_scratch_tokens, width))
   169	        self.actor_plan_tokens = nn.Parameter(torch.empty(_PLAN_TOKENS, width))
   170	        self.critic_value_tokens = nn.Parameter(torch.empty(kt.PLAYERS, width))
   171	        self.blocks = nn.ModuleList(
   172	            TransformerBlock(trunk) for _ in range(config.depth)
   173	        )
   174	        self.final_norm = nn.LayerNorm(width)
   175	        # Isaiah's critic: one logit per critic-value token (self, opponent).
   176	        self.critic_head = OutputProjectionMLP(trunk, 1)
   177	        self._compiled_transformer_trunk: (
   178	            Callable[
   179	                [torch.Tensor, torch.Tensor | None, PackedSequence | None],
   180	                torch.Tensor,
   181	            ]
   182	            | None
   183	        ) = None
   184	        self.reset_parameters()
   185	
   186	    # --- Isaiah's parameter conventions ---------------------------------------
   187	
   188	    def reset_parameters(self) -> None:
   189	        self.apply(_init_module)
   190	        for layer in self.get_input_layers():
   191	            _init_input_layer(layer)
   192	        residual_gain = 1.0 / math.sqrt(2.0 * self.config.depth)
   193	        for module in self.blocks:
   194	            assert isinstance(module, TransformerBlock)
   195	            _init_linear(module.attn.out, gain=residual_gain)
   196	            _init_linear(module.mlp.down, gain=residual_gain)
   197	        _init_linear(self.critic_head.out, gain=_CRITIC_HEAD_INIT_GAIN)
   198	
   199	    def get_input_layers(self) -> tuple[InputLayer, ...]:
   200	        return (
   201	            self.tile_proj.input,
   202	            self.actor_proj.input,
   203	            self.shop_proj.input,
   204	            self.market_proj.input,
   205	            self.player_feature_proj.input,
   206	            self.global_proj.input,
   207	            self.player_tokens,
   208	            self.board_tokens,
   209	            self.actor_plan_tokens,
   210	            self.critic_value_tokens,
   211	        )
   212	
   213	    def get_output_layers(self) -> tuple[nn.Module, ...]:
   214	        # Action-head output layers join with Task 2.3.
   215	        return (self.critic_head.out,)
   216	
   217	    # --- encoder ---------------------------------------------------------------
   218	
   219	    def count_non_masked_tokens(self, obs: kt.KaggricultureObsBatch) -> torch.Tensor:
   220	        rows = obs.still_playing.numel()
   221	        playing = obs.still_playing.sum(dtype=torch.int64)
   222	        always_on = rows * (
   223	            kt.TILES + kt.PRODUCT_COUNT + 1 + self.config.n_scratch_tokens
   224	        )
   225	        return (
   226	            obs.actor_mask.sum(dtype=torch.int64)
   227	            + obs.shop_mask.sum(dtype=torch.int64)
   228	            + (kt.PLAYERS + _PLAN_TOKENS + kt.PLAYERS) * playing
   229	            + always_on
   230	        )

