   270	pub fn plan(actors: u32, limit: u32, hire_limit: u32) -> Result<Vec<u8>, String> {
   329	pub fn decode(actors: u32, limit: u32, hire_limit: u32, frames: &[i16]) -> Result<Value, String> {
   330	    let shape = Shape::new(actors, limit, hire_limit)?;
   331	    shape.validate_length(frames.len())?;
   332	    let mut state = Some(State::default());
   333	    for (index, &value) in frames.iter().enumerate() {
   334	        let current = state.ok_or("Myolie sampler frame after STOP")?;
   335	        if value < 0 || !current.allows(value as usize, shape) {
   336	            return Err(format!(
   337	                "Myolie sampler frame {} slot {} token {value} violates syntax mask",
   338	                index / SLOTS,
   339	                current.slot
   340	            ));
   341	        }
   342	        state = current.advance(value as usize);
   343	    }
   344	    if state.is_some() {
   345	        return Err("Myolie sampler program lacks distinct final STOP".into());
   346	    }
   347	    let mut units = Vec::with_capacity(actors as usize);
   348	    let mut market = Vec::new();
   349	    for frame in frames.chunks_exact(SLOTS) {
   350	        let kind = frame[1] as usize;
   351	        if kind != 0 {
   352	            let mut command = vec![Value::String(UNIT_NAMES[kind].into())];
   353	            if matches!(kind, 6..=8) {
   354	                command.push(Value::String(ITEMS[frame[3] as usize].into()));
   355	            }
   356	            if frame[4] == 1 {
   357	                command.push(Value::from(i64::from(frame[5]) * 32 + i64::from(frame[6])));
   358	            }
   359	            units.push(Value::Array(command));
   360	        } else {
   361	            let kind = frame[7] as usize;
   362	            if kind == 0 {
   363	                continue;
   364	            }
   365	            let mut command = if kind == 7 {
   366	                Vec::new()
   367	            } else {
   368	                vec![Value::String(MARKET_NAMES[kind].into())]
   369	            };
   370	            if matches!(kind, 3..=6) {
   371	                command.push(Value::String(ITEMS[frame[8] as usize].into()));
   372	                command.push(Value::from(i64::from(frame[9]) * 32 + i64::from(frame[10])));
   373	            }
   374	            market.push(Value::Array(command));
   375	        }
   376	    }
   377	    let mut raw = Map::new();
   378	    raw.insert("farmer".into(), units.remove(0));
   379	    raw.insert("hands".into(), Value::Array(units));
   380	    raw.insert("market".into(), Value::Array(market));
   381	    Ok(Value::Object(raw))
   382	}
