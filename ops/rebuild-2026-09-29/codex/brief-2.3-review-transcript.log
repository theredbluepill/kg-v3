    97	def binary_kl_from_logits(
    98	    teacher_logits: torch.Tensor,
    99	    student_logits: torch.Tensor,
   100	) -> torch.Tensor:
   101	    teacher_logits = teacher_logits.float()
   102	    student_logits = student_logits.float()
