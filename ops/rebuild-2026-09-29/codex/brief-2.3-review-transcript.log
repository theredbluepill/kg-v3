   113	def categorical_kl_from_logits(
   114	    teacher_logits: torch.Tensor,
   115	    student_logits: torch.Tensor,
   116	    mask: torch.Tensor,
   117	) -> torch.Tensor:
   118	    teacher_log_prob = F.log_softmax(teacher_logits.float(), dim=-1)
   119	    student_log_prob = F.log_softmax(student_logits.float(), dim=-1)
   120	    teacher_prob = teacher_log_prob.exp()
   121	    kl = teacher_prob * (teacher_log_prob - student_log_prob)
   122	    return kl.masked_fill(~mask, 0.0).sum(dim=-1)
