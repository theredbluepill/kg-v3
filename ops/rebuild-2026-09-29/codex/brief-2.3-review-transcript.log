   104	    teacher_log_prob = F.logsigmoid(teacher_logits)
   105	    teacher_log_not_prob = F.logsigmoid(-teacher_logits)
   106	    student_log_prob = F.logsigmoid(student_logits)
   107	    student_log_not_prob = F.logsigmoid(-student_logits)
   108	    return teacher_prob * (teacher_log_prob - student_log_prob) + (
   109	        1.0 - teacher_prob
   110	    ) * (teacher_log_not_prob - student_log_not_prob)
