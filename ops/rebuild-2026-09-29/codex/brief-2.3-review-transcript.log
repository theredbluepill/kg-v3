    94	def test_parallel_hire_correction_exact_distribution_with_stop_and_empty() -> None:
    95	    """Enumerate the Gumbel race law, not a Monte Carlo tolerance or model copy.
    96	
    97	    For each position, P(raw=k!=HIRE, nonhire=k)=p[k], while
    98	    P(raw=HIRE, nonhire=k)=p[HIRE]*p[k]/(1-p[HIRE]). These pairs enumerate the
    99	    coupled maxima of the same independent Gumbel scores. Compare all resulting
   100	    canonical queues to direct sequential masked categorical probabilities.
   101	    """
   102	    import itertools
   103	    from collections import defaultdict
   104	
   105	    probabilities = np.array(
   106	        [[1, 5, 2, 3, 4, 2, 1, 6], [5, 7, 1, 3, 2, 4, 6, 1], [2, 6, 4, 1, 5, 3, 7, 2]],
   107	        dtype=np.float64,
   108	    )
   109	    probabilities /= probabilities.sum(axis=1, keepdims=True)
   110	    races = [
   111	        [(kind, kind, row[kind]) for kind in range(8) if kind != 1]
   112	        + [
   113	            (1, kind, row[1] * row[kind] / (1 - row[1]))
   114	            for kind in range(8)
   115	            if kind != 1
   116	        ]
   117	        for row in probabilities
   118	    ]
   119	    # Budgets include no capacity (also hire_limit<actors), partial capacity and
   120	    # a capacity exceeding the three available market positions.
   121	    for budget in (0, 1, 2, 3, 10):
   122	        parallel: dict[tuple[int, ...], float] = defaultdict(float)
   123	        for outcomes in itertools.product(*races):
   124	            hires = 0
   125	            queue = []
   126	            for raw, nonhire, _ in outcomes:
   127	                choice = raw if hires < budget else nonhire
   128	                hires += raw == 1  # deliberately raw, as in exclusive cumsum
   129	                if choice == 0:
   130	                    break
   131	                queue.append(choice)
   132	            parallel[tuple(queue)] += float(
   133	                np.prod([outcome[2] for outcome in outcomes])
   134	            )
   135	        sequential: dict[tuple[int, ...], float] = defaultdict(float)
   136	
   137	        def visit(
   138	            queue: tuple[int, ...],
   139	            mass: float,
   140	            cap: int,
   141	            distribution: dict[tuple[int, ...], float],
   142	        ) -> None:
   143	            if len(queue) == len(probabilities):
   144	                distribution[queue] += mass
   145	                return
   146	            row = probabilities[len(queue)].copy()
   147	            if queue.count(1) >= cap:
   148	                row[1] = 0
   149	                row /= row.sum()
   150	            for kind, probability in enumerate(row):
   151	                if probability == 0:
   152	                    continue
   153	                if kind == 0:
   154	                    distribution[queue] += mass * probability
   155	                else:
   156	                    visit((*queue, kind), mass * probability, cap, distribution)
   157	
   158	        visit((), 1.0, budget, sequential)
   159	        assert parallel.keys() == sequential.keys()
   160	        assert sum(parallel.values()) == pytest.approx(1.0, abs=1e-12)
   161	        assert max(abs(parallel[key] - sequential[key]) for key in parallel) < 1e-12
   162	        assert (7, 7, 7) in parallel  # EMPTY remains an explicit order.
   163	        assert all(queue.count(1) <= budget for queue in parallel)
