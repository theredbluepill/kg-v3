# Local CPU functional config (plan Task 3.5): the kaggriculture_2rank recipe
# shrunk to 2 envs and a tiny model so one iteration runs on a laptop CPU. Not a
# training recipe and not a throughput measurement: FP32, no compilation, no
# replay export. Optimizer, schedule, PPO coefficients and teacher settings are
# scaling_6m's; 2 envs with segments_per_minibatch 1 give 2 optimizer steps/iter.
# Loads through FullConfig; run_ppo checks its GEMM workload, then stops until the
# Kaggriculture env binding (Task 1.4) and trainer game seam (Task 3.1) land.
env:
  n_envs: 2
  obs_spec:
    obs_spec: kaggriculture
    schema_version: 3
  action_spec:
    action_spec: kaggriculture
    hire_limit: 241
  reward_mode: win_loss
  reward_shaping:
    econ_shaping: 0.2
    econ_starvation_weight: 4.0
    econ_drought_weight: 1.0
    econ_cap: 0.25
    econ_ineffective_weight: 0.0
  pin_memory: false
  native_threads: 1

model: kaggriculture_cpu

optimizer:
  optimizer: muon
  adamw_lr: 0.0001
  adamw_eps: 1.0e-05
  weight_decay: 0.0
  muon_lr: 0.002
  muon_weight_decay: 0.01
  muon_momentum: 0.95
  lr_schedule:
    schedule: linear_warmup_cosine_decay
    warmup_steps: 1000
