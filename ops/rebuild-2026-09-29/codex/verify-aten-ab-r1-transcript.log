   142	            _, layout = ir.as_storage_and_layout(t, freeze=False)
   143	            return isinstance(layout, ir.FlexibleLayout)
   144	
   145	        def is_preferred_layout_as_bmm_input(sizes, strides):
   146	            # contiguous on one of the last two dims
   147	            return (
   148	                strides[-1] == 1 and (sizes[-2] == 1 or strides[-2] >= sizes[-1])
   149	            ) or (strides[-2] == 1 and (sizes[-1] == 1 or strides[-1] >= sizes[-2]))
   150	
   151	        # Make the input of bmm contiguous
   152	        # if it is not contiguous on either of the last two dims,
   153	        # because bmm cpu implementation would do contiguous() if not.
   154	        # This is to avoid additional copies in bmm.
