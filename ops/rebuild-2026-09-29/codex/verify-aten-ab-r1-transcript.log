   136	def main() -> int:
   137	    t0 = time.monotonic()
   138	    deadline = t0 + BUDGET_S
   139	    log_fh = open(RUN / "driver.jsonl", "a")
   140	
   141	    def log(rec: dict) -> None:
   142	        rec = {"utc": now(), "t": round(time.monotonic() - t0, 1), **rec}
   143	        log_fh.write(json.dumps(rec) + "\n")
   144	        log_fh.flush()
   145	        print(json.dumps(rec), flush=True)
   146	
   147	    log({"status": "driver_start", "budget_s": BUDGET_S})
   148	    for name, role, backends, cache, script, args in STAGES:
   149	        remaining = deadline - time.monotonic()
   150	        if remaining < MIN_START_S:
   151	            log({"stage": name, "status": "stop_budget", "remaining_s": round(remaining)})
   152	            return 4
   153	        env = {k: v for k, v in os.environ.items()
   154	               if k != "TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS"}
   155	        env.update(CUDA_VISIBLE_DEVICES="0", PYTHONUNBUFFERED="1",
   156	                   TORCHINDUCTOR_CACHE_DIR=str(RUN / "inductor_cache" / cache),
   157	                   TRITON_CACHE_DIR=str(RUN / "triton_cache" / cache),
   158	                   TORCH_LOGS="recompiles")
   159	        record = RUN / f"{name}.backend.json"
   160	        if role == "bench":
   161	            outdir = RUN / f"bench_{backends.lower()}"
   162	            outdir.mkdir(exist_ok=True)
   163	            sargs = [*args, "--out", str(outdir)]
   164	        else:
   165	            out = RUN / f"{name}.jsonl"
   166	            sargs = [*args, "--out", str(out)]
   167	        cmd = [PY, WRAP, "--backends", backends, "--record", str(record), "--",
   168	               str(RUN / script), *sargs]
   169	        log({"stage": name, "role": role, "backends": backends, "cmd": cmd,
   170	             "status": "launch", "timeout_s": round(remaining)})
   171	        with open(RUN / f"{name}.log", "w") as fh:
   172	            try:
   173	                rc: int | str = subprocess.run(
   174	                    cmd, cwd=ROOT, env=env, stdout=fh, stderr=subprocess.STDOUT,
   175	                    timeout=remaining).returncode
   176	            except subprocess.TimeoutExpired:
   177	                rc = "timeout"
   178	        rec_ok = []
   179	        if record.exists():
   180	            br = json.loads(record.read_text())
   181	            want = "ATEN" if backends == "ATEN" else "ATEN,TRITON,CPP"
   182	            if br.get("value_at_start") != want or br.get("value_at_end") != want:
   183	                rec_ok.append(f"backend record {br.get('value_at_start')}/"
   184	                              f"{br.get('value_at_end')} != {want}")
   185	        else:
   186	            rec_ok.append("no backend record")
   187	        if role == "bench":
   188	            errs = judge_bench(RUN / f"bench_{backends.lower()}", args[1])
   189	            n_done = None
   190	        else:
   191	            n_points = len(args[-1].replace(",", ";").split(";"))
   192	            errs, n_done = judge_probe(script, RUN / f"{name}.jsonl", n_points)
   193	        if rc == "timeout":
   194	            log({"stage": name, "status": "stop_budget_timeout"})
   195	            return 4
   196	        if role == "control":
   197	            reproduced = rc != 0 or bool(errs)
   198	            log({"stage": name, "role": role, "rc": rc, "targets_done": n_done,
   199	                 "findings": errs + rec_ok,
   200	                 "status": "control_reproduced" if reproduced
   201	                 else "control_not_reproduced"})
   202	            continue
   203	        errs = rec_ok + errs
   204	        if rc != 0:
   205	            errs.insert(0, f"rc={rc}")
   206	        if errs:
   207	            log({"stage": name, "role": role, "rc": rc, "errors": errs,
   208	                 "status": "FAIL_stop"})
   209	            return 3
   210	        log({"stage": name, "role": role, "rc": rc, "targets_done": n_done,
   211	             "status": "pass"})
   212	    log({"status": "driver_done", "elapsed_s": round(time.monotonic() - t0, 1)})
   213	    return 0
