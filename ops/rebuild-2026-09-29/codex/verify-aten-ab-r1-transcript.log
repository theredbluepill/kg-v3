     4	.py files: wrappers (files with ``def call(``), extern GEMM calls
     5	(``extern_kernels.<op containing mm>(``), Triton template kernel definitions
     6	and launches (``triton_tem_``), and any text naming decompose-K, persistent /
     7	TMA matmul templates or the contiguous-subgraph mm templates. Pure text
     8	parsing; complements analyze_kernels.py revision 2 (unchanged). Writes
     9	RUN/template_census.json and prints a table.
    10	
    11	Usage: python check_templates.py RUN_DIR
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import json
    17	import re
    18	import sys
    19	from pathlib import Path
    20	
    21	EXTERN_MM = re.compile(r"extern_kernels\.(\w*mm\w*)\(")
    22	TEM_DEF = re.compile(r"^def (triton_tem_\w+)\(", re.MULTILINE)
    23	TEM_RUN = re.compile(r"(triton_tem_\w+)\.run\(")
    24	MARKERS = {
    25	    "decompose_k": re.compile(r"decompose_k", re.IGNORECASE),
    26	    "persistent_tma": re.compile(r"persistent_tma|tma_descriptor|make_tensor_descriptor|experimental_descriptor"),
    27	    "contiguous_subgraph": re.compile(r"contiguous_(mm|addmm)|mm_contiguous|addmm_contiguous"),
    28	    "triton_mm_kernel_name": re.compile(r"\btriton_(mm|addmm|bmm)_\d+"),
    29	}
    30	
    31	
    32	def census(case_dir: Path) -> dict:
    33	    out: dict = {"files": 0, "wrappers": 0, "extern_mm_calls": {},
    34	                 "triton_tem_defs": 0, "triton_tem_launches": 0,
    35	                 "marker_files": {k: [] for k in MARKERS}}
    36	    for f in sorted(case_dir.rglob("*.py")):
    37	        text = f.read_text(errors="replace")
    38	        out["files"] += 1
    39	        rel = str(f.relative_to(case_dir))
    40	        if "def call(" in text:
    41	            out["wrappers"] += 1
    42	            for op in EXTERN_MM.findall(text):
    43	                out["extern_mm_calls"][op] = out["extern_mm_calls"].get(op, 0) + 1
    44	            out["triton_tem_launches"] += len(TEM_RUN.findall(text))
    45	        out["triton_tem_defs"] += len(TEM_DEF.findall(text))
    46	        for name, pat in MARKERS.items():
    47	            if pat.search(text):
    48	                out["marker_files"][name].append(rel)
    49	    return out
    50	
    51	
    52	def main() -> None:
    53	    run = Path(sys.argv[1]).resolve()
    54	    report = {d.name: census(d) for d in sorted((run / "inductor_cache").iterdir())
    55	              if d.is_dir()}
    56	    (run / "template_census.json").write_text(json.dumps(report, indent=1) + "\n")
    57	    for case, c in report.items():
    58	        markers = {k: len(v) for k, v in c["marker_files"].items()}
    59	        print(f"{case}: files={c['files']} wrappers={c['wrappers']} "
    60	              f"extern_mm={c['extern_mm_calls']} tem_defs={c['triton_tem_defs']} "
    61	              f"tem_launches={c['triton_tem_launches']} marker_files={markers}")
    62	
    63	
    64	if __name__ == "__main__":
    65	    main()
     1	"""Run a probe/bench script with an explicit Inductor GEMM-backend setting.
     2	
     3	Usage: python gemm_backend_wrap.py --backends {default,ATEN} --record R.json
     4	       -- SCRIPT [ARGS...]
     5	
     6	``default`` leaves torch._inductor.config.max_autotune_gemm_backends untouched
     7	(torch 2.9.0 default "ATEN,TRITON,CPP"); ``ATEN`` sets it to "ATEN" before any
     8	compile. The value is recorded before and after the script runs (R.json), and
     9	the TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS env var must be unset so the
    10	setting comes only from this wrapper. The script runs in this process via
    11	runpy with run_name="__main__" and its own argv.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import json
    18	import os
    19	import runpy
    20	import sys
    21	import time
    22	
    23	import torch
    24	import torch._inductor.config as inductor_config
    25	
    26	
    27	def main() -> None:
    28	    argv = sys.argv[1:]
    29	    if "--" not in argv:
    30	        raise SystemExit("usage: gemm_backend_wrap.py --backends B --record R -- SCRIPT ...")
    31	    split = argv.index("--")
    32	    ap = argparse.ArgumentParser()
    33	    ap.add_argument("--backends", choices=("default", "ATEN"), required=True)
    34	    ap.add_argument("--record", required=True)
    35	    args = ap.parse_args(argv[:split])
    36	    script, *script_args = argv[split + 1:]
    37	    if "TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS" in os.environ:
    38	        raise SystemExit("TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS must be unset")
    39	    before = inductor_config.max_autotune_gemm_backends
    40	    if args.backends == "ATEN":
    41	        inductor_config.max_autotune_gemm_backends = "ATEN"
    42	    rec = {"requested": args.backends, "value_before_set": before,
    43	           "value_at_start": inductor_config.max_autotune_gemm_backends,
    44	           "script": script, "script_args": script_args,
    45	           "torch": torch.__version__, "torch_git": torch.version.git_version,
    46	           "start_unix": time.time()}
    47	    with open(args.record, "w") as fh:
    48	        json.dump(rec, fh, indent=1)
    49	    sys.argv = [script, *script_args]
    50	    try:
    51	        runpy.run_path(script, run_name="__main__")
    52	    finally:
    53	        rec["value_at_end"] = inductor_config.max_autotune_gemm_backends
    54	        rec["end_unix"] = time.time()
    55	        with open(args.record, "w") as fh:
    56	            json.dump(rec, fh, indent=1)
    57	
    58	
    59	if __name__ == "__main__":
    60	    main()
