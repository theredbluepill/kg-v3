    12	gpu0_idle() {
    13	  local apps util
    14	  apps=$(nvidia-smi -i 0 --query-compute-apps=pid,process_name,used_memory --format=csv,noheader)
    15	  util=$(nvidia-smi -i 0 --query-gpu=utilization.gpu --format=csv,noheader,nounits | tr -d ' ')
    16	  [ -z "$apps" ] && [ "$util" = "0" ]
    17	}
    18	
    19	snap() {  # $1 = tag
    20	  { date -u +%FT%TZ; nvidia-smi; echo "# gpu0 query";
    21	    nvidia-smi -i 0 --query-gpu=index,memory.used,utilization.gpu,pstate --format=csv;
    22	    echo "# gpu0 compute apps"; nvidia-smi -i 0 --query-compute-apps=pid,process_name,used_memory --format=csv; } > "$RC/idle_nvidia_smi_$1.txt" 2>&1
    23	  { date -u +%FT%TZ; ps -eo pid,etime,pcpu,rss,args | grep -E "python|torchrun|run_ppo|cargo|pip|maturin" | grep -v grep; } > "$RC/idle_ps_$1.txt" 2>&1
    24	}
    25	
    26	echo "=== launch.sh start $(date -u +%FT%TZ)"
    27	{ date -u +%FT%TZ; git rev-parse HEAD; git rev-parse 'HEAD^{tree}'; echo "# status --porcelain"; git status --porcelain;
    28	  echo "# check-ignore runs/"; git check-ignore -v runs/aten-gemm-ab-2026-09-29/driver.py; } > "$RC/git_pre.txt" 2>&1
    29	{ date -u +%FT%TZ; echo "# which nsys"; which nsys; echo "which rc=$?"; ls -d /usr/local/cuda*/bin/nsys /opt/nvidia/nsight-systems* 2>&1; } > "$RC/nsys_check.txt" 2>&1
    30	{ .venv/bin/python -c "import torch, triton, flash_attn, torch._inductor.config as c; print(torch.__version__, torch.version.git_version, triton.__version__, flash_attn.__version__, torch.version.cuda, repr(c.max_autotune_gemm_backends))";
    31	  nvidia-smi --query-gpu=index,name,driver_version --format=csv; env | grep -E '^TORCHINDUCTOR|^TRITON' ; echo "env-grep done"; } > "$RC/versions.txt" 2>&1
    32	( cd "$R" && sha256sum *.py *.sh ) > "$RC/scripts.sha256"
    33	snap pre
    34	
    35	waited=0
    36	until gpu0_idle; do
    37	  if [ $waited -ge 600 ]; then
    38	    snap notidle
    39	    echo "=== GPU 0 not idle after 600 s; not running $(date -u +%FT%TZ)"
    40	    echo ALLDONE
    41	    exit 2
    42	  fi
    43	  sleep 15; waited=$((waited + 15))
    44	done
    45	snap prelaunch
    46	echo "=== idle gate passed after ${waited}s; driver start $(date -u +%FT%TZ)"
    47	
    48	timeout -k 20 2700 .venv/bin/python "$R/driver.py" > "$R/driver.out" 2>&1
    49	DRC=$?
    50	echo "=== driver exit $DRC $(date -u +%FT%TZ)"
    51	
    52	"$REPO/.venv/bin/python" "$R/analyze_kernels.py" "$R" > "$R/kernel_analysis.txt" 2>&1; echo "=== analyze_kernels exit $?"
    53	"$REPO/.venv/bin/python" "$R/check_templates.py" "$R" > "$R/template_census.txt" 2>&1; echo "=== check_templates exit $?"
    54	
    55	snap post
    56	{ date -u +%FT%TZ; git rev-parse HEAD; echo "# status --porcelain"; git status --porcelain; } > "$RC/git_post.txt" 2>&1
    57	( cd "$R" && find inductor_cache triton_cache -type f -print0 | sort -z | xargs -0 sha256sum ) > "$RC/compile_caches.sha256" 2>/dev/null
    58	echo "=== launch.sh end $(date -u +%FT%TZ)"
    59	echo ALLDONE

