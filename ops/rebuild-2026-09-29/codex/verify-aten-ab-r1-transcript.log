     3	Mirrors the training precision: fp32 parameters and fp32 inputs under
     4	torch.autocast(bfloat16) with TF32 enabled, torch.compile(mode=
     5	"max-autotune-no-cudagraphs", dynamic=True), compiled at a small M first.
     6	For each target M: eager reference (cuBLAS) vs compiled output, element
     7	check |d| > 0.02 + 0.02*|ref|, bad-row count/range, input/reference clobber
     8	checks. Writes one JSON line per event to --out and flushes before each
     9	launch so a CUDA fault is attributable to the M that was running.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import argparse
    15	import json
    16	import time
    17	
    18	import torch
    19	import torch.nn.functional as F
    20	from torch import nn
    21	
    22	SMALL_M = 4096
    23	ROW_CHUNK = 1 << 18
    24	
    25	
    26	class Mlp(nn.Module):
    27	    def __init__(self, k: int, h: int, n: int) -> None:
    28	        super().__init__()
    29	        self.up = nn.Linear(k, h)
    30	        self.down = nn.Linear(h, n)
    31	
    32	    def forward(self, x: torch.Tensor) -> torch.Tensor:
    33	        return self.down(F.gelu(self.up(x)))
    34	
    35	
    36	def build(case: str) -> tuple[nn.Module, int, bool]:
    37	    kind, *dims = case.split(":")
    38	    sizes = [int(d) for d in dims]
    39	    if kind == "lin":
    40	        k, n = sizes
    41	        return nn.Linear(k, n), k, False
    42	    if kind == "mlp":
    43	        k, h, n = sizes
    44	        return Mlp(k, h, n), k, False
    45	    if kind == "mlpbwd":
    46	        k, h, n = sizes
    47	        return Mlp(k, h, n), k, True
    48	    raise ValueError(f"unknown case {case}")
    49	
    50	
    51	def emit(fh, record: dict) -> None:
    52	    fh.write(json.dumps(record) + "\n")
    53	    fh.flush()
    54	
    55	
    56	def compare(out: torch.Tensor, ref: torch.Tensor) -> dict:
    57	    rows = out.shape[0]
    58	    max_abs = 0.0
    59	    bad_rows: list[torch.Tensor] = []
    60	    nonfinite = 0
    61	    for s in range(0, rows, ROW_CHUNK):
    62	        o = out[s : s + ROW_CHUNK].float()
    63	        r = ref[s : s + ROW_CHUNK].float()
    64	        d = (o - r).abs()
    65	        nonfinite += int((~torch.isfinite(o)).sum().item())
    66	        d = torch.nan_to_num(d, nan=1e30, posinf=1e30)
    67	        max_abs = max(max_abs, float(d.max().item()))
    68	        bad = (d > 0.02 + 0.02 * r.abs()).any(dim=1)
    69	        idx = bad.nonzero().flatten()
    70	        if idx.numel():
    71	            bad_rows.append(idx + s)
    72	    if bad_rows:
    73	        all_bad = torch.cat(bad_rows)
    74	        n_bad, first, last = int(all_bad.numel()), int(all_bad[0]), int(all_bad[-1])
    75	    else:
    76	        n_bad, first, last = 0, None, None
    77	    return {
    78	        "max_abs_diff": max_abs,
    79	        "bad_rows": n_bad,
    80	        "first_bad_row": first,
    81	        "last_bad_row": last,
    82	        "nonfinite": nonfinite,
    83	    }
    84	
    85	
    86	def run_point(model, fn, m: int, k: int, backward: bool, seed: int) -> dict:
    87	    gen = torch.Generator(device="cuda").manual_seed(seed + m)
    88	    x = torch.randn((m, k), device="cuda", dtype=torch.float32, generator=gen)
    89	    x_sum = float(x.double().sum().item())
    90	    rec: dict = {"M": m}
    91	    if not backward:
    92	        with torch.no_grad(), torch.autocast("cuda", dtype=torch.bfloat16):
    93	            ref = model(x)
    94	            ref_sum = float(ref.double().sum().item())
    95	            torch.cuda.synchronize()
    96	            t0 = time.perf_counter()
    97	            out = fn(x)
    98	            torch.cuda.synchronize()
    99	            rec["compiled_s"] = time.perf_counter() - t0
   100	        rec["ref_clobbered"] = float(ref.double().sum().item()) != ref_sum
   101	        rec.update(compare(out, ref))
   102	        rec["out_dtype"] = str(out.dtype)
   103	        del out, ref
   104	    else:
   105	        g = torch.randn(
   106	            (m, model.down.out_features), device="cuda", generator=gen
   107	        ).to(torch.bfloat16)
   108	        grads = {}
   109	        for tag, f in (("eager", model), ("compiled", fn)):
   110	            model.zero_grad(set_to_none=True)
   111	            xg = x.clone().requires_grad_(True)
   112	            torch.cuda.synchronize()
   113	            t0 = time.perf_counter()
   114	            with torch.autocast("cuda", dtype=torch.bfloat16):
   115	                y = f(xg)
   116	            y.backward(g)
   117	            torch.cuda.synchronize()
   118	            rec[f"{tag}_s"] = time.perf_counter() - t0
   119	            grads[tag] = (
   120	                y.detach(),
   121	                xg.grad.detach(),
   122	                {n: p.grad.detach().clone() for n, p in model.named_parameters()},
   123	            )
   124	            del xg, y
   125	        rec["fwd"] = compare(grads["compiled"][0], grads["eager"][0])
   126	        rec["dx"] = compare(grads["compiled"][1], grads["eager"][1])
   127	        rel = {}
   128	        for name, ge in grads["eager"][2].items():
   129	            gc = grads["compiled"][2][name]
   130	            rel[name] = float(
   131	                ((gc - ge).abs().max() / ge.abs().max().clamp_min(1e-30)).item()
   132	            )
   133	        rec["param_grad_rel_max"] = rel
   134	        del grads
   135	    rec["input_clobbered"] = float(x.double().sum().item()) != x_sum
   136	    del x
   137	    torch.cuda.empty_cache()
   138	    return rec
   139	
   140	
   141	def main() -> None:
   142	    ap = argparse.ArgumentParser()
   143	    ap.add_argument("--case", required=True)
   144	    ap.add_argument("--ms", required=True)
   145	    ap.add_argument("--out", required=True)
   146	    ap.add_argument("--seed", type=int, default=0)
   147	    args = ap.parse_args()
   148	    torch.backends.cuda.matmul.allow_tf32 = True
   149	    torch.backends.cudnn.allow_tf32 = True
   150	    torch.backends.cudnn.benchmark = True
   151	    torch.manual_seed(args.seed)
   152	    model, k, backward = build(args.case)
   153	    model = model.cuda()
   154	    if not backward:
   155	        model.eval()
   156	    fn = torch.compile(model, mode="max-autotune-no-cudagraphs", dynamic=True)
   157	    with open(args.out, "a") as fh:
   158	        emit(fh, {"event": "process", "case": args.case, "torch": torch.__version__,
   159	                  "device": torch.cuda.get_device_name(0)})
   160	        for label, m in [("warm", SMALL_M)] + [
   161	            ("target", int(v)) for v in args.ms.split(",")
   162	        ]:
   163	            emit(fh, {"event": "start", "case": args.case, "label": label, "M": m})
   164	            t0 = time.perf_counter()
   165	            rec = run_point(model, fn, m, k, backward, args.seed)
   166	            rec.update(event="result", case=args.case, label=label,
   167	                       wall_s=time.perf_counter() - t0)
   168	            emit(fh, rec)
   169	
   170	
   171	if __name__ == "__main__":
   172	    main()
     1	"""Real KaggricultureTransformer trunk correctness probe at e1458d2 (one process).
     2	
     3	Adapted from ops/rebuild-2026-09-29/gemm-limits-2026-09-29/probe/probe_trunk.py
     4	(sha256 5ce3f09a...) for the ATEN-only GEMM A/B
     5	(run statement ops/rebuild-2026-09-29/run-statements/aten-gemm-ab.md).
     6	Differences from the original, and nothing else:
     7	
     8	- the model is imported from the pod checkout /workspace/kg-v3-rebuild at
     9	  e1458d2 (installed venv), not from the 1ddc71d source copy;
    10	- the preset config configs/model/kaggriculture.yaml is loaded
    11	  (force_flash_attn: true) and the REAL flash-attn 2.8.3 varlen kernel is used;
    12	  the original's aten varlen shim is not installed (flash-attn is now present);
    13	- only the packed path is supported; the helper names follow e1458d2
    14	  (trunk_gemm_width replaces gemm_kmax);
    15	- the process record carries torch._inductor.config.max_autotune_gemm_backends.
    16	
    17	Unchanged: fp32 parameters, bf16 input x [rows, 709, 256] under
    18	torch.autocast(bfloat16), TF32 on, compile_transformer_trunk(mode=
    19	"max-autotune-no-cudagraphs") (dynamic=True), compiled small first (dense:8),
    20	eager reference via _run_trunk with the compiled callable removed, the guard
    21	bypass (kaggriculture._GEMM_ELEMENT_LIMIT = 2**62), the mask specs and the
    22	comparison (|d| > 0.25 on any channel of a valid token counts as wrong).
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	import argparse
    28	import json
    29	import time
    30	from pathlib import Path
    31	
    32	import torch
    33	import torch._inductor.config as inductor_config
    34	
    35	import owl
    36	import owl.model.attn as attn_mod
    37	
    38	ROOT = Path("/workspace/kg-v3-rebuild")
    39	TOKENS = 709
    40	ROW_CHUNK = 512
    41	
    42	
    43	def emit(fh, record: dict) -> None:
    44	    fh.write(json.dumps(record) + "\n")
    45	    fh.flush()
    46	
    47	
    48	def make_mask(spec: str) -> torch.Tensor:
    49	    kind, _, value = spec.partition(":")
    50	    if kind == "dense":  # every actor slot and shop live: 709 tokens per row
    51	        return torch.ones((int(value), TOKENS), dtype=torch.bool)
    52	    if kind == "packed":  # dense rows, total valid tokens exactly value
    53	        total = int(value)
    54	        rows = -(-total // TOKENS)
    55	        mask = torch.ones((rows, TOKENS), dtype=torch.bool)
    56	        last = total - TOKENS * (rows - 1)
    57	        mask[-1, last:] = False
    58	        return mask
    59	    raise ValueError(spec)
    60	
    61	
    62	def compare(out: torch.Tensor, ref: torch.Tensor, mask: torch.Tensor) -> dict:
    63	    max_abs = 0.0
    64	    bad25 = bad100 = nonfinite = 0
    65	    first_bad_row = last_bad_row = None
    66	    for s in range(0, out.shape[0], ROW_CHUNK):
    67	        m = mask[s:s + ROW_CHUNK]
    68	        d = (out[s:s + ROW_CHUNK].float() - ref[s:s + ROW_CHUNK].float()).abs()
    69	        nonfinite += int((~torch.isfinite(out[s:s + ROW_CHUNK][m])).sum())
    70	        d = torch.nan_to_num(d, nan=1e30, posinf=1e30).amax(-1)  # per token
    71	        d = torch.where(m, d, torch.zeros_like(d))
    72	        max_abs = max(max_abs, float(d.max()))
    73	        bad25 += int((d > 0.25).sum())
    74	        bad100 += int((d > 1.0).sum())
    75	        rows_bad = (d > 0.25).any(-1).nonzero().flatten()
    76	        if rows_bad.numel():
    77	            if first_bad_row is None:
    78	                first_bad_row = int(rows_bad[0]) + s
    79	            last_bad_row = int(rows_bad[-1]) + s
    80	    return {"max_abs_diff": max_abs, "tokens_diff_gt_0.25": bad25,
    81	            "tokens_diff_gt_1.0": bad100, "nonfinite": nonfinite,
    82	            "first_bad_row": first_bad_row, "last_bad_row": last_bad_row}
    83	
    84	
    85	def main() -> None:
    86	    ap = argparse.ArgumentParser()
    87	    ap.add_argument("--points", required=True, help="';'-separated mask specs")
    88	    ap.add_argument("--bypass-guard", action="store_true")
    89	    ap.add_argument("--case", required=True)
    90	    ap.add_argument("--out", required=True)
    91	    args = ap.parse_args()
    92	    torch.backends.cuda.matmul.allow_tf32 = True
    93	    torch.backends.cudnn.allow_tf32 = True
    94	    torch.backends.cudnn.benchmark = True
    95	
    96	    import owl.model.kaggriculture as kg
    97	    from owl.kaggriculture import types as kt
    98	
    99	    if not kg.__file__.startswith(str(ROOT / "python")):
   100	        raise RuntimeError(f"model imported from the wrong tree: {kg.__file__}")
   101	    if not attn_mod.flash_attn_available():
   102	        raise RuntimeError("flash-attn is not importable; the packed path needs it")
   103	
   104	    fh = open(args.out, "a")
   105	    if args.bypass_guard:
   106	        kg._GEMM_ELEMENT_LIMIT = 2**62
   107	    cfg = kg.KaggricultureTransformerConfig.from_file(
   108	        ROOT / "configs/model/kaggriculture.yaml")
   109	    assert cfg.force_flash_attn is True
   110	    assert kg.sequence_length(cfg) == TOKENS
   111	    torch.manual_seed(0)
   112	    model = kg.KaggricultureTransformer(
   113	        cfg, obs_spec=kt.KaggricultureObsConfig(),
   114	        action_spec=kt.KaggricultureActionConfig(),
   115	    ).cuda().eval()
   116	    model.compile_transformer_trunk(mode="max-autotune-no-cudagraphs")
   117	    compiled = model._compiled_transformer_trunk
   118	    calls: list[int] = []
   119	
   120	    def recording(x, token_mask, packed):
   121	        calls.append(int(x.shape[0]) if x.dim() == 2 else int(x.shape[0] * x.shape[1]))
   122	        return compiled(x, token_mask, packed)
   123	
   124	    width = kg.trunk_gemm_width(cfg)
   125	    emit(fh, {"event": "process", "case": args.case, "torch": torch.__version__,
   126	              "owl_file": owl.__file__, "kg_file": kg.__file__,
   127	              "flash_attn_varlen_func": repr(attn_mod._FLASH_ATTN_VARLEN_FUNC),
   128	              "max_autotune_gemm_backends": inductor_config.max_autotune_gemm_backends,
   129	              "gemm_limit": kg._GEMM_ELEMENT_LIMIT,
   130	              "trunk_gemm_width": width,
   131	              "use_flash_attn_bf16": attn_mod.use_flash_attn(
   132	                  torch.empty(1, device="cuda", dtype=torch.bfloat16))})
   133	    specs = ["dense:8"] + [p for p in args.points.split(";") if p]
   134	    for i, spec in enumerate(specs):
   135	        label = "warm" if i == 0 else "target"
   136	        mask_cpu = make_mask(spec)
   137	        rows = mask_cpu.shape[0]
   138	        emit(fh, {"event": "start", "case": args.case, "label": label, "spec": spec,
   139	                  "rows": rows, "packed_tokens": int(mask_cpu.sum())})
   140	        mask = mask_cpu.cuda()
   141	        x = torch.randn((rows, TOKENS, cfg.embed_dim), device="cuda",
   142	                        dtype=torch.bfloat16,
   143	                        generator=torch.Generator(device="cuda").manual_seed(i))
   144	        rec: dict = {"event": "result", "case": args.case, "label": label,
   145	                     "spec": spec, "rows": rows,
   146	                     "packed_tokens": int(mask_cpu.sum()),
   147	                     "padded_token_rows": rows * TOKENS}
   148	        with torch.no_grad(), torch.autocast("cuda", dtype=torch.bfloat16):
   149	            model._compiled_transformer_trunk = None
   150	            try:
   151	                ref = model._run_trunk(x, mask)
   152	                rec["eager"] = "ok"
   153	            except ValueError as exc:
   154	                ref = None
   155	                rec["eager"] = f"ValueError: {exc}"
   156	            calls.clear()
   157	            model._compiled_transformer_trunk = recording
   158	            torch.cuda.synchronize()
   159	            t0 = time.perf_counter()
   160	            try:
   161	                out = model._run_trunk(x, mask)
   162	                torch.cuda.synchronize()
   163	                rec["compiled"] = "ok"
   164	            except ValueError as exc:
   165	                out = None
   166	                rec["compiled"] = f"ValueError: {exc}"
   167	            rec["compiled_s"] = time.perf_counter() - t0
   168	            rec["trunk_call_M"] = list(calls)
   169	            rec["trunk_call_M_x_width_over_2p31"] = [c * width / 2**31 for c in calls]
   170	        if out is not None and ref is not None:
   171	            rec.update(compare(out, ref, mask))
   172	        emit(fh, rec)
   173	        del x, mask, ref, out
   174	        torch.cuda.empty_cache()
   175	    fh.close()
   176	
   177	
   178	if __name__ == "__main__":
   179	    main()

