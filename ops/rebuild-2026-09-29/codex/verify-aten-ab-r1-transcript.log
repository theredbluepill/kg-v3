   108	def judge_probe(script: str, out: Path, n_points: int) -> tuple[list[str], int]:
   109	    ev = events(out)
   110	    results = [e for e in ev if e.get("event") == "result"]
   111	    errs: list[str] = []
   112	    for r in results:
   113	        bad = trunk_ok(r) if script.startswith("probe_trunk") else lin_ok(r)
   114	        errs += [f"{r['label']} {r.get('spec', r.get('M'))}: {b}" for b in bad]
   115	    targets = [r for r in results if r["label"] == "target"]
   116	    if len(targets) != n_points:
   117	        errs.append(f"{len(targets)} of {n_points} target points produced a result")
   118	    return errs, len(targets)
   119	
   120	
   121	def judge_bench(outdir: Path, density: str) -> list[str]:
   122	    path = outdir / f"results_{density}.json"
   123	    if not path.exists():
   124	        return [f"missing {path}"]
   125	    res = json.loads(path.read_text())["results"]
   126	    errs = []
   127	    for k, want in EXPECTED_CHUNKS[density].items():
   128	        got = res[k]["pack_sequence_calls_per_iter"]
   129	        if got != want:
   130	            errs.append(f"{k} chunks/iter {got} != {want}")
   131	        if not res[k]["use_flash_attn_all_true"]:
   132	            errs.append(f"{k} use_flash_attn not all true")
   133	    return errs
   134	
