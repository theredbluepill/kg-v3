     1	#!/bin/bash
     2	# ATEN-only GEMM A/B launcher (run statement run-statements/aten-gemm-ab.md).
     3	# Idle gate on GPU 0, receipts, the driver under a hard 45-minute timeout,
     4	# generated-code analysis (text only), post receipts. Never stops the pod.
     5	set -u
     6	R=/workspace/kg-v3-rebuild/runs/aten-gemm-ab-2026-09-29
     7	REPO=/workspace/kg-v3-rebuild
     8	RC=$R/receipts
     9	mkdir -p "$RC"
    10	cd "$REPO"
