    expected = expected_grammar_tables().as_dict()
    assert actual.keys() == expected.keys()
    for key, array in actual.items():
        assert array.dtype == np.bool_ and array.flags.c_contiguous
        np.testing.assert_array_equal(array, expected[key].numpy())

def test_failed_encode_preserves_output() -> None:
    out = np.full((252, 12), 91, dtype=np.int64)
    before = out.tobytes()
    with pytest.raises(ValueError):
        rs.kaggriculture_encode('{"farmer":null,"hands":[],"market":[]}',
                                1, 10, 241, out)
    assert out.tobytes() == before
```

