import copy
import importlib.util
import itertools
import json
import sys
from pathlib import Path

import numpy as np
import torch

ROOT = Path('/Users/poonszesen/kg-v3-bcnow')
OUT = Path('/tmp/bc-team-review-tZFUFb')
spec = importlib.util.spec_from_file_location('test_preparer_review', ROOT / 'tests/scripts/test_kaggriculture_prepare_bc.py')
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)
p = m.prepare
secret = 'Synthetic Player Canary'
hash_ = p.name_sha256(secret)
summary = {}
# Independent selection oracle over both seat positions, mirrors, draws and losses.
checks = 0
for banks, team_positions, losses in itertools.product([(10., 5.), (5., 10.), (7., 7.)], [[], [0], [1], [0, 1]], [False, True]):
    names = [secret if s in team_positions else f'opponent{s}' for s in (0, 1)]
    expected = tuple(s in team_positions and (losses or banks[s] == max(banks)) for s in (0, 1))
    try:
        actual = p.policy_seats(banks, names, hash_, include_losses=losses)
        assert any(expected) and actual == expected, (banks, names, losses, actual, expected)
    except p.EpisodeRejected as exc:
        assert not any(expected)
        assert str(exc) == ('team absent' if not team_positions else 'team lost')
    checks += 1
for malformed in [None, {}, secret, [], [secret], [secret, 'x', 'y'], [secret, 3], [True, secret]]:
    try:
        p.policy_seats((10., 5.), malformed, hash_, include_losses=False)
    except p.EpisodeRejected as exc:
        assert str(exc) == 'info.TeamNames is not two strings'
    else:
        raise AssertionError(malformed)
summary['selection_cases_passed'] = checks + 8

played = m.played.__wrapped__()
ids = iter(m._ids('train', 20))
cases = {}
episodes = {}
# Reuse legal observations/programs, vary only terminal targets and metadata to isolate filtering.
for outcome, banks in [('seat0_wins', (10., 5.)), ('seat1_wins', (5., 10.)), ('draw', (7., 7.))]:
    for positions in [[], [0], [1], [0, 1]]:
        eid = next(ids)
        data = m._episode(played, eid)
        data['info']['TeamNames'] = [secret if s in positions else f'opponent{s}' for s in (0, 1)]
        for s in (0, 1):
            data['steps'][-1][0]['observation']['farms'][s]['money'] = banks[s]
        episodes[eid] = data
        cases[eid] = (outcome, positions, banks)
for malformed in [None, [secret], [secret, 3]]:
    eid = next(ids)
    data = m._episode(played, eid)
    data['info']['TeamNames'] = malformed
    episodes[eid] = data
    cases[eid] = ('malformed', [], (0., 0.))
valid_id = m._ids('validation', 1)[0]
data = m._episode(played, valid_id)
data['info']['TeamNames'] = [secret, secret]
episodes[valid_id] = data
banks = tuple(f['money'] for f in data['steps'][-1][0]['observation']['farms'])
cases[valid_id] = ('validation', [0, 1], banks)
archives = OUT / 'archives'
m._archive(archives, 22, episodes)
for losses in [False, True]:
    out = OUT / ('including_losses' if losses else 'wins_only')
    argv = [str(archives), str(out), '--days', '22', '--workers', '1', '--turn-stride', '719', '--team', secret]
    if losses:
        argv += ['--include-losses']
    sys.argv = ['kaggriculture_prepare_bc.py', *argv]
    assert p.main(argv) == 0
    manifest = json.loads((out / 'manifest.json').read_text())
    dataset = m.load_bc_dataset(out)
    expected_policy_rows = 0
    for r in manifest['episodes']:
        eid = r['episode_id']
        outcome, positions, banks = cases[eid]
        expected = tuple(s in positions and (losses or banks[s] == max(banks)) for s in (0, 1))
        assert r['policy_seats'] == [s for s in (0, 1) if expected[s]]
        expected_policy_rows += sum(expected)
        split = dataset.train if r['split'] == 'train' else dataset.validation
        episode_index = split.episode_ids.index(eid)
        row_indices = np.flatnonzero(split.episode.numpy() == episode_index)
        batch = split.gather(row_indices)
        assert batch.policy_seat.tolist() == [list(expected)]
        turn = int(split.turn[row_indices[0]])
        reference = p.encode_observations(episodes[eid], [turn])
        for name, value in reference.items():
            actual = batch.obs.action_mask.can_act if name == 'can_act' else getattr(batch.obs, name)
            assert np.array_equal(actual.numpy(), value), (eid, name)
        for s in (0, 1):
            actors = int(batch.obs.actor_mask[0, s, :p.HIRE_LIMIT].sum())
            limit = int(batch.obs.order_limits[0, s])
            decoded = json.loads(p.rs.kaggriculture_decode(batch.actions.tokens[0, s].numpy(), int(batch.actions.lengths[0, s]), actors, limit, p.HIRE_LIMIT))
            action = p.normalize_action(episodes[eid]['steps'][turn+1][s]['action'])[0] if expected[s] else p.pass_action(actors)
            assert decoded == action, (eid, s)
        with np.load(out / r['shard_path'], allow_pickle=False) as shard:
            assert set(shard.files) == {'schema', 'turn', *m.load_bc_dataset.__globals__['OBS_FIELDS'], *m.load_bc_dataset.__globals__['ACTION_FIELDS']}
            assert all(shard[key].dtype.kind in 'ifbu' for key in shard.files if key != 'schema')
    assert sum(v['policy_seat_rows'] for v in manifest['totals'].values()) == expected_policy_rows
    assert sum(v['episodes'] for v in manifest['totals'].values()) + sum(manifest['episode_rejections'].values()) == len(episodes)
    for path in out.rglob('*.json'):
        assert secret not in path.read_text()
    actual_draws = sum(r['terminal_banks'][0] == r['terminal_banks'][1] for r in manifest['episodes'] if r['split'] == 'train')
    recorded_draws = manifest['totals']['train']['draw_episodes']
    summary[out.name] = {'totals': manifest['totals'], 'rejections': manifest['episode_rejections'], 'actual_train_draws': actual_draws, 'recorded_train_draws': recorded_draws}
    # Simulate interrupted final manifest write and check only intended identities change.
    (out / 'manifest.json').unlink()
    baseline = {str(path.relative_to(out)): path.read_bytes() for path in out.rglob('*') if path.is_file()}
    changed = list(argv)
    changed[changed.index(secret)] = 'Another Synthetic Player'
    try:
        p.main(changed)
    except RuntimeError as exc:
        assert "['team_sha256']" in str(exc)
        summary[out.name]['different_team_error'] = str(exc)
    else:
        raise AssertionError('changed team resumed')
    toggled = list(argv)
    if losses:
        toggled.remove('--include-losses')
    else:
        toggled.append('--include-losses')
    try:
        p.main(toggled)
    except RuntimeError as exc:
        assert "['include_losses']" in str(exc)
        summary[out.name]['changed_losses_error'] = str(exc)
    else:
        raise AssertionError('changed include_losses resumed')
    assert baseline == {str(path.relative_to(out)): path.read_bytes() for path in out.rglob('*') if path.is_file()}
    assert p.main(argv) == 0
    summary[out.name]['unchanged_resume'] = 'passed'
(OUT / 'probe-result.json').write_text(json.dumps(summary, indent=2) + '\n')
print(json.dumps(summary, indent=2))

