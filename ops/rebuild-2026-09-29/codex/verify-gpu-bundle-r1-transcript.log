   211	class Driver:
   212	    def __init__(self) -> None:
   213	        self.t0 = time.monotonic()
   214	        self.deadline = self.t0 + BUDGET_S
   215	        self.stop = threading.Event()
   216	        self.lock = threading.Lock()
   217	        self.procs: dict[str, subprocess.Popen[bytes]] = {}
   218	        self.failure: int | None = None
   219	        self.log_fh = open(RUN / "driver.jsonl", "a")
   220	
   221	    def log(self, rec: dict[str, Any]) -> None:
   222	        rec = {"utc": now(), "t": round(time.monotonic() - self.t0, 1), **rec}
   223	        with self.lock:
   224	            self.log_fh.write(json.dumps(rec) + "\n")
   225	            self.log_fh.flush()
   226	            print(json.dumps(rec), flush=True)
   227	
   228	    def fail(self, code: int) -> None:
   229	        with self.lock:
   230	            if self.failure is None:
   231	                self.failure = code
   232	            self.stop.set()
   233	            for name, p in self.procs.items():
   234	                if p.poll() is None:
   235	                    try:
   236	                        os.killpg(p.pid, signal.SIGTERM)
   237	                    except ProcessLookupError:
   238	                        pass
   239	
   240	    def run_stage(self, stage: Stage, gpu: int) -> None:
   241	        name, role, backends, cache, script, args = stage
   242	        if self.stop.is_set():
   243	            self.log({"stage": name, "gpu": gpu, "status": "skipped_after_stop"})
   244	            return
   245	        remaining = self.deadline - time.monotonic()
   246	        if remaining < MIN_START_S:
   247	            self.log({"stage": name, "gpu": gpu, "status": "stop_budget",
   248	                      "remaining_s": round(remaining)})
   249	            self.fail(4)
   250	            return
   251	        timeout = min(remaining, CONTROL_CAP_S) if role == "control" else remaining
   252	        env = {k: v for k, v in os.environ.items()
   253	               if k != "TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS"}
   254	        env.update(CUDA_VISIBLE_DEVICES=str(gpu), PYTHONUNBUFFERED="1",
   255	                   PYTHONPATH=str(RUN),
   256	                   TORCHINDUCTOR_CACHE_DIR=str(RUN / "inductor_cache" / cache),
   257	                   TRITON_CACHE_DIR=str(RUN / "triton_cache" / cache),
   258	                   TORCH_LOGS="recompiles")
   259	        record = RUN / f"{name}.backend.json"
   260	        out = RUN / f"{name}.jsonl"
   261	        cmd = [PY, WRAP, "--backends", backends, "--record", str(record), "--",
   262	               str(RUN / script), *args, "--out", str(out)]
   263	        self.log({"stage": name, "gpu": gpu, "role": role, "backends": backends,
   264	                  "cmd": cmd, "status": "launch", "timeout_s": round(timeout)})
   265	        rc: int | str
   266	        with open(RUN / f"{name}.log", "w") as fh:
   267	            p = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=fh,
   268	                                 stderr=subprocess.STDOUT, start_new_session=True)
   269	            with self.lock:
   270	                self.procs[name] = p
   271	            try:
   272	                rc = p.wait(timeout=timeout)
   273	            except subprocess.TimeoutExpired:
   274	                os.killpg(p.pid, signal.SIGKILL)
   275	                p.wait()
   276	                rc = "timeout"
   277	        if self.stop.is_set() and role != "control" and self.failure is not None \
   278	                and rc not in (0,):
   279	            self.log({"stage": name, "gpu": gpu, "rc": rc,
   280	                      "status": "terminated_by_stop"})
   281	            return
   282	        rec_errs = []
   283	        if record.exists():
   284	            br = json.loads(record.read_text())
   285	            want = "ATEN" if backends == "ATEN" else "ATEN,TRITON,CPP"
   286	            if br.get("value_at_start") != want or br.get("value_at_end") != want:
   287	                rec_errs.append(f"backend record {br.get('value_at_start')}/"
   288	                                f"{br.get('value_at_end')} != {want}")
   289	        else:
   290	            rec_errs.append("no backend record")
   291	        try:
   292	            errs = JUDGES[name[:2]](events(out))
   293	        except (KeyError, TypeError, ValueError) as exc:
   294	            errs = [f"judge error {type(exc).__name__}: {exc}"]
   295	        if role == "control":
   296	            reproduced = rc != 0 or bool(errs)
   297	            self.log({"stage": name, "gpu": gpu, "role": role, "rc": rc,
   298	                      "findings": (errs + rec_errs)[:40],
   299	                      "status": "control_reproduced" if reproduced
   300	                      else "control_not_reproduced"})
   301	            return
   302	        errs = rec_errs + errs
   303	        if rc != 0:
   304	            errs.insert(0, f"rc={rc}")
   305	        if errs:
