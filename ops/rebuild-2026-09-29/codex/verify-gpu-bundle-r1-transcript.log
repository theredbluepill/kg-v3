    34	                 "triton_tem_defs": 0, "triton_tem_launches": 0,
    35	                 "marker_files": {k: [] for k in MARKERS}}
    36	    for f in sorted(case_dir.rglob("*.py")):
    37	        text = f.read_text(errors="replace")
    38	        out["files"] += 1
    39	        rel = str(f.relative_to(case_dir))
