   105	                f"eager={r.get('eager', {}).get('status')}"]
   106	    if r["compiled"]["trunk_call_M"] != [r["packed_tokens"]]:
   107	        errs.append(f"trunk_call_M {r['compiled']['trunk_call_M']}")
   108	    o = r["out_compiled_vs_eager"]
   109	    if o["wrong_tokens"] or o["nonfinite"]:
   110	        errs.append(f"out wrong={o['wrong_tokens']} nonfinite={o['nonfinite']}")
   111	    d = r["dx_compiled_vs_eager"]
   112	    if (d["nonfinite"] or d["tokens_rel_gt_0.5"] or d["masked_nonzero"]
   113	            or not (d["rel_max"] is not None and d["rel_max"] <= REL_MAX)):
   114	        errs.append(f"dx nonfinite={d['nonfinite']} tok>0.5={d['tokens_rel_gt_0.5']} "
   115	                    f"masked_nonzero={d['masked_nonzero']} rel_max={d['rel_max']}")
   116	    params = r["params_compiled_vs_eager"]
   117	    for name, m in params.items():
   118	        if name == "_missing":
   119	            errs.append(f"param grads missing {m}")
   120	        elif name.endswith("attn.k.bias"):
   121	            # Amendment 1: the key-bias gradient is analytically zero (softmax
   122	            # shift invariance), so compiled and eager values and their
   123	            # difference are judged against the sibling query-bias scale.
