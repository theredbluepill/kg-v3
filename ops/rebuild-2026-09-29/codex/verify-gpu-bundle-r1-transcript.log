   129	
   130	def jaccard(a: list[list[int]], b: list[list[int]]) -> dict[str, Any]:
   131	    sa, sb = {tuple(x) for x in a}, {tuple(x) for x in b}
   132	    inter = len(sa & sb)
   133	    union = len(sa | sb)
   134	    return {"a": len(sa), "b": len(sb), "intersection": inter,
   135	            "jaccard": inter / union if union else None}
   136	
   137	
   138	def verdict(paths: dict[str, dict[str, Any]]) -> dict[str, Any]:
   139	    """Pre-declared rule: a path is an outlier when its mean |d| or its
   140	    outside-tol fraction vs fp32 exceeds 2x the median of the three paths on
   141	    that metric; otherwise the three are 'similar' (supports BF16 rounding)."""
   142	    out: dict[str, Any] = {"rule": "outlier if metric > 2 x median(3 paths)"}
   143	    flagged = []
   144	    for metric in ("mean_abs", "outside_tol_frac", "max_abs"):
   145	        vals = {p: paths[p][metric] for p in paths}
   146	        med = sorted(vals.values())[1]
   147	        out[metric] = {"values": vals, "median": med,
   148	                       "ratio_to_median": {p: (v / med if med else None)
   149	                                           for p, v in vals.items()}}
   150	        if metric != "max_abs":
   151	            flagged += [f"{p}:{metric}" for p, v in vals.items() if med and v > 2 * med]
   152	    out["flagged"] = flagged
   153	    out["result"] = "path_specific" if flagged else "similar"
   154	    return out
