   172	
   173	    def counting_pack(x: torch.Tensor, mask: torch.Tensor, **kw: Any) -> Any:
   174	        px, packed = real_pack(x, mask, **kw)
   175	        counters["pack"].append(int(px.shape[0]))
   176	        return px, packed
