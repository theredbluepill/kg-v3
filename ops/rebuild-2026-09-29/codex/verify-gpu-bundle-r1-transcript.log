    47	def replay_metrics(old_event: torch.Tensor, ev: Any, old_values: torch.Tensor,
    48	                   old_entropy: torch.Tensor) -> dict[str, Any]:
    49	    from owl.kaggriculture import types as kt
    50	
    51	    new_event = ev.log_probs.event.float()
