    56	        "logratio_per_row": stats(logratio),
    57	        "per_slot_max_abs_diff": {kt.SLOT_NAMES[s]: float(per_slot[s])
    58	                                  for s in range(kt.ACTION_SLOTS)},
    59	        "event_max_abs_diff": float((new_event - old).abs().max()),
    60	        "new_logp_nonfinite": int((~torch.isfinite(new_event)).sum()),
    61	        "new_logp_max": float(new_event.max()),
