   122	            "ulps": v / float(bf16_ulp(torch.tensor(rv))),
   123	        })
   124	    coords = outlier.nonzero()[:50_000]  # capped; the count above is exact
   125	    rec["outlier_coords_retained"] = int(coords.shape[0])
   126	    rec["_outlier_coords"] = coords.cpu().tolist()
   127	    return rec
