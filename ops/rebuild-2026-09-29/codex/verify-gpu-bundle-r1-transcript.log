    93	        groups.append({
    94	            "group": name,
    95	            "elements": ne,
    96	            "outliers": int(outlier[:, lo:hi].sum()),
    97	            "mean_abs": float(dm[:, lo:hi][sel].mean()) if ne else None,
    98	        })
    99	    rec["by_token_group"] = groups
   100	    per_channel = outlier.sum(dim=(0, 1))
   101	    top = torch.topk(per_channel, 8)
   102	    rec["top_outlier_channels"] = [
   103	        [int(c), int(v)] for v, c in zip(top.values, top.indices, strict=True)
   104	    ]
   105	    per_row = outlier.sum(dim=(1, 2))
   106	    rec["rows_with_outliers"] = int((per_row > 0).sum())
   107	    rec["max_outliers_in_one_row"] = int(per_row.max())
   108	    # worst elements
   109	    flat = dm.flatten()
   110	    worst = torch.topk(flat, WORST)
   111	    rows_len = mask.sum(dim=1)
   112	    T, D = ref.shape[1], ref.shape[2]
   113	    rec["worst"] = []
   114	    for v, i in zip(worst.values.tolist(), worst.indices.tolist(), strict=True):
   115	        r, rem = divmod(i, T * D)
   116	        t, c = divmod(rem, D)
   117	        rv = float(ref[r, t, c])
   118	        rec["worst"].append({
