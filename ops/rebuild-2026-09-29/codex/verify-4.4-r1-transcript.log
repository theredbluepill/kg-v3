+  # The teacher checkpoint is a required launch-time input, never a config
+  # value: --load-model-weights CHECKPOINT (the BC best) or
+  # -o rl.teacher_init=CHECKPOINT; run_ppo rejects a fresh launch without one.
   teacher_mode: last_best
   teacher_kl_coef: 0.005
   teacher_value_coef: 0.005
