[project]
name = "owl"
version = "0.1.0"
description = "An RL library for the Kaggle 2026 Orbit Wars competition"
readme = "README.md"
authors = [
    { name = "IsaiahPressman" }
]
requires-python = ">=3.11"
dependencies = [
    "kaggle-environments==1.32.7",
    "numpy>=2.4.4",
    "pydantic>=2.13.2",
    "pyyaml>=6.0.3",
    "torch==2.9.0",
    "tqdm>=4.67.3",
    "typing-extensions>=4.15.0",
    "wandb>=0.26.0",
]

[dependency-groups]
dev = [
    "kaggle>=2.1.0",
    "maturin>=1.13.1,<2.0",
    "mypy",
    "pytest>=9.0.3",
    "types-pyyaml>=6.0.12.20260408",
    "types-tqdm>=4.67.3.20260408",
]

[project.optional-dependencies]
flash-attn = [
    "flash-attn>=2.8.3",
]

[build-system]
requires = ["maturin>=1.0,<2.0"]
build-backend = "maturin"

[tool.maturin]
module-name = "owl.rs"
python-packages = ["owl"]
python-source = "python"
features = ["extension-module"]

[tool.uv]
cache-keys = [{ file = "pyproject.toml" }, { file = "src/**/*.rs" }, { file = "Cargo.toml" }, { file = "Cargo.lock" }]
constraint-dependencies = ["protobuf<7"]
no-build-isolation-package = ["flash-attn"]

[tool.uv.sources]
torch = [
  { index = "pytorch-cpu", marker = "sys_platform != 'linux'" },
  { index = "pytorch-cu128", marker = "sys_platform == 'linux'" },
]
torchvision = [
  { index = "pytorch-cpu", marker = "sys_platform != 'linux'" },
  { index = "pytorch-cu128", marker = "sys_platform == 'linux'" },
]


[[tool.uv.index]]
name = "pytorch-cpu"
url = "https://download.pytorch.org/whl/cpu"
explicit = true

[[tool.uv.index]]
name = "pytorch-cu128"
url = "https://download.pytorch.org/whl/cu128"
explicit = true

[tool.uv.extra-build-variables]
flash-attn = { FLASH_ATTENTION_SKIP_CUDA_BUILD = "TRUE" }

[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = [
    "A",
    "B",
    "D",
    "E",
    "F",
    "G",
    "I",
    "PT",
    "UP",
    "ARG",
    "ERA",
    "PIE",
    "RET",
    "RSE",
    "RUF",
    "SIM",
]
ignore = [
    "D1",
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.pymarkdown]
mode.strict-config = true
plugins.MD013.enabled = false
plugins.MD029.enabled = false

[tool.mypy]
plugins = ["pydantic.mypy"]
strict_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
disallow_any_generics = true
disallow_untyped_defs = true
allow_redefinition = true

[[tool.mypy.overrides]]
module = ["owl.*"]
no_implicit_reexport = true

[[tool.mypy.overrides]]
module = [
    "flash_attn.*",
    "kaggle.*",
]
ignore_missing_imports = true

[tool.pytest.ini_options]
addopts = "-ra"
strict_markers = true
markers = [
    "slow: long-running tests excluded from the default fast test target",
]
# Scaling-law sweep: stateless_transformer_6m @ 1xB200 for 500M env steps.
# seg_per_minibatch * grad_accum is kept at 16 (16 optimizer steps/iter); the
# split is set from the pre-launch memory smoke (grad_accum only as needed).
env:
  n_envs: 256
  obs_spec:
    obs_spec: entity_based_ext_v2
    max_entities: 320
  action_spec:
    action_spec: discrete_targets
    min_fleet_size: 3
    targeting_mode: anything_goes
  two_player_weight: 0.75
  pin_memory: true

model: stateless_transformer_6m

optimizer:
  optimizer: muon
  adamw_lr: 0.0001
  adamw_eps: 1.0e-05
  weight_decay: 0.0
  muon_lr: 0.002
  muon_weight_decay: 0.01
  muon_momentum: 0.95
  lr_schedule:
    schedule: linear_warmup_cosine_decay
    warmup_steps: 1000
    decay_steps: 400_000
    lr_min_ratio: 0.01

rl:
  horizon: 64
  checkpoint_freq: 20_000_000
  ppo_epochs: 1
  segments_per_minibatch: 16
  gradient_accumulation_steps: 1
  # gamma=1.0 keeps the critic softmax well-defined
  gamma: 1.0
  gae_lambda: 0.9
  clip_coef: 0.2
  vf_clip_coef: null
  vf_coef: 2.0
  ent_coef: 1e-6
  max_grad_norm: 10.0
  target_kl: null
  ppo_clip_mode: per_player
  normalize_advantages: true
  eval_replay_games: 8
  teacher_mode: last_best
  teacher_kl_coef: 0.005
  teacher_value_coef: 0.005
  teacher_segments_per_minibatch: 128
  compile_mode: default
  dtype: bfloat16
# 6M optimizer-density experiment @ 1xB200 for 2B env steps: half the global batch
# (n_envs 256->128, segments_per_minibatch 16->8, still 16 opt steps/iter) and half
# the LR decay rate (decay_steps 400k->800k opt steps). Relative to scaling_6m this
# doubles optimizer steps per env step while keeping the LR-vs-env-steps trajectory
# identical (decay completes at ~410M env steps in both).
env:
  n_envs: 128
  obs_spec:
    obs_spec: entity_based_ext_v2
    max_entities: 320
  action_spec:
    action_spec: discrete_targets
    min_fleet_size: 3
    targeting_mode: anything_goes
  two_player_weight: 0.75
  pin_memory: true

model: stateless_transformer_6m

optimizer:
  optimizer: muon
  adamw_lr: 0.0001
  adamw_eps: 1.0e-05
  weight_decay: 0.0
  muon_lr: 0.002
  muon_weight_decay: 0.01
  muon_momentum: 0.95
  lr_schedule:
    schedule: linear_warmup_cosine_decay
    warmup_steps: 1000
    decay_steps: 800_000
    lr_min_ratio: 0.01

rl:
  horizon: 64
  checkpoint_freq: 20_000_000
  ppo_epochs: 1
  segments_per_minibatch: 8
  gradient_accumulation_steps: 1
  # gamma=1.0 keeps the critic softmax well-defined
  gamma: 1.0
  gae_lambda: 0.9
  clip_coef: 0.2
  vf_clip_coef: null
  vf_coef: 2.0
  ent_coef: 1e-6
  max_grad_norm: 10.0
  target_kl: null
  ppo_clip_mode: per_player
  normalize_advantages: true
  eval_replay_games: 8
  teacher_mode: last_best
  teacher_kl_coef: 0.005
  teacher_value_coef: 0.005
  teacher_segments_per_minibatch: 128
