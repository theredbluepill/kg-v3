# Scaling-law sweep (down-tier): stateless_transformer_3m (~2.97M params) @ 5090s
# for 250M env steps. Half the 6m's effective batch: EFFECTIVE (global) n_envs=128
# = env.n_envs(per rank) * n_gpus, so this file is written for 2x5090 (64*2=128).
# opt steps/iter kept at 16 = n_envs / (segments_per_minibatch * grad_accum) = 64/4.
env:
  n_envs: 64
  obs_spec:
