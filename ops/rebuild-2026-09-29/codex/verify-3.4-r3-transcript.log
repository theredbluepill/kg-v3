+    return obs_spec, action_spec
+
+
+def _spec_names(
+    obs_spec: ObsConfig | KaggricultureObsConfig,
+    action_spec: ActionConfig | KaggricultureActionConfig,
+) -> str:
+    return f"{type(obs_spec).__name__}/{type(action_spec).__name__}"
