+    def sentinel(name: str) -> object:
+        def fail(*_args: object, **_kwargs: object) -> None:
+            calls.append(name)
+            raise AssertionError(f"{name} ran before the startup workload check")
+
+        return fail
+
+    monkeypatch.setattr(
+        sys, "argv", ["run_ppo.py", *argv, "--log-mode", log_mode.value]
