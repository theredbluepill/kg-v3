    44	            case "gelu" | "silu":
    45	                self.up = nn.Linear(config.embed_dim, config.embed_dim)
    46	            case "swiglu":
    47	                self.gate = nn.Linear(config.embed_dim, config.embed_dim)
    48	                self.value = nn.Linear(config.embed_dim, config.embed_dim)
    49	            case _:
    50	                assert_never(self.activation)
    51	        self.out = nn.Linear(config.embed_dim, output_dim)
    52	
    53	    @property
    54	    def weight(self) -> torch.Tensor:
    55	        return self.out.weight
    56	
    57	    @property
    58	    def bias(self) -> torch.Tensor | None:
    59	        return self.out.bias
    60	
    61	    @property
    62	    def out_features(self) -> int:
    63	        return self.out.out_features
