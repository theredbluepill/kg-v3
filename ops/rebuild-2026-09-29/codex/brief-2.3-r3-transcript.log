    77	def sample_launch(
    78	    logits: torch.Tensor,
    79	    active: torch.Tensor,
    80	    *,
    81	    deterministic: bool,
    82	) -> torch.Tensor:
    83	    logits = logits.float()
    84	    if deterministic:
    85	        launch = logits.sigmoid() > 0.5
    86	    else:
    87	        launch = Bernoulli(logits=logits).sample().bool()
    88	
    89	    return launch & active
