    65	    def forward(self, x: torch.Tensor) -> torch.Tensor:
    66	        match self.activation:
    67	            case "gelu":
    68	                return self.out(F.gelu(self.up(x)))
    69	            case "silu":
    70	                return self.out(F.silu(self.up(x)))
    71	            case "swiglu":
    72	                return self.out(F.silu(self.gate(x)) * self.value(x))
    73	            case _:
    74	                assert_never(self.activation)
