    11	class FeedForward(nn.Module):
    12	    def __init__(self, config: Any) -> None:
    13	        super().__init__()
    14	        self.activation: Literal["gelu", "silu", "swiglu"] = config.activation
    15	        hidden_dim = int(config.embed_dim * config.mlp_ratio)
    16	        match self.activation:
    17	            case "gelu" | "silu":
    18	                self.up = nn.Linear(config.embed_dim, hidden_dim)
    19	                self.down = nn.Linear(hidden_dim, config.embed_dim)
    20	            case "swiglu":
    21	                self.gate = nn.Linear(config.embed_dim, hidden_dim)
    22	                self.value = nn.Linear(config.embed_dim, hidden_dim)
    23	                self.down = nn.Linear(hidden_dim, config.embed_dim)
    24	            case _:
    25	                assert_never(self.activation)
    26	
    27	    def forward(self, x: torch.Tensor) -> torch.Tensor:
    28	        match self.activation:
    29	            case "gelu":
    30	                return self.down(F.gelu(self.up(x)))
    31	            case "silu":
    32	                return self.down(F.silu(self.up(x)))
    33	            case "swiglu":
    34	                return self.down(F.silu(self.gate(x)) * self.value(x))
    35	            case _:
    36	                assert_never(self.activation)
