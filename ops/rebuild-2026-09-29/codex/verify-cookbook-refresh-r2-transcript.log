   886	+    path = REPO_ROOT / f"scripts/kaggriculture_parity/{name}.py"
   887	+    spec = importlib.util.spec_from_file_location(f"kaggriculture_parity_{name}", path)
   888	+    assert spec is not None
   889	+    assert spec.loader is not None
   890	+    module = importlib.util.module_from_spec(spec)
   891	+    sys.modules[spec.name] = module
   892	+    spec.loader.exec_module(module)
   893	+    return module
