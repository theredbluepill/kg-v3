  4251	    27	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
  4252	    28	enum DiffKind {
  4253	    29	    Value,
  4254	    30	    KeyOrder,
  4255	    31	}
  4256	    32	
  4257	    33	/// First difference between two JSON trees. Values are compared before key order,
  4258	    34	/// so a changed value is reported as such even when it also moves keys.
  4259	    35	fn first_difference(actual: &Value, expected: &Value, path: &str) -> Option<(DiffKind, String)> {
  4260	    36	    value_difference(actual, expected, path)
  4261	    37	        .map(|path| (DiffKind::Value, path))
  4262	    38	        .or_else(|| order_difference(actual, expected, path).map(|p| (DiffKind::KeyOrder, p)))
  4263	    39	}
  4264	    40	
  4265	    41	fn value_difference(actual: &Value, expected: &Value, path: &str) -> Option<String> {
  4266	    42	    match (actual, expected) {
  4267	    43	        (Value::Object(a), Value::Object(e)) => {
  4268	    44	            for (key, value) in e {
  4269	    45	                let child = format!("{path}.{key}");
  4270	    46	                match a.get(key) {
  4271	    47	                    None => return Some(format!("{child} (missing in Rust)")),
  4272	    48	                    Some(other) => {
  4273	    49	                        if let Some(found) = value_difference(other, value, &child) {
  4274	    50	                            return Some(found);
  4275	    51	                        }
  4276	    52	                    },
  4277	    53	                }
  4278	    54	            }
  4279	    55	            a.keys()
  4280	    56	                .find(|key| !e.contains_key(*key))
  4281	    57	                .map(|key| format!("{path}.{key} (extra in Rust)"))
  4282	    58	        },
  4283	    59	        (Value::Array(a), Value::Array(e)) => {
  4284	    60	            for (index, (value, other)) in a.iter().zip(e).enumerate() {
  4285	    61	                if let Some(found) = value_difference(value, other, &format!("{path}[{index}]")) {
  4286	    62	                    return Some(found);
  4287	    63	                }
  4288	    64	            }
  4289	    65	            (a.len() != e.len()).then(|| format!("{path} (length {} vs {})", a.len(), e.len()))
  4290	    66	        },
  4291	    67	        _ => (actual != expected).then(|| path.to_string()),
  4292	    68	    }
  4293	    69	}
  4294	    70	
  4295	    71	/// `Value` equality ignores object key order, but IndexMap insertion order is
  4296	    72	/// engine state (market inventory/prices, sheds, seeds, inventories, tiles).
  4297	    73	fn order_difference(actual: &Value, expected: &Value, path: &str) -> Option<String> {
  4298	    74	    match (actual, expected) {
  4299	    75	        (Value::Object(a), Value::Object(e)) => {
  4300	    76	            if !a.keys().eq(e.keys()) {
  4301	    77	                return Some(path.to_string());
  4302	    78	            }
  4303	    79	            a.iter()
  4304	    80	                .find_map(|(key, value)| order_difference(value, &e[key], &format!("{path}.{key}")))
  4305	    81	        },
  4306	    82	        (Value::Array(a), Value::Array(e)) => {
  4307	    83	            a.iter()
  4308	    84	                .zip(e)
  4309	    85	                .enumerate()
  4310	    86	                .find_map(|(index, (value, other))| {
  4311	    87	                    order_difference(value, other, &format!("{path}[{index}]"))
  4312	    88	                })
  4313	    89	        },
  4314	    90	        _ => None,
  4315	    91	    }
  4316	    92	}
  4317	    93	
  4318	    94	/// Resolve a reported `label.key[index]...` path (annotations after a space are
  4319	    95	/// ignored) inside the tree that `label` names.
  4320	    96	fn lookup<'a>(root: &'a Value, label: &str, path: &str) -> Option<&'a Value> {
  4321	    97	    let rest = path.strip_prefix(label)?;
  4322	    98	    let rest = rest.split(' ').next().unwrap_or(rest);
  4323	    99	    let mut node = root;
  4324	   100	    let mut chars = rest.chars().peekable();
  4325	   101	    while let Some(c) = chars.next() {
  4326	   102	        let mut token = String::new();
  4327	   103	        while let Some(&next) = chars.peek() {
  4328	   104	            if next == '.' || next == '[' || (c == '[' && next == ']') {
  4329	   105	                break;
  4330	   106	            }
  4331	   107	            token.push(next);
  4332	   108	            chars.next();
  4333	   109	        }
  4334	   110	        node = match c {
  4335	   111	            '.' => node.get(token.as_str())?,
  4336	   112	            '[' => {
  4337	   113	                chars.next();
  4338	   114	                node.get(token.parse::<usize>().ok()?)?
  4339	   115	            },
  4340	   116	            _ => return None,
  4341	   117	        };
  4342	   118	    }
  4343	   119	    Some(node)
  4344	   120	}
