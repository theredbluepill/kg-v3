  4232	     8	//! Replay parity against Kaggle's Python engine (`kaggle-environments==1.32.7`).
  4233	     9	//!
  4234	    10	//! One comparator serves three trace sources: the four recorded official episodes,
  4235	    11	//! the committed traces that `scripts/kaggriculture_parity/generate_traces.py`
  4236	    12	//! produced by running Kaggle's engine live, and an optional sweep directory named
  4237	    13	//! by `KAGG_PARITY_TRACES`. Generated traces may also contain `rejected` records:
  4238	    14	//! Python's interpreter raised on those actions, so Kaggle kept the old state, and
  4239	    15	//! Rust must return an error without mutating its state.
  4240	    16	
  4241	    17	use kaggriculture_engine::{ATTRIB_FIELDS, Config, ECON_FIELDS, ECON_PASS, Game, TraceHeader};
  4242	    18	use serde_json::{Value, json};
  4243	    19	use std::fmt;
  4244	    20	use std::path::{Path, PathBuf};
  4245	    21	use std::process::Command;
  4246	    22	
  4247	    23	const MODULE_VERSION: &str = "1.32.7";
  4248	    24	const ENGINE_SHA256: &str = "bc8a54879ef02c7ea64b8b333d6a976f0ea65c4949149d01f463f23bccee653e";
