  4644	   410	/// A rejected step must leave the complete state untouched: public and private
  4645	   411	/// trees (values and map key order, which `Value` equality ignores), statuses,
  4646	   412	/// rewards and completion.
  4647	   413	fn rollback_difference(
  4648	   414	    before: &StateView,
  4649	   415	    after: &StateView,
  4650	   416	    line: usize,
  4651	   417	    from_step: Option<usize>,
  4652	   418	) -> Result<(), Divergence> {
  4653	   419	    let mutated = |divergence: Divergence| Divergence {
  4654	   420	        kind: format!("rust_mutated {}", divergence.kind),
  4655	   421	        ..divergence
  4656	   422	    };
  4657	   423	    compare_tree(&after.public, &before.public, "public", line, from_step).map_err(mutated)?;
  4658	   424	    compare_tree(
  4659	   425	        &after.privates,
  4660	   426	        &before.privates,
  4661	   427	        "private",
  4662	   428	        line,
  4663	   429	        from_step,
  4664	   430	    )
  4665	   431	    .map_err(mutated)?;
  4666	   432	    let scalar = |field: &str, expected: String, actual: String| {
  4667	   433	        Err(Divergence::new(line, from_step, "rust_mutated", field).values(expected, actual))
  4668	   434	    };
  4669	   435	    if after.statuses != before.statuses {
  4670	   436	        return scalar(
  4671	   437	            "statuses",
  4672	   438	            format!("{:?}", before.statuses),
  4673	   439	            format!("{:?}", after.statuses),
  4674	   440	        );
  4675	   441	    }
  4676	   442	    if after.rewards != before.rewards {
  4677	   443	        return scalar(
  4678	   444	            "rewards",
  4679	   445	            format!("{:?}", before.rewards),
  4680	   446	            format!("{:?}", after.rewards),
  4681	   447	        );
  4682	   448	    }
  4683	   449	    if after.done != before.done {
  4684	   450	        return scalar("done", before.done.to_string(), after.done.to_string());
  4685	   451	    }
  4686	   452	    Ok(())
  4687	   453	}
