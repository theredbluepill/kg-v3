  3352	   860	def encode_trace(records: list[dict[str, Any]]) -> bytes:
  3353	   861	    """Deterministic gzip JSONL (fixed mtime, no filename) for stable hashes."""
  3354	   862	    text = "".join(
  3355	   863	        json.dumps(record, separators=(",", ":"), allow_nan=False) + "\n"
  3356	   864	        for record in records
  3357	   865	    )
  3358	   866	    buffer = io.BytesIO()
  3359	   867	    with gzip.GzipFile(filename="", mode="wb", fileobj=buffer, mtime=0) as handle:
  3360	   868	        handle.write(text.encode("utf-8"))
  3361	   869	    return buffer.getvalue()
