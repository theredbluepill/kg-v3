   918	+def test_hash_guard_accepts_only_the_pinned_engine(tmp_path: Path) -> None:
   919	+    engine = tmp_path / "kaggriculture.py"
   920	+    engine.write_bytes(b"pinned engine bytes\n")
   921	+    digest = hashlib.sha256(engine.read_bytes()).hexdigest()
   922	+    pin = generator.EnginePin(version="1.32.7", sha256=digest)
   923	+    assert generator.verify_engine(engine, "1.32.7", pin) == digest
   924	+
   925	+    engine.write_bytes(b"pinned engine bytes, edited\n")
   926	+    with pytest.raises(generator.ParityGeneratorError, match="Refusing to generate"):
   927	+        generator.verify_engine(engine, "1.32.7", pin)
