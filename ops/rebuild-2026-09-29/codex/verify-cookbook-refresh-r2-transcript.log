  4346	   122	fn excerpt(value: Option<&Value>) -> String {
  4347	   123	    let text = value.map_or_else(|| "<absent>".to_string(), Value::to_string);
  4348	   124	    if text.chars().count() > 200 {
  4349	   125	        format!("{}…", text.chars().take(200).collect::<String>())
  4350	   126	    } else {
  4351	   127	        text
  4352	   128	    }
  4353	   129	}
