  4414	   190	    match first_difference(actual, expected, label) {
  4415	   191	        None => Ok(()),
  4416	   192	        Some((kind, path)) => {
  4417	   193	            let name = match kind {
  4418	   194	                DiffKind::Value => format!("{label} state"),
  4419	   195	                DiffKind::KeyOrder => format!("{label} map key order"),
  4420	   196	            };
