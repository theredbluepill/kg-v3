   441	+isolated ``kaggle-environments==1.32.7`` environment, replays every trace in the
   442	+Rust kernel, and writes a JSON summary with per-policy counts and each trace's
   443	+first divergence (step, field, expected and actual). Single process, CPU only::
   444	+
   445	+    uv run python scripts/kaggriculture_parity/sweep.py --games 40
   446	+"""
   447	+
   448	+from __future__ import annotations
   449	+
   450	+import argparse
   451	+import gzip
   452	+import json
   453	+import os
   454	+import platform
   455	+import subprocess
   456	+import sys
   457	+import time
   458	+from collections import Counter, defaultdict
   459	+from pathlib import Path
   460	+from typing import Any
   461	+
   462	+REPO_ROOT = Path(__file__).resolve().parents[2]
   463	+GENERATOR = REPO_ROOT / "scripts/kaggriculture_parity/generate_traces.py"
   464	+DEFAULT_OUT = REPO_ROOT / "ops/rebuild-2026-09-29/1.1b"
   465	+DEFAULT_TRACES = REPO_ROOT / "engine_rs/target/kaggriculture-parity/sweep"
   466	+KAGGLE_REQUIREMENT = "kaggle-environments==1.32.7"
   467	+
   468	+
   469	+def isolated_python() -> list[str]:
   470	+    return [
   471	+        "uv",
   472	+        "run",
   473	+        "--isolated",
   474	+        "--no-project",
   475	+        "--with",
   476	+        KAGGLE_REQUIREMENT,
   477	+        "python",
   478	+    ]
   479	+
   480	+
   481	+def _run(command: list[str], env: dict[str, str] | None = None) -> float:
   482	+    started = time.perf_counter()
   483	+    print("+", " ".join(command), flush=True)
   484	+    subprocess.run(command, cwd=REPO_ROOT, env=env, check=True)
   485	+    return time.perf_counter() - started
   486	+
   487	+
   488	+def _strings(value: Any) -> list[str]:
   489	+    if isinstance(value, str):
   490	+        return [value]
   491	+    if isinstance(value, list):
   492	+        return [text for item in value for text in _strings(item)]
   493	+    if isinstance(value, dict):
   494	+        return [text for item in value.values() for text in _strings(item)]
   495	+    return []
   496	+
   497	+
   498	+def _commands(action: Any) -> tuple[list[Any], list[Any]]:
   499	+    """(unit commands, market orders) of one submitted action."""
   500	+    if not isinstance(action, dict):
   501	+        return [], []
   502	+    hands = action.get("hands")
   503	+    market = action.get("market")
   504	+    units = [action.get("farmer"), *(hands if isinstance(hands, list) else [])]
   505	+    return units, market if isinstance(market, list) else []
   506	+
   507	+
   508	+def _unhashable(value: Any) -> bool:
   509	+    return isinstance(value, list | dict)
   510	+
   511	+
   512	+def _is_unicode_digits(text: str) -> bool:
   513	+    return any(not c.isascii() for c in text) and text.strip().isdecimal()
   514	+
   515	+
   516	+def _has_d1(actions: list[Any]) -> bool:
   517	+    return any(_is_unicode_digits(text) for text in _strings(actions))
   518	+
   519	+
   520	+def _has_d2(actions: list[Any]) -> bool:
   521	+    for action in actions:
   522	+        units, orders = _commands(action)
   523	+        for command in units:
   524	+            if not isinstance(command, list) or not command:
   525	+                continue
   526	+            if _unhashable(command[0]):
   527	+                return True
   528	+            if (
   529	+                command[0] in ("PLANT", "PICKUP", "PLACE")
   530	+                and len(command) >= 2
   531	+                and _unhashable(command[1])
   532	+            ):
   533	+                return True
   534	+        for order in orders:
   535	+            if (
   536	+                isinstance(order, list)
   537	+                and len(order) >= 3
   538	+                and order[0] in ("BUY_SEED", "BUY_ANIMAL")
   539	+                and _unhashable(order[1])
   540	+            ):
   541	+                return True
   542	+    return False
   543	+
   544	+
   545	+def input_classes(actions: list[Any]) -> list[str]:
   546	+    """Documented divergence classes whose inputs occur in a step's actions.
   547	+
   548	+    D1: a non-ASCII Unicode decimal digit string (Python int() accepts it).
   549	+    D2: an unhashable verb or item that reaches one of Python's dict lookups:
   550	+    a unit verb, a PLANT/PICKUP/PLACE item, or a BUY_SEED/BUY_ANIMAL item.
   551	+
   552	+    An input match alone never classifies a divergence; see ``confirmed_class``.
   553	+    """
   554	+    return [
   555	+        name
   556	+        for name, present in (("D1", _has_d1(actions)), ("D2", _has_d2(actions)))
   557	+        if present
   558	+    ]
   559	+
   560	+
   561	+def ascii_digits(value: Any) -> Any:
   562	+    """Replace each Unicode digit string with the ASCII digits Python int() reads."""
   563	+    if isinstance(value, str):
   564	+        return str(int(value)) if _is_unicode_digits(value) else value
   565	+    if isinstance(value, list):
   566	+        return [ascii_digits(item) for item in value]
   567	+    if isinstance(value, dict):
   568	+        return {key: ascii_digits(item) for key, item in value.items()}
   569	+    return value
   570	+
   571	+
   572	+def _d2_observed(record: dict[str, Any], divergence: dict[str, Any]) -> bool:
   573	+    """D2's mismatch: Python raised an unhashable TypeError; Rust accepted."""
   574	+    return (
   575	+        record.get("type") == "rejected"
   576	+        and str(record.get("python_error", "")).startswith("TypeError: unhashable type")
   577	+        and divergence["kind"] == "rust_accepted"
   578	+        and divergence["field"] == "step"
   579	+    )
   580	+
   581	+
   582	+def _d1_observed(
   583	+    record: dict[str, Any],
   584	+    divergence: dict[str, Any],
   585	+    recheck: dict[str, Any] | None,
   586	+) -> bool:
   587	+    """D1's mismatch: Python acted on the step, and an ASCII recheck passes it.
   588	+
   589	+    The recheck is the same trace with only that line's Unicode digits spelled
   590	+    in ASCII; it must get Rust past the divergent line.
   591	+    """
   592	+    if record.get("type") != "transition" or recheck is None:
   593	+        return False
   594	+    return bool(recheck["ok"]) or recheck["divergence"]["line"] > divergence["line"]
   595	+
   596	+
   597	+def confirmed_class(
   598	+    record: dict[str, Any],
   599	+    divergence: dict[str, Any],
   600	+    recheck: dict[str, Any] | None,
   601	+) -> str | None:
   602	+    """The documented class that explains the observed first divergence, if any."""
   603	+    actions = record.get("actions")
   604	+    classes = input_classes(actions if isinstance(actions, list) else [])
   605	+    if "D2" in classes and _d2_observed(record, divergence):
   606	+        return "D2"
   607	+    if "D1" in classes and _d1_observed(record, divergence, recheck):
   608	+        return "D1"
   609	+    return None
   610	+
   611	+
   612	+def write_d1_rechecks(
   613	+    report: list[dict[str, Any]], traces_dir: Path, recheck_dir: Path
   614	+) -> list[str]:
   615	+    """Write ASCII rechecks of traces whose divergent line has D1 inputs.
   616	+
   617	+    Each copy in ``recheck_dir`` rewrites only that line's Unicode digits in
   618	+    ASCII. Returns the rewritten trace names.
   619	+    """
   620	+    names = []
   621	+    for result in report:
   622	+        if result["ok"]:
   623	+            continue
   624	+        line = result["divergence"]["line"]
   625	+        with gzip.open(traces_dir / result["file"], "rt", encoding="utf-8") as handle:
   626	+            records = [json.loads(text) for text in handle]
   627	+        if line == 0 or line >= len(records):
   628	+            continue
   629	+        actions = records[line].get("actions")
   630	+        if not isinstance(actions, list) or "D1" not in input_classes(actions):
   631	+            continue
   632	+        records[line] = {**records[line], "actions": ascii_digits(actions)}
   633	+        recheck_dir.mkdir(parents=True, exist_ok=True)
   634	+        text = "".join(
   635	+            json.dumps(record, separators=(",", ":"), allow_nan=False) + "\n"
   636	+            for record in records
   637	+        )
   638	+        with gzip.GzipFile(recheck_dir / result["file"], "wb", mtime=0) as handle:
   639	+            handle.write(text.encode("utf-8"))
   640	+        names.append(result["file"])
   641	+    return names
   642	+
   643	+
   644	+def _record(path: Path, line: int) -> dict[str, Any]:
   645	+    with gzip.open(path, "rt", encoding="utf-8") as handle:
   646	+        for index, text in enumerate(handle):
   647	+            if index == line:
   648	+                return dict(json.loads(text))
   649	+    raise ValueError(f"{path}: no line {line}")
   650	+
   651	+
   652	+def summarize(
   653	+    generated: list[dict[str, Any]],
   654	+    report: list[dict[str, Any]],
   655	+    traces_dir: Path,
   656	+    recheck_report: list[dict[str, Any]] | None = None,
   657	+) -> dict[str, Any]:
   658	+    by_file = {entry["path"]: entry for entry in generated}
   659	+    replayed = {entry["file"]: entry for entry in report}
   660	+    rechecked = {entry["file"]: entry for entry in recheck_report or []}
   661	+    missing = sorted(set(by_file) - set(replayed))
   662	+    if missing:
   663	+        raise RuntimeError(f"Rust did not replay: {missing}")
   664	+    policies: dict[str, Counter[str]] = defaultdict(Counter)
   665	+    variants: dict[str, Counter[str]] = defaultdict(Counter)
   666	+    divergences = []
   667	+    for name, entry in sorted(by_file.items()):
   668	+        result = replayed[name]
   669	+        kind = "probe" if "probe" in entry else "game"
   670	+        labels = [
   671	+            "script" if kind == "probe" and seat == 0 else policy
   672	+            for seat, policy in enumerate(entry["policies"])
   673	+        ]
   674	+        for label in labels:
   675	+            policies[label]["seats"] += 1
   676	+        for label in set(labels):
   677	+            policies[label]["probes" if kind == "probe" else "games"] += 1
   678	+            policies[label]["transitions"] += entry["transitions"]
   679	+        variants[entry["config_variant"]]["traces"] += 1
   680	+        variants[entry["config_variant"]]["transitions"] += entry["transitions"]
   681	+        if result["ok"]:
   682	+            continue
   683	+        divergence = result["divergence"]
   684	+        record = _record(traces_dir / name, divergence["line"])
   685	+        divergences.append(
   686	+            {
   687	+                "file": name,
   688	+                "kind": kind,
   689	+                "seed": entry["seed"],
   690	+                "policies": entry["policies"],
   691	+                "config_variant": entry["config_variant"],
   692	+                **({"probe": entry["probe"]} if "probe" in entry else {}),
   693	+                "first_divergence": divergence,
   694	+                "known_class": confirmed_class(record, divergence, rechecked.get(name)),
   695	+            }
   696	+        )
   697	+    games = [e for e in generated if "probe" not in e]
   698	+    probes = [e for e in generated if "probe" in e]
   699	+    new = [d for d in divergences if d["known_class"] is None]
   700	+    return {
   701	+        "games": len(games),
   702	+        "probes": len(probes),
   703	+        "traces": len(generated),
   704	+        "transitions": sum(e["transitions"] for e in generated),
   705	+        "game_transitions": sum(e["transitions"] for e in games),
   706	+        "python_rejected_steps": sum(e["rejected"] for e in generated),
   707	+        "traces_agreeing": sum(1 for r in report if r["ok"]),
   708	+        "traces_diverging": len(divergences),
   709	+        "divergences_by_class": dict(
   710	+            Counter(d["known_class"] or "unclassified" for d in divergences)
   711	+        ),
   712	+        "new_divergences": len(new),
   713	+        "per_policy": {k: dict(v) for k, v in sorted(policies.items())},
   714	+        "per_config_variant": {k: dict(v) for k, v in sorted(variants.items())},
   715	+        "seeds": sorted({e["seed"] for e in games}),
   716	+        "divergences": divergences,
   717	+    }
   718	+
   719	+
   720	+def rust_replay(traces: Path, env: dict[str, str]) -> tuple[int, list[dict[str, Any]]]:
   721	+    """Replay every trace in ``traces`` in Rust; return (exit code, report)."""
   722	+    report_path = traces / "rust-report.json"
   723	+    rust_env = {
   724	+        **env,
   725	+        "KAGG_PARITY_TRACES": str(traces),
   726	+        "KAGG_PARITY_REPORT": str(report_path),
   727	+        "CARGO_BUILD_JOBS": env.get("CARGO_BUILD_JOBS", "3"),
   728	+    }
   729	+    rust = [
   730	+        "cargo",
   731	+        "test",
   732	+        "--manifest-path",
   733	+        "engine_rs/Cargo.toml",
   734	+        "--locked",
   735	+        "--offline",
   736	+        "--test",
   737	+        "replay_parity",
   738	+        "env_directory_traces",
   739	+        "--",
   740	+        "--exact",
   741	+        "--test-threads=1",
   742	+    ]
   743	+    print("+", " ".join(rust), flush=True)
   744	+    status = subprocess.run(rust, cwd=REPO_ROOT, env=rust_env, check=False)
   745	+    if not report_path.is_file():
   746	+        raise SystemExit(
   747	+            f"Rust replay wrote no report (exit {status.returncode}); "
   748	+            "see the cargo output above"
   749	+        )
   750	+    return status.returncode, list(json.loads(report_path.read_text(encoding="utf-8")))
   751	+
   752	+
   753	+def _git(*args: str) -> str:
   754	+    return subprocess.run(
   755	+        ["git", *args], cwd=REPO_ROOT, capture_output=True, text=True, check=True
   756	+    ).stdout.strip()
   757	+
   758	+
   759	+def main(argv: list[str] | None = None) -> int:
   760	+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   761	+    parser.add_argument("--games", type=int, default=40)
   762	+    parser.add_argument("--base-seed", type=int, default=20260929)
   763	+    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
   764	+    parser.add_argument("--traces", type=Path, default=DEFAULT_TRACES)
   765	+    parser.add_argument("--no-probes", action="store_true")
   766	+    parser.add_argument("--include-known-divergences", action="store_true")
   767	+    args = parser.parse_args(argv)
   768	+    # cargo runs the test binary from engine_rs/, so pass absolute paths.
   769	+    args.traces = args.traces.resolve()
   770	+    args.out = args.out.resolve()
   771	+    if args.traces.exists() and any(args.traces.iterdir()):
   772	+        raise SystemExit(f"{args.traces} is not empty; choose a fresh --traces dir")
   773	+    args.traces.mkdir(parents=True, exist_ok=True)
   774	+    args.out.mkdir(parents=True, exist_ok=True)
   775	+    env = {**os.environ, "UV_OFFLINE": os.environ.get("UV_OFFLINE", "1")}
   776	+    started = time.strftime("%Y-%m-%dT%H:%M:%S%z")
   777	+    timings: dict[str, float] = {}
   778	+    games_summary = args.traces / "generated-games.json"
   779	+    command = [
   780	+        *isolated_python(),
   781	+        str(GENERATOR),
   782	+        "--preset",
   783	+        "sweep",
   784	+        "--games",
   785	+        str(args.games),
   786	+        "--base-seed",
   787	+        str(args.base_seed),
   788	+        "--out",
   789	+        str(args.traces),
   790	+        "--summary",
   791	+        str(games_summary),
   792	+    ]
   793	+    if args.include_known_divergences:
   794	+        command.append("--include-known-divergences")
   795	+    timings["generate_games_s"] = _run(command, env)
   796	+    generated = json.loads(games_summary.read_text(encoding="utf-8"))
   797	+    if not args.no_probes:
   798	+        probes_summary = args.traces / "generated-probes.json"
   799	+        timings["generate_probes_s"] = _run(
   800	+            [
   801	+                *isolated_python(),
   802	+                str(GENERATOR),
   803	+                "--preset",
   804	+                "probes",
   805	+                "--out",
   806	+                str(args.traces),
   807	+                "--summary",
   808	+                str(probes_summary),
   809	+            ],
   810	+            env,
   811	+        )
   812	+        generated += json.loads(probes_summary.read_text(encoding="utf-8"))
   813	+    started_rust = time.perf_counter()
   814	+    rust_exit, report = rust_replay(args.traces, env)
   815	+    timings["rust_replay_s"] = time.perf_counter() - started_rust
   816	+    # A D1 input on the divergent line classifies it only if spelling those
   817	+    # digits in ASCII (what Python's int() read) gets Rust past that line.
   818	+    recheck_dir = args.traces / "d1-recheck"
   819	+    recheck_report = None
   820	+    if write_d1_rechecks(report, args.traces, recheck_dir):
   821	+        started_recheck = time.perf_counter()
   822	+        _, recheck_report = rust_replay(recheck_dir, env)
   823	+        timings["rust_d1_recheck_s"] = time.perf_counter() - started_recheck
   824	+    summary = {
   825	+        "sweep": "kaggriculture-live-differential-parity",
   826	+        "started": started,
   827	+        "git_head": _git("rev-parse", "HEAD"),
   828	+        "git_dirty_paths": _git("status", "--porcelain").splitlines(),
   829	+        "python_engine": KAGGLE_REQUIREMENT,
   830	+        "platform": platform.platform(),
   831	+        "arguments": {
   832	+            "games": args.games,
   833	+            "base_seed": args.base_seed,
   834	+            "probes": not args.no_probes,
   835	+            "include_known_divergences": args.include_known_divergences,
   836	+            "traces_dir": str(args.traces),
   837	+        },
   838	+        "rust_test_exit_code": rust_exit,
   839	+        "timings": {key: round(value, 2) for key, value in timings.items()},
   840	+        **summarize(generated, report, args.traces, recheck_report),
   841	+    }
   842	+    output = args.out / "sweep-summary.json"
   843	+    output.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
   844	+    print(
   845	+        f"{summary['traces']} traces ({summary['games']} games, {summary['probes']} "
   846	+        f"probes), {summary['transitions']} transitions: {summary['traces_agreeing']} "
   847	+        f"agree, {summary['traces_diverging']} diverge "
   848	+        f"{summary['divergences_by_class']}; summary {output}"
   849	+    )
   850	+    return 1 if summary["new_divergences"] else 0
   851	+
   852	+
   853	+if __name__ == "__main__":
   854	+    sys.exit(main())
