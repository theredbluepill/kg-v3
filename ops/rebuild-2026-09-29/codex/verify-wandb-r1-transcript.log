diff --git a//private/tmp/verify-wandb-r1/guard/sitecustomize.py b//private/tmp/verify-wandb-r1/guard/sitecustomize.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e5207051e0e96378c8c0335d24451f16f6aca5f
--- /dev/null
+++ b//private/tmp/verify-wandb-r1/guard/sitecustomize.py
@@ -0,0 +1,12 @@
+import os
+import sys
+
+def guard(event, args):
+    if event == 'open' and isinstance(args[0], (str, bytes)):
+        path = os.fsdecode(args[0])
+        if os.path.basename(path) in ('.netrc', '_netrc') and not os.path.realpath(path).startswith(('/private/tmp/', '/private/var/folders/', '/tmp/')):
+            raise RuntimeError('Verifier blocked access to a non-synthetic netrc')
+    if event == 'socket.connect':
+        raise RuntimeError('Verifier blocked network connection')
+
+sys.addaudithook(guard)
