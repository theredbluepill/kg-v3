+    cmd=[str(repo/'.venv/bin/python'), '-m', 'pytest', *tests, '-m', 'not slow', '-q', '-p', 'no:cacheprovider']
+    start=time.monotonic()
+    with (out/f'{name}.log').open('w') as f:
+        p=subprocess.run(cmd, cwd=root, env=env, stdout=f, stderr=subprocess.STDOUT, timeout=115)
+    log=(out/f'{name}.log').read_text()
+    return {'name':name, 'rc':p.returncode, 'seconds':round(time.monotonic()-start,2), 'summary':log.splitlines()[-1], 'failed':[l for l in log.splitlines() if l.startswith('FAILED ')]}
+
+results=[run('scratch_baseline',[L,R])]
+print(json.dumps(results[-1]),flush=True)
+assert results[-1]['rc']==0, 'Scratch baseline failed'
+for name,target,old,new,tests,count in cases:
+    source=originals[target].decode()
+    assert source.count(old)==count,(name,source.count(old))
+    try:
+        targets[target].write_text(source.replace(old,new,count))
+        result=run(name,tests)
+    finally:
+        targets[target].write_bytes(originals[target])
+    result['restored']=targets[target].read_bytes()==originals[target]
+    result['status']='SURVIVED' if result['rc']==0 else 'KILLED' if result['rc']==1 else 'HARNESS ERROR'
+    results.append(result)
+    (out/'mutation-results.json').write_text(json.dumps(results,indent=2)+'\n')
+    print(json.dumps(result),flush=True)
+proof={k:{'scratch_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'repo_sha256':hashlib.sha256((repo/p.relative_to(root)).read_bytes()).hexdigest(),'equal':p.read_bytes()==(repo/p.relative_to(root)).read_bytes()} for k,p in targets.items()}
+(out/'restoration.json').write_text(json.dumps(proof,indent=2)+'\n')
+print('RESTORATION '+json.dumps(proof),flush=True)
+print('MAX_CHILD_RSS_BYTES '+str(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss),flush=True)
