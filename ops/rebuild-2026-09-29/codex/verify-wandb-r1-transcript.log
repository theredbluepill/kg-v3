+(out/'extra-mutation-results.json').write_text(json.dumps(results,indent=2)+'\n')
+print('MAX_CHILD_RSS_BYTES '+str(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss),flush=True)
