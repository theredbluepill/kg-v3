+        (root/path).symlink_to(repo/path)
+targets = {'L':root/'python/owl/train/logging.py', 'R':root/'scripts/run_ppo.py'}
+originals = {k:v.read_bytes() for k,v in targets.items()}
+env = {k:v for k,v in os.environ.items() if not k.startswith('WANDB_') and k != 'NETRC'}
+env.update(OMP_NUM_THREADS='2', NETRC=str(out/'empty.netrc'), PYTHONPATH=f'{out}/guard:{root}/python', PYTHONDONTWRITEBYTECODE='1')
+L='tests/owl/train/test_logging.py'
+R='tests/scripts/test_run_ppo.py'
+cases=[]
+def add(name, target, old, new, tests, count=1):
+    cases.append((name,target,old,new,tests,count))
+add('G1_project','L','WANDB_PROJECT = "kg-v3"','WANDB_PROJECT = "orbit-wars"',[L])
+add('G2_env','L','if environ.get("WANDB_API_KEY", "").strip():','if False:',[L])
+add('G2_blank','L','if environ.get("WANDB_API_KEY", "").strip():','if environ.get("WANDB_API_KEY", ""):',[L])
+add('G2_password','L','if entry is None or not entry[2]:','if entry is None:',[L])
+add('G2_NETRC','L','configured = environ.get("NETRC")','configured = None',[L])
+add('G2_host','L','base_url = environ.get("WANDB_BASE_URL") or DEFAULT_WANDB_BASE_URL','base_url = DEFAULT_WANDB_BASE_URL',[L])
+add('G2_require','L','if source is None:','if False:',[L])
+add('G3_sanitize','L','f"cannot parse {netrc_path} (line {error.lineno}); repair it with "','f"cannot parse {netrc_path}: {error}; repair it with "',[L])
+add('G4_banner','L','print(telemetry_outage_banner(mode), file=sys.stderr, flush=True)','pass',[L,R])
+add('G5_env_mode','L','if mode is not TelemetryMode.DISABLED and env_mode and env_mode != wandb_mode:','if False:',[L])
+add('G6_debug_offline','L','if wandb_mode != WandbMode.ONLINE:','if False:',[L,R])
+add('G7_resume_id','R','if args.output_dir is None and args.experiment_id is not None:','if False:',[R])
+add('G8_fresh','L','if path.exists():','if False:',[L])
+add('G8_missing','L','raise FileNotFoundError(f"resume needs the run\'s attempt records: {path}")','return []',[L])
+add('G8_changed_id','L','if experiment_id is not None and experiment_id != recorded_id:','if False:',[L])
+add('G8_regex','L','if not _EXPERIMENT_ID_RE.fullmatch(experiment_id):','if False:',[L,R])
+add('G9_schema','L','if not isinstance(record, dict) or set(record) != _ATTEMPT_KEYS:','if False:',[L])
+add('G9_order','L','if record["attempt"] != index:','if False:',[L])
+add('G10_mismatch','L','if (run is None) != (identity.telemetry is TelemetryMode.DISABLED):','if False:',[L])
+add('G10_telemetry','L','"telemetry_mode": str(identity.telemetry),','"telemetry_mode": "disabled",',[L,R])
+add('G11_gate_order','R','telemetry = _check_launch_telemetry(args, distributed)','telemetry = telemetry_mode(args.log_mode, args.wandb_mode)',[R])
+add('G12_record','R','receipt = record_attempt(\n            run_dir, identity, logger, start_env_steps=start_env_steps\n        )','receipt = run_dir / "attempts.jsonl"',[R])
+add('G12_outage','R','if identity.telemetry.is_outage:','if False:',[R])
+add('G13_group','L','group=identity.experiment_id,','group="wrong",',[L])
+add('G13_job_type','L','job_type=identity.job_type,','job_type="wrong",',[L])
+add('G13_tags','L','tags=[V3_TAG, identity.job_type, game],','tags=[],',[L])
+add('G13_config','L','config={**config, "v3": identity.wandb_config()},','config=dict(config),',[L])
+add('G13_summary','L','self._run.summary[key] = value','pass',[L])
+add('G13_mode','L','mode=_wandb_init_mode(mode),','mode="offline",',[L])
+add('G14_consistency','L','if identity.telemetry is not TelemetryMode.DISABLED:','if False:',[L])
+
+def run(name, tests):
+    cmd=[str(repo/'.venv/bin/python'), '-m', 'pytest', *tests, '-m', 'not slow', '-q', '-p', 'no:cacheprovider']
+    start=time.monotonic()
+    with (out/f'{name}.log').open('w') as f:
+        p=subprocess.run(cmd, cwd=root, env=env, stdout=f, stderr=subprocess.STDOUT, timeout=115)
+    log=(out/f'{name}.log').read_text()
+    return {'name':name, 'rc':p.returncode, 'seconds':round(time.monotonic()-start,2), 'summary':log.splitlines()[-1], 'failed':[l for l in log.splitlines() if l.startswith('FAILED ')]}
