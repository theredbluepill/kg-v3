+    (root/parent).mkdir(parents=True, exist_ok=True)
+if not (root/'python/owl').exists():
+    shutil.copytree(repo/'python/owl', root/'python/owl', ignore=shutil.ignore_patterns('__pycache__'))
+for path in ('scripts/run_ppo.py', 'tests/owl/train/test_logging.py', 'tests/scripts/test_run_ppo.py', 'tests/conftest.py', 'pyproject.toml'):
+    shutil.copy2(repo/path, root/path)
