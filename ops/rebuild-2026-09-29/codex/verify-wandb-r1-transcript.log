+add('G2_host','L','base_url = environ.get("WANDB_BASE_URL") or DEFAULT_WANDB_BASE_URL','base_url = DEFAULT_WANDB_BASE_URL',[L])
+add('G2_require','L','if source is None:','if False:',[L])
+add('G3_sanitize','L','f"cannot parse {netrc_path} (line {error.lineno}); repair it with "','f"cannot parse {netrc_path}: {error}; repair it with "',[L])
+add('G4_banner','L','print(telemetry_outage_banner(mode), file=sys.stderr, flush=True)','pass',[L,R])
+add('G5_env_mode','L','if mode is not TelemetryMode.DISABLED and env_mode and env_mode != wandb_mode:','if False:',[L])
+add('G6_debug_offline','L','if wandb_mode != WandbMode.ONLINE:','if False:',[L,R])
+add('G7_resume_id','R','if args.output_dir is None and args.experiment_id is not None:','if False:',[R])
+add('G8_fresh','L','if path.exists():','if False:',[L])
+add('G8_missing','L','raise FileNotFoundError(f"resume needs the run\'s attempt records: {path}")','return []',[L])
+add('G8_changed_id','L','if experiment_id is not None and experiment_id != recorded_id:','if False:',[L])
+add('G8_regex','L','if not _EXPERIMENT_ID_RE.fullmatch(experiment_id):','if False:',[L,R])
+add('G9_schema','L','if not isinstance(record, dict) or set(record) != _ATTEMPT_KEYS:','if False:',[L])
+add('G9_order','L','if record["attempt"] != index:','if False:',[L])
