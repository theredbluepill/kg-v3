diff --git a//private/tmp/verify-wandb-r1/run_check.py b//private/tmp/verify-wandb-r1/run_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f582127b3200f3e5f902bad2a5bc13f25e3d2d5
--- /dev/null
+++ b//private/tmp/verify-wandb-r1/run_check.py
@@ -0,0 +1,28 @@
+import os
+import resource
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+root = Path('/Users/poonszesen/kg-v3-wandb')
+scratch = Path('/private/tmp/verify-wandb-r1')
+label, *cmd = sys.argv[1:]
+env = {k:v for k,v in os.environ.items() if not k.startswith('WANDB_') and k != 'NETRC'}
+env.update(OMP_NUM_THREADS='2', NETRC=str(scratch/'empty.netrc'), PYTHONPATH=str(scratch/'guard'), UV_OFFLINE='1', PYTHONDONTWRITEBYTECODE='1', UV_CACHE_DIR='/Users/poonszesen/.cache/uv')
+start = time.monotonic()
+peak = 0
+reason = None
+with (scratch/f'{label}.log').open('w') as log:
+    p = subprocess.Popen(cmd, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+    try:
+        rc = p.wait(timeout=118)
+    except subprocess.TimeoutExpired:
+        reason = 'time bound reached'
+        os.killpg(p.pid, signal.SIGTERM)
+        rc = p.wait(timeout=2)
+peak = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+print(f'{label}: rc={rc}, seconds={time.monotonic()-start:.2f}, child_peak_rss_bytes={peak}, stopped={reason}')
+print((scratch/f'{label}.log').read_text()[-6000:])
+sys.exit(rc)
diff --git a//private/tmp/verify-wandb-r1/test_verifier.py b//private/tmp/verify-wandb-r1/test_verifier.py
new file mode 100644
index 0000000000000000000000000000000000000000..6a2377c4300997643be49a1e947c3355b33d980f
--- /dev/null
+++ b//private/tmp/verify-wandb-r1/test_verifier.py
@@ -0,0 +1,78 @@
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+from contextlib import nullcontext
+from argparse import Namespace
+from types import SimpleNamespace
+
+import pytest
+import torch
+from owl.train import FullConfig
+import owl.train.logging as log
+
+ROOT=Path('/Users/poonszesen/kg-v3-wandb')
+spec=importlib.util.spec_from_file_location('verifier_run_ppo',ROOT/'scripts/run_ppo.py')
+run=importlib.util.module_from_spec(spec)
+sys.modules[spec.name]=run
+spec.loader.exec_module(run)
+
+def identity():
+    return log.RunIdentity('exp','ppo',0,'source',('source',),'f'*64,log.TelemetryMode.DISABLED)
+
+def test_attempt_order_is_rejected(tmp_path):
+    path=log.record_attempt(tmp_path,identity(),log.DebugLogger(),start_env_steps=0)
+    record=json.loads(path.read_text())
+    record['attempt']=1
+    path.write_text(json.dumps(record)+'\n')
+    with pytest.raises(ValueError,match='not attempt 0'):
+        log.read_attempts(path)
+
+@pytest.mark.parametrize('field,value',[('attempt',False),('experiment_id',['invalid']),('telemetry_mode','made-up'),('config_sha256',None)])
+def test_receipt_schema_rejects_bad_values(tmp_path,field,value):
+    path=log.record_attempt(tmp_path,identity(),log.DebugLogger(),start_env_steps=0)
+    record=json.loads(path.read_text())
+    record[field]=value
+    path.write_text(json.dumps(record)+'\n')
+    with pytest.raises(ValueError):
+        log.read_attempts(path)
+
+def test_receipt_rejects_changed_historical_identity(tmp_path):
+    path=log.record_attempt(tmp_path,identity(),log.DebugLogger(),start_env_steps=0)
+    first=json.loads(path.read_text())
+    second={**first,'attempt':1,'experiment_id':'unrelated'}
+    path.write_text(json.dumps(first)+'\n'+json.dumps(second)+'\n')
+    with pytest.raises(ValueError):
+        log.read_attempts(path)
+
+def test_worker_main_never_reads_credentials_or_git(monkeypatch,tmp_path):
+    class StopAtConfig(Exception):
+        pass
+    def forbidden(*args,**kwargs):
+        pytest.fail('worker accessed rank-zero credentials or git')
+    def config(*args,**kwargs):
+        raise StopAtConfig
+    worker=run.DistributedContext(torch.device('cpu'),1,1,2,False)
+    monkeypatch.setattr(sys,'argv',['run_ppo.py',str(ROOT/'configs/kaggriculture_2rank.yaml'),str(tmp_path/'runs')])
+    monkeypatch.setattr(run,'assert_release_build',lambda:None)
+    monkeypatch.setattr(run,'configure_torch',lambda:None)
+    monkeypatch.setattr(run,'distributed_session',lambda:nullcontext(worker))
+    monkeypatch.setattr(run,'check_telemetry',forbidden)
+    monkeypatch.setattr(run,'git_source_commit',forbidden)
+    monkeypatch.setattr(run.FullConfig,'from_file',config)
+    with pytest.raises(StopAtConfig):
+        run.main()
+    assert not (tmp_path/'runs').exists()
+
+@pytest.mark.parametrize('telemetry',[log.TelemetryMode.WANDB_ONLINE,log.TelemetryMode.WANDB_OFFLINE])
+def test_resume_id_and_must_forwarded_unchanged(tmp_path,monkeypatch,telemetry):
+    calls=[]
+    def init(**kwargs):
+        calls.append(kwargs)
+        return SimpleNamespace(summary={})
+    monkeypatch.setitem(sys.modules,'wandb',SimpleNamespace(init=init))
+    ident=log.RunIdentity('exp','ppo',1,'source',('source','source'),'f'*64,telemetry)
+    log.create_metric_logger(tmp_path,config={},game='kaggriculture',identity=ident,resume_run_id='prior')
+    assert calls[0]['id']=='prior'
+    assert calls[0]['resume']=='must'

