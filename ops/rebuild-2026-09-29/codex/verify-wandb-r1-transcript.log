+import os
+import resource
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+root = Path('/Users/poonszesen/kg-v3-wandb')
+scratch = Path('/private/tmp/verify-wandb-r1')
+label, *cmd = sys.argv[1:]
+env = {k:v for k,v in os.environ.items() if not k.startswith('WANDB_') and k != 'NETRC'}
+env.update(OMP_NUM_THREADS='2', NETRC=str(scratch/'empty.netrc'), PYTHONPATH=str(scratch/'guard'), UV_OFFLINE='1', PYTHONDONTWRITEBYTECODE='1', UV_CACHE_DIR='/Users/poonszesen/.cache/uv')
+start = time.monotonic()
+peak = 0
+reason = None
+with (scratch/f'{label}.log').open('w') as log:
+    p = subprocess.Popen(cmd, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+    try:
+        rc = p.wait(timeout=118)
+    except subprocess.TimeoutExpired:
+        reason = 'time bound reached'
+        os.killpg(p.pid, signal.SIGTERM)
+        rc = p.wait(timeout=2)
+peak = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+print(f'{label}: rc={rc}, seconds={time.monotonic()-start:.2f}, child_peak_rss_bytes={peak}, stopped={reason}')
+print((scratch/f'{label}.log').read_text()[-6000:])
+sys.exit(rc)
