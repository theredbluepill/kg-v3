"""Offline public replays -> current Rust features and exact current action grammar."""

import argparse
import hashlib
import json
import zipfile
from collections import Counter
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path

import numpy as np
from owl.kaggriculture.actor_codec import SLOT_NAMES, CodecError, encode_action
from owl.kaggriculture.env import native_seed_header
from owl.kaggriculture.native_bridge import MyolieBuffers
from owl.rs import KaggricultureBatch


def prepare_episode(job):
    archive, record, destination = job
    with zipfile.ZipFile(archive) as z:
        payload = z.read(record["member"])
    assert hashlib.sha256(payload).hexdigest() == record["sha256"]
    d = json.loads(payload)
    shared = [
        k for k, v in d["specification"]["observation"].items() if v.get("shared")
    ]
    configuration = dict(d["configuration"])
    configuration["seed"] = None
    header = native_seed_header(0, configuration)
    rows = []
    contexts = []
    actions = []
    lengths = []
    drops = Counter()
    headers = []
    pending = []

    def flush():
        if not headers:
            return
        batch = KaggricultureBatch(json.dumps(headers), explicit_state=True)
        b = MyolieBuffers(len(headers), observation_version=2)
        try:
            batch.observe(b.features, b.context, b.banks, b.done, 2)
        finally:
            batch.close()
        rows.append(b.features.copy())
        contexts.append(b.context.copy())
        actions.extend(action for action, length in pending)
        lengths.extend(length for action, length in pending)
        headers.clear()
        pending.clear()

    for turn in range(len(d["steps"]) - 1):
        obs = []
        for seat in (0, 1):
            o = dict(d["steps"][turn][seat]["observation"])
            for key in shared:
                o[key] = d["steps"][turn][0]["observation"][key]
            obs.append(o)
        tokens = np.zeros((2, 252, 12), dtype=np.int16)
        lens = np.zeros(2, dtype=np.int16)
        try:
            for seat in (0, 1):
                raw = d["steps"][turn + 1][seat]["action"]
                if not isinstance(raw, dict):
                    raise CodecError("recorded action is not a mapping")
                if set(raw) - {"farmer", "hands", "market"}:
                    raise CodecError("unsupported action keys")
                n = len(obs[seat]["farms"][seat].get("hands") or [])
                hands = raw.get("hands") or []
                if len(hands) > n:
                    raise CodecError("extra hand commands")
                # Omitted units are explicit NONE. Market orders and quantities
                # are never truncated.
                action = {
                    "farmer": raw.get("farmer"),
                    "hands": hands + [None] * (n - len(hands)),
                    "market": raw.get("market") or [],
                }
                encoded = encode_action(
                    action,
                    {"observation": obs[seat], "configuration": configuration},
                    hire_limit=241,
                )
                frames = np.asarray(
                    [[f[k] for k in SLOT_NAMES] for f in encoded["frames"]],
                    dtype=np.int16,
                )
                tokens[seat, : len(frames)] = frames
                lens[seat] = len(frames)
        except (CodecError, ValueError, TypeError, KeyError) as error:
            drops[f"{type(error).__name__}:{error}"] += 1
            continue
        public = {
            k: obs[0][k] for k in ("step", "day", "hour", "farms", "market", "town")
        }
        h = dict(header)
        h["initial"] = {"public": public, "privates": [o["private"] for o in obs]}
        headers.append(h)
        pending.append((tokens, lens))
        if len(headers) == 32:
            flush()
    flush()
    if not rows:
        raise ValueError(f"no admitted turns: {record['member']} {drops}")
    target = (
        Path(destination)
        / record["split"]
        / record["member"].replace("/", "-").replace(".json", ".npz")
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    np.savez(
        target,
        features=np.concatenate(rows),
        context=np.concatenate(contexts),
        tokens=np.asarray(actions),
        lengths=np.asarray(lengths),
    )
    return {
        "member": record["member"],
        "split": record["split"],
        "source_sha256": record["sha256"],
        "turns": len(actions),
        "total_turns": len(d["steps"]) - 1,
        "drops": dict(drops),
        "terminal_banks": d["rewards"],
        "shard": str(target),
        "sha256": hashlib.sha256(target.read_bytes()).hexdigest(),
    }


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("archive")
    parser.add_argument("output")
    parser.add_argument("--workers", type=int, default=8)
    args = parser.parse_args()
    with zipfile.ZipFile(args.archive) as z:
        selection = json.loads(z.read("selection.json"))
    assert len({Path(r["member"]).name for r in selection["episodes"]}) == len(
        selection["episodes"]
    ), "duplicate episode across selected dates"
    out = Path(args.output)
    out.mkdir(parents=True, exist_ok=True)
    with ProcessPoolExecutor(max_workers=args.workers) as pool:
        results = []
        for result in pool.map(
            prepare_episode,
            [(args.archive, r, args.output) for r in selection["episodes"]],
        ):
            results.append(result)
            if len(results) % 28 == 0:
                print(
                    json.dumps(
                        {
                            "episodes": len(results),
                            "admitted_turns": sum(r["turns"] for r in results),
                        }
                    ),
                    flush=True,
                )
    (out / "manifest.json").write_text(
        json.dumps({"selection": selection, "episodes": results}, indent=2) + "\n"
    )
    print(
        json.dumps(
            {
                "episodes": len(results),
                "turns": sum(r["turns"] for r in results),
                "dropped_turns": sum(r["total_turns"] - r["turns"] for r in results),
            }
        ),
        flush=True,
    )
