        dones: PyReadwriteArrayDyn<'_, bool>,
        transition_banks_before: PyReadwriteArrayDyn<'_, f64>,
        transition_banks_after: PyReadwriteArrayDyn<'_, f64>,
        transition_econ_before: PyReadwriteArrayDyn<'_, i64>,
        transition_econ_after: PyReadwriteArrayDyn<'_, i64>,
    ) -> PyResult<()>;
    fn terminal_metrics(&self, py: Python<'_>, env_index: usize)
        -> PyResult<Option<Py<PyDict>>>;
    fn state_snapshot(&self, env_index: usize) -> PyResult<String>;
    fn seed_state(&self, py: Python<'_>) -> PyResult<Py<PyTuple>>;
}

#[pyfunction]
fn kaggriculture_grammar_tables(py: Python<'_>) -> PyResult<Py<PyDict>>;
#[pyfunction]
fn kaggriculture_grammar_constants(py: Python<'_>) -> PyResult<Py<PyTuple>>;
#[pyfunction]
fn kaggriculture_encode(py: Python<'_>, action_json: &str, actors: i64,
    order_limit: i64, hire_limit: i64,
    out: PyReadwriteArrayDyn<'_, i64>) -> PyResult<i64>;
