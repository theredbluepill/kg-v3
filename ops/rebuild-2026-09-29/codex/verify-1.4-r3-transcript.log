        market_product,
        market_float,
        market_int,
        global_features,
        globals_int,
        still_playing,
        order_limits,
        can_act,
    } = src;
    *dst.tile_kind = *tile_kind;
    *dst.tile_crop = *tile_crop;
    *dst.tile_animal = *tile_animal;
    *dst.tile_cell = *tile_cell;
    *dst.tile_role = *tile_role;
    *dst.tiles_int = *tiles_int;
    *dst.tiles_float = *tiles_float;
    *dst.actor_slot = *actor_slot;
