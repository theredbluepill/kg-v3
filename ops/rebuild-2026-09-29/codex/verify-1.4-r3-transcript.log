Concrete binding-level red tests for C/F (module imports fail before the binding lands; no skip):

```python
import numpy as np
import pytest
from owl import rs
from owl.kaggriculture.gpu_grammar import expected_grammar_tables

REWARD = dict(reward_mode="win_loss", econ_shaping=.2,
              econ_starvation_weight=4., econ_drought_weight=1.,
              econ_cap=.25, econ_ineffective_weight=0., econ_ineffective_cap=.10)

def test_constructor_seed_consumption() -> None:
    env = rs.KaggricultureEnv(2, 11, 2, "{}", REWARD, 1, hire_limit=241)
    assert env.seed_state() == (15, (11, 13))
    with pytest.raises(ValueError, match="seed"):
        rs.KaggricultureEnv(1, -1, 1, "{}", REWARD, 1, hire_limit=241)
    with pytest.raises(OverflowError):
        rs.KaggricultureEnv(1, 2**63-1, 1, "{}", REWARD, 1, hire_limit=241)

def test_tables_are_copied_bool_support() -> None:
    actual = rs.kaggriculture_grammar_tables()
    expected = expected_grammar_tables().as_dict()
    assert actual.keys() == expected.keys()
    for key, array in actual.items():
        assert array.dtype == np.bool_ and array.flags.c_contiguous
        np.testing.assert_array_equal(array, expected[key].numpy())

def test_failed_encode_preserves_output() -> None:
    out = np.full((252, 12), 91, dtype=np.int64)
    before = out.tobytes()
    with pytest.raises(ValueError):
        rs.kaggriculture_encode('{"farmer":null,"hands":[],"market":[]}',
                                1, 10, 241, out)
    assert out.tobytes() == before
```

