   124	        "first_call_use_flash_attn": first_flash,
   125	        "warmup_iters": WARMUP,
   126	        "timed_iters": TIMED,
   127	        "cuda_event_ms": ev_ms,
   128	        "median_ms": statistics.median(ev_ms),
   129	        "p90_ms": _pct(ev_ms, 0.9),
   130	        "min_ms": min(ev_ms),
