   135	def _next_hire_cost(hires_today: int) -> int:
   136	    """Engine rule: ``farmHandCostMult * fib(hires_today)``, fib = 1, 1, 2, 3, 5."""
   137	    a, b = 1, 1
   138	    for _ in range(hires_today):
   139	        a, b = b, a + b
   140	    return _FARM_HAND_COST_MULT * a
