    55	def _to(obj: BaseModel, device: torch.device) -> BaseModel:
    56	    fields: dict[str, Any] = {}
    57	    for name in type(obj).model_fields:
    58	        value = getattr(obj, name)
    59	        if isinstance(value, torch.Tensor):
    60	            fields[name] = value.to(device)
    61	        elif isinstance(value, BaseModel):
    62	            fields[name] = _to(value, device)
    63	        else:
    64	            fields[name] = value
    65	    return type(obj)(**fields)
    66	
    67	
    68	def _tile(obj: BaseModel, k: int) -> BaseModel:
    69	    """Repeat every tensor k times along the leading (env) dim."""
    70	    fields: dict[str, Any] = {}
    71	    for name in type(obj).model_fields:
    72	        value = getattr(obj, name)
    73	        if isinstance(value, torch.Tensor):
    74	            fields[name] = value.repeat(k, *([1] * (value.dim() - 1)))
    75	        elif isinstance(value, BaseModel):
    76	            fields[name] = _tile(value, k)
    77	        else:
    78	            fields[name] = value
    79	    return type(obj)(**fields)
