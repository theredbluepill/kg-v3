    58	def _ranked_keys(generator: torch.Generator, counts: torch.Tensor) -> torch.Tensor:
    59	    """IndexMap-style ranks: present keys get 1..k in a random insertion order."""
    60	    present = torch.rand(counts.shape, generator=generator) < 0.6
    61	    counts.mul_(present)
    62	    rank = torch.zeros_like(counts)
    63	    for row in range(counts.shape[0]):
    64	        order = torch.randperm(counts.shape[1], generator=generator)
    65	        keys = [int(k) for k in order if present[row, k]]
    66	        for position, key in enumerate(keys, start=1):
    67	            rank[row, key] = position
    68	    return rank
