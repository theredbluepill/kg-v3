   228	class CachedTeacherDistillationTargets(TeacherTargets):
   229	    """Precomputed frozen-teacher distillation targets for a rollout.
   230	
   231	    Produced once per iteration by ``compute_teacher_distillation_targets`` and
   232	    consumed per update minibatch by ``evaluate_actions_with_cached_teacher`` so
   233	    the teacher trunk runs once instead of once per minibatch. Tensors are stored
   234	    in the same layout as the observations they were computed from (segment-major
   235	    ``[N, T, ...]`` in the PPO trainer); they are sliced per minibatch with
   236	    ``index`` and joined from chunks with ``concat`` (``TeacherTargets``).
   237	    """
   238	
   239	    action_params: DiscreteTargetPolicyParams | None
   240	    winner_probabilities: torch.Tensor | None
   241	
   242	    def index(self, indices: torch.Tensor) -> Self:
   243	        """Slice cached teacher targets along the leading (segment) dimension."""
   244	        action_params = (
   245	            _map_policy_params(self.action_params, lambda tensor: tensor[indices])
   246	            if self.action_params is not None
   247	            else None
   248	        )
   249	        winner_probabilities = (
   250	            self.winner_probabilities[indices]
   251	            if self.winner_probabilities is not None
   252	            else None
   253	        )
   254	        return type(self)(
   255	            action_params=action_params,
   256	            winner_probabilities=winner_probabilities,
   257	        )
   258	
   259	    @classmethod
   260	    def concat(cls, chunks: Sequence[Self]) -> Self:
   261	        """Concatenate per-chunk cached teacher targets along the segment dimension.
   262	
   263	        The first chunk decides which optional targets the result carries. A
   264	        later chunk that lacks one of them raises ``ValueError``; a target that
   265	        only later chunks carry is silently dropped. This asymmetry is inherited
   266	        from Isaiah's ``concat_teacher_distillation_targets`` (32b3ec9) and kept
   267	        until rebuild Phase 4 decides on symmetric validation.
   268	        """
   269	        if not chunks:
   270	            raise ValueError("cannot concatenate an empty list of teacher targets")
   271	        action_params: DiscreteTargetPolicyParams | None = None
   272	        if chunks[0].action_params is not None:
   273	            params: list[DiscreteTargetPolicyParams] = []
   274	            for chunk in chunks:
   275	                if chunk.action_params is None:
   276	                    raise ValueError(
   277	                        "inconsistent action_params across teacher target chunks"
   278	                    )
   279	                params.append(chunk.action_params)
   280	            action_params = DiscreteTargetPolicyParams(
   281	                target_logits=torch.cat([p.target_logits for p in params], dim=0),
   282	                size_mix_logits=torch.cat([p.size_mix_logits for p in params], dim=0),
   283	                size_mu=torch.cat([p.size_mu for p in params], dim=0),
   284	                size_scale=torch.cat([p.size_scale for p in params], dim=0),
   285	                continue_logits=_cat_optional_tensors(
   286	                    [p.continue_logits for p in params]
   287	                ),
   288	            )
   289	        winner_probabilities: torch.Tensor | None = None
   290	        if chunks[0].winner_probabilities is not None:
   291	            winners: list[torch.Tensor] = []
   292	            for chunk in chunks:
   293	                if chunk.winner_probabilities is None:
   294	                    raise ValueError(
   295	                        "inconsistent winner_probabilities across teacher target chunks"
   296	                    )
   297	                winners.append(chunk.winner_probabilities)
   298	            winner_probabilities = torch.cat(winners, dim=0)
   299	        return cls(
   300	            action_params=action_params,
   301	            winner_probabilities=winner_probabilities,
   302	        )
