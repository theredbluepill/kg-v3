+        assert tensor.dtype == torch.int64
+        assert tensor.device.type == "cpu"
+        assert tensor.is_contiguous()
+        assert torch.equal(tensor[use_a], first[use_a])
+        assert torch.equal(tensor[~use_a], second[~use_a])
