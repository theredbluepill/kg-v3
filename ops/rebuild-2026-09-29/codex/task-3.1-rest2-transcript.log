+            "model.embed_dim": 16,
+            "model.depth": 1,
+            "model.n_heads": 1,
+            "model.mlp_ratio": 1,
+            "model.n_scratch_tokens": 0,
+            "rl.dtype": "float32",
+            "rl.model_compile": "none",
+            "rl.segments_per_minibatch": 1,
+            "rl.gradient_accumulation_steps": 1,
