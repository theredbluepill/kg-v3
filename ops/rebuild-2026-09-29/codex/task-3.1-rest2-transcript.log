+        _CONFIGS / "kaggriculture.yaml",
+        overrides={
+            "env.n_envs": 2, "env.native_threads": 1,
+            "env.pin_memory": False, "env.config.episodeSteps": 3,
+            "model.embed_dim": 16, "model.depth": 1, "model.n_heads": 1,
+            "model.mlp_ratio": 1, "model.n_scratch_tokens": 0,
+            "rl.dtype": "float32", "rl.model_compile": "none",
