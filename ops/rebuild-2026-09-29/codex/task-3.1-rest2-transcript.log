) -> ActionBundle:
    actions, _hidden_current, _hidden_last_best = (
        _eval_actions_for_assignments_and_hidden(
            obs,
            assignments,
            current_model=current_model,
            last_best_model=last_best_model,
            hidden_current=None,
            hidden_last_best=None,
            config=config,
            device=device,
        )
    )
