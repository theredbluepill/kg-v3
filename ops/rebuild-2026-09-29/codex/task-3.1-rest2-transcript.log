+    width = cfg.env.n_envs * ctx.world_size
+    update = width * cfg.rl.horizon
+    worst_steps = limit + update - 1
+    assert cfg.env.seed + 2 * width + 2 * worst_steps <= 2**62
+    assert worst_steps < 2**61
