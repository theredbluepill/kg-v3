    orbit_output: ModelOutput[ActionBundle] = kagg.forward(kobs)  # E
    del as_orbit, orbit_output


def mixed_specs(config: KaggricultureTransformerConfig) -> None:
    KaggricultureTransformer(
        config,
        obs_spec=EntityBasedConfig(),  # E
