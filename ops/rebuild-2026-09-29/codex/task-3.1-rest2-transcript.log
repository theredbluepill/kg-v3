+    ):
+        assert torch.isfinite(torch.tensor([candidate, incumbent, margin])).all()
+        assert candidate - incumbent == margin
+    logged = run_ppo._eval_env_metrics(metrics)
+    assert logged["eval/candidate_bank_margin"] == sum(margins) / 2
 
 
