+    )
+    last_best = run_ppo._create_eval_model_from_weights(
+        current, cfg, device=torch.device("cpu")
+    )
+    current.eval()
+    with torch.no_grad():
+        stats, by_count, metrics, steps = run_ppo._evaluate_games(
+            current_model=current,
+            last_best_model=last_best,
+            cfg=cfg,
+            n_games=2,
