+    monkeypatch.setattr(run_ppo, "broadcast_object", lambda _obj, _ctx: tmp_path)
+    seen: list[tuple[object, dict[str, object]]] = []
+
+    def factory(config: object, **kwargs: object) -> None:
+        seen.append((config, kwargs))
