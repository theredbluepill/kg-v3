+fn semantic_numbers_are_exact_without_float_seed_rounding() {
+    let number = |s: &str| serde_json::from_str::<Value>(s).unwrap();
+    assert!(compare_tree(&number("0.00001"), &number("1e-5"), "/number").is_ok());
