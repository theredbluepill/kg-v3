+        let tape = replay_export::ActionTape::parse(&tape).map_err(|e| e.to_string())?;
+        replay_export::export_kaggle_episode(&header, &tape)
+            .map(|v| v.to_string())
+            .map_err(|e| e.to_string())
+    })
