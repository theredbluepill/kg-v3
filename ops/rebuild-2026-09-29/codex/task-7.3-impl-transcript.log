+}
+
+#[test]
+fn typed_tape_rejects_token_seat_count_without_panicking() {
+    let h = SeedHeader::parse(&header_json()).unwrap();
+    for n in [0, 1, 3] {
+        let mut tape = ActionTape::parse(&tape_json(1, false)).unwrap();
+        let p = super::grammar::plan(1, 10, 21).unwrap();
