+#[pyfunction]
+fn export_kaggriculture_episode(
+    py: Python<'_>,
+    seed_header_json: &str,
+    tape_json: &str,
+) -> PyResult<String> {
+    validate_replay_framework(py, seed_header_json, false)?;
+    py.detach(|| {
+        let header: Value = serde_json::from_str(seed_header_json).map_err(|e| e.to_string())?;
