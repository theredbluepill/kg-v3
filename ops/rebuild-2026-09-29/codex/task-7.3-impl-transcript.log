+    PyModule::import(py, "owl.kaggriculture.replay_export")
+        .and_then(|module| module.call_method1("validate_native_replay_input", (json, episode)))
+        .map(|_| ())
+        .map_err(|error| PyValueError::new_err(error.to_string()))
 }
