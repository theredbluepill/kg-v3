+    py.detach(|| {
+        let captured: Option<Value> = captured_json.map(serde_json::from_str).transpose().map_err(|e| e.to_string())?;
+        replay_export::verify_round_trip(episode_json, captured.as_ref()).map(|v| v.to_string()).map_err(|e| e.to_string())
+    }).map_err(PyValueError::new_err)
 }
