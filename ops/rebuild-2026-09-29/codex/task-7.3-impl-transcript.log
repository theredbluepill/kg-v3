+            .find_map(|(i, (a, e))| number_spelling_difference(a, e, &format!("{p}/{i}"))),
+        (Value::Number(a), Value::Number(e)) => {
+            let actual = a.to_string();
+            let expected = e.to_string();
+            (actual != expected).then(|| Divergence::new(p, "canonical number bytes differ"))
+        },
+        _ => None,
+    }
