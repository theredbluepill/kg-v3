+fn number_spelling_difference(actual: &Value, expected: &Value, p: &str) -> Option<Divergence> {
+    match (actual, expected) {
+        (Value::Object(a), Value::Object(e)) => a.iter().find_map(|(key, value)| {
+            number_spelling_difference(value, &e[key], &child(p, key))
+        }),
+        (Value::Array(a), Value::Array(e)) => a.iter().zip(e).enumerate().find_map(|(i, (a, e))| {
