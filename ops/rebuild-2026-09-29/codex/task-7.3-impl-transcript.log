+#[test]
+fn shifted_action_and_dropped_transition_are_detected() {
+    let h = SeedHeader::parse(&header_json()).unwrap();
+    let mut raw = tape_json(6, true);
+    raw["transitions"][1]["actions"][0]["market"] = json!([["BUY_PRODUCT", "WHEAT", 2]]);
