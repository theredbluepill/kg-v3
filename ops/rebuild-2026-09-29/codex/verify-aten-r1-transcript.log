   233	            raise RuntimeError(
   234	                _unprobed(
   235	                    "NVIDIA driver",
   236	                    ", ".join(unprobed),
   237	                    ", ".join(probed.nvidia_drivers),
   238	                )
   239	            )
   240	        nvidia_driver = ", ".join(sorted(set(installed.nvidia_drivers)))
   241	    else:
   242	        nvidia_driver = (
   243	            "skipped: torch.cuda.is_available() is False; the driver is checked "
   244	            "with nvidia-smi on GPU hosts"
   245	        )
