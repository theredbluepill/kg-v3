   212	    if torch_base != probed.torch:
   213	        raise RuntimeError(_unprobed("torch", installed.torch, probed.torch))
   214	    if installed.triton is not None:
   215	        if installed.triton != probed.triton:
   216	            raise RuntimeError(_unprobed("triton", installed.triton, probed.triton))
   217	        triton = installed.triton
   218	    elif installed.cuda_available:
   219	        raise RuntimeError(
   220	            "CUDA is available but triton is not installed; the compiled "
   221	            f"Kaggriculture stack was probed with triton {probed.triton}"
   222	        )
   223	    else:
   224	        triton = (
   225	            "skipped: triton is not installed and torch.cuda.is_available() is "
