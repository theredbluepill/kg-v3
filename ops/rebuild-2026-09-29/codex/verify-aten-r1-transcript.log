+    monkeypatch.setattr(train_utils, "_GEMM_BACKEND_CLAIM", None)
+    monkeypatch.setattr(
+        inductor_config,
+        "max_autotune_gemm_backends",
+        inductor_config.max_autotune_gemm_backends,
+    )
