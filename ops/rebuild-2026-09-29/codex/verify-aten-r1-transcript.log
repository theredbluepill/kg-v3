   341	def _compile_transformer_mlp_modules(
   342	    model: nn.Module,
   343	    *,
   344	    mode: ModelCompileMode,
   345	) -> int:
   346	    compiled = 0
   347	    for name, module in model.named_modules():
   348	        if not _is_transformer_mlp_module_name(name):
   349	            continue
   350	        module.compile(mode=mode, dynamic=True)
   351	        compiled += 1
   352	    if compiled == 0:
   353	        raise RuntimeError(
   354	            "rl.model_compile='mlp' found no transformer MLP modules to compile"
   355	        )
   356	    return compiled
