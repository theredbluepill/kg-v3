   265	def _claim_gemm_backends(model: nn.Module) -> GemmBackendClaim:
   266	    """Check and apply the compiling game's GEMM backends before ``torch.compile``.
   267	
   268	    Kaggriculture restricts Inductor to cuBLAS GEMMs (``"ATEN"``) for every
   269	    compile mode: only max-autotune modes consider Triton GEMM templates, but
   270	    ``TORCHINDUCTOR_MAX_AUTOTUNE`` can enable them under any mode. Isaiah's
   271	    Orbit models keep the backends they find.
   272	    """
   273	    global _GEMM_BACKEND_CLAIM
   274	    game: CompileGame = (
   275	        "kaggriculture" if isinstance(model, KaggricultureTransformer) else "orbit"
   276	    )
   277	    current = _GEMM_BACKEND_CLAIM
   278	    if current is not None and current.game != game:
   279	        raise RuntimeError(
   280	            f"this process already compiled a {current.game} model with "
   281	            f"max_autotune_gemm_backends={current.gemm_backends!r}; compiling a "
   282	            f"{game} model here would change or inherit that process-global "
   283	            f"setting. Compile each game in its own process (see "
   284	            f"{_GEMM_BACKENDS_DECISION})"
   285	        )
   286	    if game == "orbit":
   287	        claim = GemmBackendClaim(
   288	            game=game,
   289	            gemm_backends=inductor_config.max_autotune_gemm_backends,
   290	            stack=None,
   291	        )
   292	    else:
   293	        stack = check_compile_stack(installed_compile_stack())
   294	        inductor_config.max_autotune_gemm_backends = COMPILED_GEMM_BACKENDS
   295	        require_compiled_gemm_backends()
   296	        claim = GemmBackendClaim(
   297	            game=game, gemm_backends=COMPILED_GEMM_BACKENDS, stack=stack
   298	        )
   299	    _GEMM_BACKEND_CLAIM = claim
   300	    return claim
