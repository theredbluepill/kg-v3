   468	    def _run_trunk(self, x: torch.Tensor, token_mask: torch.Tensor) -> torch.Tensor:
   469	        """Isaiah's dispatch, guarded against the compiled-GEMM overflow."""
   470	        should_use_flash = use_flash_attn(x)
   471	        if (
   472	            _requires_flash_attn(x, force_flash_attn=self.config.force_flash_attn)
   473	            and not should_use_flash
   474	        ):
   475	            raise RuntimeError(
   476	                "force_flash_attn=True requires CUDA fp16/bf16 tensors "
   477	                "and the flash-attn package"
   478	            )
   479	        if self.compiled_regions_require_gemm_backends:
   480	            require_compiled_gemm_backends()
   481	        trunk = self._compiled_transformer_trunk or self._forward_transformer_trunk
   482	        width = trunk_gemm_width(self.config)
   483	        if should_use_flash:
   484	            return self._run_packed_trunk(trunk, x, token_mask, width)
   485	        chunk = rows_per_chunk(tokens=x.shape[1], width=width)
   486	        if chunk <= 0:
   487	            raise ValueError(
   488	                f"a single padded row of {x.shape[1]} tokens x {width} reaches the "
   489	                f"2**31 GEMM limit; see {_OVERFLOW_REFERENCE}"
   490	            )
   491	        if x.shape[0] <= chunk:
   492	            return trunk(x, token_mask, None)
   493	        return torch.cat(
   494	            [
   495	                trunk(x[start : start + chunk], token_mask[start : start + chunk], None)
   496	                for start in range(0, x.shape[0], chunk)
   497	            ],
   498	            dim=0,
   499	        )
   500	
   501	    @staticmethod
   502	    def _run_packed_trunk(
   503	        trunk: Callable[
   504	            [torch.Tensor, torch.Tensor | None, PackedSequence | None], torch.Tensor
   505	        ],
   506	        x: torch.Tensor,
   507	        token_mask: torch.Tensor,
   508	        width: int,
   509	    ) -> torch.Tensor:
   510	        """Packed dispatch, chunked at row boundaries below the GEMM limit.
   511	
   512	        The padded bound needs no sync; only a batch whose padded size could
   513	        overflow transfers its per-row token counts to plan the chunks.
   514	        """
   515	        rows, tokens = x.shape[:2]
   516	        if rows * tokens * width < _GEMM_ELEMENT_LIMIT:
   517	            packed_x, packed = pack_sequence(x, token_mask, max_seqlen=tokens)
   518	            return unpack_sequence(trunk(packed_x, None, packed), packed)
   519	        row_tokens = [int(n) for n in token_mask.sum(dim=1).tolist()]
   520	        outputs = []
   521	        for start, stop in packed_row_chunks(row_tokens, width=width):
   522	            packed_x, packed = pack_sequence(
   523	                x[start:stop], token_mask[start:stop], max_seqlen=tokens
   524	            )
   525	            outputs.append(unpack_sequence(trunk(packed_x, None, packed), packed))
   526	        return torch.cat(outputs, dim=0)
