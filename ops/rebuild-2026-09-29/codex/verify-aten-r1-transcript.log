   303	def configure_model_compile(model: nn.Module, cfg: ModelCompileConfig) -> int:
   304	    """Compile the configured model region in place; never the whole model.
   305	
   306	    ``trunk`` dispatches through ``TrunkCompileAPI``, so each model compiles
   307	    only its trunk and keeps its own dispatch (packing, chunking, overflow
   308	    guards) in front of the compiled callable. ``mlp`` compiles the trunk's
   309	    block MLP modules in place. Before any compile, the game claims the
   310	    process-global GEMM backends (cuBLAS only for Kaggriculture; unchanged for
   311	    Orbit), and one process never compiles both games.
   312	    """
   313	    match cfg.model_compile:
   314	        case "none":
   315	            return 0
   316	        case "mlp":
   317	            _claim_gemm_backends(model)
   318	            compiled = _compile_transformer_mlp_modules(
   319	                model,
   320	                mode=cfg.model_compile_mode,
   321	            )
   322	            if isinstance(model, KaggricultureTransformer):
   323	                model.compiled_regions_require_gemm_backends = True
   324	            return compiled
   325	        case "trunk":
   326	            if isinstance(model, RecurrentTransformerV1):
   327	                raise RuntimeError(
   328	                    "rl.model_compile='trunk' does not support recurrent_transformer_v1"
   329	                )
   330	            if not isinstance(model, TrunkCompileAPI):
   331	                raise RuntimeError(
   332	                    "rl.model_compile='trunk' requires a model implementing "
   333	                    f"TrunkCompileAPI, got {type(model).__name__}"
   334	                )
   335	            _claim_gemm_backends(model)
   336	            return model.compile_transformer_trunk(mode=cfg.model_compile_mode)
   337	        case _:
   338	            assert_never(cfg.model_compile)
