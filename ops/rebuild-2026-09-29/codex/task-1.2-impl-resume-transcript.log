            14 => Ok(Self::Feed),
            15 => Ok(Self::Fertilize),
            16 => Ok(Self::CollectFertilizer),
            17 => Ok(Self::Care),
            18 => Ok(Self::Dig),
            _ => Err(format!("invalid UnitKind value {value}")),
        }
    }
}
impl UnitKind {
    pub fn as_str(self) -> &'static str {
        match self {
            Self::None => "NONE",
            Self::Pass => "PASS",
            Self::North => "NORTH",
            Self::South => "SOUTH",
            Self::East => "EAST",
            Self::West => "WEST",
            Self::Pickup => "PICKUP",
            Self::Place => "PLACE",
            Self::Plant => "PLANT",
            Self::Water => "WATER",
            Self::Harvest => "HARVEST",
            Self::Drop => "DROP",
            Self::BuildCoop => "BUILD_COOP",
            Self::BuildPasture => "BUILD_PASTURE",
            Self::Feed => "FEED",
            Self::Fertilize => "FERTILIZE",
            Self::CollectFertilizer => "COLLECT_FERTILIZER",
            Self::Care => "CARE",
            Self::Dig => "DIG",
        }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
#[repr(u8)]
pub enum MarketKind {
    None = 0,
