pub fn write_can_act(plan: &GrammarPlan, out: &mut [bool]) -> Result<(), String> {
    if out.len() != MAX_FRAMES {
        return Err(format!("can_act shape: expected {MAX_FRAMES}, got {}", out.len()));
    }
    let active = plan.shape.actors() + plan.shape.order_limit() + 1;
    for (frame, value) in out.iter_mut().enumerate() { *value = frame < active; }
    Ok(())
}
