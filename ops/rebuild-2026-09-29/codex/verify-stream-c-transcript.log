  1933	class ShiftedReplayModel(TinyOrbitModel):
  1934	    """Replays actions with log-probs shifted from the ones it sampled with.
  1935	
  1936	    Models a sampling path and a replay path that disagree before any weight
  1937	    change, as the reference's corrupted compiled rollouts did.
  1938	    """
  1939	
  1940	    def __init__(self, shift: float, *, shift_from_call: int = 0) -> None:
  1941	        super().__init__()
  1942	        self.shift = shift
  1943	        self.shift_from_call = shift_from_call
  1944	        self.evaluate_calls = 0
  1945	
  1946	    def evaluate_actions(
  1947	        self,
  1948	        obs: ObsBatch,
  1949	        actions: ActionBundle,
  1950	    ) -> ModelEvaluation:
  1951	        call = self.evaluate_calls
  1952	        self.evaluate_calls += 1
  1953	        evaluation = super().evaluate_actions(obs, actions)
  1954	        if call < self.shift_from_call:
  1955	            return evaluation
  1956	        per_player = evaluation.log_probs.per_player_entity[:, :, 0] + self.shift
  1957	        return replace(evaluation, log_probs=self._log_probs(per_player))
