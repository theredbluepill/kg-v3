+   162	def create_lr_scheduler(
+   163	    optimizer: Optimizer,
+   164	    config: LRScheduleConfig | None,
+   165	) -> LRScheduler | None:
+   166	    if config is None:
+   167	        return None
+   168	    if isinstance(optimizer, CompositeOptimizer):
+   169	        return CompositeLRScheduler(
+   170	            torch.optim.lr_scheduler.LambdaLR(
+   171	                inner_optimizer,
+   172	                lr_lambda=lambda step: lr_multiplier(config, step),
+   173	            )
+   174	            for inner_optimizer in optimizer.optimizers
+   175	        )
+   176	    if not isinstance(optimizer, torch.optim.Optimizer):
+   177	        raise TypeError("optimizer must be a torch optimizer or CompositeOptimizer")
+   178	    return torch.optim.lr_scheduler.LambdaLR(
+   179	        optimizer,
+   180	        lr_lambda=lambda step: lr_multiplier(config, step),
+   181	    )
