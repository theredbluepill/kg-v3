+   184	def lr_multiplier(config: LRScheduleConfig, step: int) -> float:
+   185	    if step < 0:
+   186	        raise ValueError("step must be non-negative")
+   187	
+   188	    match config.schedule:
+   189	        case "linear_warmup_cosine_decay":
+   190	            if config.warmup_steps > 0 and step < config.warmup_steps:
+   191	                return step / config.warmup_steps
+   192	
+   193	            decay_step = min(
+   194	                max(step - config.warmup_steps, 0),
+   195	                config.decay_steps,
+   196	            )
+   197	            progress = decay_step / config.decay_steps
+   198	            cosine = 0.5 * (1.0 + cos(pi * progress))
+   199	            return config.lr_min_ratio + (1.0 - config.lr_min_ratio) * cosine
+   200	        case "cosine":
+   201	            cycle_progress = (step % config.full_cycle_steps) / config.full_cycle_steps
+   202	            cosine = 0.5 * (1.0 + cos(2.0 * pi * cycle_progress))
+   203	            return config.lr_min_ratio + (1.0 - config.lr_min_ratio) * cosine
+   204	        case _:
+   205	            assert_never(config.schedule)
