+[group: 'rust']
+rs-test:
+	cargo test
+[group: 'rust']
+rs-prepare: rs-format rs-lint rs-test docs-fresh
+
+[group: 'build']
+build:
+	uv run maturin develop
+[group: 'build']
+build-release:
+	uv run maturin develop --release
+[group: 'build']
