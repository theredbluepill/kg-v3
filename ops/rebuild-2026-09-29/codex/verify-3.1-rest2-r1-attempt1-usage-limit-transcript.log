    _patch_kaggriculture_startup(
        monkeypatch,
        [
            str(_CONFIGS / "kaggriculture.yaml"),
            str(tmp_path / "runs"),
            "-o",
            f"env.seed={seed}",
            "rl.eval_replay_games=0",
        ],
        calls,
    )
    with pytest.raises(ValueError, match=r"env\.seed must be in"):
        run_ppo.main()
    assert calls == []


