    const git = (...args) => execFileSync('git', args, { encoding: 'utf8' })
    const paths = git('diff', '--cached', '--name-only', '-z').split('\0')
    const notes = git('diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z').split('\0').filter(isConcept)
