  return [...problems, ...resources.flatMap((raw) => {
    const { value, error } = sourceScalar(raw)
    const problem = error ?? resourceProblem(value, raw)
    return problem ? [`sources[].resource ${JSON.stringify(value ?? raw)}: ${problem}`] : []
