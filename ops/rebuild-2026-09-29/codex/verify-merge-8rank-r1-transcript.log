def test_startup_workload_check_skips_isaiahs_unchunked_orbit_models(
    capsys: pytest.CaptureFixture[str],
) -> None:
    cfg = _full_config()
    reports = run_ppo._check_model_workload(
        cfg.model,
        n_envs=cfg.env.n_envs,
