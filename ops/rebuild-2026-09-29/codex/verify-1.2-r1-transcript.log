  Sketch of the state check:

  ```rust
  let p = plan(1, 10, 11).unwrap();
  let tables = grammar_tables().unwrap();
  let mut pending = vec![p.start()];
  let mut seen = std::collections::HashSet::new();
  while let Some(s) = pending.pop() {
      if !seen.insert(s) { continue; }
      let mut mask = vec![false; s.slot().width()];
      s.write_mask(&p, &mut mask).unwrap();
      for (choice, &admitted) in mask.iter().enumerate() {
          assert_eq!(s.allows(choice as i64, &p), admitted);
          match s.advance(choice as i64, &p) {
              Ok(Some(next)) => { assert!(admitted); pending.push(next); }
              Ok(None) => { assert!(admitted); assert_eq!(s.slot(), Slot::Stop); assert_eq!(choice, 1); }
              Err(_) => assert!(!admitted),
          }
      }
      assert!(!s.allows(-1, &p));
      assert!(!s.allows(s.slot().width() as i64, &p));
      // At each node, also compare mask to the corresponding factored table
      // with the unit/market/ordinal/availability/HIRE overlays in §2/§4.
  }
  assert!(seen.len() <= MAX_ACTORS * 24 + 66 * 32);
  ```

