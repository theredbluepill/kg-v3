def verdicts_differ(row: dict[str, Any]) -> bool:
    sampler = row["sampler"]
    for key in ("training_decoder", "python_codec", "v4_expected"):
        other = row[key]
        if sampler.get("accepted") != other.get("accepted"):
            return True
        if sampler.get("accepted") and sampler["action"] != other.get("action"):
            return True
    return False


