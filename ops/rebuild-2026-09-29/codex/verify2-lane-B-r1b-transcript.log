   271	                max(0, _EPISODE_STEPS - 1 - step) / _EPISODE_STEPS,
   272	                _TURNS_PER_DAY / 24,
   273	                order_limit / 10,
   274	                _SHED_CAPACITY / 1000,
   275	                100 / 100,
   276	                _EPISODE_STEPS / 1000,
   277	                0.05,
   278	                48 / _TURNS_PER_DAY,
   279	                24 / _TURNS_PER_DAY,
   280	                72 / _TURNS_PER_DAY,
   281	                500 / 200_000,
   282	                shop_count / 8,
   283	            ]
   284	        )
   285	        for seat in range(kt.PLAYERS):
   286	            me, rival = players[seat], players[1 - seat]
   287	            own_n, rival_n = me.actor_cells.numel(), rival.actor_cells.numel()
   288	            view = (env, seat)
   289	            out["tile_kind"][view] = torch.cat((me.tile_kind, rival.tile_kind))
   290	            out["tile_crop"][view] = torch.cat((me.tile_crop, rival.tile_crop))
   291	            out["tile_animal"][view] = torch.cat((me.tile_animal, rival.tile_animal))
   292	            out["tiles_int"][view] = torch.cat((me.tiles_int, rival.tiles_int))
   293	            out["tiles_float"][view] = torch.cat((me.tiles_float, rival.tiles_float))
   294	            for offset, owner, count, roles in (
   295	                (0, me, own_n, (0, 1)),
   296	                (kt.MAX_ACTORS, rival, rival_n, (2, 3)),
   297	            ):
   298	                rows = slice(offset, offset + count)
   299	                out["actor_slot"][(*view, rows)] = torch.arange(count)
   300	                out["actor_cell"][(*view, rows)] = owner.actor_cells
   301	                out["actor_role"][(*view, rows)] = roles[1]
   302	                out["actor_role"][(*view, offset)] = roles[0]
   303	                out["actor_mask"][(*view, rows)] = True
   304	                xy = torch.stack(
   305	                    (owner.actor_cells % 10, owner.actor_cells // 10), dim=-1
   306	                )
   307	                out["actors_float"][(*view, rows, slice(0, 2))] = xy / 9
   308	            own_rows = slice(0, own_n)
   309	            out["actor_inventory"][(*view, own_rows)] = me.inventory
   310	            out["actor_inventory_rank"][(*view, own_rows)] = me.inventory_rank
   311	            out["actors_float"][(*view, own_rows, slice(2, 14))] = me.inventory / 32
   312	            out["actors_float"][(*view, own_rows, slice(14, 26))] = (
   313	                me.inventory_rank / 12
   314	            )
   315	            out["player_features"][(*view, 0, slice(0, 11))] = me.public
   316	            out["player_features"][(*view, 0, _OWN_PRIVATE_PLAYER_CHANNELS)] = (
   317	                me.private
   318	            )
   319	            out["player_features"][(*view, 1, slice(0, 11))] = rival.public
   320	            out["storage_counts"][view] = me.storage
   321	            out["storage_rank"][view] = me.storage_rank
   322	            out["banks"][view] = torch.tensor(
   323	                [me.bank, rival.bank], dtype=torch.float64
   324	            )
   325	            out["shop_type"][(*view, slice(0, shop_count))] = shop_types
   326	            out["shop_slot"][(*view, slice(0, shop_count))] = torch.arange(shop_count)
   327	            out["shop_mask"][(*view, slice(0, shop_count))] = True
   328	            out["market_int"][view] = market_int
   329	            out["market_float"][view] = market_int / torch.tensor([10_000.0, 250.0])
   330	            out["global_features"][view] = global_features
   331	            out["globals_int"][view] = torch.tensor(
   332	                [
   333	                    step, day, hour, *config_ints,
   334	                    me.hires_today, rival.hires_today, own_n, rival_n,
   335	                ]
   336	            )  # fmt: skip
   337	            can_act[view] = frames < own_n + order_limit + 1
   338	    return kt.KaggricultureObsBatch(
   339	        **out,
   340	        tile_cell=torch.arange(kt.CELLS).repeat(2).expand(*lead, kt.TILES).clone(),
   341	        tile_role=torch.arange(kt.PLAYERS)
   342	        .repeat_interleave(kt.CELLS)
   343	        .expand(*lead, kt.TILES)
   344	        .clone(),
   345	        market_product=torch.arange(kt.PRODUCT_COUNT)
   346	        .expand(*lead, kt.PRODUCT_COUNT)
   347	        .clone(),
   348	        still_playing=torch.ones(lead, dtype=torch.bool),
   349	        order_limits=torch.full(lead, order_limit, dtype=torch.int64),
   350	        action_mask=kt.KaggricultureActionMask(can_act=can_act),
   351	    )
