   209	def _marker_stem(base: float, width: int) -> Callable[[torch.Tensor], torch.Tensor]:
   210	    """A stem stub whose token ``i`` is the constant ``base + i``."""
   211	
   212	    def forward(x: torch.Tensor) -> torch.Tensor:
   213	        if x.dim() == 2:
   214	            return torch.full((x.shape[0], width), base)
   215	        index = torch.arange(x.shape[1], dtype=torch.float32)
   216	        return (base + index)[None, :, None].expand(x.shape[0], -1, width).clone()
   217	
   218	    return forward
   219	
