   657	def _optimizer_ids(
   658	    model: km.KaggricultureTransformer,
   659	) -> tuple[set[int], set[int]]:
   660	    optimizer = create_optimizer(model, MuonConfig())
   661	    groups: dict[type, set[int]] = {torch.optim.Muon: set(), torch.optim.AdamW: set()}
   662	    for inner in optimizer.optimizers:
   663	        ids = groups[type(inner)]
   664	        ids.update(id(p) for group in inner.param_groups for p in group["params"])
   665	    return groups[torch.optim.Muon], groups[torch.optim.AdamW]
