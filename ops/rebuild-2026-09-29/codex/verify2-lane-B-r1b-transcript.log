   347	    def _run_trunk(self, x: torch.Tensor, token_mask: torch.Tensor) -> torch.Tensor:
   348	        """Isaiah's dispatch, guarded against the compiled-GEMM overflow."""
   349	        should_use_flash = use_flash_attn(x)
   350	        if (
   351	            _requires_flash_attn(x, force_flash_attn=self.config.force_flash_attn)
   352	            and not should_use_flash
   353	        ):
   354	            raise RuntimeError(
   355	                "force_flash_attn=True requires CUDA fp16/bf16 tensors "
   356	                "and the flash-attn package"
   357	            )
   358	        trunk = self._compiled_transformer_trunk or self._forward_transformer_trunk
   359	        kmax = gemm_kmax(self.config)
   360	        if should_use_flash:
   361	            packed_x, packed = pack_sequence(x, token_mask, max_seqlen=x.shape[1])
   362	            if packed_x.shape[0] * kmax >= _GEMM_ELEMENT_LIMIT:
   363	                raise ValueError(
   364	                    f"packed trunk input has {packed_x.shape[0]} rows x {kmax}, "
   365	                    f"at or above 2**31; see {_OVERFLOW_REFERENCE}"
   366	                )
   367	            return unpack_sequence(trunk(packed_x, None, packed), packed)
   368	        chunk = rows_per_chunk(tokens=x.shape[1], kmax=kmax)
   369	        if chunk <= 0:
   370	            raise ValueError(
   371	                f"a single padded row of {x.shape[1]} tokens x {kmax} reaches the "
   372	                f"2**31 GEMM limit; see {_OVERFLOW_REFERENCE}"
   373	            )
   374	        if x.shape[0] <= chunk:
   375	            return trunk(x, token_mask, None)
   376	        return torch.cat(
   377	            [
   378	                trunk(x[start : start + chunk], token_mask[start : start + chunk], None)
   379	                for start in range(0, x.shape[0], chunk)
   380	            ],
   381	            dim=0,
   382	        )
   383	
   384	    def _forward_transformer_trunk(
   385	        self,
   386	        x: torch.Tensor,
   387	        token_mask: torch.Tensor | None,
   388	        packed: PackedSequence | None,
   389	    ) -> torch.Tensor:
   390	        for block in self.blocks:
   391	            x = block(x, token_mask, packed)
   392	        return self.final_norm(x)
   393	
   394	    def compile_transformer_trunk(self, *, mode: str) -> int:
   395	        self._compiled_transformer_trunk = torch.compile(
   396	            self._forward_transformer_trunk, mode=mode, dynamic=True
   397	        )
   398	        return 1
   399	
   400	    # --- policy / value API (Tasks 2.2 and 2.3) --------------------------------
   401	
   402	    @staticmethod
   403	    def _require_stateless(hidden_state: ModelHiddenState | None) -> None:
   404	        if hidden_state is not None:
   405	            raise ValueError(
   406	                "KaggricultureTransformer is stateless; hidden_state must be None"
   407	            )
   408	
   409	    def forward(
   410	        self,
   411	        obs: kt.KaggricultureObsBatch,
   412	        *,
   413	        deterministic: bool = False,
   414	        hidden_state: ModelHiddenState | None = None,
   415	    ) -> ModelOutput[kt.KaggricultureActions]:
   416	        del obs, deterministic
   417	        self._require_stateless(hidden_state)
   418	        raise NotImplementedError("action heads arrive with Task 2.3")
   419	
   420	    def evaluate_actions(
   421	        self,
   422	        obs: kt.KaggricultureObsBatch,
   423	        actions: kt.KaggricultureActions,
   424	        *,
   425	        hidden_state: ModelHiddenState | None = None,
   426	        dones: torch.Tensor | None = None,
   427	    ) -> ModelEvaluation:
   428	        del obs, actions, dones
   429	        self._require_stateless(hidden_state)
   430	        raise NotImplementedError("action heads arrive with Task 2.3")
   431	
   432	    def compute_value(
   433	        self,
   434	        obs: kt.KaggricultureObsBatch,
   435	        *,
   436	        hidden_state: ModelHiddenState | None = None,
   437	    ) -> torch.Tensor:
   438	        """``win_loss`` value ``2 * p(self) - 1`` per seat, shape ``[env, seat]``."""
   439	        self._require_stateless(hidden_state)
   440	        log_probs = self.winner_log_probabilities(obs)
   441	        return 2.0 * log_probs[..., 0].exp() - 1.0
   442	
   443	    def winner_log_probabilities(self, obs: kt.KaggricultureObsBatch) -> torch.Tensor:
   444	        """Winner distribution over (self, opponent) from each seat's own view.
   445	
   446	        Shape ``[env, seat, 2]``; index 0 is this seat winning.
   447	        """
   448	        encoded = self.encode_observations(obs)
   449	        return self._winner_log_probabilities(encoded).reshape(
   450	            *obs.still_playing.shape, kt.PLAYERS
   451	        )
   452	
   453	    def _winner_log_probabilities(self, encoded: KaggricultureEncoded) -> torch.Tensor:
   454	        logits = self.critic_head(encoded.critic_value_hidden).float().squeeze(-1)
   455	        return logits.log_softmax(dim=-1)

