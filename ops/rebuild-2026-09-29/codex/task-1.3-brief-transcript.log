455:         # Embeddings stay FP32 under autocast; attention needs the active mixed
456:         # precision dtype to select the starter's packed FlashAttention path.
457:         if torch.is_autocast_enabled(x.device.type):
458:             x = x.to(torch.get_autocast_dtype(x.device.type))
459:         fixed_tail = 15 + self.special_tokens.shape[0]
460:         mask = torch.cat(
461:             (
462:                 torch.ones(count, 200, dtype=torch.bool, device=x.device),
463:                 *actor_masks,
464:                 torch.ones(count, fixed_tail, dtype=torch.bool, device=x.device),
465:             ),
466:             dim=1,
467:         )
468:         packed = None
469:         if use_flash_attn(x):
470:             x, packed = pack_sequence(x, mask, max_seqlen=x.shape[1])
471:             x = self._trunk_forward(x, None, packed)
472:             x = unpack_sequence(x, packed)
473:         else:
474:             if self.config.force_flash_attn and x.device.type == "cuda":
475:                 raise RuntimeError(
476:                     "force_flash_attn requires CUDA fp16/bf16 and flash-attn"
477:                 )
478:             x = self._trunk_forward(x, mask, None)
479:         return _Encoded(
480:             own_actors=x[:, 200 : 200 + own_pad],
481:             plan=x[:, -2],
482:             critic=x[:, -1],
483:             leading_shape=leading,
484:             shapes=shapes,
485:             active=obs.still_playing.reshape(-1),

## python/owl/model/kaggriculture.py:503-509

503:     def _decoder_inputs(self, encoded: _Encoded) -> tuple[torch.Tensor, torch.Tensor]:
504:         width = encoded.plan.shape[-1]
505:         weight = self.frame_input.weight
506:         plan = F.linear(encoded.plan, weight[:, :width], self.frame_input.bias)
507:         actor = F.linear(encoded.own_actors, weight[:, width:]) + plan[:, None, :]
508:         market = F.linear(encoded.plan, weight[:, width:]) + plan
509:         return actor, market

