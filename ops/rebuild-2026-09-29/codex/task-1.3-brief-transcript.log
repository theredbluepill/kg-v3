+    pub actor_cell: &'a mut [i64; 482],
+    pub actor_role: &'a mut [i64; 482],
+    pub actor_mask: &'a mut [bool; 482],
+    pub actor_inventory: &'a mut [[i64; 12]; 241],
+    pub actor_inventory_rank: &'a mut [[i64; 12]; 241],
