    21	  --quantization FORMAT
    22	                     Optional slim-checkpoint quantization format:
    23	                     fp32, fp8_e4m3fn, fp4_e2m1fn_x2_scaled_block16, or
    24	                     nf5_g128_lsq_policy_last_fp8, nf4_g128_lsq,
    25	                     nf3_nf4_structured_3p5, or nf3_g128_lsq.
    26	                     Unique prefixes such as fp4 are accepted.
    27	  --lora-quantization FORMAT
    28	                     Optional LoRA adapter quantization format: fp32, fp16,
    29	                     bf16, or any --quantization format. Defaults to fp16 when
    30	                     --quantization is set and the checkpoint has LoRA tensors.
    31	  -h, --help         Show this help.
    32	EOF
    33	}
