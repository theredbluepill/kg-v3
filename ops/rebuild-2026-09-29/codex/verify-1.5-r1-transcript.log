@dataclass(frozen=True)
class NativeArrays:
    """One persistent NumPy view for each ABI output, never rebuilt on step."""

    tile_kind: NDArray[np.int64]
    tile_crop: NDArray[np.int64]
    tile_animal: NDArray[np.int64]
