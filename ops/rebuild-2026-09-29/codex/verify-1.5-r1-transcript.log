}

fn half_ulp32(value: f64) -> f64 {
    let rounded = value as f32;
    ((f64::from(rounded.next_up()) - f64::from(rounded))
        .abs()
        .max((f64::from(rounded) - f64::from(rounded.next_down())).abs()))
        / 2.
}
fn half_ulp64(value: f64) -> f64 {
    (value.next_up() - value)
        .abs()
        .max((value - value.next_down()).abs())
        / 2.
}
