   351	        if kind != 0 {
   352	            let mut command = vec![Value::String(UNIT_NAMES[kind].into())];
   353	            if matches!(kind, 6..=8) {
   354	                command.push(Value::String(ITEMS[frame[3] as usize].into()));
   355	            }
   356	            if frame[4] == 1 {
   357	                command.push(Value::from(i64::from(frame[5]) * 32 + i64::from(frame[6])));
   358	            }
   359	            units.push(Value::Array(command));
   360	        } else {
   361	            let kind = frame[7] as usize;
   362	            if kind == 0 {
   363	                continue;
   364	            }
   365	            let mut command = if kind == 7 {
   366	                Vec::new()
   367	            } else {
   368	                vec![Value::String(MARKET_NAMES[kind].into())]
   369	            };
