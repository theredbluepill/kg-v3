   336	            return Err(format!(
   337	                "Myolie sampler frame {} slot {} token {value} violates syntax mask",
   338	                index / SLOTS,
   339	                current.slot
   340	            ));
   341	        }
   342	        state = current.advance(value as usize);
   343	    }
   344	    if state.is_some() {
   345	        return Err("Myolie sampler program lacks distinct final STOP".into());
   346	    }
