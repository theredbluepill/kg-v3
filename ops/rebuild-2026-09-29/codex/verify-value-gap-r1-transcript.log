    46	def pair_metrics(s: Any, r: Any, playing: torch.Tensor) -> dict[str, Any]:
    47	    s_lp = s.winner_probabilities.float().clamp_min(1e-30).log()
    48	    r_lp = (r.winner_log_probabilities.float() if getattr(r, "winner_log_probabilities", None)
    49	            is not None else r.winner_probabilities.float().clamp_min(1e-30).log())
    50	    old_ppe = s.log_probs.per_player_entity.float()
    51	    new_ppe = r.log_probs.per_player_entity.float()
    52	    old_pp = old_ppe.sum(-1)
    53	    new_pp = new_ppe.sum(-1)
    54	    return {
    55	        "values": C.diff(r.values, s.values, playing),
