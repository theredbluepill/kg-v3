    39	def map_tensors(obj: BaseModel, fn: Any) -> Any:
    40	    fields: dict[str, Any] = {}
    41	    for name in type(obj).model_fields:
    42	        value = getattr(obj, name)
    43	        if isinstance(value, torch.Tensor):
    44	            fields[name] = fn(value)
    45	        elif isinstance(value, BaseModel):
    46	            fields[name] = map_tensors(value, fn)
