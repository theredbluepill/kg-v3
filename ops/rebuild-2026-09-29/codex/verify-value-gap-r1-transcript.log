   263	        self.log({"status": "stage_cleanup", "reason": reason,
   264	                  "registered": len(procs), "groups": report})
   265	        return report
   266	
   267	    def _on_signal(self, signum: int, _frame: object) -> None:
   268	        if self.cleanup_started:
   269	            return
   270	        name = signal.Signals(signum).name
   271	        if self.failure is None:
   272	            self.failure = 128 + signum
   273	        self.log({"status": "signal", "signal": name})
   274	        self.cleanup(f"signal {name}")
   275	        raise SystemExit(128 + signum)
   276	
   277	    def install_cleanup(self) -> None:
   278	        atexit.register(self.cleanup, "atexit")
   279	        for sig in CLEANUP_SIGNALS:
   280	            signal.signal(sig, self._on_signal)
   281	
   282	    def _command(self, stage: Stage, record: Path, out: Path) -> list[str]:
   283	        name, _role, backends, script, args, _exp = stage
   284	        if SELFTEST:
   285	            return [PY, str(RUN / "test_driver_cleanup.py"), "--dummy-stage",
   286	                    "--backends", backends, "--record", str(record),
   287	                    "--pids", str(Path(SELFTEST) / f"{name}.pids"), *args]
   288	        return [PY, WRAP, "--backends", backends, "--record", str(record), "--",
   289	                str(RUN / script), *args, "--out", str(out)]
   290	
   291	    def run_stage(self, stage: Stage, gpu: int) -> None:
   292	        name, role, backends, _script, _args, exp = stage
   293	        if self.stop.is_set():
   294	            self.log({"stage": name, "gpu": gpu, "status": "skipped_after_stop"})
   295	            return
   296	        remaining = self.deadline - time.monotonic()
   297	        if role == "optional" and remaining < OPTIONAL_MIN_S:
   298	            self.log({"stage": name, "gpu": gpu, "status": "optional_skipped_budget",
   299	                      "remaining_s": round(remaining)})
