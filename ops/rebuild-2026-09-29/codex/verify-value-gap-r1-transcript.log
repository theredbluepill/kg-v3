    93	        "entropy_event": C.diff(r.entropies.event, s.entropies.event),
    94	        "r_values_requires_grad": bool(r.values.requires_grad),
    95	        "r_values": C.stats(r.values),
    96	        "s_values": C.stats(s.values),
    97	        "s_logp_event": C.stats(old),
    98	        "s_joint_logp_row": C.stats(old.sum(dim=(-1, -2))),
    99	    }
