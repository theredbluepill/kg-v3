   213	def main() -> None:
   214	    ap = argparse.ArgumentParser()
   215	    ap.add_argument("--case", required=True)
   216	    ap.add_argument("--precision", choices=("bf16", "fp32"), required=True)
   217	    ap.add_argument("--trunk", choices=("compiled", "eager"), required=True)
   218	    ap.add_argument("--rows", default="4,8" if C.DRYRUN else "256,1024")
   219	    ap.add_argument("--hidden", action="store_true")
   220	    ap.add_argument("--gain-swap", action="store_true")
   221	    # Amendment 1: attempt 1's fp32 compiled training graph failed in Inductor's
   222	    # coalesce tiling analysis (sympy is_constant on a symbolic index); this
   223	    # turns that analysis off for the fp32 compiled stages only.
   224	    ap.add_argument("--no-coalesce-tiling", action="store_true")
   225	    ap.add_argument("--out", required=True)
   226	    args = ap.parse_args()
   227	    fh = open(args.out, "a")
   228	    C.configure(args.precision)
   229	    dev = C.device()
   230	    import owl.model.kaggriculture as km
   231	    from owl.model.stateless_transformer_v1 import _init_linear
   232	
   233	    flash_flags: list[bool] = []
   234	    real_use_flash = km.use_flash_attn
   235	
   236	    def counting_use_flash(x: torch.Tensor) -> bool:
   237	        flag = real_use_flash(x)
   238	        flash_flags.append(bool(flag))
   239	        return flag
   240	
   241	    km.use_flash_attn = counting_use_flash
   242	    C.emit(fh, C.process_record(args.case))
   243	    model = build_model(dev, args.precision)
   244	    trunk_calls = [0]
   245	    if args.trunk == "compiled":
   246	        if args.no_coalesce_tiling:
   247	            import torch._inductor.config as inductor_config
   248	
   249	            inductor_config.triton.coalesce_tiling_analysis = False
   250	        C.compile_trunk(model)
   251	        compiled = model._compiled_transformer_trunk
   252	
   253	        def counting(*a: Any) -> torch.Tensor:
   254	            trunk_calls[0] += 1
   255	            return compiled(*a)
   256	
   257	        model._compiled_transformer_trunk = counting
   258	    rows = [int(r) for r in args.rows.split(",")]
   259	    rec: dict[str, Any] = {"event": "result", "case": args.case,
   260	                           "output_layer_spectral_norms": C.output_layer_gains(
   261	                               model, model.critic_head.out),
   262	                           "precision": args.precision, "trunk": args.trunk,
   263	                           "rows": rows, "force_flash_attn": model.config.force_flash_attn,
   264	                           "tf32_matmul": torch.backends.cuda.matmul.allow_tf32,
   265	                           "inductor_coalesce_tiling_analysis":
   266	                           __import__("torch._inductor.config", fromlist=["triton"])
   267	                           .triton.coalesce_tiling_analysis}
   268	    steps: dict[str, str] = {}
   269	    rec["steps"] = steps
   270	    try:
   271	        for r in rows:
   272	            obs = make_obs(r, dev)
   273	            steps[f"pair_{r}"] = "started"
   274	            rec[f"default_gain_{r}"] = run_pair(model, obs, dev, args.precision, True)
   275	            steps[f"pair_{r}"] = "ok"
   276	            if args.hidden:
   277	                steps[f"hidden_{r}"] = "started"
   278	                rec[f"hidden_{r}"] = hidden_metrics(model, obs, dev, args.precision)
   279	                steps[f"hidden_{r}"] = "ok"
   280	            del obs
   281	        if args.gain_swap:
   282	            layers = model.actor.get_output_layers()
   283	            before = [float(l.weight.detach().float().norm()) for l in layers]
   284	            torch.manual_seed(SEED + 7)
   285	            for layer in layers:
   286	                _init_linear(layer, gain=1.0)
   287	            rec["gain_swap"] = {
   288	                "layers": len(layers),
   289	                "weight_norm_before": before,
   290	                "weight_norm_after": [float(l.weight.detach().float().norm())
   291	                                      for l in layers],
   292	                "critic_out_is_swapped": any(l is model.critic_head.out for l in layers),
   293	            }
   294	            for r in rows:
   295	                obs = make_obs(r, dev)
   296	                steps[f"gain1_pair_{r}"] = "started"
   297	                rec[f"actor_gain1_{r}"] = run_pair(model, obs, dev, args.precision, False)
   298	                steps[f"gain1_pair_{r}"] = "ok"
   299	                del obs
   300	    except Exception as exc:
   301	        rec["error"] = f"{type(exc).__name__}: {exc}"[:3000]
   302	        raise
   303	    finally:
   304	        rec["use_flash_attn_flags"] = sorted(set(flash_flags))
   305	        rec["use_flash_attn_calls"] = len(flash_flags)
   306	        rec["compiled_trunk_calls"] = trunk_calls[0]
   307	        rec["memory"] = C.mem(dev)
   308	        try:
   309	            from torch._dynamo.utils import counters
   310	
   311	            rec["dynamo_counters"] = {k: dict(v) for k, v in counters.items()}
   312	        except Exception as exc:  # noqa: BLE001 - diagnostic only
   313	            rec["dynamo_counters"] = f"unavailable: {exc}"
   314	        C.emit(fh, rec)
   315	    C.emit(fh, {"event": "done", "case": args.case})
   316	    fh.close()
