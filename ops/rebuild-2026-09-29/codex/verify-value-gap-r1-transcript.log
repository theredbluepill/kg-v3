   138	def hidden_metrics(model: Any, obs: Any, dev: torch.device, prec: str) -> dict[str, Any]:
   139	    from owl.kaggriculture import types as kt
   140	    from owl.model import kaggriculture as km
   141	
   142	    with torch.no_grad(), C.amp(dev, prec):
   143	        x_ng, mask = model._assemble_tokens(obs)
   144	        enc_ng = model.encode_observations(obs)
   145	    with C.amp(dev, prec):
   146	        x_g, _ = model._assemble_tokens(obs)
   147	        enc_g = model.encode_observations(obs)
   148	    rec: dict[str, Any] = {"trunk_input": C.diff(x_g, x_ng, mask),
   149	                           "x_dtype": str(x_ng.dtype)}
   150	    h_ng, h_g = enc_ng.hidden.detach(), enc_g.hidden.detach()
   151	    critic_start = h_ng.shape[1] - kt.PLAYERS
   152	    plan = slice(critic_start - km._PLAN_TOKENS, critic_start)
   153	    groups = {
   154	        "all": (slice(None), mask),
   155	        "critic": (slice(critic_start, None), mask[:, critic_start:]),
   156	        "plan": (plan, mask[:, plan]),
   157	        "own_actor": (slice(0, kt.MAX_ACTORS), mask[:, : kt.MAX_ACTORS]),
   158	    }
   159	    # fp32 reference: eager padded SDPA, autocast off, TF32 off, same input.
   160	    tf32 = (torch.backends.cuda.matmul.allow_tf32, torch.backends.cudnn.allow_tf32)
   161	    torch.backends.cuda.matmul.allow_tf32 = False
   162	    torch.backends.cudnn.allow_tf32 = False
   163	    chunks = []
   164	    with torch.no_grad():
   165	        for i in range(0, x_ng.shape[0], 128):
   166	            out = model._forward_transformer_trunk(
   167	                x_ng[i:i + 128].float(), mask[i:i + 128], None)
   168	            chunks.append(out.masked_fill(~mask[i:i + 128].unsqueeze(-1), 0.0))
   169	    torch.backends.cuda.matmul.allow_tf32, torch.backends.cudnn.allow_tf32 = tf32
   170	    h_ref = torch.cat(chunks)
   171	    for name, (sl, m) in groups.items():
   172	        rec[name] = {
   173	            "grad_vs_nograd": C.diff(h_g[:, sl], h_ng[:, sl], m),
   174	            "nograd_vs_fp32": C.diff(h_ng[:, sl], h_ref[:, sl], m),
   175	            "grad_vs_fp32": C.diff(h_g[:, sl], h_ref[:, sl], m),
   176	        }
   177	    # head swap: the same (no_grad) critic head on each path's hidden states
   178	    with torch.no_grad(), C.amp(dev, prec):
   179	        lp_ng = model._winner_log_probabilities(enc_ng)
   180	        lp_g = model._winner_log_probabilities(enc_g)
   181	    v_ng = 2 * lp_ng[..., 0].exp() - 1
   182	    v_g = 2 * lp_g[..., 0].exp() - 1
   183	    rec["head_swap_values"] = C.diff(v_g, v_ng)
   184	    rec["head_swap_critic_logit_diff"] = C.diff(lp_g[..., 0] - lp_g[..., 1],
   185	                                                lp_ng[..., 0] - lp_ng[..., 1])
   186	    rec["critic_logit_bf16_head"] = C.stats(lp_ng[..., 0] - lp_ng[..., 1])
   187	    # fp32 critic head (autocast off, TF32 off) on each path's hidden states and
   188	    # on the fp32 reference hidden: separates trunk noise from head rounding.
   189	    cmask = mask[:, critic_start:]
   190	
   191	    def fp32_head_values(h: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
   192	        logits = model.critic_head(h.float()).float().squeeze(-1)
   193	        lp = torch.log_softmax(logits.masked_fill(
   194	            ~cmask, torch.finfo(torch.float32).min), dim=-1)
   195	        return 2 * lp[..., 0].exp() - 1, lp[..., 0] - lp[..., 1]
   196	
   197	    torch.backends.cuda.matmul.allow_tf32 = False
   198	    torch.backends.cudnn.allow_tf32 = False
   199	    with torch.no_grad():
   200	        v_ref, _ = fp32_head_values(h_ref[:, critic_start:])
   201	        v32_ng, d32_ng = fp32_head_values(h_ng[:, critic_start:])
   202	        v32_g, d32_g = fp32_head_values(h_g[:, critic_start:])
   203	    torch.backends.cuda.matmul.allow_tf32, torch.backends.cudnn.allow_tf32 = tf32
   204	    rec["head_swap_fp32_head_values"] = C.diff(v32_g, v32_ng)
   205	    rec["head_swap_fp32_head_critic_logit_diff"] = C.diff(d32_g, d32_ng)
   206	    rec["fp32_head_vs_bf16_head_values_nograd"] = C.diff(v32_ng, v_ng)
   207	    rec["values_nograd_vs_fp32_head"] = C.diff(v_ng, v_ref)
   208	    rec["values_grad_vs_fp32_head"] = C.diff(v_g, v_ref)
   209	    del enc_ng, enc_g, h_ref, chunks
   210	    return rec
