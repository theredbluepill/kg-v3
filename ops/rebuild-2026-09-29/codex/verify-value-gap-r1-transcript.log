    40	def playing_centered(logp: torch.Tensor, playing: torch.Tensor) -> torch.Tensor:
    41	    lp = logp.float().masked_fill(~playing, 0.0)
    42	    mean = lp.sum(-1, keepdim=True) / playing.sum(-1, keepdim=True)
    43	    return (lp - mean).masked_fill(~playing, 0.0)
