    58	                                       playing_centered(s_lp, playing), playing),
    59	        "logp_per_player": C.diff(new_pp, old_pp, playing),
    60	        "logratio_per_player": C.stats((new_pp - old_pp)[playing]),
    61	        "logp_per_player_entity": C.diff(new_ppe, old_ppe),
    62	        "entropy_per_player_entity": C.diff(r.entropies.per_player_entity,
    63	                                            s.entropies.per_player_entity),
    64	        "r_values_requires_grad": bool(r.values.requires_grad),
    65	        "s_values": C.stats(s.values[playing]),
    66	        "s_logp_per_player": C.stats(old_pp[playing]),
    67	        "players_per_row": C.stats(playing.sum(-1).float()),
    68	    }
    69	
    70	
    71	def run_pair(model: Any, obs: Any, dev: torch.device) -> dict[str, Any]:
    72	    playing = obs.still_playing.bool()
    73	    torch.manual_seed(SEED + 1)
    74	    with torch.no_grad(), C.amp(dev, "bf16"):
    75	        s = model(obs)
    76	    with C.amp(dev, "bf16"):
    77	        r = model.evaluate_actions(obs, s.actions)
    78	    rec: dict[str, Any] = {"pair": pair_metrics(s, r, playing)}
    79	    with torch.no_grad(), C.amp(dev, "bf16"):
    80	        e_ng = model.evaluate_actions(obs, s.actions)
    81	    rec["eval_nograd_vs_sample"] = pair_metrics(s, e_ng, playing)
    82	    with C.amp(dev, "bf16"):
    83	        v_g = model.compute_value(obs)
    84	    rec["compute_value_grad_vs_sample"] = {
    85	        "values": C.diff(v_g, s.values, playing), "requires_grad": bool(v_g.requires_grad)}
    86	    with torch.no_grad(), C.amp(dev, "bf16"):
    87	        v_ng = model.compute_value(obs)
    88	    rec["compute_value_nograd_vs_sample"] = {"values": C.diff(v_ng, s.values, playing)}
    89	    with C.amp(dev, "bf16"):
    90	        r2 = model.evaluate_actions(obs, s.actions)
    91	    rec["replay_grad_repeat"] = {"values": C.diff(r2.values, r.values, playing)}
    92	    return rec
    93	
    94	
    95	def hidden_metrics(model: Any, obs: Any, dev: torch.device) -> dict[str, Any]:
    96	    from owl.model.stateless_transformer_v1 import _action_entity_slots_from_mask
    97	
    98	    slots = _action_entity_slots_from_mask(obs.action_mask)
    99	    playing = obs.still_playing.bool()
   100	    with torch.no_grad(), C.amp(dev, "bf16"):
   101	        enc_ng = model.encode_observations(obs, action_entity_slots=slots)
   102	    with C.amp(dev, "bf16"):
   103	        enc_g = model.encode_observations(obs, action_entity_slots=slots)
   104	    rec: dict[str, Any] = {
   105	        "all": C.diff(enc_g.hidden, enc_ng.hidden, enc_ng.token_mask.bool()),
   106	        "critic": C.diff(enc_g.critic_value_hidden, enc_ng.critic_value_hidden, playing),
   107	        "plan": C.diff(enc_g.actor_plan_hidden, enc_ng.actor_plan_hidden),
   108	        "token_mask_equal": bool(torch.equal(enc_g.token_mask, enc_ng.token_mask)),
   109	    }
   110	    with torch.no_grad(), C.amp(dev, "bf16"):
   111	        v_ng, _ = model._critic(enc_ng.critic_value_hidden, playing)
   112	        v_g, _ = model._critic(enc_g.critic_value_hidden, playing)
   113	    rec["head_swap_values"] = C.diff(v_g, v_ng, playing)
   114	    # fp32 critic head (autocast off, TF32 off) on each path's hidden states
   115	    tf32 = (torch.backends.cuda.matmul.allow_tf32, torch.backends.cudnn.allow_tf32)
   116	    torch.backends.cuda.matmul.allow_tf32 = False
   117	    torch.backends.cudnn.allow_tf32 = False
   118	    with torch.no_grad():
   119	        v32_ng, _ = model._critic(enc_ng.critic_value_hidden.float(), playing)
   120	        v32_g, _ = model._critic(enc_g.critic_value_hidden.float(), playing)
   121	        logits = model.critic_head(enc_ng.critic_value_hidden.float()).squeeze(-1)
   122	    torch.backends.cuda.matmul.allow_tf32, torch.backends.cudnn.allow_tf32 = tf32
   123	    rec["head_swap_fp32_head_values"] = C.diff(v32_g, v32_ng, playing)
   124	    rec["fp32_head_vs_bf16_head_values_nograd"] = C.diff(v32_ng, v_ng, playing)
   125	    rec["critic_logit_centered_fp32_head"] = C.stats(
   126	        playing_centered(logits, playing)[playing])
   127	    return rec
   128	
   129	
   130	def get_states(cfg: Any, model: Any, rows: int, dev: torch.device,
   131	               obs_dir: Path) -> tuple[Any, dict[str, Any]]:
   132	    from owl.rl import VectorizedEnv
   133	    from owl.train.ppo import _actions_to_cpu, _obs_to_device
   134	
   135	    path = obs_dir / f"orbit_obs_{rows}.pt"
   136	    if path.exists():
   137	        obs = torch.load(path, weights_only=False)
   138	        return _obs_to_device(obs, dev), {"source": "loaded", "path": str(path)}
   139	    env = VectorizedEnv(
   140	        n_envs=rows,
   141	        obs_spec=cfg.env.obs_spec,
   142	        action_spec=cfg.env.action_spec,
   143	        two_player_weight=cfg.env.two_player_weight,
   144	        reward_mode=cfg.env.reward_mode,
   145	        pin_memory=dev.type == "cuda",
   146	    )
   147	    obs = env.reset()
   148	    torch.manual_seed(SEED + 2)
   149	    launches = 0
   150	    for _ in range(STEPS):
   151	        with torch.no_grad(), C.amp(dev, "bf16"):
   152	            out = model(_obs_to_device(obs, dev))
   153	        launches += int(out.actions.launch.sum())
   154	        obs, _, _, _ = env.step(_actions_to_cpu(out.actions))
   155	    cpu = _obs_to_device(obs, torch.device("cpu"))  # cpu target clones the buffers
   156	    obs_dir.mkdir(parents=True, exist_ok=True)
   157	    torch.save(cpu, path)
   158	    info = {"source": "generated", "path": str(path), "steps": STEPS,
   159	            "sampled_launches": launches,
   160	            "entity_mask_true": int(cpu.entity_mask.sum()),
   161	            "still_playing_per_row": C.stats(cpu.still_playing.sum(-1).float())}
   162	    return _obs_to_device(cpu, dev), info
   163	
   164	
   165	def main() -> None:
   166	    ap = argparse.ArgumentParser()
   167	    ap.add_argument("--case", required=True)
   168	    ap.add_argument("--trunk", choices=("compiled", "eager"), required=True)
   169	    ap.add_argument("--rows", default="4,8" if C.DRYRUN else "256,1024")
   170	    ap.add_argument("--obs-dir", required=True)
   171	    ap.add_argument("--out", required=True)
   172	    args = ap.parse_args()
   173	    fh = open(args.out, "a")
   174	    C.configure("bf16")
   175	    dev = C.device()
   176	    import owl.model.stateless_transformer_v1 as st
   177	    from owl.model import create_model
   178	    from owl.train import FullConfig
   179	
   180	    # Amendment 3: attempt 3 wrapped st.use_flash_attn with a list-appending
   181	    # closure. Isaiah's attention calls use_flash_attn inside the compiled trunk,
   182	    # so Dynamo guarded on the list length, recompiled on every call and hit
   183	    # recompile_limit (8), running the 1,024-row cells eagerly. No wrapper now:
   184	    # force_flash_attn=True makes his trunk raise on any non-flash call
   185	    # (_requires_flash_attn), and a probe records use_flash_attn on a CUDA bf16
   186	    # tensor; the driver also fails a stage whose log hits recompile_limit.
   187	    flash_flags: list[bool] = []
   188	    C.emit(fh, C.process_record(args.case))
   189	    if not C.DRYRUN:
   190	        flash_flags.append(bool(st.use_flash_attn(
   191	            torch.zeros(1, 8, 8, 32, device=dev, dtype=torch.bfloat16))))
   192	    cfg = FullConfig.from_file(C.ROOT / "configs/scaling_6m.yaml")
   193	    torch.manual_seed(SEED)
   194	    model = create_model(cfg.model, obs_spec=cfg.env.obs_spec,
   195	                         action_spec=cfg.env.action_spec).to(dev).train()
   196	    model.reset_parameters()  # as run_ppo._create_training_model_for_config
   197	    head_gains = C.output_layer_gains(model, model.critic_head.out)
   198	    trunk_calls = [0]
   199	    if args.trunk == "compiled":
   200	        C.compile_trunk(model)
   201	        compiled = model._compiled_transformer_trunk
   202	
   203	        def counting(*a: Any) -> torch.Tensor:
   204	            trunk_calls[0] += 1
   205	            return compiled(*a)
   206	
   207	        model._compiled_transformer_trunk = counting
   208	    rows = [int(r) for r in args.rows.split(",")]
   209	    rec: dict[str, Any] = {
   210	        "event": "result", "case": args.case, "trunk": args.trunk, "rows": rows,
   211	        "config": {"model": cfg.model.model_dump(mode="json"),
   212	                   "obs_spec": cfg.env.obs_spec.model_dump(mode="json"),
   213	                   "action_spec": cfg.env.action_spec.model_dump(mode="json"),
   214	                   "two_player_weight": cfg.env.two_player_weight,
   215	                   "rl_model_compile": cfg.rl.model_compile,
   216	                   "rl_model_compile_mode": cfg.rl.model_compile_mode,
   217	                   "rl_dtype": cfg.rl.dtype},
   218	        "output_layer_spectral_norms": head_gains,
   219	        "tf32_matmul": torch.backends.cuda.matmul.allow_tf32,
   220	    }
   221	    steps: dict[str, str] = {}
   222	    rec["steps"] = steps
   223	    try:
   224	        for r in rows:
   225	            steps[f"states_{r}"] = "started"
   226	            obs, info = get_states(cfg, model, r, dev, Path(args.obs_dir))
   227	            rec[f"states_{r}"] = info
   228	            steps[f"states_{r}"] = "ok"
   229	            steps[f"pair_{r}"] = "started"
   230	            rec[f"default_gain_{r}"] = run_pair(model, obs, dev)
   231	            steps[f"pair_{r}"] = "ok"
   232	            steps[f"hidden_{r}"] = "started"
   233	            rec[f"hidden_{r}"] = hidden_metrics(model, obs, dev)
   234	            steps[f"hidden_{r}"] = "ok"
   235	            del obs
   236	    except Exception as exc:
   237	        rec["error"] = f"{type(exc).__name__}: {exc}"[:3000]
   238	        raise
   239	    finally:
   240	        rec["use_flash_attn_flags"] = sorted(set(flash_flags))
   241	        rec["use_flash_attn_calls"] = len(flash_flags)
   242	        rec["force_flash_attn"] = cfg.model.force_flash_attn
   243	        rec["flash_check"] = "probe + force_flash_attn (Amendment 3)"
   244	        rec["compiled_trunk_calls"] = trunk_calls[0]
   245	        rec["memory"] = C.mem(dev)
   246	        try:
   247	            from torch._dynamo.utils import counters
   248	
   249	            rec["dynamo_counters"] = {k: dict(v) for k, v in counters.items()}
   250	        except Exception as exc:  # noqa: BLE001 - diagnostic only
   251	            rec["dynamo_counters"] = f"unavailable: {exc}"
   252	        C.emit(fh, rec)
   253	    C.emit(fh, {"event": "done", "case": args.case})
   254	    fh.close()
   255	
   256	
   257	if __name__ == "__main__":
   258	    main()

