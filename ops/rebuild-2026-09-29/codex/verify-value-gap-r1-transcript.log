   180	class Driver:
   181	    def __init__(self) -> None:
   182	        self.t0 = time.monotonic()
   183	        self.deadline = self.t0 + BUDGET_S
   184	        self.stop = threading.Event()
   185	        self.spawn_lock = threading.Lock()  # non-reentrant; see module doc
   186	        self.log_lock = threading.RLock()
   187	        self.procs: dict[str, subprocess.Popen[bytes]] = {}
   188	        self.failure: int | None = None
   189	        self.cleaned = False
   190	        # Main-thread only (handler/atexit): set before any lock is taken, so a
   191	        # second signal during cleanup returns instead of re-entering the lock.
   192	        self.cleanup_started = False
   193	        self.log_fh = open(RUN / "driver.jsonl", "a")
   194	
   195	    def log(self, rec: dict[str, Any]) -> None:
   196	        rec = {"utc": now(), "t": round(time.monotonic() - self.t0, 1), **rec}
   197	        with self.log_lock:
   198	            self.log_fh.write(json.dumps(rec) + "\n")
   199	            self.log_fh.flush()
   200	            print(json.dumps(rec), flush=True)
   201	
   202	    @staticmethod
   203	    def _signal_group(p: subprocess.Popen[bytes], sig: int) -> None:
   204	        try:
   205	            os.killpg(p.pid, sig)
   206	        except ProcessLookupError:
   207	            pass
   208	
   209	    @staticmethod
   210	    def _group_alive(p: subprocess.Popen[bytes]) -> bool:
   211	        p.poll()  # reap an exited leader; members may outlive it
   212	        try:
   213	            os.killpg(p.pid, 0)
   214	        except ProcessLookupError:
   215	            return False
   216	        except PermissionError:
   217	            return True
   218	        return True
   219	
   220	    def fail(self, code: int) -> None:
   221	        """Record the first failure and stop the other stream (called in workers)."""
   222	        with self.spawn_lock:
   223	            if self.failure is None:
   224	                self.failure = code
   225	            self.stop.set()
   226	            procs = list(self.procs.values())
   227	        for p in procs:
   228	            if p.poll() is None:
   229	                self._signal_group(p, signal.SIGTERM)
   230	
   231	    def cleanup(self, reason: str) -> list[dict[str, Any]]:
   232	        """Terminate every started stage group, bounded in time. Idempotent.
   233	
   234	        Runs only in the main thread (signal handler or atexit).
   235	        """
   236	        if self.cleanup_started:
   237	            return []
   238	        self.cleanup_started = True
   239	        with self.spawn_lock:
   240	            if self.cleaned:
   241	                return []
   242	            self.cleaned = True
   243	            self.stop.set()
   244	            procs = dict(self.procs)
   245	        live = {n: p for n, p in procs.items() if self._group_alive(p)}
   246	        report: list[dict[str, Any]] = []
   247	        if live:
   248	            for p in live.values():
   249	                self._signal_group(p, signal.SIGTERM)
