   102	def run_pair(model: Any, obs: Any, dev: torch.device, prec: str,
   103	             suppl: bool) -> dict[str, Any]:
   104	    torch.manual_seed(SEED + 1)
   105	    with torch.no_grad(), C.amp(dev, prec):
   106	        s = model(obs)
   107	    with C.amp(dev, prec):
   108	        r = model.evaluate_actions(obs, s.actions)
   109	    rec = {"pair": pair_metrics(s, r)}
   110	    if suppl:
   111	        with torch.no_grad(), C.amp(dev, prec):
   112	            e_ng = model.evaluate_actions(obs, s.actions)
   113	        rec["eval_nograd_vs_sample"] = pair_metrics(s, e_ng)
   114	        with C.amp(dev, prec):
   115	            v_g = model.compute_value(obs)
   116	        rec["compute_value_grad_vs_sample"] = {
   117	            "values": C.diff(v_g, s.values), "requires_grad": bool(v_g.requires_grad)}
   118	        with torch.no_grad(), C.amp(dev, prec):
   119	            v_ng = model.compute_value(obs)
   120	        rec["compute_value_nograd_vs_sample"] = {"values": C.diff(v_ng, s.values)}
   121	        with C.amp(dev, prec):
   122	            r2 = model.evaluate_actions(obs, s.actions)
   123	        rec["replay_grad_repeat"] = {
   124	            "values": C.diff(r2.values, r.values),
   125	            "logp_event": C.diff(r2.log_probs.event, r.log_probs.event)}
   126	        torch.manual_seed(SEED + 1)
   127	        with torch.no_grad(), C.amp(dev, prec):
   128	            s2 = model(obs)
   129	        rec["sample_nograd_repeat"] = {
   130	            "values": C.diff(s2.values, s.values),
   131	            "actions_equal": bool(torch.equal(s2.actions.tokens, s.actions.tokens)),
   132	            "logp_event": C.diff(s2.log_probs.event, s.log_probs.event)}
   133	        del e_ng, v_g, v_ng, r2, s2
   134	    del s, r
   135	    return rec
