# Sourced by setup_pod.sh and eval_ckpt.sh. Override any value from the environment.
# The CPU eval pod (RunPod, 32 vCPU AMD EPYC 9965, Ubuntu 24.04). Never the H200
# training pod (port 15795) or the diagnostic pod (port 15537).
POD_HOST=${POD_HOST:-<terminated-pod-ip-redacted>}
POD_PORT=${POD_PORT:-32670}
POD_KEY=${POD_KEY:-$HOME/.ssh/id_ed25519}
POD_KNOWN_HOSTS=${POD_KNOWN_HOSTS:-$HOME/.ssh/known_hosts.runpod}
case "$POD_PORT" in 15795 | 15537) echo "refusing: port $POD_PORT is a training/diagnostic pod" >&2; exit 2 ;; esac

# Pinned inputs (see README.md).
KENV_ENGINE_SHA256=f73d27ce04a6fd5ddcdd59c618e1da8c9b6fb2f27f5cf9cdc27efad942345004
V2_REPO=${V2_REPO:-$HOME/kaggriculture-v2}             # read-only: only `git archive` runs there
V2_COMMIT=23f758007c3c53befc9bcab15a5bc7661d8b97e0
CHA22_AGENT_SHA256=bd7ffaa0b97b829a6ea3217178f12a1aa0f64cf8f58a750849c79ca94088c5ca
V56_AGENT_SHA256=34458b2a35f77be6431a3b4b692aaffd0bcb6bb3fbcf1356849555f54478f119
INPUT_CACHE=${INPUT_CACHE:-$HOME/.cache/kg-v3/anchor-eval}  # kenv-fixedshop.tar.gz, engine_rs-<commit>.tar.gz
KG_PKG_REPO=${KG_PKG_REPO:-/Users/poonszesen/kg-v3-pkg60}  # clean worktree with scripts/package_checkpoint.sh

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ANCHOR_GAMES="$(cd "$HERE/.." && pwd -P)"
SSH_OPTS=(-i "$POD_KEY" -o IdentitiesOnly=yes -o UserKnownHostsFile="$POD_KNOWN_HOSTS"
  -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -o ServerAliveInterval=30)
pod() { ssh "${SSH_OPTS[@]}" -p "$POD_PORT" "root@$POD_HOST" "$@" </dev/null; }
pod_put() { scp -q "${SSH_OPTS[@]}" -P "$POD_PORT" "${@:1:$#-1}" "root@$POD_HOST:${!#}"; }
pod_get() { scp -q -r "${SSH_OPTS[@]}" -P "$POD_PORT" "root@$POD_HOST:$1" "$2"; }
