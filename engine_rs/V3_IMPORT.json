  "adaptations": {
    "engine_rs/src/lib.rs": [
      "Expose existing native ABI module to the root PyO3 crate; no Python ctypes execution."
    ],
    "engine_rs/src/ffi.rs": [
      "Add re_native_seed_header: construct actual native initial state from seed/config for cold reset envelope.",
      "Retain transactional game/array behavior and per-batch Rayon from source; formatting normalized."
    ],
    "engine_rs/src/native_agents/library.rs": [
      "Make sell-intent test source and animal-resupply fixture dependencies crate-local."
    ],
    "engine_rs/src/native_agents/sell_intent_tests.rs": [
      "Relocate upstream test-only source into crate and point its fixture at crate-local copy."
    ],
    "engine_rs/src/native_agents/v39/late.rs": [
      "Locate retained late-helper oracle fixture in crate fixtures directory."
    ],
    "engine_rs/src/native_agents/v39/production.rs": [
      "Locate retained production-helper oracle fixture in crate fixtures directory."
    ],
    "python/owl/kaggriculture/native_bridge.py": [
      "Retain checked array ownership and native grammar wire parser; replace all ctypes calls/loading/build helpers with owl.rs PyO3 calls.",
      "Retain minimal observe/frame-step/reset/snapshot/economic-counter APIs only; type public boundaries."
    ],
    "python/owl/kaggriculture/actor_codec.py": [
      "Retain action schema/grammar/encoding/decoding validation oracle only.",
      "Remove all v2 model upgrade, model checkpoint migration, frame-representation and model mask-widening implementation.",
      "Typed public encode/decode/validate; narrow allow-untyped-defs applies to upstream private oracle helpers, not ignored type errors."
    ],
    "python/owl/kaggriculture/gpu_sampling_grammar.py": [
      "Type native-plan/device grammar interface; shallow-copy cached-table views rather than manipulating __dict__; no model implementation.",
      "Rename validation pending_hires scalar to avoid shadowing the allocated hires NumPy array under the locked mypy version."
    ],
    "python/owl/kaggriculture/env.py": [
      "Fresh v3 two-seat adapter uses caller-owned PyO3 buffers and existing shared PPO contracts; no v2 collector/trainer/model imported.",
      "Reuse narrowing scratch, mask-index tensors and economic NumPy view across steps; skip penalty arithmetic when shaping disabled while preserving counters, checked int64 narrowing and transactional native behavior.",
      "DDP seeds remain disjoint via persistent rank seed stride; terminal reward/counters retained before autoreset."
    ],
    "src/rules_engine/generation.rs": [
      "Test-only uniform random fixture decimals deserialize through serde_json::Number before finite f64 conversion: vendored arbitrary_precision feature unifies across crates and internally-tagged serde buffering otherwise reports map versus f64. Oracle comparisons and required-fixture checks unchanged."
    ]
  },
  "reward_formula_source": {
    "source": "ops/myolie-dagger-2026-09-22/selfplay.py",
    "sha256_at_review": "60bd910a767a6bd2b11365e94b6807fb8694182e1c0185dc9387a6b2fec9e531",
    "functions": [
      "terminal_reward",
      "econ_caps",
      "econ_terminal_scale",
      "econ_penalty_parts",
      "econ_shaping_rewards"
    ],
    "scope": "Formulas reimplemented in rewards.py; no trainer/model code imported. Margin uses terminal bank difference/3000, economic components default off; projected critic bounds not ported."
  },
